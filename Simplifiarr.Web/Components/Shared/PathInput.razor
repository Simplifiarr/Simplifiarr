@*
    A folder (or file) path box that says, as you type, whether that path
    exists - so a typo shows up before Save rather than as an empty scan.
*@

<div>
    <label class="form-label" for="@_id">@Label</label>

    <input id="@_id"
           class="form-control"
           placeholder="@Placeholder"
           value="@Value"
           @oninput="OnInput" />

    <div class="cell-note mt-1">
        @if (string.IsNullOrWhiteSpace(Value))
        {
            <span>@EmptyText</span>
        }
        else if (Exists(Value))
        {
            <span class="status-ok">Found</span>
        }
        else
        {
            <span class="status-warn">@(IsFile ? "File not found" : "Folder not found")</span>

            @if (!IsFile && CanCreate(Value))
            {
                <button type="button"
                        class="btn btn-secondary btn-sm ms-2 py-0"
                        @onclick="CreateFolder">
                    Create folder
                </button>
            }
        }

        @if (_createError is not null)
        {
            <span class="status-warn"> · @_createError</span>
        }

        @if (!string.IsNullOrWhiteSpace(Help))
        {
            <span> · @Help</span>
        }
    </div>
</div>

@code
{
    private readonly string _id = $"path-{Guid.NewGuid():N}";

    [Parameter, EditorRequired]
    public string Label { get; set; } = string.Empty;

    [Parameter]
    public string Value { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    [Parameter]
    public string? Placeholder { get; set; }

    [Parameter]
    public string? Help { get; set; }

    /// <summary>What to say when the box is empty.</summary>
    [Parameter]
    public string EmptyText { get; set; } = "Not set";

    /// <summary>The path is a file rather than a folder.</summary>
    [Parameter]
    public bool IsFile { get; set; }

    private string? _createError;

    private Task OnInput(ChangeEventArgs args)
    {
        _createError = null;

        return ValueChanged.InvokeAsync(args.Value?.ToString() ?? string.Empty);
    }

    // Only a full path on a drive that is there: "Torrents\Books" or a
    // missing drive letter would make a folder somewhere unexpected.
    private static bool CanCreate(string path)
    {
        try
        {
            var root = Path.GetPathRoot(path);

            return Path.IsPathFullyQualified(path) &&
                   !string.IsNullOrEmpty(root) &&
                   Directory.Exists(root);
        }
        catch
        {
            return false;
        }
    }

    private void CreateFolder()
    {
        try
        {
            Directory.CreateDirectory(Value.Trim());

            _createError = null;
        }
        catch (Exception exception) when (exception is IOException or UnauthorizedAccessException or ArgumentException or NotSupportedException)
        {
            _createError = $"Couldn't create it: {exception.Message}";
        }
    }

    private bool Exists(string path)
    {
        try
        {
            return IsFile ? File.Exists(path) : Directory.Exists(path);
        }
        catch
        {
            return false;
        }
    }
}
