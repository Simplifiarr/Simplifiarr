@*
    The top of every page: its name, one line saying what it's for, and
    (optionally) the page's main actions on the right.
*@

<div class="page-header">
    <div class="page-header-text">
        <h1>@Title</h1>

        @if (!string.IsNullOrWhiteSpace(Subtitle))
        {
            <p class="page-header-subtitle">@Subtitle</p>
        }
        else if (Description is not null)
        {
            <p class="page-header-subtitle">@Description</p>
        }
    </div>

    @if (ChildContent is not null)
    {
        <div class="page-header-actions">
            @ChildContent
        </div>
    }
</div>

@code
{
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string? Subtitle { get; set; }

    /// <summary>Use instead of Subtitle when the line needs markup.</summary>
    [Parameter]
    public RenderFragment? Description { get; set; }

    /// <summary>Buttons shown at the right of the header.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
