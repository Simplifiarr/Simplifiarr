@using Simplifiarr.Core.Models
@using Simplifiarr.Core.Services
@implements IDisposable

@inject IMediaPromotionService MediaPromotion
@inject IPromotionPreviewService PromotionPreviewService
@inject IPromotionExecuteService PromotionExecuteService
@inject IIgnoredItemsService IgnoredItemsService
@inject IHistoryService HistoryService
@inject IScanCoordinator Scans

@*
    The Hardlinks section for one media type handled by the shared pipeline
    (books, audiobooks, music, comics). Everything here is the same for every
    type; what differs - the name and the middle columns - comes from the
    type's MediaTypeDefinition.
*@

@if (!string.IsNullOrWhiteSpace(_statusMessage))
{
    <div class="alert alert-info">
        @_statusMessage
    </div>
}

@if (_selectedPreview is not null)
{
    <div class="card mb-3">
        <div class="card-header">
            Promotion Preview
        </div>

        <div class="card-body">
            <p>
                <strong>Source</strong>
            </p>

            <code>@_selectedPreview.SourcePath</code>

            <p class="mt-3">
                <strong>Target File</strong>
            </p>

            <code>@_selectedPreview.TargetFilePath</code>

            <p class="mt-3">
                <strong>Actions</strong>
            </p>

            <ul>
                @foreach (var action in _selectedPreview.PlannedActions)
                {
                    <li>@action</li>
                }
            </ul>

            <button class="btn btn-success"
                    disabled="@IsBusy"
                    @onclick="ExecuteSelectedAsync">
                <i class="bi bi-check-lg" aria-hidden="true"></i>
                @(_isExecuting
                    ? "Promoting..."
                    : "Confirm Promotion")
            </button>

            <button class="btn btn-secondary ms-2"
                    disabled="@_isExecuting"
                    @onclick="CancelPreview">
                <i class="bi bi-x-lg" aria-hidden="true"></i>
                Cancel
            </button>
        </div>
    </div>
}

@if (!_hasScanned)
{
    <EmptyState Icon="search" Text="@($"No scan has looked for {Plural} yet. Press Scan at the top of the page.")" />
}
else if (_candidates.Count == 0)
{
    <EmptyState Icon="check-circle" Text="@($"No {Plural} waiting to be linked into the library.")" />
}
else
{
    <p>
        <strong>@_candidates.Count</strong>
        promotable @(Definition.SingularName)(s) found.
    </p>

    @if (_isConfirmingBatch)
    {
        <BatchConfirmBanner IsBusy="_isExecuting"
                            ConfirmLabel="Confirm Promote"
                            BusyLabel="Promoting..."
                            OnConfirm="ConfirmBatchAsync"
                            OnCancel="CancelBatchConfirm">
            <Message>
                Promote @_pendingBatch.Count @(Definition.SingularName)(s)? This creates a hardlink for each.
            </Message>
        </BatchConfirmBanner>
    }
    else
    {
        <div class="mb-2">
            <button class="btn btn-primary btn-sm"
                    disabled="@IsBusy"
                    @onclick="() => RequestBatchConfirm(GetPromotable())">
                <i class="bi bi-arrow-up-right" aria-hidden="true"></i>
                Promote All @Definition.PluralName
            </button>

            <button class="btn btn-primary btn-sm ms-2"
                    disabled="@(IsBusy || _selection.Count == 0)"
                    @onclick="() => RequestBatchConfirm(GetSelectedPromotable())">
                <i class="bi bi-arrow-up-right" aria-hidden="true"></i>
                Promote Selected (@_selection.Count)
            </button>
        </div>
    }

    <table class="table">
        <thead>
            <tr>
                <th>Select</th>
                <th>Title</th>
                @foreach (var column in Definition.Columns)
                {
                    <th>@column.Header</th>
                }
                <th>Status</th>
                <th>Actions</th>
                <th>Details</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var candidate in _candidates)
            {
                <tr @key="candidate.SourcePath" class="@_previewSelection.RowClass(candidate)">
                    <SelectableCheckboxCell Checked="_selection.IsSelected(candidate)"
                                            Disabled="IsBusy"
                                            OnChanged="selected => _selection.SetSelected(candidate, selected)" />

                    <td>
                        <strong>@candidate.Title</strong>

                        <div class="text-muted small">
                            Found @HowLongAgo(candidate.DiscoveredUtc)
                        </div>

                        @if (!string.IsNullOrWhiteSpace(candidate.DriveProfileName))
                        {
                            <div class="text-muted small">
                                Drive: @candidate.DriveProfileName
                            </div>
                        }
                    </td>

                    @foreach (var column in Definition.Columns)
                    {
                        <td>@column.Value(candidate)</td>
                    }

                    <td>
                        @if (candidate.CanPromote)
                        {
                            <i class="bi bi-check-circle text-success" aria-hidden="true"></i> <text>READY</text>
                        }
                        else
                        {
                            <i class="bi bi-x-circle text-danger" aria-hidden="true"></i> <text>BLOCKED</text>
                        }
                    </td>

                    <td>
                        @if (candidate.CanPromote && candidate.Plan is not null)
                        {
                            <button class="@_previewSelection.ButtonClass(candidate)"
                                    disabled="@_previewSelection.IsButtonDisabled(candidate, IsBusy)"
                                    @onclick="() => PreviewAsync(candidate)">
                                <i class="bi bi-arrow-up-right" aria-hidden="true"></i>
                                @_previewSelection.ButtonText(candidate)
                            </button>
                        }

                        <button class="btn btn-sm btn-outline-secondary ms-1"
                                disabled="@IsBusy"
                                @onclick="() => Ignore(candidate)">
                            <i class="bi bi-eye-slash" aria-hidden="true"></i>
                            Ignore
                        </button>
                    </td>

                    <td>
                        <details>
                            <summary>View paths</summary>

                            <div class="mt-2">
                                <div>
                                    <strong>Reason</strong>
                                </div>

                                <p>
                                    @candidate.Reason
                                </p>

                                <div>
                                    <strong>Source File</strong>
                                </div>

                                <code>
                                    @candidate.SourcePath
                                </code>

                                @if (candidate.Plan is not null)
                                {
                                    <div class="mt-2">
                                        <strong>Target File</strong>
                                    </div>

                                    <code>
                                        @candidate.Plan.TargetFilePath
                                    </code>
                                }
                            </div>
                        </details>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code
{
    [Parameter, EditorRequired]
    public MediaTypeDefinition Definition { get; set; } = default!;

    [Parameter, EditorRequired]
    public List<DriveProfile> Profiles { get; set; } = [];

    /// <summary>
    /// Raised after the list changes (something was promoted or ignored),
    /// so the page can update the count on this type's tab.
    /// </summary>
    [Parameter]
    public EventCallback OnChanged { get; set; }

    private List<MediaPromotionCandidate> _candidates = [];

    private readonly CandidateSelection<MediaPromotionCandidate> _selection =
        new(candidate => candidate.SourcePath);

    private readonly PreviewSelection<MediaPromotionCandidate> _previewSelection =
        new();

    private PromotionPreview? _selectedPreview;

    private bool _isConfirmingBatch;

    private List<MediaPromotionCandidate> _pendingBatch = [];

    private bool _isExecuting;
    private bool _hasScanned;
    private bool _scanIsRunning;

    private string _statusMessage =
        string.Empty;

    private string Plural =>
        Definition.PluralName.ToLowerInvariant();

    // Nothing here may change the list while a scan is rebuilding it.
    private bool IsBusy =>
        _isExecuting || _scanIsRunning;

    protected override void OnInitialized()
    {
        _scanIsRunning = Scans.Progress.IsRunning;

        Scans.Changed += OnScanChanged;
    }

    protected override void OnParametersSet() =>
        LoadCandidates();

    private void OnScanChanged()
    {
        _ = InvokeAsync(() =>
        {
            var isRunning = Scans.Progress.IsRunning;
            var justFinished = _scanIsRunning && !isRunning;

            if (isRunning == _scanIsRunning)
            {
                return;
            }

            _scanIsRunning = isRunning;

            if (justFinished)
            {
                // The scan replaced the list, so anything previewed or
                // ticked may no longer exist.
                CancelPreview();
                CancelBatchConfirm();
                LoadCandidates();
            }

            StateHasChanged();
        });
    }

    private void LoadCandidates()
    {
        _candidates =
            Profiles
                .SelectMany(profile =>
                    MediaPromotion.GetCandidates(Definition.MediaType, profile.Name))
                .GroupBy(
                    candidate => candidate.SourcePath,
                    StringComparer.OrdinalIgnoreCase)
                .Select(group => group.First())
                .OrderBy(candidate => candidate.Title)
                .ToList();

        _hasScanned =
            Profiles.Any(profile =>
                MediaPromotion.GetLastScanUtc(Definition.MediaType, profile.Name).HasValue);
    }

    private List<MediaPromotionCandidate> GetPromotable() =>
        _candidates
            .Where(candidate => candidate.CanPromote && candidate.Plan is not null)
            .ToList();

    private List<MediaPromotionCandidate> GetSelectedPromotable() =>
        GetPromotable()
            .Where(candidate => _selection.IsSelected(candidate))
            .ToList();

    private async Task PreviewAsync(
        MediaPromotionCandidate candidate)
    {
        if (IsBusy || candidate.Plan is null)
        {
            return;
        }

        try
        {
            var preview =
                await PromotionPreviewService.CreateAsync(candidate.Plan);

            _previewSelection.Select(candidate);
            _selectedPreview = preview;
        }
        catch (Exception ex)
        {
            _statusMessage =
                $"Preview failed: {ex.Message}";
        }
    }

    private void CancelPreview()
    {
        _previewSelection.Clear();

        _selectedPreview = null;
    }

    private async Task ExecuteSelectedAsync()
    {
        var candidate = _previewSelection.Selected;

        if (IsBusy || candidate?.Plan is null)
        {
            return;
        }

        _isExecuting = true;

        try
        {
            var result = await PromoteAsync(candidate);

            _statusMessage = result.Reason;

            if (result.Success)
            {
                LoadCandidates();
                CancelPreview();

                _statusMessage =
                    $"{result.Reason} Remaining {Definition.SingularName} opportunities: {_candidates.Count}.";

                await OnChanged.InvokeAsync();
            }
        }
        catch (Exception ex)
        {
            _statusMessage =
                $"Promotion failed: {ex.Message}";
        }
        finally
        {
            _isExecuting = false;
        }
    }

    private void RequestBatchConfirm(
        List<MediaPromotionCandidate> candidates)
    {
        if (IsBusy || candidates.Count == 0)
        {
            return;
        }

        _pendingBatch = candidates;
        _isConfirmingBatch = true;
    }

    private void CancelBatchConfirm()
    {
        _isConfirmingBatch = false;
        _pendingBatch = [];
    }

    private async Task ConfirmBatchAsync()
    {
        if (IsBusy)
        {
            return;
        }

        _isExecuting = true;

        var succeeded = 0;
        var failed = 0;

        try
        {
            foreach (var candidate in _pendingBatch.ToList())
            {
                var result = await PromoteAsync(candidate);

                if (result.Success)
                {
                    succeeded++;
                }
                else
                {
                    failed++;
                }
            }

            LoadCandidates();
            CancelBatchConfirm();

            _statusMessage =
                failed == 0
                    ? $"Promoted {succeeded} {Definition.SingularName}(s)."
                    : $"Promoted {succeeded} {Definition.SingularName}(s), {failed} failed.";

            await OnChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            _statusMessage =
                $"Batch promotion failed: {ex.Message}";
        }
        finally
        {
            _isExecuting = false;
        }
    }

    /// <summary>
    /// Creates the hardlink, records it in History either way, and on
    /// success takes the candidate off the list.
    /// </summary>
    private async Task<PromotionExecutionResult> PromoteAsync(
        MediaPromotionCandidate candidate)
    {
        var plan = candidate.Plan!;

        var result =
            await PromotionExecuteService.ExecuteAsync(plan);

        await HistoryService.AddRecordAsync(
            new HistoryRecord
            {
                ActionType =
                    result.Success
                        ? HistoryActionType.PromotionSucceeded
                        : HistoryActionType.PromotionFailed,
                FileName = candidate.Title,
                LibraryPath = plan.TargetFilePath,
                DownloadPath = plan.SourcePath,
                SizeBytes =
                    File.Exists(plan.SourcePath)
                        ? new FileInfo(plan.SourcePath).Length
                        : 0,
                Success = result.Success,
                Message = result.Reason
            });

        if (result.Success)
        {
            MediaPromotion.RemoveCandidate(
                Definition.MediaType,
                candidate.SourcePath);

            _selection.Remove(candidate);
        }

        return result;
    }

    private async Task Ignore(
        MediaPromotionCandidate candidate)
    {
        if (IsBusy)
        {
            return;
        }

        await IgnoreCore(candidate);
        await OnChanged.InvokeAsync();
    }

    private Task IgnoreCore(
        MediaPromotionCandidate candidate)
    {

        IgnoredItemsService.Add(
            new IgnoredItem
            {
                SourcePath = candidate.SourcePath,
                Title = candidate.Title,
                Category = Definition.IgnoredCategory,
                Author = candidate.Author,
                DriveProfileName = candidate.DriveProfileName,
                IgnoredUtc = DateTime.UtcNow,
                Reason = candidate.Reason
            });

        MediaPromotion.RemoveCandidate(
            Definition.MediaType,
            candidate.SourcePath);

        _selection.Remove(candidate);

        if (ReferenceEquals(_previewSelection.Selected, candidate))
        {
            CancelPreview();
        }

        LoadCandidates();

        _statusMessage =
            $"Ignored \"{candidate.Title}\". It won't reappear until un-ignored and rescanned.";

        return Task.CompletedTask;
    }

    private static string HowLongAgo(
        DateTime discoveredUtc)
    {
        if (discoveredUtc == default)
        {
            return "at an unknown time";
        }

        var age = DateTime.UtcNow - discoveredUtc;

        if (age.TotalMinutes < 1)
        {
            return "just now";
        }

        if (age.TotalHours < 1)
        {
            var minutes = Math.Max(1, (int)age.TotalMinutes);

            return $"{minutes} minute{(minutes == 1 ? string.Empty : "s")} ago";
        }

        if (age.TotalDays < 1)
        {
            var hours = Math.Max(1, (int)age.TotalHours);

            return $"{hours} hour{(hours == 1 ? string.Empty : "s")} ago";
        }

        var days = Math.Max(1, (int)age.TotalDays);

        return $"{days} day{(days == 1 ? string.Empty : "s")} ago";
    }

    public void Dispose() =>
        Scans.Changed -= OnScanChanged;
}
