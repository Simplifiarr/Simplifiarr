@using Simplifiarr.Core.Models
@using Simplifiarr.Core.Services
@inherits ScanAwareComponent

@inject IMediaPromotionService MediaPromotion
@inject IPromotionPreviewService PromotionPreviewService
@inject IPromotionExecuteService PromotionExecuteService
@inject IIgnoredItemsService IgnoredItemsService
@inject IHistoryService HistoryService

@*
    The Hardlinks tab for one media type handled by the shared pipeline
    (books, audiobooks, music, comics). Everything here is the same for every
    type; what differs - the name and the middle columns - comes from the
    type's MediaTypeDefinition.
*@

@if (!string.IsNullOrWhiteSpace(_statusMessage))
{
    <div class="alert alert-info">
        @_statusMessage
    </div>
}

@if (_selectedPreview is not null)
{
    <div class="panel mb-3">
        <div class="action-row">
            <div>
                <div class="action-row-title">Link this file into the library?</div>

                <div class="detail-label">Download (stays where it is)</div>
                <code>@_selectedPreview.SourcePath</code>

                <div class="detail-label">Will also appear in the library as</div>
                <code>@_selectedPreview.TargetFilePath</code>

                <details class="mt-2">
                    <summary>What will happen, step by step</summary>

                    <ul class="mt-2 mb-0">
                        @foreach (var action in _selectedPreview.PlannedActions)
                        {
                            <li>@action</li>
                        }
                    </ul>
                </details>
            </div>

            <div class="cell-actions">
                <button type="button"
                        class="btn btn-primary"
                        disabled="@IsBusy"
                        @onclick="ExecuteSelectedAsync">
                    @(_isExecuting ? "Linking..." : "Link")
                </button>

                <button type="button"
                        class="btn btn-secondary"
                        disabled="@_isExecuting"
                        @onclick="CancelPreview">
                    Cancel
                </button>
            </div>
        </div>
    </div>
}

@if (!_hasScanned)
{
    <EmptyState Icon="search" Text="@($"No scan has looked for {Plural} yet. Press Scan at the top of the page.")" />
}
else if (_candidates.Count == 0)
{
    <EmptyState Icon="check-circle" Text="@($"No {Plural} waiting to be linked into the library.")" />
}
else
{
    @if (_isConfirmingBatch)
    {
        <BatchConfirmBanner IsBusy="_isExecuting"
                            ConfirmLabel="Link"
                            BusyLabel="Linking..."
                            OnConfirm="ConfirmBatchAsync"
                            OnCancel="CancelBatchConfirm">
            <Message>
                <strong>Link @_pendingBatch.Count @(Definition.SingularName)(s) into the library?</strong>
                Each gets a hardlink - nothing is copied or moved.
            </Message>
        </BatchConfirmBanner>
    }
    else
    {
        <div class="toolbar">
            <div class="toolbar-summary">
                <strong>@_candidates.Count</strong> @(Definition.SingularName)(s) ready to link
                @if (_selection.Count > 0)
                {
                    <text> · @_selection.Count selected</text>
                }
            </div>

            <div class="toolbar-actions">
                <button type="button"
                        class="btn btn-secondary btn-sm"
                        disabled="@(IsBusy || GetLinkable().Count == 0)"
                        @onclick="() => RequestBatchConfirm(GetLinkable())">
                    Link all
                </button>

                <button type="button"
                        class="btn btn-primary btn-sm"
                        disabled="@(IsBusy || _selection.Count == 0)"
                        @onclick="() => RequestBatchConfirm(GetSelectedLinkable())">
                    Link selected (@_selection.Count)
                </button>
            </div>
        </div>
    }

    <div class="table-scroll">
        <table class="table">
            <thead>
                <tr>
                    <th class="col-check">Select</th>
                    <th>Title</th>
                    @foreach (var column in Definition.Columns)
                    {
                        <th>@column.Header</th>
                    }
                    <th>Drive</th>
                    <th>Status</th>
                    <th>Actions</th>
                    <th>Details</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var candidate in _candidates.Take(_shown))
                {
                    var canLink =
                        candidate.CanPromote && candidate.Plan is not null;

                    <tr @key="candidate.SourcePath" class="@_previewSelection.RowClass(candidate)">
                        <SelectableCheckboxCell Checked="_selection.IsSelected(candidate)"
                                                Disabled="IsBusy || !canLink"
                                                OnChanged="selected => _selection.SetSelected(candidate, selected)" />

                        <td>
                            <div class="file-name">@candidate.Title</div>
                            <div class="cell-note">Found @HowLongAgo(candidate.DiscoveredUtc)</div>
                        </td>

                        @foreach (var column in Definition.Columns)
                        {
                            <td>@column.Value(candidate)</td>
                        }

                        <td>@(string.IsNullOrWhiteSpace(candidate.DriveProfileName) ? "-" : candidate.DriveProfileName)</td>

                        <td>
                            @if (canLink)
                            {
                                <span class="status-ok">Ready</span>
                            }
                            else
                            {
                                <span class="status-warn">Can't link</span>
                                <div class="cell-note">@candidate.Reason</div>
                            }
                        </td>

                        <td>
                            <div class="cell-actions">
                                @if (canLink)
                                {
                                    <button type="button"
                                            class="@_previewSelection.ButtonClass(candidate)"
                                            disabled="@_previewSelection.IsButtonDisabled(candidate, IsBusy)"
                                            @onclick="() => PreviewAsync(candidate)">
                                        @_previewSelection.ButtonText(candidate)
                                    </button>
                                }

                                <button type="button"
                                        class="btn btn-secondary btn-sm"
                                        disabled="@IsBusy"
                                        @onclick="() => Ignore(candidate)">
                                    Ignore
                                </button>
                            </div>
                        </td>

                        <td>
                            <details>
                                <summary>View paths</summary>

                                <div class="detail-label">Download</div>
                                <code>@candidate.SourcePath</code>

                                @if (candidate.Plan is not null)
                                {
                                    <div class="detail-label">Will be linked to</div>
                                    <code>@candidate.Plan.TargetFilePath</code>
                                }

                                <div class="detail-label">Why it's listed</div>
                                <div>@candidate.Reason</div>
                            </details>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (_candidates.Count > _shown)
    {
        <button type="button"
                class="btn btn-secondary mt-3"
                @onclick="() => _shown += PageSize">
            Show @Math.Min(PageSize, _candidates.Count - _shown) more (@(_candidates.Count - _shown) left)
        </button>
    }
}

@code
{
    // A music download folder can hold thousands of tracks.
    private const int PageSize = 100;

    [Parameter, EditorRequired]
    public MediaTypeDefinition Definition { get; set; } = default!;

    [Parameter, EditorRequired]
    public List<DriveProfile> Profiles { get; set; } = [];

    /// <summary>
    /// Raised after the list changes (something was linked or ignored),
    /// so the page can update the count on this type's tab.
    /// </summary>
    [Parameter]
    public EventCallback OnChanged { get; set; }

    private List<MediaPromotionCandidate> _candidates = [];

    private readonly CandidateSelection<MediaPromotionCandidate> _selection =
        new(candidate => candidate.SourcePath);

    private readonly PreviewSelection<MediaPromotionCandidate> _previewSelection =
        new();

    private PromotionPreview? _selectedPreview;

    private bool _isConfirmingBatch;

    private List<MediaPromotionCandidate> _pendingBatch = [];

    private int _shown = PageSize;

    private bool _isExecuting;
    private bool _hasScanned;

    private string _statusMessage =
        string.Empty;

    private string Plural =>
        Definition.PluralName.ToLowerInvariant();

    // Nothing here may change the list while a scan is rebuilding it.
    private bool IsBusy =>
        _isExecuting || IsScanning;

    protected override void OnParametersSet() =>
        LoadCandidates();

    protected override Task OnScanFinishedAsync()
    {
        // The scan replaced the list, so anything previewed or ticked may
        // no longer exist.
        CancelPreview();
        CancelBatchConfirm();

        _selection.Clear();
        _statusMessage = string.Empty;

        LoadCandidates();

        return Task.CompletedTask;
    }

    private void LoadCandidates()
    {
        _candidates =
            Profiles
                .SelectMany(profile =>
                    MediaPromotion.GetCandidates(Definition.MediaType, profile.Name))
                .GroupBy(
                    candidate => candidate.SourcePath,
                    StringComparer.OrdinalIgnoreCase)
                .Select(group => group.First())
                .OrderBy(candidate => candidate.Title)
                .ToList();

        _hasScanned =
            Profiles.Any(profile =>
                MediaPromotion.GetLastScanUtc(Definition.MediaType, profile.Name).HasValue);
    }

    private List<MediaPromotionCandidate> GetLinkable() =>
        _candidates
            .Where(candidate => candidate.CanPromote && candidate.Plan is not null)
            .ToList();

    private List<MediaPromotionCandidate> GetSelectedLinkable() =>
        GetLinkable()
            .Where(candidate => _selection.IsSelected(candidate))
            .ToList();

    private async Task PreviewAsync(
        MediaPromotionCandidate candidate)
    {
        if (IsBusy || candidate.Plan is null)
        {
            return;
        }

        try
        {
            var preview =
                await PromotionPreviewService.CreateAsync(candidate.Plan);

            _previewSelection.Select(candidate);
            _selectedPreview = preview;
        }
        catch (Exception ex)
        {
            _statusMessage =
                $"Couldn't prepare the preview: {ex.Message}";
        }
    }

    private void CancelPreview()
    {
        _previewSelection.Clear();

        _selectedPreview = null;
    }

    private async Task ExecuteSelectedAsync()
    {
        var candidate = _previewSelection.Selected;

        if (IsBusy || candidate?.Plan is null)
        {
            return;
        }

        _isExecuting = true;

        try
        {
            var result = await LinkAsync(candidate);

            if (result.Success)
            {
                LoadCandidates();
                CancelPreview();

                _statusMessage =
                    $"Linked \"{candidate.Title}\" into the library. {_candidates.Count} left.";

                await OnChanged.InvokeAsync();
            }
            else
            {
                _statusMessage =
                    $"Couldn't link \"{candidate.Title}\": {result.Reason}";
            }
        }
        catch (Exception ex)
        {
            _statusMessage =
                $"Couldn't link \"{candidate.Title}\": {ex.Message}";
        }
        finally
        {
            _isExecuting = false;
        }
    }

    private void RequestBatchConfirm(
        List<MediaPromotionCandidate> candidates)
    {
        if (IsBusy || candidates.Count == 0)
        {
            return;
        }

        _pendingBatch = candidates;
        _isConfirmingBatch = true;
    }

    private void CancelBatchConfirm()
    {
        _isConfirmingBatch = false;
        _pendingBatch = [];
    }

    private async Task ConfirmBatchAsync()
    {
        if (IsBusy)
        {
            return;
        }

        _isExecuting = true;

        var succeeded = 0;
        var failed = 0;

        try
        {
            foreach (var candidate in _pendingBatch.ToList())
            {
                var result = await LinkAsync(candidate);

                if (result.Success)
                {
                    succeeded++;
                }
                else
                {
                    failed++;
                }
            }

            LoadCandidates();
            CancelBatchConfirm();

            _statusMessage =
                failed == 0
                    ? $"Linked {succeeded} {Definition.SingularName}(s) into the library."
                    : $"Linked {succeeded} {Definition.SingularName}(s); {failed} failed and are still listed. See History for why.";

            await OnChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            _statusMessage =
                $"Linking stopped part-way: {ex.Message}";
        }
        finally
        {
            _isExecuting = false;
        }
    }

    /// <summary>
    /// Creates the hardlink, records it in History either way, and on
    /// success takes the candidate off the list.
    /// </summary>
    private async Task<PromotionExecutionResult> LinkAsync(
        MediaPromotionCandidate candidate)
    {
        var plan = candidate.Plan!;

        var result =
            await PromotionExecuteService.ExecuteAsync(plan);

        await HistoryService.AddRecordAsync(
            new HistoryRecord
            {
                ActionType =
                    result.Success
                        ? HistoryActionType.PromotionSucceeded
                        : HistoryActionType.PromotionFailed,
                FileName = candidate.Title,
                LibraryPath = plan.TargetFilePath,
                DownloadPath = plan.SourcePath,
                SizeBytes =
                    File.Exists(plan.SourcePath)
                        ? new FileInfo(plan.SourcePath).Length
                        : 0,
                Success = result.Success,
                Message = result.Reason
            });

        if (result.Success)
        {
            MediaPromotion.RemoveCandidate(
                Definition.MediaType,
                candidate.SourcePath);

            _selection.Remove(candidate);
        }

        return result;
    }

    private async Task Ignore(
        MediaPromotionCandidate candidate)
    {
        if (IsBusy)
        {
            return;
        }

        IgnoredItemsService.Add(
            new IgnoredItem
            {
                SourcePath = candidate.SourcePath,
                Title = candidate.Title,
                Category = Definition.IgnoredCategory,
                Author = candidate.Author,
                DriveProfileName = candidate.DriveProfileName,
                IgnoredUtc = DateTime.UtcNow,
                Reason = candidate.Reason
            });

        MediaPromotion.RemoveCandidate(
            Definition.MediaType,
            candidate.SourcePath);

        _selection.Remove(candidate);

        if (ReferenceEquals(_previewSelection.Selected, candidate))
        {
            CancelPreview();
        }

        LoadCandidates();

        _statusMessage =
            $"Ignored \"{candidate.Title}\". Undo this on the Ignored page.";

        await OnChanged.InvokeAsync();
    }

    private static string HowLongAgo(
        DateTime discoveredUtc)
    {
        if (discoveredUtc == default)
        {
            return "at an unknown time";
        }

        var age = DateTime.UtcNow - discoveredUtc;

        if (age.TotalMinutes < 1)
        {
            return "just now";
        }

        if (age.TotalHours < 1)
        {
            var minutes = Math.Max(1, (int)age.TotalMinutes);

            return $"{minutes} minute{(minutes == 1 ? string.Empty : "s")} ago";
        }

        if (age.TotalDays < 1)
        {
            var hours = Math.Max(1, (int)age.TotalHours);

            return $"{hours} hour{(hours == 1 ? string.Empty : "s")} ago";
        }

        var days = Math.Max(1, (int)age.TotalDays);

        return $"{days} day{(days == 1 ? string.Empty : "s")} ago";
    }
}
