<td>
    <input type="checkbox"
           checked="@Checked"
           disabled="@Disabled"
           @onchange="HandleChanged" />
</td>

@code
{
    [Parameter]
    public bool Checked { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public EventCallback<bool> OnChanged { get; set; }

    private Task HandleChanged(
        ChangeEventArgs e) =>
        OnChanged.InvokeAsync((bool?)e.Value == true);
}
