@page "/settings"
@rendermode InteractiveServer

@using System.Net.Http
@using System.Text.Json
@using Simplifiarr.Core.Models
@using Simplifiarr.Core.Services
@using Simplifiarr.Core.Utilities

@inject ISettingsService SettingsService
@inject IJellyfinClient JellyfinClient
@inject IArrEnrichmentService ArrEnrichmentService
@inject ITorrentClient TorrentClient
@inject IScanCoordinator Scans
@inject ISeerrClient SeerrClient

<PageTitle>Settings - Simplifiarr</PageTitle>

<PageHeader Title="Settings"
            Subtitle="Where your files are, which other apps Simplifiarr talks to, and where it keeps its own data. Nothing changes until you press Save.">
    @if (_settings is not null)
    {
        @if (HasUnsavedChanges)
        {
            <span class="pill">Unsaved changes</span>
        }

        <button type="button"
                class="btn btn-primary"
                disabled="@(_isSaving || !HasUnsavedChanges)"
                @onclick="SaveAsync">
            @(_isSaving ? "Saving..." : "Save")
        </button>
    }
</PageHeader>

@if (!string.IsNullOrWhiteSpace(_statusMessage))
{
    <div class="alert @(_saveFailed ? "alert-danger" : "alert-info")">
        @_statusMessage
    </div>
}

@if (_settings is null)
{
    <EmptyState Icon="hourglass-split" Text="Loading settings..." />
}
else
{
    <div class="app-tabs" role="tablist" aria-label="Settings section">
        <button type="button"
                role="tab"
                aria-selected="@(_tab == DrivesTab)"
                class="app-tab @(_tab == DrivesTab ? "active" : null)"
                @onclick="() => _tab = DrivesTab">
            Drives <span class="app-tab-count">@_settings.DriveProfiles.Count</span>
        </button>

        <button type="button"
                role="tab"
                aria-selected="@(_tab == ConnectionsTab)"
                class="app-tab @(_tab == ConnectionsTab ? "active" : null)"
                @onclick="() => _tab = ConnectionsTab">
            Connections
        </button>

        <button type="button"
                role="tab"
                aria-selected="@(_tab == StorageTab)"
                class="app-tab @(_tab == StorageTab ? "active" : null)"
                @onclick="() => _tab = StorageTab">
            Storage
        </button>

        <button type="button"
                role="tab"
                aria-selected="@(_tab == ScanningTab)"
                class="app-tab @(_tab == ScanningTab ? "active" : null)"
                @onclick="() => _tab = ScanningTab">
            Scanning
        </button>
    </div>

    @if (_tab == DrivesTab)
    {
        <div class="toolbar">
            <div class="toolbar-summary" style="max-width: 70ch">
                One entry per drive. A hardlink can only be made between folders on the
                same drive, so each drive gets its own downloads folder and libraries.
            </div>

            <div class="toolbar-actions">
                <button type="button"
                        class="btn btn-secondary btn-sm"
                        @onclick="AddDrive">
                    <i class="bi bi-plus-lg" aria-hidden="true"></i> Add drive
                </button>
            </div>
        </div>

        @if (_settings.DriveProfiles.Count == 0)
        {
            <EmptyState Icon="hdd" Text="No drives yet. Add one to tell Simplifiarr where your downloads and libraries are." />
        }

        @foreach (var profile in _settings.DriveProfiles)
        {
            var problems = DriveProfileValidator.GetProblems(profile);
            var isOpen = _openDrives.Contains(profile);
            var index = _settings.DriveProfiles.IndexOf(profile);

            <div class="group-card" @key="profile">
                <div class="group-card-header" style="align-items: center">
                    <div class="group-card-title">
                        @(string.IsNullOrWhiteSpace(profile.Name) ? "Unnamed drive" : profile.Name)

                        @if (!profile.Enabled)
                        {
                            <span class="cell-note ms-1">· turned off</span>
                        }

                        @if (problems.Count > 0)
                        {
                            <span class="status-warn ms-1">· folders overlap</span>
                        }
                    </div>

                    <div class="cell-actions">
                        <button type="button"
                                class="btn btn-secondary btn-sm"
                                aria-expanded="@isOpen"
                                @onclick="() => Toggle(profile)">
                            @(isOpen ? "Close" : "Edit")
                        </button>
                    </div>
                </div>

                @if (problems.Count > 0)
                {
                    <div class="alert alert-warning" style="margin: 0 1.1rem 1rem">
                        <strong>These folders overlap, so this drive's results can't be trusted:</strong>

                        <ul class="mb-0 mt-1">
                            @foreach (var problem in problems)
                            {
                                <li>@problem</li>
                            }
                        </ul>
                    </div>
                }

                @if (isOpen)
                {
                    <div style="padding: 0 1.1rem 1.1rem">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label" for="@($"drive-name-{index}")">Name</label>
                                <input id="@($"drive-name-{index}")"
                                       class="form-control"
                                       placeholder="D Drive"
                                       @bind="profile.Name"
                                       @bind:event="oninput" />
                            </div>

                            <div class="col-md-6">
                                <PathInput Label="Drive"
                                           Placeholder="D:\"
                                           Help="Every folder below should be on this drive"
                                           @bind-Value="profile.DriveRoot" />
                            </div>

                            <div class="col-md-6">
                                <PathInput Label="Downloads folder"
                                           Placeholder="D:\Torrents"
                                           Help="Where your torrent client saves finished downloads. Movies, TV and books are looked for here unless they have their own folder below"
                                           @bind-Value="profile.DownloadPath" />
                            </div>

                            <div class="col-md-6">
                                <PathInput Label="Seed-only folder"
                                           Placeholder="D:\Torrents\SeedOnly"
                                           EmptyText="Not used"
                                           Help="Downloads kept only for seeding; never suggested for a library"
                                           @bind-Value="profile.SeedOnlyPath" />
                            </div>
                        </div>

                        <h3 class="mt-4 mb-2">Libraries</h3>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <PathInput Label="Movies"
                                           Placeholder="D:\Movies"
                                           EmptyText="No movie library on this drive"
                                           @bind-Value="profile.MovieLibraryPath" />
                            </div>

                            <div class="col-md-6">
                                <PathInput Label="Movie downloads"
                                           Placeholder="D:\Torrents\Movies"
                                           EmptyText="Not set, so movies are looked for in the main downloads folder"
                                           @bind-Value="profile.MovieDownloadPath" />
                            </div>

                            <div class="col-md-6">
                                <PathInput Label="TV"
                                           Placeholder="D:\TV"
                                           EmptyText="No TV library on this drive"
                                           @bind-Value="profile.TvLibraryPath" />
                            </div>

                            <div class="col-md-6">
                                <PathInput Label="TV downloads"
                                           Placeholder="D:\Torrents\TV"
                                           EmptyText="Not set, so TV is looked for in the main downloads folder"
                                           @bind-Value="profile.TvDownloadPath" />
                            </div>

                            <div class="col-md-6">
                                <PathInput Label="Books"
                                           Placeholder="D:\Books"
                                           EmptyText="No book library on this drive"
                                           @bind-Value="profile.BookLibraryPath" />
                            </div>

                            <div class="col-md-6">
                                <PathInput Label="Book downloads"
                                           Placeholder="D:\Torrents\Books"
                                           EmptyText="Not set, so books are looked for in the main downloads folder"
                                           @bind-Value="profile.BookDownloadPath" />
                            </div>

                            <div class="col-md-6">
                                <PathInput Label="Audiobooks"
                                           Placeholder="D:\Audiobooks"
                                           EmptyText="No audiobook library on this drive"
                                           @bind-Value="profile.AudiobookLibraryPath" />
                            </div>

                            <div class="col-md-6">
                                <PathInput Label="Audiobook downloads"
                                           Placeholder="D:\Torrents\Audiobooks"
                                           EmptyText="Not set, so audiobooks are not looked for"
                                           @bind-Value="profile.AudiobookDownloadPath" />
                            </div>

                            <div class="col-md-6">
                                <PathInput Label="Music"
                                           Placeholder="D:\Music"
                                           EmptyText="No music library on this drive"
                                           @bind-Value="profile.MusicLibraryPath" />
                            </div>

                            <div class="col-md-6">
                                <PathInput Label="Music downloads"
                                           Placeholder="D:\Torrents\Music"
                                           EmptyText="Not set, so music is not looked for"
                                           @bind-Value="profile.MusicDownloadPath" />
                            </div>

                            <div class="col-md-6">
                                <PathInput Label="Comics"
                                           Placeholder="D:\Comics"
                                           EmptyText="No comic library on this drive"
                                           @bind-Value="profile.ComicLibraryPath" />
                            </div>

                            <div class="col-md-6">
                                <PathInput Label="Comic downloads"
                                           Placeholder="D:\Torrents\Comics"
                                           EmptyText="Not set, so comics are not looked for"
                                           @bind-Value="profile.ComicDownloadPath" />
                            </div>
                        </div>

                        <p class="cell-note mt-2 mb-0">
                            Movies, TV and books can share the main downloads folder, or each have one
                            of their own. A movie downloads folder is only searched for movies and a TV
                            one only for TV. Audiobooks, music and comics always need their own,
                            because an audiobook and a song are the same kind of file and can't be told
                            apart. Any of these can be a folder inside the main downloads folder.
                        </p>

                        <div class="form-check mt-3">
                            <input class="form-check-input"
                                   type="checkbox"
                                   id="@($"drive-keep-name-{index}")"
                                   @bind="profile.PreserveOriginalFileName" />
                            <label class="form-check-label" for="@($"drive-keep-name-{index}")">
                                Keep the download's file name in the library
                            </label>
                            <div class="cell-note">
                                Otherwise files are named "Title (Year)" or "Title - S01E02". Folders are the same either way.
                            </div>
                        </div>

                        <div class="form-check mt-3">
                            <input class="form-check-input"
                                   type="checkbox"
                                   id="@($"drive-protected-{index}")"
                                   @bind="profile.IsProtected" />
                            <label class="form-check-label" for="@($"drive-protected-{index}")">
                                Protected: keep this drive clear
                            </label>
                            <div class="cell-note">
                                Titles move off a protected drive once it gets too full, and nothing is moved onto it.
                                Every other drive is an overflow drive: it takes what full drives send it.
                            </div>
                        </div>

                        <div class="row g-3 mt-1">
                            @if (profile.IsProtected)
                            {
                                <div class="col-md-6">
                                    <label class="form-label" for="@($"drive-full-{index}")">Start moving titles off above</label>
                                    <div class="d-flex align-items-center gap-2">
                                        <input id="@($"drive-full-{index}")"
                                               class="form-control"
                                               type="number"
                                               min="10"
                                               max="100"
                                               style="max-width: 7rem"
                                               placeholder="@_settings.StorageFullAtPercent"
                                               @bind="profile.FullAtPercent" />
                                        <span>% used</span>
                                    </div>
                                    <div class="cell-note">
                                        Blank: the default, @(_settings.StorageFullAtPercent)%, set on the Scanning tab under Storage.
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label" for="@($"drive-back-{index}")">And bring it back down to</label>
                                    <div class="d-flex align-items-center gap-2">
                                        <input id="@($"drive-back-{index}")"
                                               class="form-control"
                                               type="number"
                                               min="5"
                                               max="100"
                                               style="max-width: 7rem"
                                               placeholder="@((profile.FullAtPercent ?? _settings.StorageFullAtPercent) - 10)"
                                               @bind="profile.BringBackToPercent" />
                                        <span>% used</span>
                                    </div>
                                    <div class="cell-note">
                                        Going lower than the start means it doesn't creep back over every few days.
                                        Blank: 10 points under the start.
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="col-md-6">
                                    <label class="form-label" for="@($"drive-keep-free-{index}")">Always leave free</label>
                                    <div class="d-flex align-items-center gap-2">
                                        <input id="@($"drive-keep-free-{index}")"
                                               class="form-control"
                                               type="number"
                                               min="0"
                                               style="max-width: 7rem"
                                               placeholder="@TenthOfDriveGb(profile)"
                                               @bind="profile.KeepFreeGb" />
                                        <span>GB</span>
                                    </div>
                                    <div class="cell-note">
                                        Nothing is moved onto it past this, and if it drops below, titles move off it.
                                        Blank: a tenth of the drive@(TenthOfDriveGb(profile) is { } tenth ? $", about {tenth} GB" : null),
                                        the usual advice for keeping a drive quick.
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="form-check mt-2">
                            <input class="form-check-input"
                                   type="checkbox"
                                   id="@($"drive-enabled-{index}")"
                                   @bind="profile.Enabled" />
                            <label class="form-check-label" for="@($"drive-enabled-{index}")">
                                Include this drive in scans
                            </label>
                        </div>

                        <div class="cell-actions mt-3">
                            @if (_confirmRemove == profile)
                            {
                                <button type="button"
                                        class="btn btn-danger btn-sm"
                                        @onclick="() => RemoveDrive(profile)">
                                    Remove this drive
                                </button>

                                <button type="button"
                                        class="btn btn-secondary btn-sm"
                                        @onclick="() => _confirmRemove = null">
                                    Cancel
                                </button>

                                <span class="cell-note" style="white-space: normal">
                                    Only removes it from Simplifiarr - no files are touched.
                                </span>
                            }
                            else
                            {
                                <button type="button"
                                        class="btn btn-outline-danger btn-sm"
                                        @onclick="() => _confirmRemove = profile">
                                    Remove drive
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    }
    else if (_tab == ConnectionsTab)
    {
        <p class="text-muted" style="max-width: 70ch">
            Only the torrent client is needed. The rest are optional and each adds one thing.
            Test connection tries what is typed in right now, saved or not.
        </p>

        <div class="group-card">
            <div class="group-card-header">
                <div class="group-card-title">Torrent client</div>
                <div class="group-card-meta" style="white-space: normal">Knows which downloads are still seeding, and adds and moves torrents when you ask</div>
            </div>

            <div style="padding: 0 1.1rem 1.1rem">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label" for="client-kind">Client</label>
                        <select id="client-kind" class="form-select" @bind="_settings.TorrentClient">
                            <option value="@TorrentClientKind.QBittorrent">qBittorrent</option>
                        </select>
                    </div>

                    <div class="col-md-8">
                        <label class="form-label" for="client-url">Web UI address</label>
                        <input id="client-url" class="form-control" placeholder="http://localhost:8080" @bind="_settings.TorrentClientUrl" @bind:event="oninput" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label" for="client-user">Username</label>
                        <input id="client-user" class="form-control" autocomplete="off" @bind="_settings.TorrentClientUsername" @bind:event="oninput" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label" for="client-password">Password</label>
                        <input id="client-password" class="form-control" type="password" autocomplete="off" @bind="_settings.TorrentClientPassword" @bind:event="oninput" />
                    </div>
                </div>

                <div class="cell-note mt-2">
                    Leave the username blank if the client lets this computer in without one
                    (in qBittorrent: "Bypass authentication for clients on localhost").
                </div>

                <div class="cell-actions mt-3" style="flex-wrap: wrap; align-items: center">
                    <button type="button" class="btn btn-secondary btn-sm" disabled="@_isTestingClient" @onclick="TestTorrentClientAsync">
                        @(_isTestingClient ? "Testing..." : "Test connection")
                    </button>

                    @if (_clientTestResult is not null)
                    {
                        <span class="@(_clientTestOk ? "status-ok" : "status-warn")" style="white-space: normal">@_clientTestResult</span>
                    }
                </div>
            </div>
        </div>

        <ConnectionFields Name="Radarr"
                          Purpose="Optional. Adds genres and exact titles to your movies"
                          UrlPlaceholder="http://localhost:7878"
                          @bind-Url="_settings.RadarrUrl"
                          @bind-ApiKey="_settings.RadarrApiKey"
                          Test="@(() => TestArrAsync(_settings.RadarrUrl, _settings.RadarrApiKey, "/api/v3/system/status"))">
            <button type="button"
                    class="btn btn-secondary btn-sm"
                    disabled="@(_isSyncingRadarr || HasUnsavedChanges)"
                    title="@(HasUnsavedChanges ? "Save first - this uses the saved address and key" : null)"
                    @onclick="SyncRadarrAsync">
                @(_isSyncingRadarr ? "Fetching..." : "Fetch movie details")
            </button>
        </ConnectionFields>

        @if (!string.IsNullOrWhiteSpace(_radarrSyncMessage))
        {
            <div class="alert alert-info">@_radarrSyncMessage <a href="arr">See what matched</a></div>
        }

        <ConnectionFields Name="Sonarr"
                          Purpose="Optional. Adds genres, show names and episode numbers to your TV"
                          UrlPlaceholder="http://localhost:8989"
                          @bind-Url="_settings.SonarrUrl"
                          @bind-ApiKey="_settings.SonarrApiKey"
                          Test="@(() => TestArrAsync(_settings.SonarrUrl, _settings.SonarrApiKey, "/api/v3/system/status"))">
            <button type="button"
                    class="btn btn-secondary btn-sm"
                    disabled="@(_isSyncingSonarr || HasUnsavedChanges)"
                    title="@(HasUnsavedChanges ? "Save first - this uses the saved address and key" : null)"
                    @onclick="SyncSonarrAsync">
                @(_isSyncingSonarr ? "Fetching..." : "Fetch TV details")
            </button>
        </ConnectionFields>

        @if (!string.IsNullOrWhiteSpace(_sonarrSyncMessage))
        {
            <div class="alert alert-info">@_sonarrSyncMessage <a href="arr">See what matched</a></div>
        }

        <ConnectionFields Name="Prowlarr"
                          Purpose="Optional. Searches your indexers for Cross-Seed and Size Reduction"
                          UrlPlaceholder="http://localhost:9696"
                          @bind-Url="_settings.ProwlarrUrl"
                          @bind-ApiKey="_settings.ProwlarrApiKey"
                          Test="@(() => TestArrAsync(_settings.ProwlarrUrl, _settings.ProwlarrApiKey, "/api/v1/system/status"))" />

        <ConnectionFields Name="Jellyfin"
                          Purpose="Optional. Collections are sent to it, and Posters changes its artwork"
                          UrlPlaceholder="http://localhost:8096"
                          @bind-Url="_settings.JellyfinUrl"
                          @bind-ApiKey="_settings.JellyfinApiKey"
                          Test="TestJellyfinAsync" />

        <ConnectionFields Name="Seerr"
                          Purpose="Optional. Jellyseerr or Overseerr: Storage shows who asked for each title and whether they've watched it"
                          UrlPlaceholder="http://localhost:5055"
                          @bind-Url="_settings.SeerrUrl"
                          @bind-ApiKey="_settings.SeerrApiKey"
                          Test="@(() => SeerrClient.TestConnectionAsync(_settings.SeerrUrl, _settings.SeerrApiKey))" />

        <div class="group-card">
            <div class="group-card-header">
                <div class="group-card-title">fanart.tv</div>
                <div class="group-card-meta" style="white-space: normal">Optional. Adds fanart.tv's posters, backdrops, logos and more to the Posters page</div>
            </div>

            <div style="padding: 0 1.1rem 1.1rem">
                <label class="form-label" for="fanart-key">Personal API key</label>
                <input id="fanart-key"
                       class="form-control"
                       type="password"
                       autocomplete="off"
                       @bind="_settings.FanartApiKey" />
                <div class="cell-note mt-1">
                    Free from your fanart.tv account page. Leave blank to use only the posters Jellyfin finds itself.
                </div>
            </div>
        </div>
    }
    else if (_tab == ScanningTab)
    {
        <div class="group-card">
            <div class="group-card-header">
                <div class="group-card-title">Automatic scanning</div>
                <div class="group-card-meta" style="white-space: normal">Runs Scan by itself, so every page is up to date when you open it</div>
            </div>

            <div style="padding: 0 1.1rem 1.1rem">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label" for="auto-scan">Scan</label>
                        <select id="auto-scan" class="form-select" @bind="_settings.AutoScan">
                            <option value="@AutoScanMode.Off">Only when I press Scan</option>
                            <option value="@AutoScanMode.EveryHours">Every few hours</option>
                            <option value="@AutoScanMode.Daily">Once a day</option>
                        </select>
                    </div>

                    @if (_settings.AutoScan == AutoScanMode.EveryHours)
                    {
                        <div class="col-md-4">
                            <label class="form-label" for="auto-scan-hours">Every</label>
                            <select id="auto-scan-hours" class="form-select" @bind="_settings.AutoScanEveryHours">
                                @foreach (var hours in AutoScanSchedule.HourChoices)
                                {
                                    <option value="@hours">@(hours == 1 ? "hour" : $"{hours} hours")</option>
                                }
                            </select>
                        </div>
                    }
                    else if (_settings.AutoScan == AutoScanMode.Daily)
                    {
                        <div class="col-md-4">
                            <label class="form-label" for="auto-scan-time">At</label>
                            <input id="auto-scan-time" class="form-control" type="time" @bind="DailyTime" @bind:event="onchange" />
                        </div>
                    }
                </div>

                @if (_settings.AutoScan != AutoScanMode.Off)
                {
                    <div class="form-check mt-3">
                        <input id="auto-cross-seed" class="form-check-input" type="checkbox" @bind="_settings.AutoScanCrossSeed" />
                        <label class="form-check-label" for="auto-cross-seed">
                            Then search for cross-seeds
                        </label>
                        <div class="cell-note">
                            Asks your indexers through Prowlarr about every torrent you seed, which can take a while.
                            Matches wait on the Cross-Seed page; nothing is added to your torrent client without you.
                        </div>
                    </div>
                }

                <div class="cell-note mt-3">
                    @NextScanText
                </div>

                <div class="cell-note">
                    Automatic scans only find things. Nothing is linked, moved or deleted until you press a button.
                    A scan already running is never interrupted, and a scan missed while the computer was off runs
                    a couple of minutes after Simplifiarr starts.
                </div>
            </div>
        </div>

        <div class="group-card">
            <div class="group-card-header">
                <div class="group-card-title">Size Reduction</div>
                <div class="group-card-meta" style="white-space: normal">Searches your indexers for smaller releases by itself and saves what it finds</div>
            </div>

            <div style="padding: 0 1.1rem 1.1rem">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label" for="sr-auto">Search</label>
                        <select id="sr-auto" class="form-select" @bind="_settings.SizeReductionAuto">
                            <option value="@AutoScanMode.Off">Only when I press Search</option>
                            <option value="@AutoScanMode.EveryHours">Every few days</option>
                            <option value="@AutoScanMode.Daily">Once a day</option>
                        </select>
                    </div>

                    @if (_settings.SizeReductionAuto == AutoScanMode.EveryHours)
                    {
                        <div class="col-md-4">
                            <label class="form-label" for="sr-hours">Every</label>
                            <select id="sr-hours" class="form-select" @bind="_settings.SizeReductionEveryHours">
                                <option value="24">day</option>
                                <option value="72">3 days</option>
                                <option value="168">week</option>
                                <option value="336">2 weeks</option>
                                <option value="720">month</option>
                            </select>
                        </div>
                    }
                    else if (_settings.SizeReductionAuto == AutoScanMode.Daily)
                    {
                        <div class="col-md-4">
                            <label class="form-label" for="sr-time">At</label>
                            <input id="sr-time" class="form-control" type="time" @bind="SizeReductionTime" @bind:event="onchange" />
                        </div>
                    }
                </div>

                @if (_settings.SizeReductionAuto != AutoScanMode.Off)
                {
                    <div class="mt-3">
                        <div class="form-label">Drives to search</div>
                        @foreach (var profile in _settings.DriveProfiles.Where(profile => profile.Enabled))
                        {
                            <div class="form-check form-check-inline">
                                <input class="form-check-input"
                                       type="checkbox"
                                       id="@($"sr-drive-{profile.Name}")"
                                       checked="@SearchesDrive(profile.Name)"
                                       @onchange="e => SetSearchesDrive(profile.Name, e.Value is true)" />
                                <label class="form-check-label" for="@($"sr-drive-{profile.Name}")">@profile.Name</label>
                            </div>
                        }
                        <div class="cell-note">
                            Each drive is searched on its own turn, one at a time, counted from its last search.
                            All ticked means every drive, including ones added later.
                        </div>
                    </div>
                }

                <div class="cell-note mt-2">
                    Needs Prowlarr. Results wait on the <a href="size-reduction">Size Reduction</a> page; nothing is downloaded by itself.
                </div>

                <div class="form-check mt-3">
                    <input id="sr-autoswap" class="form-check-input" type="checkbox" @bind="_settings.SizeReductionAutoSwap" />
                    <label class="form-check-label" for="sr-autoswap">Swap a smaller release in as soon as it has downloaded</label>
                    <div class="cell-note">
                        For releases you pressed Download on. Off: each one waits for you to press Swap now. Either way the
                        old file goes to the Recycle Bin and Radarr or Sonarr rescans.
                    </div>
                </div>
            </div>
        </div>

        <div class="group-card">
            <div class="group-card-header">
                <div class="group-card-title">Storage</div>
                <div class="group-card-meta" style="white-space: normal">When a drive counts as full, and when an unwatched title is worth a look</div>
            </div>

            <div style="padding: 0 1.1rem 1.1rem">
                <div style="max-width: 32rem">
                    <label class="form-label" for="storage-full">Protected drives start moving titles off above</label>
                    <div class="d-flex align-items-center gap-2">
                        <input id="storage-full"
                               class="form-control"
                               type="number"
                               min="10"
                               max="100"
                               style="max-width: 7rem"
                               @bind="_settings.StorageFullAtPercent" />
                        <span>% used</span>
                    </div>
                    <div class="cell-note">
                        Unless a drive has its own. Which drives are protected, and how much an overflow
                        drive keeps free, is set for each drive on the Drives tab.
                    </div>
                </div>

                <div class="mt-3" style="max-width: 32rem">
                    <label class="form-label" for="storage-largest">Leave titles bigger than this for me to move</label>
                    <div class="d-flex align-items-center gap-2">
                        <input id="storage-largest"
                               class="form-control"
                               type="number"
                               min="0"
                               style="max-width: 7rem"
                               @bind="_settings.StorageLargestToMoveGb" />
                        <span>GB</span>
                    </div>
                    <div class="cell-note">
                        Big titles take hours to copy, and a smaller release from Size Reduction often frees
                        more. They're listed on Storage for you to decide. 0: no limit.
                    </div>
                </div>

                <div class="mt-3" style="max-width: 32rem">
                    <label class="form-label" for="storage-recent">Leave titles added or changed in the last</label>
                    <div class="d-flex align-items-center gap-2">
                        <input id="storage-recent"
                               class="form-control"
                               type="number"
                               min="0"
                               style="max-width: 7rem"
                               @bind="_settings.StorageRecentDays" />
                        <span>days</span>
                    </div>
                    <div class="cell-note">
                        A show still getting episodes, or a new movie, is what people are watching. 0: no wait.
                    </div>
                </div>

                <div class="form-check mt-3" style="max-width: 32rem">
                    <input class="form-check-input"
                           type="checkbox"
                           id="storage-auto-move"
                           @bind="_settings.StorageAutoMove" />
                    <label class="form-check-label" for="storage-auto-move">
                        Move titles off full drives by itself after each automatic scan
                    </label>
                    <div class="cell-note">
                        Queues the same moves Storage suggests, as if you had pressed Move all. Each file is
                        still copied and checked before the old folder goes to the Recycle Bin. Try Move all
                        by hand a few times before turning this on.
                    </div>
                </div>

                <div class="mt-3" style="max-width: 32rem">
                    <label class="form-label" for="storage-unwatched">Suggest reviewing titles nobody has watched after</label>
                    <select id="storage-unwatched" class="form-select" style="max-width: 12rem" @bind="_settings.StorageUnwatchedMonths">
                        <option value="3">3 months</option>
                        <option value="6">6 months</option>
                        <option value="12">12 months</option>
                    </select>
                    <div class="cell-note">Watch history comes from Jellyfin during Scan.</div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="group-card">
            <div class="group-card-header">
                <div class="group-card-title">Simplifiarr's own files</div>
            </div>

            <div style="padding: 0 1.1rem 1.1rem">
                <div class="detail-label" style="margin-top: 0">Settings are saved in</div>
                <code>@AppPaths.SettingsFile</code>

                <div class="detail-label">Scan results and logs are kept in</div>
                <code>@AppPaths.DataRoot</code>

                <div class="row g-3 mt-1">
                    <div class="col-md-6">
                        <PathInput Label="Quarantine folder"
                                   EmptyText="@($"Default: {AppPaths.DefaultQuarantinePath}")"
                                   Help="Removed files wait here until you delete or restore them"
                                   @bind-Value="_settings.QuarantinePath" />

                        <button type="button"
                                class="btn btn-secondary btn-sm mt-2"
                                @onclick="@(() => _quarantineTest = TestWritable(_settings.QuarantinePath, isFile: false))">
                            Check it can be written to
                        </button>

                        @if (!string.IsNullOrWhiteSpace(_quarantineTest))
                        {
                            <span class="cell-note ms-2">@_quarantineTest</span>
                        }
                    </div>

                    <div class="col-md-6">
                        <PathInput Label="History file"
                                   IsFile="true"
                                   EmptyText="@($"Default: {AppPaths.DefaultHistoryFile}")"
                                   Help="The record of everything Simplifiarr has changed"
                                   @bind-Value="_settings.HistoryPath" />

                        <button type="button"
                                class="btn btn-secondary btn-sm mt-2"
                                @onclick="@(() => _historyTest = TestWritable(_settings.HistoryPath, isFile: true))">
                            Check it can be written to
                        </button>

                        @if (!string.IsNullOrWhiteSpace(_historyTest))
                        {
                            <span class="cell-note ms-2">@_historyTest</span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="group-card">
            <div class="group-card-header">
                <div class="group-card-title">Cross-Seed</div>
            </div>

            <div style="padding: 0 1.1rem 1.1rem">
                <PathInput Label="Cross-seed folder"
                           Help="Matched torrents are hardlinked here and their .torrent files saved here"
                           @bind-Value="_settings.CrossSeedTorrentStoragePath" />

                <p class="cell-note mt-2 mb-2">
                    Point your download client's watch folder at this folder, or use the Add
                    buttons on the Cross-Seed page. Hardlinks can't cross drives, so for files
                    on another drive a folder with the same name is made at the top of that drive.
                </p>

                <button type="button"
                        class="btn btn-secondary btn-sm"
                        @onclick="@(() => _crossSeedTest = TestWritable(_settings.CrossSeedTorrentStoragePath, isFile: false))">
                    Check it can be written to
                </button>

                @if (!string.IsNullOrWhiteSpace(_crossSeedTest))
                {
                    <span class="cell-note ms-2">@_crossSeedTest</span>
                }
            </div>
        </div>

        <div class="group-card">
            <div class="group-card-header">
                <div class="group-card-title">Video details (ffprobe)</div>
            </div>

            <div style="padding: 0 1.1rem 1.1rem">
                <p class="cell-note">
                    Simplifiarr uses ffprobe, part of ffmpeg, to read each video's resolution
                    and codec. It looks for it in the usual places by itself.
                </p>

                @if (_ffprobeFound is null)
                {
                    <div class="alert alert-warning">
                        ffprobe wasn't found, so videos have no resolution or codec. Install
                        ffmpeg, or enter where <code>ffprobe.exe</code> is below.
                    </div>
                }
                else
                {
                    <div class="detail-label" style="margin-top: 0">Currently using</div>
                    <code>@_ffprobeFound</code>
                }

                <div class="mt-3">
                    <PathInput Label="Use this ffprobe instead"
                               IsFile="true"
                               Placeholder="C:\ffmpeg\bin\ffprobe.exe"
                               EmptyText="Not set - found automatically"
                               @bind-Value="_settings.FfprobePath" />
                </div>

                <div class="mt-3">
                    <PathInput Label="7-Zip, for unpacking packed releases"
                               IsFile="true"
                               Placeholder="C:\Program Files\7-Zip\7z.exe"
                               EmptyText="Not set - found automatically"
                               @bind-Value="_settings.SevenZipPath" />
                </div>

                <div class="mt-3">
                    <label class="form-label" for="media-server-account">Media server's Windows account</label>
                    <input id="media-server-account"
                           class="form-control"
                           placeholder="Found from the Jellyfin, Emby or Plex service"
                           @bind="_settings.MediaServerAccount" />
                    <div class="cell-note mt-1">
                        Playback Errors checks this account can read each file. Leave blank to use the account the
                        Jellyfin, Emby or Plex Windows service runs as. If your media server runs as a normal program,
                        enter your Windows user name, e.g. <code>@(Environment.MachineName)\you</code>.
                    </div>
                </div>
            </div>
        </div>
    }

    @if (HasUnsavedChanges)
    {
        <div class="cell-actions mt-3" style="align-items: center">
            <button type="button"
                    class="btn btn-primary"
                    disabled="@_isSaving"
                    @onclick="SaveAsync">
                @(_isSaving ? "Saving..." : "Save")
            </button>

            <button type="button"
                    class="btn btn-secondary"
                    disabled="@_isSaving"
                    @onclick="DiscardAsync">
                Discard changes
            </button>
        </div>
    }
}

@code
{
    // A tenth of the drive the entry is on, in GB, for the "leave free"
    // placeholder; null when the drive can't be read.
    private static int? TenthOfDriveGb(DriveProfile profile)
    {
        var anyPath =
            new[] { profile.DriveRoot, profile.MovieLibraryPath, profile.TvLibraryPath }
                .FirstOrDefault(path => !string.IsNullOrWhiteSpace(path));

        if (anyPath is null)
        {
            return null;
        }

        try
        {
            var info = new DriveInfo(StoragePlanner.RootOf(anyPath));

            return info.IsReady ? (int)(info.TotalSize / 10 / (1024L * 1024 * 1024)) : null;
        }
        catch (Exception exception) when (exception is IOException or UnauthorizedAccessException or ArgumentException or NotSupportedException)
        {
            return null;
        }
    }

    private const string DrivesTab = "drives";
    private const string ConnectionsTab = "connections";
    private const string StorageTab = "storage";
    private const string ScanningTab = "scanning";

    private TimeOnly? DailyTime
    {
        get => AutoScanSchedule.ParseTime(_settings?.AutoScanDailyTime) is { } time
            ? TimeOnly.FromTimeSpan(time)
            : null;
        set
        {
            if (_settings is not null && value is { } time)
            {
                _settings.AutoScanDailyTime = time.ToString("HH:mm", System.Globalization.CultureInfo.InvariantCulture);
            }
        }
    }

    private TimeOnly? SizeReductionTime
    {
        get => AutoScanSchedule.ParseTime(_settings?.SizeReductionDailyTime) is { } time
            ? TimeOnly.FromTimeSpan(time)
            : null;
        set
        {
            if (_settings is not null && value is { } time)
            {
                _settings.SizeReductionDailyTime = time.ToString("HH:mm", System.Globalization.CultureInfo.InvariantCulture);
            }
        }
    }

    private bool SearchesDrive(string name) =>
        _settings is not null &&
        (_settings.SizeReductionDrives.Count == 0 ||
         _settings.SizeReductionDrives.Contains(name, StringComparer.OrdinalIgnoreCase));

    private void SetSearchesDrive(string name, bool on)
    {
        if (_settings is null)
        {
            return;
        }

        var all = _settings.DriveProfiles.Where(profile => profile.Enabled).Select(profile => profile.Name).ToList();

        var chosen =
            _settings.SizeReductionDrives.Count == 0
                ? all.ToHashSet(StringComparer.OrdinalIgnoreCase)
                : _settings.SizeReductionDrives.ToHashSet(StringComparer.OrdinalIgnoreCase);

        if (on)
        {
            chosen.Add(name);
        }
        else
        {
            chosen.Remove(name);
        }

        // Nothing ticked: nothing to search, so automatic searching is off.
        if (chosen.Count == 0)
        {
            _settings.SizeReductionAuto = AutoScanMode.Off;
            _settings.SizeReductionDrives = [];

            return;
        }

        // Everything ticked is stored as "all", so new drives are included.
        _settings.SizeReductionDrives =
            all.All(chosen.Contains) ? [] : all.Where(chosen.Contains).ToList();
    }

    private string NextScanText
    {
        get
        {
            if (_settings is null || _settings.AutoScan == AutoScanMode.Off)
            {
                return "Automatic scanning is off.";
            }

            if (Scans.Progress.IsRunning)
            {
                return "A scan is running now. The next automatic one is worked out from when it started.";
            }

            var now = DateTime.Now;
            var last = Scans.LastSummary?.StartedUtc.ToLocalTime();
            var next = AutoScanSchedule.NextRunLocal(_settings, last, now);

            var lastText =
                last is { } lastValue ? $" The last scan started {lastValue:ddd d MMM, h:mm tt}." : string.Empty;

            var saved = HasUnsavedChanges ? " (once you press Save)" : string.Empty;

            return next is not { } nextValue
                ? "Automatic scanning is off."
                : nextValue <= now
                    ? $"The next automatic scan is due now{saved}; it starts within a minute.{lastText}"
                    : $"The next automatic scan is {nextValue:ddd d MMM, h:mm tt}{saved}.{lastText}";
        }
    }

    private SimplifiarrSettings? _settings;

    // What the settings looked like when last loaded or saved, to tell
    // whether anything has been changed since.
    private string _savedSnapshot = string.Empty;

    private string _tab = DrivesTab;

    private readonly HashSet<DriveProfile> _openDrives = [];

    private DriveProfile? _confirmRemove;

    private bool _isSaving;
    private bool _saveFailed;

    private string _statusMessage = string.Empty;

    private string _quarantineTest = string.Empty;
    private string _historyTest = string.Empty;
    private string _crossSeedTest = string.Empty;

    private string? _ffprobeFound;

    private bool _isSyncingRadarr;
    private bool _isSyncingSonarr;

    private string _radarrSyncMessage = string.Empty;
    private string _sonarrSyncMessage = string.Empty;

    private bool HasUnsavedChanges =>
        _settings is not null &&
        Snapshot(_settings) != _savedSnapshot;

    protected override Task OnInitializedAsync() =>
        LoadAsync();

    private async Task LoadAsync()
    {
        _settings =
            await SettingsService.GetSettingsAsync();

        _settings.DriveProfiles ??= [];

        _savedSnapshot = Snapshot(_settings);

        _openDrives.Clear();
        _confirmRemove = null;

        // A drive with a setup problem opens by itself, so the thing that
        // needs fixing is in front of you.
        foreach (var profile in _settings.DriveProfiles)
        {
            if (DriveProfileValidator.GetProblems(profile).Count > 0)
            {
                _openDrives.Add(profile);
            }
        }

        FfprobeLocator.Configure(_settings.FfprobePath);

        _ffprobeFound = FfprobeLocator.Find();
    }

    private static string Snapshot(SimplifiarrSettings settings) =>
        JsonSerializer.Serialize(settings);

    private void Toggle(DriveProfile profile)
    {
        if (!_openDrives.Remove(profile))
        {
            _openDrives.Add(profile);
        }
    }

    private void AddDrive()
    {
        if (_settings is null)
        {
            return;
        }

        var profile =
            new DriveProfile
            {
                Name = string.Empty,
                Enabled = true
            };

        _settings.DriveProfiles.Add(profile);

        _openDrives.Add(profile);
    }

    private void RemoveDrive(DriveProfile profile)
    {
        _settings?.DriveProfiles.Remove(profile);

        _openDrives.Remove(profile);
        _confirmRemove = null;
    }

    private async Task DiscardAsync()
    {
        await LoadAsync();

        _saveFailed = false;
        _statusMessage = "Changes discarded.";
    }

    private async Task SaveAsync()
    {
        if (_settings is null || _isSaving)
        {
            return;
        }

        var unnamed =
            _settings.DriveProfiles.Count(profile => string.IsNullOrWhiteSpace(profile.Name));

        var duplicateNames =
            _settings.DriveProfiles
                .Where(profile => !string.IsNullOrWhiteSpace(profile.Name))
                .GroupBy(profile => profile.Name.Trim(), StringComparer.OrdinalIgnoreCase)
                .Where(group => group.Count() > 1)
                .Select(group => group.Key)
                .ToList();

        // Scan results are filed under the drive's name, so every drive
        // needs one, and no two can share it.
        if (unnamed > 0 || duplicateNames.Count > 0)
        {
            _saveFailed = true;

            _statusMessage =
                unnamed > 0
                    ? "Not saved: every drive needs a name."
                    : $"Not saved: more than one drive is called \"{duplicateNames[0]}\". Give each drive its own name.";

            _tab = DrivesTab;

            return;
        }

        _isSaving = true;
        _saveFailed = false;

        try
        {
            foreach (var profile in _settings.DriveProfiles)
            {
                profile.Name = profile.Name.Trim();
            }

            // The junk rules and picture types are set on their own pages,
            // which save them as they change; keep those rather than the
            // copy loaded here.
            var onDisk = await SettingsService.GetSettingsAsync();

            _settings.Junk = onDisk.Junk;
            _settings.PictureTypes = onDisk.PictureTypes;
            _settings.SizeReductionRules = onDisk.SizeReductionRules;

            await SettingsService.SaveSettingsAsync(_settings);

            _savedSnapshot = Snapshot(_settings);

            FfprobeLocator.Configure(_settings.FfprobePath);

            _ffprobeFound = FfprobeLocator.Find();

            var missing =
                _settings.DriveProfiles
                    .Where(profile => profile.Enabled)
                    .SelectMany(ConfiguredFolders)
                    .Count(path => !Directory.Exists(path));

            var overlapping =
                _settings.DriveProfiles
                    .Count(profile =>
                        profile.Enabled &&
                        DriveProfileValidator.GetProblems(profile).Count > 0);

            _statusMessage =
                "Saved. Press Scan to refresh results with the new settings." +
                (missing > 0 ? $" {missing} folder(s) on the Drives tab don't exist." : string.Empty) +
                (overlapping > 0 ? $" {overlapping} drive(s) have overlapping folders." : string.Empty);
        }
        catch (Exception ex)
        {
            _saveFailed = true;

            _statusMessage =
                $"Not saved. {ex.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private static IEnumerable<string> ConfiguredFolders(
        DriveProfile profile)
    {
        return new[]
            {
                profile.DriveRoot,
                profile.DownloadPath,
                profile.MovieDownloadPath,
                profile.TvDownloadPath,
                profile.BookDownloadPath,
                profile.MovieLibraryPath,
                profile.TvLibraryPath,
                profile.BookLibraryPath,
                profile.AudiobookLibraryPath,
                profile.AudiobookDownloadPath,
                profile.MusicLibraryPath,
                profile.MusicDownloadPath,
                profile.ComicLibraryPath,
                profile.ComicDownloadPath,
                profile.SeedOnlyPath
            }
            .Where(path => !string.IsNullOrWhiteSpace(path));
    }

    private bool _isTestingClient;
    private bool _clientTestOk;
    private string? _clientTestResult;

    // Uses what is typed in now, saved or not, including the login.
    private async Task TestTorrentClientAsync()
    {
        if (_isTestingClient || _settings is null)
        {
            return;
        }

        _isTestingClient = true;
        _clientTestResult = null;

        try
        {
            var problem =
                await TorrentClient.TestConnectionAsync(
                    _settings.TorrentClientUrl,
                    _settings.TorrentClientUsername,
                    _settings.TorrentClientPassword);

            _clientTestOk = problem is null;
            _clientTestResult = problem ?? $"Connected to {TorrentClient.Name}";
        }
        finally
        {
            _isTestingClient = false;
        }
    }

    private static Task<string?> TestArrAsync(
        string url,
        string apiKey,
        string statusPath)
    {
        if (!Uri.TryCreate(url.TrimEnd('/') + statusPath, UriKind.Absolute, out var uri))
        {
            return Task.FromResult<string?>("That isn't a valid address. It should look like http://localhost:7878");
        }

        return TryGetAsync(uri, apiKey);
    }

    /// <summary>
    /// Null when the app answered; otherwise what went wrong, in words.
    /// </summary>
    private static async Task<string?> TryGetAsync(
        Uri uri,
        string? apiKey)
    {
        try
        {
            using var client =
                new HttpClient
                {
                    Timeout = TimeSpan.FromSeconds(5)
                };

            using var request =
                new HttpRequestMessage(HttpMethod.Get, uri);

            if (apiKey is not null)
            {
                request.Headers.Add("X-Api-Key", apiKey);
            }

            using var response =
                await client.SendAsync(request);

            if (response.IsSuccessStatusCode)
            {
                return null;
            }

            return (int)response.StatusCode is 401 or 403
                ? "It answered, but refused the request. Check the API key."
                : $"It answered with an error: {(int)response.StatusCode} {response.ReasonPhrase}.";
        }
        catch (TaskCanceledException)
        {
            return "No answer within 5 seconds. Check the address and that the app is running.";
        }
        catch (HttpRequestException ex)
        {
            return $"Couldn't reach it: {ex.Message}";
        }
    }

    private async Task<string?> TestJellyfinAsync()
    {
        var connected =
            await JellyfinClient.TestConnectionAsync(
                _settings!.JellyfinUrl,
                _settings.JellyfinApiKey);

        return connected
            ? null
            : "Couldn't connect. Check the address and API key.";
    }

    private async Task SyncRadarrAsync()
    {
        if (_isSyncingRadarr)
        {
            return;
        }

        _isSyncingRadarr = true;
        _radarrSyncMessage = string.Empty;

        try
        {
            var result =
                await ArrEnrichmentService.EnrichFromRadarrAsync();

            _radarrSyncMessage =
                $"Radarr knows {result.TotalFetched:N0} movie(s); {result.Matched:N0} matched files in your libraries.";
        }
        catch (Exception ex)
        {
            _radarrSyncMessage = $"Couldn't fetch from Radarr: {ex.Message}";
        }
        finally
        {
            _isSyncingRadarr = false;
        }
    }

    private async Task SyncSonarrAsync()
    {
        if (_isSyncingSonarr)
        {
            return;
        }

        _isSyncingSonarr = true;
        _sonarrSyncMessage = string.Empty;

        try
        {
            var result =
                await ArrEnrichmentService.EnrichFromSonarrAsync();

            _sonarrSyncMessage =
                $"Sonarr knows {result.TotalFetched:N0} episode file(s); {result.Matched:N0} matched files in your libraries.";
        }
        catch (Exception ex)
        {
            _sonarrSyncMessage = $"Couldn't fetch from Sonarr: {ex.Message}";
        }
        finally
        {
            _isSyncingSonarr = false;
        }
    }

    private static string TestWritable(
        string? configuredPath,
        bool isFile)
    {
        if (string.IsNullOrWhiteSpace(configuredPath))
        {
            return "Nothing entered - the default location is used.";
        }

        try
        {
            var folder =
                isFile
                    ? Path.GetDirectoryName(configuredPath)
                    : configuredPath;

            if (string.IsNullOrWhiteSpace(folder) || !Directory.Exists(folder))
            {
                return "That folder doesn't exist yet. Simplifiarr will try to create it when it is first needed.";
            }

            var testFile =
                Path.Combine(folder, $".simplifiarr-test-{Guid.NewGuid():N}.tmp");

            File.WriteAllText(testFile, "Simplifiarr");
            File.Delete(testFile);

            return "Yes, it can be written to.";
        }
        catch (UnauthorizedAccessException)
        {
            return "No - Windows refused access to that folder.";
        }
        catch (Exception ex)
        {
            return $"No - {ex.Message}";
        }
    }
}
