@page "/collections"
@rendermode InteractiveServer

@using Simplifiarr.Core.Models
@using Simplifiarr.Core.Services
@using Simplifiarr.Core.Utilities

@inject ICollectionService CollectionService
@inject ICollectionBuilderService CollectionBuilderService
@inject IMediaCatalogService MediaCatalogService
@inject ISettingsService SettingsService

<PageTitle>Collections</PageTitle>

<h1>Collections</h1>

<p>
    Curate groups of Movies, TV episodes, Books, Audiobooks, Music, and
    Comics however you like - a Sci-Fi shelf, a Christmas collection,
    anything.
</p>

<div class="alert alert-warning">
    <strong>Jellyfin sync is temporarily disabled.</strong> Both ways of
    creating a real Jellyfin collection (its REST API, and hand-writing a
    collection.xml file) were confirmed broken/unreliable during testing,
    including an incident where the API repeatedly spawned duplicate
    internal library folders. Collections can still be curated here - just
    not synced to Jellyfin right now.
</div>

@if (!string.IsNullOrWhiteSpace(_statusMessage))
{
    <div class="alert alert-info">@_statusMessage</div>
}

@if (_selectedCollection is null)
{
    @if (_profiles.Count == 0)
    {
        <div class="alert alert-warning">No enabled drive profiles configured.</div>
    }
    else
    {
        <div class="card mb-3">
            <div class="card-body">
                <h5>Create Collection</h5>

                <div class="row g-2 align-items-end">
                    <div class="col-md-5">
                        <label class="form-label">Name</label>
                        <input class="form-control" @bind="_newCollectionName" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Drive</label>
                        <select class="form-select" @bind="_newCollectionDrive">
                            @foreach (var profile in _profiles)
                            {
                                <option value="@profile.Name">@profile.Name</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-3">
                        <button type="button"
                                class="btn btn-primary"
                                disabled="@string.IsNullOrWhiteSpace(_newCollectionName)"
                                @onclick="CreateCollectionAsync">
                            <i class="bi bi-plus-lg" aria-hidden="true"></i>
                            Create
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (_collections.Count == 0)
    {
        <EmptyState Icon="collection" Text="No collections yet." />
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Drive</th>
                    <th>Items</th>
                    <th>Orphaned</th>
                    <th>Last Built</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var collection in _collections)
                {
                    var orphanCount =
                        _orphanCounts.GetValueOrDefault(collection.Id);

                    <tr>
                        <td>@collection.Name</td>
                        <td>@collection.DriveProfileName</td>
                        <td>@collection.AssetIds.Count</td>
                        <td>
                            @if (orphanCount > 0)
                            {
                                <span class="text-danger fw-bold">@orphanCount</span>
                            }
                            else
                            {
                                <span>0</span>
                            }
                        </td>
                        <td>@(collection.LastBuiltUtc.HasValue ? collection.LastBuiltUtc.Value.ToLocalTime().ToString("g") : "Never")</td>
                        <td>
                            <button type="button"
                                    class="btn btn-sm btn-outline-primary"
                                    @onclick="() => OpenCollectionAsync(collection)">
                                <i class="bi bi-folder2-open" aria-hidden="true"></i>
                                Open
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}
else
{
    <button type="button" class="btn btn-link ps-0" @onclick="CloseCollection">&larr; Back to Collections</button>

    <h3>
        @_selectedCollection.Name
        <span class="text-muted">(@_selectedCollection.DriveProfileName)</span>
    </h3>

    <div class="mb-3">
        @if (!_isConfirmingDelete)
        {
            <button type="button"
                    class="btn btn-outline-danger"
                    @onclick="() => _isConfirmingDelete = true">
                <i class="bi bi-trash" aria-hidden="true"></i>
                Delete Collection
            </button>
        }
        else
        {
            <BatchConfirmBanner CssClass="alert alert-danger d-inline-block mb-0 py-2"
                                ConfirmLabel="Confirm Delete"
                                OnConfirm="DeleteCollectionAsync"
                                OnCancel="() => _isConfirmingDelete = false">
                <Message>
                    Delete this collection? This only removes the grouping
                    in Simplifiarr - it was never synced to Jellyfin, so
                    there's nothing else to clean up.
                </Message>
            </BatchConfirmBanner>
        }
    </div>

    @if (_orphanedMembers.Count > 0 || _orphanedCount > _orphanedMembers.Count)
    {
        <div class="alert alert-warning">
            <strong>@_orphanedCount</strong> item(s) in this collection no
            longer exist in your library (the original file was deleted,
            likely from Radarr/Sonarr or manually).

            @if (_orphanedMembers.Count > 0)
            {
                <ul class="mb-2">
                    @foreach (var asset in _orphanedMembers)
                    {
                        <li>@asset.Title</li>
                    }
                </ul>
            }

            @if (!_isConfirmingOrphanCleanup)
            {
                <button type="button"
                        class="btn btn-warning btn-sm"
                        @onclick="() => _isConfirmingOrphanCleanup = true">
                    <i class="bi bi-trash" aria-hidden="true"></i>
                    Remove Orphaned Item(s)
                </button>
            }
            else
            {
                <BatchConfirmBanner CssClass="mt-2"
                                    ConfirmLabel="Confirm Remove"
                                    OnConfirm="RemoveOrphanedMembersAsync"
                                    OnCancel="() => _isConfirmingOrphanCleanup = false">
                    <Message>
                        This removes them from this collection's membership.
                        Your library is unaffected either way - there's
                        nothing left there to affect.
                    </Message>
                </BatchConfirmBanner>
            }
        </div>
    }

    <h5 class="mt-4">Members (@GetMembers().Count)</h5>

    @if (GetMembers().Count == 0)
    {
        <EmptyState Icon="collection" Text="No items added yet." />
    }
    else
    {
        <table class="table table-sm">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Year</th>
                    <th>Season</th>
                    <th>Episode</th>
                    <th>Episode Title</th>
                    <th>Author</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var asset in GetMembers())
                {
                    <tr>
                        <td>@asset.Title</td>
                        <td>@asset.Year</td>
                        <td>@(asset.MediaType == MediaType.TvEpisode ? $"{asset.Season:00}" : "")</td>
                        <td>@(asset.MediaType == MediaType.TvEpisode ? $"{asset.Episode:00}" : "")</td>
                        <td>@(asset.MediaType == MediaType.TvEpisode ? asset.EpisodeTitle : "")</td>
                        <td>@(asset.MediaType is MediaType.Book or MediaType.Audiobook or MediaType.Music or MediaType.Comic ? asset.Author : "")</td>
                        <td>
                            <button type="button"
                                    class="btn btn-sm btn-outline-secondary"
                                    @onclick="() => RemoveMember(asset.Id)">
                                Remove
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <h5 class="mt-4">Add Movies</h5>

    <div class="row g-2 mb-2">
        <div class="col-md-6">
            <input class="form-control"
                   placeholder="Filter by title..."
                   @bind="_movieFilterText"
                   @bind:event="oninput" />
        </div>

        @if (GetAvailableMovieGenres().Count > 0)
        {
            <div class="col-md-4">
                <select class="form-select" @bind="_movieGenre">
                    <option value="">All genres</option>
                    @foreach (var genre in GetAvailableMovieGenres())
                    {
                        <option value="@genre">@genre</option>
                    }
                </select>
            </div>

            <div class="col-md-2">
                <button type="button"
                        class="btn btn-outline-primary w-100"
                        disabled="@(!GetFilteredAddableMovies().Any())"
                        @onclick="AddAllFilteredMovies">
                    Add All (@GetFilteredAddableMovies().Count())
                </button>
            </div>
        }
    </div>

    @if (GetAddableMovies().Count == 0)
    {
        <EmptyState Icon="film" Text="No matching movies from this drive's library to add." />
    }
    else
    {
        <table class="table table-sm">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Year</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var asset in GetAddableMovies())
                {
                    <tr>
                        <td>@asset.Title</td>
                        <td>@asset.Year</td>
                        <td>
                            <button type="button"
                                    class="btn btn-sm btn-outline-primary"
                                    @onclick="() => AddMember(asset.Id)">
                                Add
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <h5 class="mt-4">Add TV Episodes</h5>

    <div class="row g-2 mb-2">
        <div class="col-md-6">
            <input class="form-control"
                   placeholder="Filter by show title..."
                   @bind="_tvFilterText"
                   @bind:event="oninput" />
        </div>

        @if (GetAvailableTvGenres().Count > 0)
        {
            <div class="col-md-4">
                <select class="form-select" @bind="_tvGenre">
                    <option value="">All genres</option>
                    @foreach (var genre in GetAvailableTvGenres())
                    {
                        <option value="@genre">@genre</option>
                    }
                </select>
            </div>

            <div class="col-md-2">
                <button type="button"
                        class="btn btn-outline-primary w-100"
                        disabled="@(!GetFilteredAddableTv().Any())"
                        @onclick="AddAllFilteredTv">
                    Add All (@GetFilteredAddableTv().Count())
                </button>
            </div>
        }
    </div>

    @if (GetTvShowGroups().Count == 0)
    {
        <EmptyState Icon="tv" Text="No matching TV episodes from this drive's library to add." />
    }
    else
    {
        @foreach (var show in GetTvShowGroups())
        {
            <details class="mb-2">
                <summary>
                    <strong>@show.Title</strong> - @show.EpisodeCount episode(s)
                    <button type="button"
                            class="btn btn-sm btn-outline-primary ms-2"
                            @onclick="() => AddWholeShow(show.Title)">
                        Add whole show
                    </button>
                </summary>

                <div class="mt-2 ps-3">
                    @foreach (var season in show.Seasons)
                    {
                        <h6 class="mt-2">
                            @(season.Season.HasValue ? $"Season {season.Season:00}" : "Season Unknown")
                            - @season.Episodes.Count episode(s)
                            <button type="button"
                                    class="btn btn-sm btn-outline-primary ms-2"
                                    @onclick="() => AddWholeSeason(show.Title, season.Season)">
                                Add whole season
                            </button>
                        </h6>

                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Episode</th>
                                    <th>Title</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var episode in season.Episodes)
                                {
                                    <tr>
                                        <td>@(episode.Episode.HasValue ? $"E{episode.Episode:00}" : "Unknown")</td>
                                        <td>@(episode.EpisodeTitle ?? "")</td>
                                        <td>
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-primary"
                                                    @onclick="() => AddMember(episode.Id)">
                                                Add
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </details>
        }
    }

    <h5 class="mt-4">Add Books</h5>

    <div class="row g-2 mb-2">
        <div class="col-md-6">
            <input class="form-control"
                   placeholder="Filter by title..."
                   @bind="_bookFilterText"
                   @bind:event="oninput" />
        </div>

        @if (GetAvailableBookGenres().Count > 0)
        {
            <div class="col-md-4">
                <select class="form-select" @bind="_bookGenre">
                    <option value="">All genres</option>
                    @foreach (var genre in GetAvailableBookGenres())
                    {
                        <option value="@genre">@genre</option>
                    }
                </select>
            </div>

            <div class="col-md-2">
                <button type="button"
                        class="btn btn-outline-primary w-100"
                        disabled="@(!GetFilteredAddableBooks().Any())"
                        @onclick="AddAllFilteredBooks">
                    Add All (@GetFilteredAddableBooks().Count())
                </button>
            </div>
        }
    </div>

    @if (GetAddableBooks().Count == 0)
    {
        <EmptyState Icon="book" Text="No matching books from this drive's library to add." />
    }
    else
    {
        <table class="table table-sm">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Author</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var asset in GetAddableBooks())
                {
                    <tr>
                        <td>@asset.Title</td>
                        <td>@asset.Author</td>
                        <td>
                            <button type="button"
                                    class="btn btn-sm btn-outline-primary"
                                    @onclick="() => AddMember(asset.Id)">
                                Add
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <h5 class="mt-4">Add Audiobooks</h5>

    <div class="row g-2 mb-2">
        <div class="col-md-6">
            <input class="form-control"
                   placeholder="Filter by title..."
                   @bind="_audiobookFilterText"
                   @bind:event="oninput" />
        </div>

        @if (GetAvailableAudiobookGenres().Count > 0)
        {
            <div class="col-md-4">
                <select class="form-select" @bind="_audiobookGenre">
                    <option value="">All genres</option>
                    @foreach (var genre in GetAvailableAudiobookGenres())
                    {
                        <option value="@genre">@genre</option>
                    }
                </select>
            </div>

            <div class="col-md-2">
                <button type="button"
                        class="btn btn-outline-primary w-100"
                        disabled="@(!GetFilteredAddableAudiobooks().Any())"
                        @onclick="AddAllFilteredAudiobooks">
                    Add All (@GetFilteredAddableAudiobooks().Count())
                </button>
            </div>
        }
    </div>

    @if (GetAddableAudiobooks().Count == 0)
    {
        <EmptyState Icon="headphones" Text="No matching audiobooks from this drive's library to add." />
    }
    else
    {
        <table class="table table-sm">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Author</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var asset in GetAddableAudiobooks())
                {
                    <tr>
                        <td>@asset.Title</td>
                        <td>@asset.Author</td>
                        <td>
                            <button type="button"
                                    class="btn btn-sm btn-outline-primary"
                                    @onclick="() => AddMember(asset.Id)">
                                Add
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <h5 class="mt-4">Add Music</h5>

    <div class="row g-2 mb-2">
        <div class="col-md-6">
            <input class="form-control"
                   placeholder="Filter by title..."
                   @bind="_musicFilterText"
                   @bind:event="oninput" />
        </div>

        @if (GetAvailableMusicGenres().Count > 0)
        {
            <div class="col-md-4">
                <select class="form-select" @bind="_musicGenre">
                    <option value="">All genres</option>
                    @foreach (var genre in GetAvailableMusicGenres())
                    {
                        <option value="@genre">@genre</option>
                    }
                </select>
            </div>

            <div class="col-md-2">
                <button type="button"
                        class="btn btn-outline-primary w-100"
                        disabled="@(!GetFilteredAddableMusic().Any())"
                        @onclick="AddAllFilteredMusic">
                    Add All (@GetFilteredAddableMusic().Count())
                </button>
            </div>
        }
    </div>

    @if (GetAddableMusic().Count == 0)
    {
        <EmptyState Icon="music-note" Text="No matching tracks from this drive's library to add." />
    }
    else
    {
        <table class="table table-sm">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Artist</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var asset in GetAddableMusic())
                {
                    <tr>
                        <td>@asset.Title</td>
                        <td>@asset.Author</td>
                        <td>
                            <button type="button"
                                    class="btn btn-sm btn-outline-primary"
                                    @onclick="() => AddMember(asset.Id)">
                                Add
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <h5 class="mt-4">Add Comics</h5>

    <div class="row g-2 mb-2">
        <div class="col-md-6">
            <input class="form-control"
                   placeholder="Filter by title..."
                   @bind="_comicFilterText"
                   @bind:event="oninput" />
        </div>

        @if (GetAvailableComicGenres().Count > 0)
        {
            <div class="col-md-4">
                <select class="form-select" @bind="_comicGenre">
                    <option value="">All genres</option>
                    @foreach (var genre in GetAvailableComicGenres())
                    {
                        <option value="@genre">@genre</option>
                    }
                </select>
            </div>

            <div class="col-md-2">
                <button type="button"
                        class="btn btn-outline-primary w-100"
                        disabled="@(!GetFilteredAddableComics().Any())"
                        @onclick="AddAllFilteredComics">
                    Add All (@GetFilteredAddableComics().Count())
                </button>
            </div>
        }
    </div>

    @if (GetAddableComics().Count == 0)
    {
        <EmptyState Icon="book" Text="No matching comics from this drive's library to add." />
    }
    else
    {
        <table class="table table-sm">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Series</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var asset in GetAddableComics())
                {
                    <tr>
                        <td>@asset.Title</td>
                        <td>@asset.Album</td>
                        <td>
                            <button type="button"
                                    class="btn btn-sm btn-outline-primary"
                                    @onclick="() => AddMember(asset.Id)">
                                Add
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code
{
    private List<Collection> _collections = [];
    private List<DriveProfile> _profiles = [];
    private Collection? _selectedCollection;
    private Dictionary<Guid, int> _orphanCounts = [];
    private List<MediaAsset> _orphanedMembers = [];
    private int _orphanedCount;

    private string _newCollectionName = string.Empty;
    private string _newCollectionDrive = string.Empty;
    private string _movieFilterText = string.Empty;
    private string _movieGenre = string.Empty;
    private string _tvFilterText = string.Empty;
    private string _tvGenre = string.Empty;
    private string _bookFilterText = string.Empty;
    private string _bookGenre = string.Empty;
    private string _audiobookFilterText = string.Empty;
    private string _audiobookGenre = string.Empty;
    private string _musicFilterText = string.Empty;
    private string _musicGenre = string.Empty;
    private string _comicFilterText = string.Empty;
    private string _comicGenre = string.Empty;
    private string _statusMessage = string.Empty;

    private bool _isConfirmingDelete;
    private bool _isConfirmingOrphanCleanup;

    protected override async Task OnInitializedAsync()
    {
        _profiles =
            await SettingsService.GetEnabledDriveProfilesAsync();

        _newCollectionDrive =
            _profiles.FirstOrDefault()?.Name ?? string.Empty;

        await LoadCollectionsAsync();
    }

    private async Task LoadCollectionsAsync()
    {
        _collections = CollectionService.GetAll().ToList();

        _orphanCounts = [];

        foreach (var collection in _collections)
        {
            _orphanCounts[collection.Id] =
                await CollectionBuilderService.GetOrphanedMemberCountAsync(collection.Id);
        }
    }

    private async Task CreateCollectionAsync()
    {
        if (string.IsNullOrWhiteSpace(_newCollectionName) ||
            string.IsNullOrWhiteSpace(_newCollectionDrive))
        {
            return;
        }

        CollectionService.Create(_newCollectionName, _newCollectionDrive);

        _newCollectionName = string.Empty;

        await LoadCollectionsAsync();
    }

    private async Task OpenCollectionAsync(Collection collection)
    {
        _selectedCollection = collection;
        _movieFilterText = string.Empty;
        _movieGenre = string.Empty;
        _tvFilterText = string.Empty;
        _tvGenre = string.Empty;
        _bookFilterText = string.Empty;
        _bookGenre = string.Empty;
        _audiobookFilterText = string.Empty;
        _audiobookGenre = string.Empty;
        _isConfirmingDelete = false;
        _isConfirmingOrphanCleanup = false;

        await RefreshOrphanedMembersAsync();
    }

    private async Task RefreshOrphanedMembersAsync()
    {
        if (_selectedCollection is null)
        {
            _orphanedMembers = [];
            _orphanedCount = 0;
            return;
        }

        _orphanedMembers =
            await CollectionBuilderService.GetOrphanedMembersAsync(_selectedCollection.Id);

        _orphanedCount =
            await CollectionBuilderService.GetOrphanedMemberCountAsync(_selectedCollection.Id);
    }

    private async Task RemoveOrphanedMembersAsync()
    {
        if (_selectedCollection is null)
        {
            return;
        }

        var removedCount =
            await CollectionBuilderService.RemoveOrphanedMembersAsync(_selectedCollection.Id);

        _statusMessage =
            $"Removed {removedCount} orphaned item(s) and their built copies.";

        _isConfirmingOrphanCleanup = false;

        _selectedCollection = CollectionService.Get(_selectedCollection.Id);

        await RefreshOrphanedMembersAsync();
    }

    private async Task CloseCollection()
    {
        _selectedCollection = null;

        await LoadCollectionsAsync();
    }

    private async Task DeleteCollectionAsync()
    {
        if (_selectedCollection is null)
        {
            return;
        }

        var collectionName = _selectedCollection.Name;

        await CollectionBuilderService.DeleteBuiltFilesAsync(_selectedCollection.Id);

        _statusMessage =
            $"Deleted \"{collectionName}\".";

        CollectionService.Delete(_selectedCollection.Id);

        _selectedCollection = null;
        _isConfirmingDelete = false;

        await LoadCollectionsAsync();
    }

    private void AddMember(Guid assetId)
    {
        if (_selectedCollection is null)
        {
            return;
        }

        CollectionService.AddAsset(_selectedCollection.Id, assetId);

        _selectedCollection = CollectionService.Get(_selectedCollection.Id);
    }

    private void RemoveMember(Guid assetId)
    {
        if (_selectedCollection is null)
        {
            return;
        }

        CollectionService.RemoveAsset(_selectedCollection.Id, assetId);

        _selectedCollection = CollectionService.Get(_selectedCollection.Id);
    }

    private List<MediaAsset> GetMembers()
    {
        if (_selectedCollection is null)
        {
            return [];
        }

        return _selectedCollection.AssetIds
            .Select(id => MediaCatalogService.GetAsset(id))
            .Where(asset => asset is not null)
            .Select(asset => asset!)
            .OrderBy(asset => asset.Title)
            .ThenBy(asset => asset.Season)
            .ThenBy(asset => asset.Episode)
            .ToList();
    }

    // --- Movies ---

    private List<MediaAsset> GetAddableMovies()
    {
        return GetFilteredAddableMovies()
            .Take(50)
            .ToList();
    }

    private List<string> GetAvailableMovieGenres()
    {
        return GetAddableMoviesForDrive()
            .SelectMany(asset => asset.Genres)
            .Where(genre => !string.IsNullOrWhiteSpace(genre))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(genre => genre)
            .ToList();
    }

    private IEnumerable<MediaAsset> GetFilteredAddableMovies()
    {
        return GetAddableMoviesForDrive()
            .Where(asset =>
                (string.IsNullOrWhiteSpace(_movieFilterText) ||
                 asset.Title.Contains(_movieFilterText, StringComparison.OrdinalIgnoreCase)) &&
                (string.IsNullOrWhiteSpace(_movieGenre) ||
                 asset.Genres.Contains(_movieGenre, StringComparer.OrdinalIgnoreCase)))
            .OrderBy(asset => asset.Title);
    }

    private IEnumerable<MediaAsset> GetAddableMoviesForDrive()
    {
        if (_selectedCollection is null)
        {
            return [];
        }

