@page "/collections"
@rendermode InteractiveServer
@inherits ScanAwareComponent

@using Simplifiarr.Core.Models
@using Simplifiarr.Core.Services

@inject ICollectionService CollectionService
@inject ICollectionBuilderService CollectionBuilderService
@inject IMediaCatalogService MediaCatalogService
@inject ISettingsService SettingsService

<PageTitle>Collections - Simplifiarr</PageTitle>

@if (_open is null)
{
    <PageHeader Title="Collections"
                Subtitle="Group anything in your libraries however you like - a Horror shelf, Christmas episodes, your recommendations - then send the group to Jellyfin as a collection. A collection is only a list: no files are copied, moved or linked." />

    @if (!_jellyfinConfigured)
    {
        <div class="alert alert-warning">
            Jellyfin isn't connected yet, so collections can be put together here but not sent.
            <a href="settings">Add Jellyfin's address and API key in Settings</a>, under Connections.
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_statusMessage))
    {
        <div class="alert alert-info">@_statusMessage</div>
    }

    <div class="toolbar">
        <div class="toolbar-summary">
            <strong>@_collections.Count</strong> collection(s)
        </div>

        <form class="toolbar-actions" @onsubmit="Create" @onsubmit:preventDefault="true">
            <label class="visually-hidden" for="new-collection-name">Name for a new collection</label>
            <input id="new-collection-name"
                   class="form-control form-control-sm"
                   style="width: 16rem"
                   placeholder="Name for a new collection"
                   @bind="_newName"
                   @bind:event="oninput" />

            <button type="submit"
                    class="btn btn-primary btn-sm"
                    disabled="@string.IsNullOrWhiteSpace(_newName)">
                Create
            </button>
        </form>
    </div>

    @if (_collections.Count == 0)
    {
        <EmptyState Icon="collection" Text="No collections yet. Type a name above and press Create." />
    }
    else
    {
        <div class="table-scroll">
            <table class="table">
                <thead>
                    <tr>
                        <th>Collection</th>
                        <th class="col-num">Items</th>
                        <th>In Jellyfin</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var collection in _collections)
                    {
                        var missing = _orphanCounts.GetValueOrDefault(collection.Id);

                        <tr @key="collection.Id">
                            <td>
                                <div class="file-name">@collection.Name</div>

                                @if (missing > 0)
                                {
                                    <div class="cell-note status-warn">@missing item(s) no longer exist on disk</div>
                                }
                            </td>

                            <td class="col-num">@collection.AssetIds.Count</td>

                            <td>
                                @if (collection.LastSyncedUtc is null)
                                {
                                    <span class="status-muted">Not sent yet</span>
                                }
                                else
                                {
                                    <span class="status-ok">Sent</span>
                                    <div class="cell-note">@HowLongAgo(collection.LastSyncedUtc)</div>
                                }
                            </td>

                            <td>
                                <div class="cell-actions">
                                    <button type="button"
                                            class="btn btn-secondary btn-sm"
                                            @onclick="() => OpenAsync(collection)">
                                        Open
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}
else
{
    <PageHeader Title="@_open.Name"
                Subtitle="@OpenSubtitle">
        <button type="button"
                class="btn btn-secondary"
                disabled="@_isSending"
                @onclick="Close">
            Back
        </button>

        <button type="button"
                class="btn btn-primary"
                disabled="@(_isSending || !_jellyfinConfigured || _open.AssetIds.Count == 0)"
                title="@(!_jellyfinConfigured ? "Connect Jellyfin in Settings first" : null)"
                @onclick="SendAsync">
            @(_isSending ? "Sending..." : "Send to Jellyfin")
        </button>
    </PageHeader>

    @if (_syncResult is not null)
    {
        @if (!_syncResult.Succeeded)
        {
            <div class="alert alert-danger">
                <strong>Not sent.</strong> @_syncResult.Error
            </div>
        }
        else
        {
            <div class="alert alert-info">
                <strong>@(_syncResult.CreatedInJellyfin ? "Created in Jellyfin." : "Jellyfin is up to date.")</strong>
                @SyncSummary(_syncResult)

                @if (_syncResult.NotInJellyfin.Count > 0)
                {
                    <details class="mt-2">
                        <summary>
                            @_syncResult.NotInJellyfin.Count item(s) aren't in any Jellyfin library, so they were left out
                        </summary>

                        <div class="mt-2">
                            Either their folder isn't part of a Jellyfin library, or Jellyfin hasn't scanned it since they arrived.
                        </div>

                        <ul class="mt-2 mb-0">
                            @foreach (var title in _syncResult.NotInJellyfin.Take(50))
                            {
                                <li>@title</li>
                            }
                        </ul>
                    </details>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(_syncResult.Warning))
            {
                <div class="alert alert-warning">
                    <strong>Check Jellyfin.</strong> @_syncResult.Warning
                </div>
            }
        }
    }

    @if (!string.IsNullOrWhiteSpace(_statusMessage))
    {
        <div class="alert alert-info">@_statusMessage</div>
    }

    @if (IsScanning)
    {
        <div class="alert alert-info">
            A scan is running. What you can add will update when it finishes.
        </div>
    }

    @if (_orphanCount > 0)
    {
        <div class="panel mb-3">
            <div class="action-row action-row-warn">
                <div>
                    <div class="action-row-title">@_orphanCount item(s) in this collection no longer exist on disk</div>
                    <div class="action-row-detail">They were deleted, moved or renamed since they were added. Nothing is sent to Jellyfin for them.</div>
                </div>

                <button type="button"
                        class="btn btn-secondary"
                        disabled="@_isSending"
                        @onclick="RemoveOrphansAsync">
                    Take them out
                </button>
            </div>
        </div>
    }

    <div class="app-tabs" role="tablist" aria-label="Collection view">
        <button type="button"
                role="tab"
                aria-selected="@(!_adding)"
                class="app-tab @(!_adding ? "active" : null)"
                @onclick="() => ShowAdding(false)">
            In this collection <span class="app-tab-count">@_members.Count</span>
        </button>

        <button type="button"
                role="tab"
                aria-selected="@_adding"
                class="app-tab @(_adding ? "active" : null)"
                @onclick="() => ShowAdding(true)">
            Add items
        </button>
    </div>

    @if (!_adding)
    {
        @if (_members.Count == 0)
        {
            <EmptyState Icon="collection" Text="Nothing in this collection yet. Open Add items to put something in." />
        }
        else
        {
            <div class="toolbar">
                <div class="toolbar-summary">
                    <strong>@FilteredMembers.Count</strong> item(s)
                </div>

                <div class="toolbar-actions">
                    <label class="visually-hidden" for="member-filter">Filter by title</label>
                    <input id="member-filter"
                           type="search"
                           class="form-control form-control-sm"
                           style="width: 14rem"
                           placeholder="Filter by title"
                           @bind="_memberFilter"
                           @bind:event="oninput"
                           @bind:after="ResetPaging" />
                </div>
            </div>

            <div class="table-scroll">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Type</th>
                            <th>Where</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var asset in FilteredMembers.Take(_shown))
                        {
                            <tr @key="asset.Id">
                                <td>
                                    <div class="file-name">@asset.Title</div>

                                    @if (Detail(asset).Length > 0)
                                    {
                                        <div class="cell-note">@Detail(asset)</div>
                                    }
                                </td>

                                <td>@TypeLabel(asset.MediaType)</td>

                                <td class="cell-note">@Path.GetDirectoryName(asset.CanonicalPath)</td>

                                <td>
                                    <button type="button"
                                            class="btn btn-secondary btn-sm"
                                            disabled="@_isSending"
                                            @onclick="() => Remove(asset)">
                                        Take out
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (FilteredMembers.Count > _shown)
            {
                <button type="button"
                        class="btn btn-secondary mt-3"
                        @onclick="() => _shown += PageSize">
                    Show @Math.Min(PageSize, FilteredMembers.Count - _shown) more (@(FilteredMembers.Count - _shown) left)
                </button>
            }
        }
    }
    else
    {
        <div class="app-tabs" role="tablist" aria-label="Media type">
            @foreach (var type in AddTypes)
            {
                <button type="button"
                        role="tab"
                        aria-selected="@(_addType == type)"
                        class="app-tab @(_addType == type ? "active" : null)"
                        @onclick="() => ShowAddType(type)">
                    @TypeLabel(type) <span class="app-tab-count">@_addable.Count(asset => asset.MediaType == type).ToString("N0")</span>
                </button>
            }
        </div>

        @if (_addable.Count == 0 && _members.Count == 0)
        {
            <EmptyState Icon="search" Text="Nothing has been scanned yet. Press Scan at the top of the page, then come back." />
        }
        else
        {
            <div class="toolbar">
                <div class="toolbar-summary">
                    <strong>@Matching.Count.ToString("N0")</strong> @ItemNoun(_addType) not in this collection
                    @if (HasFilter)
                    {
                        <text> match</text>
                    }
                </div>

                <div class="toolbar-actions">
                    <label class="visually-hidden" for="add-filter">Filter by title</label>
                    <input id="add-filter"
                           type="search"
                           class="form-control form-control-sm"
                           style="width: 14rem"
                           placeholder="Filter by title"
                           @bind="_addFilter"
                           @bind:event="oninput"
                           @bind:after="ResetPaging" />

                    @if (Genres.Count > 0)
                    {
                        <label class="visually-hidden" for="add-genre">Genre</label>
                        <select id="add-genre"
                                class="form-select form-select-sm"
                                style="width: 11rem"
                                @bind="_addGenre"
                                @bind:after="ResetPaging">
                            <option value="">Any genre</option>
                            @foreach (var genre in Genres)
                            {
                                <option value="@genre">@genre</option>
                            }
                        </select>
                    }

                    <button type="button"
                            class="btn btn-secondary btn-sm"
                            disabled="@(_isSending || Matching.Count == 0 || (!HasFilter && Matching.Count > AddAllLimit))"
                            title="@(!HasFilter && Matching.Count > AddAllLimit ? "Filter the list first" : null)"
                            @onclick="() => Add(Matching)">
                        Add all @Matching.Count.ToString("N0")
                    </button>
                </div>
            </div>

            @if (Matching.Count == 0)
            {
                <EmptyState Icon="@(HasFilter ? "funnel" : "check-circle")"
                            Text="@(HasFilter ? "Nothing matches that filter." : $"No {ItemNoun(_addType)} to add: either none have been scanned, or they are all in this collection already.")" />
            }
            else if (_addType == MediaType.TvEpisode)
            {
                @foreach (var show in ShowGroup.GroupByShow(Matching).Take(_shown))
                {
                    var showOpen = _openShows.Contains(show.Title);

                    <div class="group-card" @key="show.Title">
                        <div class="group-card-header" style="align-items: center">
                            <div class="group-card-title">
                                @show.Title
                                <span class="cell-note ms-1">· @show.EpisodeCount episode(s)</span>
                            </div>

                            <div class="cell-actions">
                                <button type="button"
                                        class="btn btn-secondary btn-sm"
                                        aria-expanded="@showOpen"
                                        @onclick="() => ToggleShow(show.Title)">
                                    @(showOpen ? "Hide seasons" : "Seasons")
                                </button>

                                <button type="button"
                                        class="btn btn-primary btn-sm"
                                        disabled="@_isSending"
                                        @onclick="() => Add(show.Seasons.SelectMany(season => season.Episodes).ToList())">
                                    Add whole show
                                </button>
                            </div>
                        </div>

                        @if (showOpen)
                        {
                            @foreach (var season in show.Seasons)
                            {
                                <div class="action-row" style="border-top: 1px solid var(--app-border)">
                                    <div>
                                        <div class="action-row-title">
                                            @(season.Season.HasValue ? $"Season {season.Season:00}" : "Season unknown")
                                        </div>
                                        <div class="action-row-detail">
                                            @string.Join(", ", season.Episodes.Select(EpisodeLabel))
                                        </div>
                                    </div>

                                    <button type="button"
                                            class="btn btn-secondary btn-sm"
                                            disabled="@_isSending"
                                            @onclick="() => Add(season.Episodes)">
                                        Add season (@season.Episodes.Count)
                                    </button>
                                </div>

                                @if (season.Episodes.Count <= EpisodeListLimit)
                                {
                                    <div class="table-scroll">
                                        <table class="table table-sm">
                                            <tbody>
                                                @foreach (var episode in season.Episodes)
                                                {
                                                    <tr @key="episode.Id">
                                                        <td>
                                                            <div class="file-name">@EpisodeLabel(episode)</div>

                                                            @if (!string.IsNullOrWhiteSpace(episode.EpisodeTitle))
                                                            {
                                                                <div class="cell-note">@episode.EpisodeTitle</div>
                                                            }
                                                        </td>

                                                        <td class="col-num">
                                                            <button type="button"
                                                                    class="btn btn-secondary btn-sm"
                                                                    disabled="@_isSending"
                                                                    @onclick="() => Add([episode])">
                                                                Add
                                                            </button>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            }
                        }
                    </div>
                }

                @if (ShowGroup.GroupByShow(Matching).Count > _shown)
                {
                    <button type="button"
                            class="btn btn-secondary mt-3"
                            @onclick="() => _shown += PageSize">
                        Show more shows
                    </button>
                }
            }
            else
            {
                <div class="table-scroll">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Title</th>
                                <th>Where</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var asset in Matching.Take(_shown))
                            {
                                <tr @key="asset.Id">
                                    <td>
                                        <div class="file-name">@asset.Title</div>

                                        @if (Detail(asset).Length > 0)
                                        {
                                            <div class="cell-note">@Detail(asset)</div>
                                        }
                                    </td>

                                    <td class="cell-note">@Path.GetDirectoryName(asset.CanonicalPath)</td>

                                    <td>
                                        <button type="button"
                                                class="btn btn-secondary btn-sm"
                                                disabled="@_isSending"
                                                @onclick="() => Add([asset])">
                                            Add
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (Matching.Count > _shown)
                {
                    <button type="button"
                            class="btn btn-secondary mt-3"
                            @onclick="() => _shown += PageSize">
                        Show @Math.Min(PageSize, Matching.Count - _shown) more (@((Matching.Count - _shown).ToString("N0")) left)
                    </button>
                }
            }
        }
    }

    <div class="cell-actions mt-4" style="align-items: center; flex-wrap: wrap">
        @if (_confirmDelete)
        {
            <button type="button"
                    class="btn btn-danger btn-sm"
                    @onclick="Delete">
                Delete this collection
            </button>

            <button type="button"
                    class="btn btn-secondary btn-sm"
                    @onclick="() => _confirmDelete = false">
                Cancel
            </button>

            <span class="cell-note" style="white-space: normal">
                Removes the list from Simplifiarr only. No files are touched, and a collection already
                sent to Jellyfin stays there until you delete it in Jellyfin.
            </span>
        }
        else
        {
            <button type="button"
                    class="btn btn-outline-danger btn-sm"
                    disabled="@_isSending"
                    @onclick="() => _confirmDelete = true">
                Delete collection
            </button>
        }
    </div>
}

@code
{
    private const int PageSize = 50;

    // "Add all" on an unfiltered list would put a whole library in a
    // collection with one click; make that a deliberate, filtered act.
    private const int AddAllLimit = 200;

    // A long season's episodes are added with "Add season"; listing every
    // one only makes the page slow.
    private const int EpisodeListLimit = 60;

    private static readonly MediaType[] AddTypes =
    [
        MediaType.Movie, MediaType.TvEpisode, MediaType.Book,
        MediaType.Audiobook, MediaType.Music, MediaType.Comic
    ];

    private List<Collection> _collections = [];

    private Dictionary<Guid, int> _orphanCounts = [];

    private bool _jellyfinConfigured;

    private string _newName = string.Empty;

    private string _statusMessage = string.Empty;

    // The collection being looked at, and what is and isn't in it.
    private Collection? _open;

    private List<MediaAsset> _members = [];

    private List<MediaAsset> _addable = [];

    private int _orphanCount;

    private bool _adding;

    private MediaType _addType = MediaType.Movie;

    private string _memberFilter = string.Empty;
    private string _addFilter = string.Empty;
    private string _addGenre = string.Empty;

    private int _shown = PageSize;

    private readonly HashSet<string> _openShows =
        new(StringComparer.OrdinalIgnoreCase);

    private bool _isSending;
    private bool _confirmDelete;

    private CollectionSyncResult? _syncResult;

    private bool HasFilter =>
        !string.IsNullOrWhiteSpace(_addFilter) ||
        !string.IsNullOrWhiteSpace(_addGenre);

    private string OpenSubtitle
    {
        get
        {
            if (_open is null)
            {
                return string.Empty;
            }

            var items = $"{_open.AssetIds.Count:N0} item(s)";

            return _open.LastSyncedUtc is null
                ? $"{items} · not sent to Jellyfin yet"
                : $"{items} · last sent to Jellyfin {HowLongAgo(_open.LastSyncedUtc)}";
        }
    }

    private List<MediaAsset> FilteredMembers =>
        _members
            .Where(asset =>
                string.IsNullOrWhiteSpace(_memberFilter) ||
                asset.Title.Contains(_memberFilter.Trim(), StringComparison.OrdinalIgnoreCase))
            .ToList();

    private List<MediaAsset> Matching =>
        _addable
            .Where(asset => asset.MediaType == _addType)
            .Where(asset =>
                string.IsNullOrWhiteSpace(_addFilter) ||
                asset.Title.Contains(_addFilter.Trim(), StringComparison.OrdinalIgnoreCase) ||
                (asset.Author?.Contains(_addFilter.Trim(), StringComparison.OrdinalIgnoreCase) ?? false) ||
                (asset.Album?.Contains(_addFilter.Trim(), StringComparison.OrdinalIgnoreCase) ?? false))
            .Where(asset =>
                string.IsNullOrWhiteSpace(_addGenre) ||
                asset.Genres.Contains(_addGenre, StringComparer.OrdinalIgnoreCase))
            .ToList();

    // Genres come from Radarr and Sonarr; without them there is nothing
    // to choose from and the box isn't shown.
    private List<string> Genres =>
        _addable
            .Where(asset => asset.MediaType == _addType)
            .SelectMany(asset => asset.Genres)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(genre => genre)
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        var settings =
            await SettingsService.GetSettingsAsync();

        _jellyfinConfigured =
            !string.IsNullOrWhiteSpace(settings.JellyfinUrl) &&
            !string.IsNullOrWhiteSpace(settings.JellyfinApiKey);

        await LoadListAsync();
    }

    protected override async Task OnScanFinishedAsync()
    {
        // A scan can change which files exist and what there is to add.
        await LoadListAsync();

        if (_open is not null)
        {
            _open = CollectionService.Get(_open.Id);

            await LoadOpenAsync();
        }
    }

    private async Task LoadListAsync()
    {
        _collections = CollectionService.GetAll().ToList();

        _orphanCounts = [];

        foreach (var collection in _collections)
        {
            // Re-attach anything renamed or replaced before counting what
            // is really gone.
            await CollectionBuilderService.RefreshMembersAsync(collection.Id);

            _orphanCounts[collection.Id] =
                await CollectionBuilderService.GetOrphanedMemberCountAsync(collection.Id);
        }
    }

    private async Task LoadOpenAsync()
    {
        if (_open is null)
        {
            return;
        }

        var memberIds = _open.AssetIds.ToHashSet();

        var catalog = MediaCatalogService.GetAssets();

        _members =
            catalog
                .Where(asset => memberIds.Contains(asset.Id))
                .OrderBy(asset => asset.Title)
                .ThenBy(asset => asset.Season)
                .ThenBy(asset => asset.Episode)
                .ToList();

        _addable =
            catalog
                .Where(asset =>
                    !memberIds.Contains(asset.Id) &&
                    AddTypes.Contains(asset.MediaType))
                .OrderBy(asset => asset.Title)
                .ThenBy(asset => asset.Year)
                .ThenBy(asset => asset.Season)
                .ThenBy(asset => asset.Episode)
                .ToList();

        _orphanCount =
            await CollectionBuilderService.GetOrphanedMemberCountAsync(_open.Id);
    }

    private async Task Create()
    {
        if (string.IsNullOrWhiteSpace(_newName))
        {
            return;
        }

        try
        {
            var created = CollectionService.Create(_newName);

            _newName = string.Empty;
            _statusMessage = string.Empty;

            await LoadListAsync();

            // Straight into it, on the Add tab - an empty collection has
            // nothing else to do.
            await OpenAsync(created);

            _adding = true;
        }
        catch (InvalidOperationException ex)
        {
            _statusMessage = ex.Message;
        }
    }

    private async Task OpenAsync(Collection collection)
    {
        _open = CollectionService.Get(collection.Id);

        _adding = false;
        _syncResult = null;
        _confirmDelete = false;
        _statusMessage = string.Empty;
        _memberFilter = string.Empty;
        _addFilter = string.Empty;
        _addGenre = string.Empty;

        _openShows.Clear();

        ResetPaging();

        await LoadOpenAsync();
    }

    private async Task Close()
    {
        _open = null;
        _syncResult = null;
        _statusMessage = string.Empty;

        await LoadListAsync();
    }

    private void ShowAdding(bool adding)
    {
        _adding = adding;

        ResetPaging();
    }

    private void ShowAddType(MediaType type)
    {
        _addType = type;
        _addGenre = string.Empty;

        _openShows.Clear();

        ResetPaging();
    }

    private void ToggleShow(string title)
    {
        if (!_openShows.Remove(title))
        {
            _openShows.Add(title);
        }
    }

    private void ResetPaging() =>
        _shown = PageSize;

    private void Add(List<MediaAsset> assets)
    {
        if (_open is null || _isSending || assets.Count == 0)
        {
            return;
        }

        CollectionService.AddAssets(
            _open.Id,
            assets.Select(asset => asset.Id).ToList());

        var added = assets.Select(asset => asset.Id).ToHashSet();

        _members =
            _members
                .Concat(assets)
                .OrderBy(asset => asset.Title)
                .ThenBy(asset => asset.Season)
                .ThenBy(asset => asset.Episode)
                .ToList();

        _addable.RemoveAll(asset => added.Contains(asset.Id));

        _open = CollectionService.Get(_open.Id);

        _statusMessage =
            assets.Count == 1
                ? $"Added \"{assets[0].Title}\". {NotSentYetHint}"
                : $"Added {assets.Count:N0} items. {NotSentYetHint}";
    }

    private void Remove(MediaAsset asset)
    {
        if (_open is null || _isSending)
        {
            return;
        }

        CollectionService.RemoveAsset(_open.Id, asset.Id);

        _members.Remove(asset);
        _addable.Add(asset);

        _addable =
            _addable
                .OrderBy(other => other.Title)
                .ThenBy(other => other.Year)
                .ThenBy(other => other.Season)
                .ThenBy(other => other.Episode)
                .ToList();

        _open = CollectionService.Get(_open.Id);

        _statusMessage =
            $"Took out \"{asset.Title}\". {NotSentYetHint}";
    }

    private string NotSentYetHint =>
        _jellyfinConfigured
            ? "Press Send to Jellyfin when you're done."
            : string.Empty;

    private async Task RemoveOrphansAsync()
    {
        if (_open is null)
        {
            return;
        }

        var removed =
            await CollectionBuilderService.RemoveOrphanedMembersAsync(_open.Id);

        _open = CollectionService.Get(_open.Id);

        await LoadOpenAsync();

        _statusMessage =
            $"Took out {removed} item(s) that no longer exist.";
    }

    private async Task SendAsync()
    {
        if (_open is null || _isSending)
        {
            return;
        }

        _isSending = true;
        _syncResult = null;
        _statusMessage = string.Empty;

        try
        {
            _syncResult =
                await CollectionBuilderService.SyncToJellyfinAsync(_open.Id);

            _open = CollectionService.Get(_open.Id);
        }
        finally
        {
            _isSending = false;
        }
    }

    private async Task Delete()
    {
        if (_open is null)
        {
            return;
        }

        var name = _open.Name;

        CollectionService.Delete(_open.Id);

        _confirmDelete = false;

        await Close();

        _statusMessage =
            $"Deleted \"{name}\" from Simplifiarr.";
    }

    private static string SyncSummary(CollectionSyncResult result)
    {
        var parts = new List<string>();

        if (result.Added > 0)
        {
            parts.Add($"{result.Added:N0} added");
        }

        if (result.Removed > 0)
        {
            parts.Add($"{result.Removed:N0} taken out");
        }

        if (result.AlreadyThere > 0)
        {
            parts.Add($"{result.AlreadyThere:N0} already there");
        }

        if (result.MissingFiles > 0)
        {
            parts.Add($"{result.MissingFiles:N0} skipped because the file is gone");
        }

        return parts.Count == 0
            ? "Nothing needed changing."
            : string.Join(", ", parts) + ".";
    }

    private static string EpisodeLabel(MediaAsset episode) =>
        episode.Episode.HasValue
            ? $"E{episode.Episode:00}"
            : "E?";

    // The quieter line under a title: what tells two same-named things apart.
    private static string Detail(MediaAsset asset) =>
        asset.MediaType switch
        {
            MediaType.TvEpisode =>
                $"S{asset.Season ?? 0:00}E{asset.Episode ?? 0:00}" +
                (string.IsNullOrWhiteSpace(asset.EpisodeTitle) ? string.Empty : $" · {asset.EpisodeTitle}"),

            MediaType.Movie =>
                asset.Year?.ToString() ?? string.Empty,

            MediaType.Music =>
                string.Join(
                    " · ",
                    new[] { asset.Author, asset.Album }
                        .Where(part => !string.IsNullOrWhiteSpace(part))),

            MediaType.Comic =>
                string.Join(
                    " · ",
                    new[] { asset.Album, asset.TrackNumber.HasValue ? $"#{asset.TrackNumber:0.#}" : null }
                        .Where(part => !string.IsNullOrWhiteSpace(part))),

            _ =>
                asset.Author ?? string.Empty
        };

    private static string TypeLabel(MediaType type) =>
        type switch
        {
            MediaType.Movie => "Movies",
            MediaType.TvEpisode => "TV",
            MediaType.Book => "Books",
            MediaType.Audiobook => "Audiobooks",
            MediaType.Music => "Music",
            MediaType.Comic => "Comics",
            _ => type.ToString()
        };

    // For the middle of a sentence: "2,501 TV episodes not in this collection".
    private static string ItemNoun(MediaType type) =>
        type switch
        {
            MediaType.Movie => "movies",
            MediaType.TvEpisode => "TV episodes",
            MediaType.Book => "books",
            MediaType.Audiobook => "audiobooks",
            MediaType.Music => "tracks",
            MediaType.Comic => "comics",
            _ => "items"
        };

    private static string HowLongAgo(DateTime? utc)
    {
        if (utc is null)
        {
            return "never";
        }

        var age = DateTime.UtcNow - utc.Value;

        return age.TotalMinutes < 1 ? "just now"
            : age.TotalMinutes < 2 ? "a minute ago"
            : age.TotalHours < 1 ? $"{(int)age.TotalMinutes} minutes ago"
            : age.TotalHours < 2 ? "an hour ago"
            : age.TotalDays < 1 ? $"{(int)age.TotalHours} hours ago"
            : age.TotalDays < 2 ? "yesterday"
            : $"{(int)age.TotalDays} days ago";
    }
}
