@page "/storage"
@rendermode InteractiveServer
@implements IDisposable

@using Simplifiarr.Core.Models
@using Simplifiarr.Core.Services
@using Simplifiarr.Core.Utilities

@inject IStorageService StorageService
@inject IStorageMoveService Mover
@inject ISettingsService SettingsService
@inject IScanCoordinator Scans
@inject IWatchHistoryService WatchHistory
@inject ISizeReductionCandidateService SizeReduction
@inject IIgnoredItemsService Ignored

<PageTitle>Storage - Simplifiarr</PageTitle>

<PageHeader Title="Storage"
            Subtitle="How full each drive is, and what to move so none of them fills up." />

@if (_drives is null)
{
    <EmptyState Icon="hourglass-split" Text="Loading..." />
}
else if (_drives.Count == 0)
{
    <div class="alert alert-warning">
        No drives with libraries are set up yet. <a href="settings">Add one in Settings</a>.
    </div>
}
else
{
    @* ------------------------------------------------------------ Drives *@

    <div class="stat-grid">
        @foreach (var drive in _drives ?? [])
        {
            <button type="button"
                    class="stat-card text-start"
                    style="cursor: pointer; @(_tab == BrowseTab && _selectedRoot == drive.Root ? "border-color: var(--app-accent)" : null)"
                    title="See what takes the space on @drive.Root"
                    @onclick="() => Browse(drive.Root)">
                <div class="stat-label">@drive.Root @string.Join(", ", drive.ProfileNames)</div>

                @if (!drive.IsAvailable)
                {
                    <div class="stat-value status-muted">-</div>
                    <div class="stat-note">Drive not found</div>
                }
                else
                {
                    <div class="d-flex align-items-center justify-content-between gap-2 flex-wrap">
                        <div class="stat-value @(drive.IsOverLimit ? "status-warn" : null)">@($"{drive.UsedPercent:0}%")</div>
                        @if (drive.IsOverLimit)
                        {
                            <span class="pill pill-warn">Move @SizeFormatter.FormatBytes(drive.ToFreeBytes)</span>
                        }
                        else
                        {
                            <span class="pill pill-ok">OK</span>
                        }
                    </div>

                    <div class="space-bar" title="@LimitText(drive)">
                        <div class="space-bar-fill @(drive.IsOverLimit ? "over" : null)"
                             style="width: @Css(Math.Min(100, drive.UsedPercent))%"></div>
                        <div class="space-bar-limit"
                             style="left: @Css(Math.Min(100, drive.LimitLinePercent))%"></div>
                    </div>

                    <div class="stat-note">@SizeFormatter.FormatBytes(drive.FreeBytes) free of @SizeFormatter.FormatBytes(drive.TotalBytes)</div>
                    <div class="stat-note">@LimitText(drive)</div>
                }
            </button>
        }
    </div>

    @* ------------------------------------------------------------ Moving *@

    @if (Mover.Current is not null || Mover.Queue.Count > 0)
    {
        <div class="panel storage-box mb-3">
            <div class="toolbar mb-1">
                <div class="toolbar-summary">
                    @if (Mover.Current is { } current)
                    {
                        <strong>Moving @current.Request.Title.Name</strong>
                        <text> to @StoragePlanner.RootOf(current.Request.ToLibraryPath)</text>
                    }
                    else
                    {
                        <strong>Waiting to move</strong>
                    }
                    @if (Mover.Queue.Count > 0)
                    {
                        <text> · @Mover.Queue.Count more after this (@SizeFormatter.FormatBytes(Mover.Queue.Sum(request => request.Title.SizeBytes)))</text>
                    }
                    @if (Mover.IsPaused)
                    {
                        <text> · <span class="status-warn">Paused</span></text>
                    }
                </div>

                <div class="toolbar-actions">
                    @if (Mover.IsPaused)
                    {
                        <button type="button" class="btn btn-primary btn-sm" @onclick="Mover.Resume">Resume</button>
                    }
                    else if (Mover.Queue.Count > 0)
                    {
                        <button type="button" class="btn btn-secondary btn-sm" @onclick="Mover.Pause">Pause after this one</button>
                    }

                    @if (Mover.Queue.Count > 0)
                    {
                        <button type="button" class="btn btn-secondary btn-sm" @onclick="Mover.ClearQueue">Cancel the rest</button>
                    }
                </div>
            </div>

            @if (Mover.Current is { } running)
            {
                <div class="space-bar">
                    <div class="space-bar-fill"
                         style="width: @(running.BytesTotal <= 0 ? 0 : running.BytesDone * 100 / running.BytesTotal)%"></div>
                </div>
                <div class="cell-note">
                    @running.Step · @SizeFormatter.FormatBytes(running.BytesDone) of @SizeFormatter.FormatBytes(running.BytesTotal).
                    It carries on if you leave the page.
                </div>
            }

            @if (Mover.Queue.Count > 0)
            {
                <details class="mt-1">
                    <summary>Waiting (@Mover.Queue.Count)</summary>
                    <ul class="mb-0">
                        @foreach (var waiting in Mover.Queue)
                        {
                            <li>
                                @waiting.Title.Name
                                <span class="cell-note">to @StoragePlanner.RootOf(waiting.ToLibraryPath) · @SizeFormatter.FormatBytes(waiting.Title.SizeBytes)</span>
                                <button type="button" class="btn btn-link btn-sm py-0" @onclick="() => Mover.Remove(waiting)">Take off</button>
                            </li>
                        }
                    </ul>
                </details>
            }
        </div>
    }

    @if (Mover.Results.Count > 0)
    {
        var moved = Mover.Results.Count(result => result.Succeeded);
        var failed = Mover.Results.Count - moved;

        <details class="panel storage-box mb-3">
            <summary>
                <strong>Moves so far:</strong> @($"{moved} moved" + (failed > 0 ? $", {failed} left where they were" : string.Empty))
            </summary>
            <ul class="mb-1 mt-2">
                @foreach (var result in Mover.Results.Take(30))
                {
                    <li class="@(result.Succeeded ? null : "status-warn")">@result.Message</li>
                }
            </ul>
            @if (moved > 0)
            {
                <div class="cell-note">@RecycleBinNote</div>
            }
        </details>
    }

    @* -------------------------------------------------------------- Tabs *@

    <div class="app-tabs" role="tablist" aria-label="Storage">
        <button type="button" role="tab" aria-selected="@(_tab == PlanTab)"
                class="app-tab @(_tab == PlanTab ? "active" : null)"
                @onclick="() => _tab = PlanTab">
            Plan <span class="app-tab-count">@_suggestions.Count</span>
        </button>
        <button type="button" role="tab" aria-selected="@(_tab == BrowseTab)"
                class="app-tab @(_tab == BrowseTab ? "active" : null)"
                @onclick="() => _tab = BrowseTab">
            Browse a drive
        </button>
        <button type="button" role="tab" aria-selected="@(_tab == ReviewTab)"
                class="app-tab @(_tab == ReviewTab ? "active" : null)"
                @onclick="() => _tab = ReviewTab">
            Worth a look <span class="app-tab-count">@_reviews.Count</span>
        </button>
    </div>

    @if (_tab == PlanTab)
    {
        @* ------------------------------------------------------ Plan *@

        var full = _drives!.Where(drive => drive.IsAvailable && drive.IsOverLimit).ToList();

        @if (full.Count == 0)
        {
            <EmptyState Icon="check-circle" Text="Every drive is fine. Nothing needs to move." />
        }
        else
        {
            @foreach (var drive in full)
            {
                var moves = _suggestions.Where(suggestion => suggestion.FromRoot == drive.Root).ToList();

                <div class="panel storage-box mb-3">
                    <p class="mb-2">@PlanSentence(drive, moves)</p>

                    @if (moves.Count == 0)
                    {
                        <div class="cell-note">@NoMovesReason()</div>
                    }
                </div>
            }

            @if (_suggestions.Count > 0)
            {
                var waiting = _suggestions.Count(suggestion => !IsQueued(suggestion.Title));

                <div class="toolbar">
                    <div class="toolbar-summary">
                        <strong>@_suggestions.Count</strong> title(s), @SizeFormatter.FormatBytes(_suggestions.Sum(suggestion => suggestion.Title.SizeBytes))
                    </div>

                    <div class="toolbar-actions">
                        <button type="button"
                                class="btn btn-secondary btn-sm"
                                @onclick="() => _showPlanList = !_showPlanList">
                            @(_showPlanList ? "Hide titles" : "Review titles")
                        </button>

                        <button type="button"
                                class="btn btn-primary btn-sm"
                                disabled="@(waiting == 0)"
                                @onclick="MoveAllSuggestions">
                            Move all (@waiting)
                        </button>
                    </div>
                </div>

                @if (_showPlanList)
                {
                    <div class="toolbar">
                        <div class="toolbar-summary cell-note">
                            Least watched first, then smallest.
                            @if (_pickedSuggestions.Count > 0)
                            {
                                <text> @_pickedSuggestions.Count selected.</text>
                            }
                        </div>
                        <div class="toolbar-actions">
                            <button type="button"
                                    class="btn btn-secondary btn-sm"
                                    disabled="@(_pickedSuggestions.Count == 0)"
                                    @onclick="MoveSuggestions">
                                Move only selected (@_pickedSuggestions.Count)
                            </button>
                        </div>
                    </div>

                    <div class="table-scroll mb-2">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th class="col-check">Select</th>
                                    <th>Title</th>
                                    <th>To</th>
                                    <th class="col-num">Size</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var suggestion in _suggestions)
                                {
                                    var queued = IsQueued(suggestion.Title);

                                    <tr @key="suggestion.Title.FolderPath" class="@(queued ? "row-disabled" : null)">
                                        <SelectableCheckboxCell Checked="_pickedSuggestions.Contains(suggestion.Title.FolderPath)"
                                                                Disabled="queued"
                                                                OnChanged="selected => Toggle(_pickedSuggestions, suggestion.Title, selected)" />
                                        <td>
                                            <div class="file-name">@suggestion.Title.Name</div>
                                            <div class="cell-note">
                                                @suggestion.Title.Kind · watched: @WatchText(suggestion.Title)
                                                @if (queued)
                                                {
                                                    <text> · queued</text>
                                                }
                                            </div>
                                        </td>
                                        <td>@suggestion.ToRoot</td>
                                        <td class="col-num">@SizeFormatter.FormatBytes(suggestion.Title.SizeBytes)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }

            @if (_heldBack.Count > 0)
            {
                <details class="panel storage-box mb-3">
                    <summary>
                        <strong>@_heldBack.Count left alone:</strong>
                        @string.Join(", ", _heldBack.GroupBy(entry => entry.Reason).Select(group => $"{group.Count()} {ShortReason(group.Key)}"))
                    </summary>
                    <div class="cell-note mt-2">
                        Seeding titles would free nothing. Titles added or changed in the last @_recentDays day(s)
                        are still getting episodes or being watched. Titles over @_largestGb GB are for you to move
                        on Browse a drive, or to shrink with <a href="size-reduction">Size Reduction</a>.
                    </div>
                    <ul class="mb-0 mt-1">
                        @foreach (var entry in _heldBack.Take(40))
                        {
                            <li>
                                @entry.Title.Name
                                <span class="cell-note">@entry.Reason · @SizeFormatter.FormatBytes(entry.Title.SizeBytes)</span>
                            </li>
                        }
                    </ul>
                </details>
            }
        }

        <details class="mt-3">
            <summary class="cell-note">How this works</summary>
            <ul class="cell-note mt-2">
                <li>
                    With a <strong>downloads drive</strong> set in Settings, that is the drive kept clear: everything
                    new lands there, and finished titles move off it as it fills. Without one, <strong>protected</strong>
                    drives are kept clear. Either way, once it passes its limit titles move off it until it's back
                    down to its target, and nothing is moved onto it.
                </li>
                <li>
                    A title stays while a torrent seeds it, and a show Sonarr still gets episodes of stays on the
                    downloads drive, so new episodes are linked rather than copied. A leftover download name of a
                    title's files (its torrent removed) is deleted with the move, so the space really comes back.
                </li>
                <li>
                    Everything else is an <strong>overflow</strong> drive. Each title goes to the one with the most
                    free space, and never past the space it keeps free.
                </li>
                <li>
                    Titles someone is watching, or that another program has open, are skipped when their turn comes.
                </li>
                <li>
                    Each file is copied, read back and checked against the original. Only then is Radarr or Sonarr
                    given the new folder and the old one deleted. If anything fails, the title stays where it was.
                </li>
                <li>Set each drive's role in <a href="settings">Settings</a>, under Drives.</li>
            </ul>
        </details>
    }
    else if (_tab == ReviewTab)
    {
        @* ----------------------------------------------- Worth a look *@

        <p class="cell-note">
            Titles you might delete instead of moving: watched by whoever asked for them, or unwatched for over
            @_unwatchedMonths months.
        </p>

        @if (WatchHistory.RefreshedUtc is null)
        {
            <div class="alert alert-info">
                Simplifiarr reads who has watched what from Jellyfin, and who asked for it from Seerr,
                during Scan. Set up Jellyfin (and optionally Seerr) in <a href="settings">Settings</a>,
                under Connections, then press Scan.
            </div>
        }
        else if (_reviews.Count == 0)
        {
            <EmptyState Icon="check-circle" Text="Nothing to review right now." />
        }
        else
        {
            <div class="toolbar">
                <div class="toolbar-summary">
                    <strong>@_reviews.Count</strong> title(s), @SizeFormatter.FormatBytes(_reviews.Sum(review => review.Title.SizeBytes))
                </div>
            </div>

            <div class="table-scroll">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Why</th>
                            <th class="col-num">Size</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var review in _reviews.Take(_reviewsShown))
                        {
                            <tr @key="review.Title.FolderPath">
                                <td>
                                    <div class="file-name">@review.Title.Name</div>
                                    <div class="cell-note">
                                        @review.Title.Kind · @review.Title.FolderPath.Substring(0, 3)
                                        @if (review.Watch.AddedUtc is { } added)
                                        {
                                            <text> · added @added.ToLocalTime().ToString("d MMM yyyy")</text>
                                        }
                                    </div>
                                </td>
                                <td>
                                    @review.Reason
                                    @if (review.Watch.StartedBy.Count > 0)
                                    {
                                        <div class="cell-note">Watched by @string.Join(", ", review.Watch.StartedBy.Distinct())</div>
                                    }
                                </td>
                                <td class="col-num">@SizeFormatter.FormatBytes(review.Title.SizeBytes)</td>
                                <td>
                                    @if (review.Title.IsSeeding)
                                    {
                                        <span class="cell-note">Seeding - deleting frees nothing</span>
                                    }
                                    else if (_confirmDelete == review.Title.FolderPath)
                                    {
                                        <div class="d-flex gap-2 flex-wrap">
                                            <button type="button" class="btn btn-danger btn-sm" disabled="@_deleting" @onclick="() => DeleteAsync(review)">
                                                @(_deleting ? "Deleting..." : "Delete it")
                                            </button>
                                            <button type="button" class="btn btn-secondary btn-sm" disabled="@_deleting" @onclick="() => _confirmDelete = null">Cancel</button>
                                        </div>
                                        <div class="cell-note mt-1">
                                            Removes it from @(review.Title.Kind == StorageKinds.Tv ? "Sonarr" : "Radarr")
                                            @(review.Watch.SeerrMediaId > 0 ? "and Seerr" : null), and moves the folder to Quarantine, where you can restore it.
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="d-flex gap-2 flex-wrap">
                                            <button type="button" class="btn btn-outline-danger btn-sm" @onclick="() => _confirmDelete = review.Title.FolderPath">Delete...</button>
                                            <button type="button" class="btn btn-secondary btn-sm" title="Stop suggesting it. Undo on the Ignored page." @onclick="() => Keep(review)">Keep</button>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (_reviews.Count > _reviewsShown)
            {
                <button type="button" class="btn btn-secondary btn-sm mt-2" @onclick="() => _reviewsShown += 50">Show 50 more</button>
            }

            @if (_deleteMessage is not null)
            {
                <div class="alert @(_deleteOk ? "alert-success" : "alert-danger") mt-2">@_deleteMessage</div>
            }
        }
    }
    else if (SelectedDrive is not null && _drives is not null)
    {
        @* ------------------------------------------------ Browse *@

        <div class="toolbar">
            <div class="toolbar-summary">
                <select class="form-select form-select-sm d-inline-block w-auto me-2" aria-label="Drive" value="@_selectedRoot" @onchange="args => Browse(args.Value?.ToString() ?? string.Empty)">
                    @foreach (var drive in _drives ?? [])
                    {
                        <option value="@drive.Root">@drive.Root @string.Join(", ", drive.ProfileNames)</option>
                    }
                </select>
                <strong>@FilteredTitles.Count</strong> title(s), @SizeFormatter.FormatBytes(FilteredTitles.Sum(title => title.SizeBytes))
                @if (FilteredTitles.Sum(title => title.SeedingBytes) is > 0 and var seeding)
                {
                    <text> · @SizeFormatter.FormatBytes(seeding) still seeding</text>
                }
            </div>

            <div class="toolbar-actions">
                <select class="form-select form-select-sm" aria-label="Kind" @bind="_kind">
                    <option value="">Everything</option>
                    @foreach (var kind in SelectedDrive!.Titles.Select(title => title.Kind).Distinct())
                    {
                        <option value="@kind">@kind</option>
                    }
                </select>
            </div>
        </div>

        @if (_pickedTitles.Count > 0)
        {
            <div class="toolbar">
                <div class="toolbar-summary">
                    @_pickedTitles.Count selected (@SizeFormatter.FormatBytes(PickedTitles.Sum(title => title.SizeBytes)))
                </div>
                <div class="toolbar-actions">
                    <select class="form-select form-select-sm" aria-label="Move to" @bind="_moveTo">
                        <option value="">Move to...</option>
                        @foreach (var root in TargetRoots)
                        {
                            <option value="@root">@root (@SizeFormatter.FormatBytes(_drives!.First(drive => drive.Root == root).FreeBytes) free)</option>
                        }
                    </select>

                    <button type="button"
                            class="btn btn-primary btn-sm"
                            disabled="@(string.IsNullOrEmpty(_moveTo))"
                            @onclick="MovePicked">
                        Move (@_pickedTitles.Count)
                    </button>
                </div>
            </div>
        }

        @if (_moveNote is not null)
        {
            <div class="alert alert-warning">@_moveNote</div>
        }

        @if (SelectedDrive!.Titles.Count == 0)
        {
            <EmptyState Icon="search" Text="Nothing measured on this drive yet. Press Scan at the top of the page." />
        }
        else
        {
            <div class="table-scroll">
                <table class="table">
                    <thead>
                        <tr>
                            <th class="col-check">Select</th>
                            <th>Title</th>
                            <th class="col-num">Size</th>
                            <th>Watched</th>
                            <th>Can it move?</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var title in FilteredTitles.Take(_shown))
                        {
                            var queued = IsQueued(title);

                            <tr @key="title.FolderPath" class="@(title.CanMove && !queued ? null : "row-disabled")">
                                <SelectableCheckboxCell Checked="_pickedTitles.Contains(title.FolderPath)"
                                                        Disabled="!title.CanMove || queued"
                                                        OnChanged="picked => Toggle(_pickedTitles, title, picked)" />
                                <td>
                                    <div class="file-name">@title.Name</div>
                                    <div class="cell-note">@title.Kind · added @title.ContentChangedUtc.ToLocalTime().ToString("d MMM yyyy")</div>
                                </td>
                                <td class="col-num">@SizeFormatter.FormatBytes(title.SizeBytes)</td>
                                <td>@WatchText(title)</td>
                                <td>
                                    @if (queued)
                                    {
                                        <span class="status-muted">Queued</span>
                                    }
                                    else if (title.IsSeeding)
                                    {
                                        <span class="status-muted">No, still seeding</span>
                                    }
                                    else if (!title.CanMove)
                                    {
                                        <span class="status-muted">No, only movies and TV</span>
                                    }
                                    else
                                    {
                                        <span class="status-ok">Yes</span>
                                    }

                                    @if (_shrinkable.TryGetValue(title.FolderPath, out var savings))
                                    {
                                        <div class="cell-note">
                                            <a href="size-reduction">A smaller release could save @SizeFormatter.FormatBytes(savings)</a>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (FilteredTitles.Count > _shown)
            {
                <button type="button" class="btn btn-secondary btn-sm mt-2" @onclick="() => _shown += 100">
                    Show 100 more
                </button>
            }
        }
    }
}

@code
{
    private const string PlanTab = "plan";
    private const string BrowseTab = "browse";
    private const string ReviewTab = "review";

    private string _tab = PlanTab;
    private bool _showPlanList;

    private List<StorageDrive>? _drives;
    private List<StorageMoveSuggestion> _suggestions = [];
    private List<(StorageTitle Title, string Reason)> _heldBack = [];
    private int _largestGb;
    private int _recentDays;
    private List<StoragePlanner.Destination> _destinations = [];

    private HashSet<string> _pickedSuggestions = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> _pickedTitles = new(StringComparer.OrdinalIgnoreCase);

    private string? _selectedRoot;
    private string _kind = string.Empty;
    private string _moveTo = string.Empty;
    private string? _moveNote;
    private int _shown = 100;
    private bool _scanWasRunning;
    private int _resultsSeen;

    private List<StorageReview> _reviews = [];

    // Title folder -> the most Size Reduction has found it could save.
    private Dictionary<string, long> _shrinkable = new(StringComparer.OrdinalIgnoreCase);
    private int _unwatchedMonths = 6;
    private int _reviewsShown = 50;
    private string? _confirmDelete;
    private bool _deleting;
    private string? _deleteMessage;
    private bool _deleteOk;

    private string WatchText(StorageTitle title)
    {
        if (WatchHistory.Find(title) is not { } watch)
        {
            return title.Kind is StorageKinds.Movies or StorageKinds.Tv && WatchHistory.RefreshedUtc is not null
                ? "Not in Jellyfin"
                : "-";
        }

        var who =
            watch.StartedBy.Count == 0
                ? "Nobody yet"
                : string.Join(", ", watch.StartedBy.Distinct().Take(3)) + (watch.StartedBy.Distinct().Count() > 3 ? " and others" : string.Empty);

        return watch.RequestedBy is null
            ? who
            : $"{who} · asked for by {watch.RequestedBy}" + (watch.RequesterWatched == true ? " (watched)" : watch.RequesterStarted == true ? " (started)" : " (not yet)");
    }

    private void Keep(StorageReview review)
    {
        Ignored.Add(
            new IgnoredItem
            {
                SourcePath = review.Title.FolderPath,
                Title = review.Title.Name,
                Category = review.Title.Kind == StorageKinds.Tv ? IgnoredCategory.Tv : IgnoredCategory.Movie,
                DriveProfileName = review.Title.DriveName,
                IgnoredUtc = DateTime.UtcNow,
                Reason = "Kept: not suggested on Storage's Worth a look"
            });

        _reviews.Remove(review);
    }


    private async Task DeleteAsync(StorageReview review)
    {
        _deleting = true;

        try
        {
            var result = await Mover.DeleteAsync(review.Title, review.Watch.SeerrMediaId);

            _deleteOk = result.Succeeded;
            _deleteMessage = result.Message;
        }
        finally
        {
            _deleting = false;
            _confirmDelete = null;
        }

        await LoadAsync();
    }

    private StorageDrive? SelectedDrive =>
        _drives?.FirstOrDefault(drive => drive.Root == _selectedRoot);

    private List<StorageTitle> FilteredTitles =>
        SelectedDrive?.Titles
            .Where(title => _kind.Length == 0 || title.Kind == _kind)
            .ToList() ?? [];

    private List<StorageTitle> PickedTitles =>
        SelectedDrive?.Titles.Where(title => _pickedTitles.Contains(title.FolderPath)).ToList() ?? [];

    /// <summary>Other drives with a library for every kind picked.</summary>
    private List<string> TargetRoots =>
        _destinations
            .Where(destination => destination.Root != _selectedRoot)
            .GroupBy(destination => destination.Root)
            .Where(group => PickedTitles.All(title => group.Any(destination => destination.Kind == title.Kind)))
            .Select(group => group.Key)
            .OrderBy(root => root)
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        _scanWasRunning = Scans.Progress.IsRunning;
        _resultsSeen = Mover.Results.Count;

        Scans.Changed += OnScanChanged;
        Mover.Changed += OnMoverChanged;

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var settings = await SettingsService.GetSettingsAsync();

        _destinations = StoragePlanner.Destinations(settings.DriveProfiles);
        _drives = await StorageService.GetDrivesAsync();
        _suggestions = await StorageService.GetSuggestionsAsync(WatchHistory.Find);

        _largestGb = settings.StorageLargestToMoveGb;
        _recentDays = settings.StorageRecentDays;
        _heldBack =
            StoragePlanner.HeldBack(
                _drives,
                WatchHistory.Find,
                StoragePlanner.LargestToMoveBytes(settings),
                StoragePlanner.RecentAfterUtc(settings, DateTime.UtcNow));

        _unwatchedMonths = settings.StorageUnwatchedMonths;

        // Each file's best saving, added up per title folder.
        var found = await SizeReduction.GetFoundAsync();

        _shrinkable =
            _drives
                .SelectMany(drive => drive.Titles)
                .Select(title => (
                    title.FolderPath,
                    Savings: found
                        .Where(candidate => PathContainment.IsPathUnderRoot(candidate.CanonicalPath, title.FolderPath))
                        .GroupBy(candidate => candidate.CanonicalPath, StringComparer.OrdinalIgnoreCase)
                        .Sum(file => file.Max(candidate => candidate.SavingsBytes))))
                .Where(entry => entry.Savings > 0)
                .GroupBy(entry => entry.FolderPath, StringComparer.OrdinalIgnoreCase)
                .ToDictionary(group => group.Key, group => group.First().Savings, StringComparer.OrdinalIgnoreCase);
        _reviews =
            WatchHistoryService.Review(
                _drives.SelectMany(drive => drive.Titles).Where(title => !Ignored.IsIgnored(title.FolderPath)),
                WatchHistory.Find,
                _unwatchedMonths,
                DateTime.UtcNow);

        var present = _suggestions.Select(suggestion => suggestion.Title.FolderPath).ToHashSet(StringComparer.OrdinalIgnoreCase);
        _pickedSuggestions.IntersectWith(present);

        // Start on the fullest drive.
        if (_selectedRoot is null || _drives.All(drive => drive.Root != _selectedRoot))
        {
            _selectedRoot =
                _drives
                    .Where(drive => drive.IsAvailable)
                    .OrderByDescending(drive => drive.UsedPercent - drive.LimitLinePercent)
                    .FirstOrDefault()?.Root;
        }
    }

    private void SelectDrive(string root)
    {
        if (_selectedRoot == root)
        {
            return;
        }

        _selectedRoot = root;
        _pickedTitles.Clear();
        _moveTo = string.Empty;
        _moveNote = null;
        _shown = 100;
    }

    private static void Toggle(HashSet<string> set, StorageTitle title, bool picked)
    {
        if (picked)
        {
            set.Add(title.FolderPath);
        }
        else
        {
            set.Remove(title.FolderPath);
        }
    }

    private bool IsQueued(StorageTitle title) =>
        Mover.Queue.Any(request => string.Equals(request.Title.FolderPath, title.FolderPath, StringComparison.OrdinalIgnoreCase)) ||
        (Mover.Current is { } current && string.Equals(current.Request.Title.FolderPath, title.FolderPath, StringComparison.OrdinalIgnoreCase));

    private void MoveSuggestions()
    {
        Mover.Enqueue(
            _suggestions
                .Where(suggestion => _pickedSuggestions.Contains(suggestion.Title.FolderPath))
                .Select(suggestion => new StorageMoveRequest(suggestion.Title, suggestion.ToLibraryPath)));

        _pickedSuggestions.Clear();
    }

    private void MoveAllSuggestions()
    {
        Mover.Enqueue(
            _suggestions
                .Where(suggestion => !IsQueued(suggestion.Title))
                .Select(suggestion => new StorageMoveRequest(suggestion.Title, suggestion.ToLibraryPath)));

        _pickedSuggestions.Clear();
    }

    private static string LimitText(StorageDrive drive) =>
        drive.IsDownloadsDrive
            ? $"Downloads drive · moves start at {drive.LimitPercent}%"
        : drive.IsProtected
            ? $"Protected · moves start at {drive.LimitPercent}%"
            : $"Overflow · keeps {SizeFormatter.FormatBytes(drive.KeepFreeBytes)} free";

    private static string Css(double value) =>
        value.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);

    private static string ShortReason(string reason) =>
        reason switch
        {
            "Still seeding" => "seeding",
            "Still airing" => "airing",
            "Added or changed recently" => "added recently",
            "Too big to move by itself" => "too big",
            _ => reason.ToLowerInvariant()
        };

    // The plan for one full drive, in a sentence.
    private static string PlanSentence(StorageDrive drive, List<StorageMoveSuggestion> moves)
    {
        var where =
            drive.IsProtected
                ? $"{drive.Root} is at {drive.UsedPercent:0}%, over its {drive.LimitPercent}% limit."
                : $"{drive.Root} has {SizeFormatter.FormatBytes(drive.FreeBytes)} free, less than the {SizeFormatter.FormatBytes(drive.KeepFreeBytes)} it keeps free.";

        if (moves.Count == 0)
        {
            return where;
        }

        var moving = moves.Sum(move => move.Title.SizeBytes);
        var after = drive.TotalBytes <= 0 ? 0 : (drive.UsedBytes - moving) * 100.0 / drive.TotalBytes;
        var to = string.Join(" and ", moves.Select(move => move.ToRoot).Distinct());

        var result =
            $"{where} Moving {moves.Count} title(s) ({SizeFormatter.FormatBytes(moving)}) to {to} brings it to about {after:0}%.";

        if (drive.UsedBytes - moving > drive.TargetBytes)
        {
            result += " That's as far as it can go with the titles that are allowed to move.";
        }

        return result;
    }

    private string NoMovesReason() =>
        _drives!.Any(drive => drive.IsAvailable && !drive.IsProtected && !drive.IsOverLimit)
            ? "Nothing on it can move right now: every title is left alone (see below) or too big for the overflow drives' room."
            : "There's no overflow drive with room. In Settings, leave at least one drive unprotected, or lower what it keeps free.";

    // Moved folders are deleted for good once their copy is checked: the
    // service's own Recycle Bin is a hidden folder on the same drive.
    private static string RecycleBinNote =>
        "The old folders are deleted once their copies are checked, so the space they took is free again.";

    private void Browse(string root)
    {
        SelectDrive(root);

        _tab = BrowseTab;
    }

    private void MovePicked()
    {
        var requests = new List<StorageMoveRequest>();
        var skipped = new List<string>();

        foreach (var title in PickedTitles)
        {
            var library =
                _destinations.FirstOrDefault(destination => destination.Root == _moveTo && destination.Kind == title.Kind);

            if (library is null)
            {
                skipped.Add(title.Name);
            }
            else
            {
                requests.Add(new StorageMoveRequest(title, library.LibraryPath));
            }
        }

        Mover.Enqueue(requests);

        _pickedTitles.Clear();
        _moveTo = string.Empty;
        _moveNote = skipped.Count == 0 ? null : $"Not queued, no library for them on that drive: {string.Join(", ", skipped)}.";
    }

    private void OnScanChanged()
    {
        var running = Scans.Progress.IsRunning;
        var finished = _scanWasRunning && !running;

        _scanWasRunning = running;

        if (finished)
        {
            _ = InvokeAsync(async () =>
            {
                await LoadAsync();
                StateHasChanged();
            });
        }
    }

    private void OnMoverChanged()
    {
        _ = InvokeAsync(async () =>
        {
            // A title finished: free space and the lists have changed.
            if (Mover.Results.Count != _resultsSeen)
            {
                _resultsSeen = Mover.Results.Count;

                await LoadAsync();
            }

            StateHasChanged();
        });
    }

    public void Dispose()
    {
        Scans.Changed -= OnScanChanged;
        Mover.Changed -= OnMoverChanged;
    }
}
