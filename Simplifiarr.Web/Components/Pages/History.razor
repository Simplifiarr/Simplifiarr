@page "/history"
@rendermode InteractiveServer

@using Simplifiarr.Core.Models
@using Simplifiarr.Core.Services
@using Simplifiarr.Core.Utilities

@inject IHistoryService HistoryService

<PageTitle>History - Simplifiarr</PageTitle>

<PageHeader Title="History"
            Subtitle="Everything Simplifiarr has changed on disk, newest first.">
    @if (_loaded && _records.Count > 0 && !_confirmingClear)
    {
        <button type="button"
                class="btn btn-outline-danger"
                @onclick="() => _confirmingClear = true">
            Clear history
        </button>
    }
</PageHeader>

@if (_confirmingClear)
{
    <BatchConfirmBanner CssClass="alert alert-danger"
                        IsBusy="_isClearing"
                        ConfirmLabel="Clear history"
                        BusyLabel="Clearing..."
                        OnConfirm="ClearHistoryAsync"
                        OnCancel="() => _confirmingClear = false">
        <Message>
            <strong>Permanently delete all @_records.Count.ToString("N0") history record(s)?</strong>
            This cannot be undone. It also resets "Space saved" on Home, and
            Quarantine will no longer know where its files came from, so they
            can't be restored to their original place.
        </Message>
    </BatchConfirmBanner>
}

@if (!string.IsNullOrWhiteSpace(_statusMessage))
{
    <div class="alert alert-info">
        @_statusMessage
    </div>
}

@if (!_loaded)
{
    <EmptyState Icon="hourglass-split" Text="Loading history..." />
}
else if (_records.Count == 0)
{
    <EmptyState Icon="journal-text" Text="Nothing has been changed yet." />
}
else
{
    <div class="stat-grid">
        <StatCard Label="Space freed"
                  Value="@SizeFormatter.FormatBytes(_spaceFreedBytes)"
                  Note="by deleting old copies from Quarantine"
                  Accent="true" />

        <StatCard Label="Linked into libraries"
                  Value="@Count(HistoryActionType.PromotionSucceeded).ToString("N0")"
                  Note="downloads hardlinked, nothing copied" />

        <StatCard Label="Copies converted"
                  Value="@Count(HistoryActionType.ConversionSucceeded).ToString("N0")"
                  Note="full copies replaced with hardlinks" />

        <StatCard Label="Didn't work"
                  Value="@_records.Count(record => !record.Success).ToString("N0")"
                  Note="actions that failed and changed nothing" />
    </div>

    <div class="app-tabs" role="tablist" aria-label="Kind of action">
        @foreach (var tab in Tabs)
        {
            <button type="button"
                    role="tab"
                    aria-selected="@(_activeTab == tab.Key)"
                    class="app-tab @(_activeTab == tab.Key ? "active" : null)"
                    @onclick="() => ShowTab(tab.Key)">
                @tab.Label <span class="app-tab-count">@_records.Count(tab.Matches).ToString("N0")</span>
            </button>
        }
    </div>

    <div class="toolbar">
        <div class="toolbar-summary">
            <strong>@Filtered.Count.ToString("N0")</strong> record(s)
        </div>

        <div class="toolbar-actions">
            <label class="visually-hidden" for="history-filter">Filter by file name</label>
            <input id="history-filter"
                   type="search"
                   class="form-control form-control-sm"
                   style="width: 14rem"
                   placeholder="Filter by file name"
                   @bind="_filter"
                   @bind:event="oninput"
                   @bind:after="ResetPaging" />
        </div>
    </div>

    @if (Filtered.Count == 0)
    {
        <EmptyState Icon="funnel" Text="Nothing matches that filter." />
    }
    else
    {
        <div class="table-scroll">
            <table class="table">
                <thead>
                    <tr>
                        <th>When</th>
                        <th>What happened</th>
                        <th>File</th>
                        <th class="col-num">Size</th>
                        <th>Details</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var record in Filtered.Take(_shown))
                    {
                        <tr @key="record.Id">
                            <td style="white-space: nowrap">@record.TimestampUtc.ToLocalTime().ToString("g")</td>

                            <td>
                                <span class="@(record.Success ? null : "status-warn")">@Describe(record)</span>
                            </td>

                            <td>
                                <div class="file-name">@record.FileName</div>
                            </td>

                            <td class="col-num">@(record.SizeBytes > 0 ? SizeFormatter.FormatBytes(record.SizeBytes) : "-")</td>

                            <td>
                                <details>
                                    <summary>More</summary>

                                    <div class="mt-2">@record.Message</div>

                                    @if (!string.IsNullOrWhiteSpace(record.LibraryPath))
                                    {
                                        <div class="detail-label">Library</div>
                                        <code>@record.LibraryPath</code>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(record.DownloadPath))
                                    {
                                        <div class="detail-label">Download</div>
                                        <code>@record.DownloadPath</code>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(record.QuarantinePath))
                                    {
                                        <div class="detail-label">Quarantine</div>
                                        <code>@record.QuarantinePath</code>
                                    }
                                </details>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Filtered.Count > _shown)
        {
            <button type="button"
                    class="btn btn-secondary mt-3"
                    @onclick="() => _shown += PageSize">
                Show @Math.Min(PageSize, Filtered.Count - _shown) more (@((Filtered.Count - _shown).ToString("N0")) left)
            </button>
        }
    }
}

@code
{
    // History runs to thousands of rows; drawing them all at once makes the
    // page crawl, so show a page at a time.
    private const int PageSize = 100;

    private sealed record Tab(string Key, string Label, Func<HistoryRecord, bool> Matches);

    private static readonly Tab[] Tabs =
    [
        new("all", "All", _ => true),
        new("linked", "Linked", record =>
            record.ActionType is HistoryActionType.PromotionSucceeded or HistoryActionType.PromotionFailed),
        new("converted", "Converted", record =>
            record.ActionType is HistoryActionType.ConversionSucceeded or HistoryActionType.ConversionFailed or HistoryActionType.BatchCompleted),
        new("removed", "Moved to Quarantine", record =>
            record.ActionType is HistoryActionType.JunkFileQuarantined or HistoryActionType.DuplicateQuarantined),
        new("deleted", "Deleted", record =>
            record.ActionType is HistoryActionType.QuarantineDeleted or HistoryActionType.DownloadCopyRemoved),
        new("restored", "Restored", record =>
            record.ActionType is HistoryActionType.QuarantineRestored or HistoryActionType.PermissionsRestored),
        new("playback", "Playback fixes", record =>
            record.ActionType == HistoryActionType.PlaybackErrorFixed),
        new("seeds", "Seeds moved", record =>
            record.ActionType == HistoryActionType.SeedMoved),
        new("failed", "Didn't work", record => !record.Success)
    ];

    private List<HistoryRecord> _records = [];
    private bool _loaded;

    private long _spaceFreedBytes;

    private string _activeTab = "all";
    private string _filter = string.Empty;
    private int _shown = PageSize;

    private bool _confirmingClear;
    private bool _isClearing;

    private string _statusMessage = string.Empty;

    private List<HistoryRecord> Filtered
    {
        get
        {
            var tab = Tabs.First(candidate => candidate.Key == _activeTab);

            return _records
                .Where(tab.Matches)
                .Where(record =>
                    string.IsNullOrWhiteSpace(_filter) ||
                    record.FileName.Contains(_filter.Trim(), StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _records =
            (await HistoryService.GetHistoryAsync())
                .OrderByDescending(record => record.TimestampUtc)
                .ToList();

        _spaceFreedBytes =
            _records
                .Where(record =>
                    record.ActionType == HistoryActionType.QuarantineDeleted &&
                    record.Success)
                .Sum(record => record.SizeBytes);

        _loaded = true;
    }

    private int Count(HistoryActionType type) =>
        _records.Count(record => record.ActionType == type);

    private void ShowTab(string key)
    {
        _activeTab = key;

        ResetPaging();
    }

    private void ResetPaging() =>
        _shown = PageSize;

    private async Task ClearHistoryAsync()
    {
        if (_isClearing)
        {
            return;
        }

        _isClearing = true;

        try
        {
            await HistoryService.ClearHistoryAsync();

            _records = [];
            _spaceFreedBytes = 0;
            _confirmingClear = false;

            _statusMessage = "History cleared.";
        }
        catch (Exception ex)
        {
            _statusMessage = $"Couldn't clear history: {ex.Message}";
        }
        finally
        {
            _isClearing = false;
        }
    }

    // What happened, in words rather than the internal action name.
    private static string Describe(HistoryRecord record) =>
        record.ActionType switch
        {
            HistoryActionType.PromotionSucceeded => "Linked into library",
            HistoryActionType.PromotionFailed => "Couldn't link into library",
            HistoryActionType.ConversionSucceeded => "Copy converted to hardlink",
            HistoryActionType.ConversionFailed => "Couldn't convert copy",
            HistoryActionType.BatchCompleted =>
                record.Success ? "Batch of conversions finished" : "Batch of conversions finished with failures",
            HistoryActionType.JunkFileQuarantined =>
                record.Success ? "Leftover moved to Quarantine" : "Couldn't move leftover to Quarantine",
            HistoryActionType.DuplicateQuarantined =>
                record.Success ? "Duplicate moved to Quarantine" : "Couldn't move duplicate to Quarantine",
            HistoryActionType.QuarantineDeleted =>
                record.Success ? "Deleted from Quarantine" : "Couldn't delete from Quarantine",
            HistoryActionType.QuarantineRestored =>
                record.Success ? "Restored from Quarantine" : "Couldn't restore from Quarantine",
            HistoryActionType.DownloadCopyRemoved =>
                record.Success ? "Download copy deleted" : "Couldn't delete download copy",
            HistoryActionType.PlaybackErrorFixed =>
                record.Success ? "Playback problem fixed" : "Couldn't fix playback problem",
            HistoryActionType.PermissionsRestored =>
                record.Success ? "Earlier permissions put back" : "Couldn't put earlier permissions back",
            HistoryActionType.SeedMoved =>
                record.Success ? "Seed moved to its library's drive" : "Couldn't move seed",
            _ => record.ActionType.ToString()
        };
}
