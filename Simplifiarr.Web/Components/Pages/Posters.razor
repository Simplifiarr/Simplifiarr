@page "/posters"
@rendermode InteractiveServer

@using Simplifiarr.Core.Models
@using Simplifiarr.Core.Services

@inject IJellyfinClient Jellyfin
@inject IPosterService PosterService
@inject ISettingsService SettingsService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Posters - Simplifiarr</PageTitle>

@if (_open is null)
{
    <PageHeader Title="Posters"
                Subtitle="Pick anything in Jellyfin and choose its poster, backdrop, logo and more. Click a picture and it is set in Jellyfin straight away.">
        @if (_isSetUp)
        {
            <button type="button"
                    class="btn btn-secondary"
                    aria-expanded="@_showChoices"
                    @onclick="() => _showChoices = !_showChoices">
                <i class="bi bi-sliders" aria-hidden="true"></i>
                Pictures to show
            </button>
        }
    </PageHeader>

    @if (!_isSetUp)
    {
        <div class="alert alert-warning">
            Jellyfin isn't set up yet. <a href="settings">Add its address and API key in Settings</a>, under Connections.
        </div>
    }
    else
    {
        @if (_showChoices)
        {
            <section class="section">
                <h2 class="section-title">Pictures to show</h2>
                <p class="cell-note">
                    Tick the kinds of picture you care about. They get a tab when you open something, and the list
                    points out what's missing. The poster is always there. Saved as you tick.
                </p>

                <div class="picture-choices">
                    @foreach (var picture in PictureTypes.All)
                    {
                        var isPoster = picture.Type == PictureTypes.Poster;

                        <label class="picture-choice">
                            <input type="checkbox"
                                   class="form-check-input"
                                   checked="@(isPoster || _chosen.Contains(picture.Type))"
                                   disabled="@isPoster"
                                   @onchange="e => ChooseAsync(picture.Type, e.Value is true)" />
                            <span>
                                <strong>@picture.Label</strong> <span class="cell-note">@picture.FileName</span><br />
                                <span class="cell-note">@picture.About</span>
                            </span>
                        </label>
                    }
                </div>
            </section>
        }

        <div class="app-tabs" role="tablist" aria-label="Kind of item">
            @foreach (var kind in Kinds)
            {
                <button type="button"
                        role="tab"
                        aria-selected="@(_kind == kind.Type)"
                        class="app-tab @(_kind == kind.Type ? "active" : null)"
                        @onclick="() => ShowKindAsync(kind.Type)">
                    @kind.Label
                </button>
            }
        </div>

        <form class="toolbar" @onsubmit="() => LoadItemsAsync(reset: true)">
            <div class="d-flex flex-wrap gap-2 fill-row">
                <input class="form-control fill-row"
                       aria-label="Search by name"
                       placeholder="Search by name"
                       @bind="_search" />

                <button type="submit" class="btn btn-secondary" disabled="@_isLoadingItems">
                    <i class="bi bi-search" aria-hidden="true"></i>
                    Search
                </button>
            </div>

            <div class="toolbar-summary">
                @if (!_isLoadingItems)
                {
                    <text><strong>@_total</strong> @KindLabel(_kind).ToLowerInvariant()</text>
                }
            </div>
        </form>

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="alert alert-warning">@_error</div>
        }
        else if (_isLoadingItems && _items.Count == 0)
        {
            <p class="cell-note" role="status">Loading...</p>
        }
        else if (_items.Count == 0)
        {
            <EmptyState Icon="image" Text="@(string.IsNullOrWhiteSpace(_search) ? "Jellyfin has nothing of this kind." : "Nothing matches that search.")" />
        }
        else
        {
            <div class="poster-grid">
                @foreach (var item in _items)
                {
                    var gaps = Gaps(item);

                    <button type="button" class="poster-card" @key="item.Id" @onclick="() => OpenAsync(item)">
                        @if (item.HasPoster)
                        {
                            <img loading="lazy" alt="" src="@PictureUrl(item.Id, PictureTypes.Poster)" />
                        }
                        else
                        {
                            <span class="poster-missing">
                                <i class="bi bi-image" aria-hidden="true"></i>
                                No poster
                            </span>
                        }

                        <span class="poster-card-title">@item.Name</span>

                        @if (item.Year is not null)
                        {
                            <span class="cell-note">@item.Year</span>
                        }

                        @if (gaps.Count > 0)
                        {
                            <span class="picture-gaps">No @string.Join(", ", gaps.Select(gap => gap.Label.ToLowerInvariant()))</span>
                        }
                    </button>
                }
            </div>

            @if (_items.Count < _total)
            {
                <button type="button"
                        class="btn btn-secondary mt-3"
                        disabled="@_isLoadingItems"
                        @onclick="() => LoadItemsAsync(reset: false)">
                    @(_isLoadingItems ? "Loading..." : $"Show more ({_total - _items.Count} left)")
                </button>
            }
        }
    }
}
else
{
    var picture = PictureTypes.Find(_type);
    var label = picture.Label.ToLowerInvariant();

    <PageHeader Title="@OpenTitle"
                Subtitle="@($"{(_open.Year is null ? "" : $"{_open.Year} · ")}Choose a {label}. Clicking one sets it in Jellyfin straight away.")">
        <button type="button" class="btn btn-secondary" disabled="@_isSetting" @onclick="BackAsync">
            <i class="bi bi-arrow-left" aria-hidden="true"></i>
            @(_series is null ? "Back" : $"Back to {_series.Name}")
        </button>
    </PageHeader>

    @if (OpenTypes.Count > 1)
    {
        <div class="app-tabs" role="tablist" aria-label="Kind of picture">
            @foreach (var type in OpenTypes)
            {
                <button type="button"
                        role="tab"
                        aria-selected="@(_type == type.Type)"
                        class="app-tab @(_type == type.Type ? "active" : null)"
                        disabled="@_isSetting"
                        @onclick="() => ShowTypeAsync(type.Type)">
                    @type.Label
                    @if (!_open.Has(type.Type))
                    {
                        <span class="picture-tab-gap" title="@($"No {type.Label.ToLowerInvariant()} yet")"></span>
                    }
                </button>
            }
        </div>
    }

    @if (_pending is not null)
    {
        <div class="alert alert-info" role="alert">
            <strong>@_open.Name already has @_open.Backdrops backdrop@(_open.Backdrops == 1 ? "" : "s").</strong>
            Some apps rotate through all of them; most show the first.
            <div class="d-flex flex-wrap gap-2 mt-2">
                <button type="button" class="btn btn-primary btn-sm" @onclick="() => FinishPendingAsync(BackdropChoice.ReplaceMain)">
                    Change the main one
                </button>
                <button type="button" class="btn btn-secondary btn-sm" @onclick="() => FinishPendingAsync(BackdropChoice.Add)">
                    Add to them
                </button>
                <button type="button" class="btn btn-secondary btn-sm" @onclick="() => _pending = null">
                    Cancel
                </button>
            </div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="alert @(_messageIsProblem ? "alert-warning" : "alert-info")" role="status">
            @_message

            @if (_lastChange is not null && !_messageIsProblem)
            {
                <button type="button"
                        class="btn btn-secondary btn-sm ms-2"
                        disabled="@_isSetting"
                        @onclick="UndoAsync">
                    Undo
                </button>
            }
        </div>
    }

    <div class="poster-detail">
        <div class="poster-current shape-@picture.Shape">
            <div class="detail-label mt-0">Current @label</div>

            @if (_open.Has(_type))
            {
                <img alt="@($"Current {label}")" src="@PictureUrl(_open.Id, _type)" />
            }
            else
            {
                <span class="poster-missing">
                    <i class="bi bi-image" aria-hidden="true"></i>
                    No @label
                </span>
            }

            @if (_type == PictureTypes.Backdrop && _open.Backdrops > 1)
            {
                <div class="backdrop-strip" aria-label="All backdrops">
                    @for (var index = 0; index < _open.Backdrops; index++)
                    {
                        <figure>
                            <img alt="" src="@PictureUrl(_open.Id, _type, index)" />
                            <figcaption>@(index == 0 ? "Main" : $"#{index + 1}")</figcaption>
                        </figure>
                    }
                </div>
            }
        </div>

        <div class="poster-own">
            <div class="detail-label mt-0">Use your own picture</div>

            <label class="poster-drop @(_isSetting ? "disabled" : null)">
                <i class="bi bi-upload" aria-hidden="true"></i>
                <span>Drop a picture here, or click to choose one</span>
                <span class="cell-note">JPEG, PNG or WebP, up to 25 MB@(picture.Shape == "logo" ? ". Use a PNG with a see-through background." : "")</span>
                <InputFile accept="image/jpeg,image/png,image/webp"
                           disabled="@_isSetting"
                           OnChange="UseFileAsync" />
            </label>

            <form class="d-flex flex-wrap gap-2 mt-3" @onsubmit="UseLinkAsync">
                <input class="form-control fill-row"
                       aria-label="Web address of a picture"
                       placeholder="Or paste a picture's web address"
                       @bind="_link" />

                <button type="submit"
                        class="btn btn-secondary"
                        disabled="@(_isSetting || string.IsNullOrWhiteSpace(_link))">
                    Use this
                </button>
            </form>

            <div class="cell-note mt-1">
                For sites such as ThePosterDB: copy the picture's own image address there and paste it here.
            </div>
        </div>
    </div>

    @if (InsideWithType.Count > 0)
    {
        <section class="section">
            <h2 class="section-title">@($"{picture.Label}s of what's inside this collection")</h2>

            <div class="poster-grid shape-@picture.Shape">
                @foreach (var member in InsideWithType)
                {
                    <button type="button"
                            class="poster-card"
                            disabled="@_isSetting"
                            @key="member.Id"
                            @onclick="() => UseItemAsync(member)">
                        <img loading="lazy" alt="" src="@PictureUrl(member.Id, _type)" />
                        <span class="poster-card-title">@member.Name</span>
                    </button>
                }
            </div>
        </section>
    }

    <section class="section">
        <h2 class="section-title">@($"{picture.Label}s found online")</h2>

        @foreach (var note in _notes)
        {
            <div class="alert alert-warning">@note</div>
        }

        @if (_isLoadingOptions)
        {
            <p class="cell-note" role="status">Looking for @(label)s...</p>
        }
        else if (_options.Count == 0)
        {
            <EmptyState Icon="image" Text="@NothingFoundText" />
        }
        else
        {
            <div class="toolbar">
                <div class="toolbar-summary">
                    <strong>@VisibleOptions.Count</strong> @(label)(s)
                </div>

                <div class="toolbar-actions">
                    @if (Sources.Count > 1)
                    {
                        <select class="form-select form-select-sm w-auto"
                                aria-label="Source"
                                value="@_source"
                                @onchange="e => SetSource(e.Value?.ToString())">
                            <option value="">Every source</option>
                            @foreach (var source in Sources)
                            {
                                <option value="@source">@source</option>
                            }
                        </select>
                    }

                    @if (Languages.Count > 1)
                    {
                        <select class="form-select form-select-sm w-auto"
                                aria-label="Language"
                                value="@_language"
                                @onchange="e => SetLanguage(e.Value?.ToString())">
                            <option value="">Any language</option>
                            @foreach (var language in Languages)
                            {
                                <option value="@language">@LanguageLabel(language)</option>
                            }
                        </select>
                    }
                </div>
            </div>

            <div class="poster-grid shape-@picture.Shape">
                @foreach (var option in VisibleOptions.Take(_shown))
                {
                    <button type="button"
                            class="poster-card"
                            disabled="@_isSetting"
                            @key="option.Url"
                            @onclick="() => UseOptionAsync(option)">
                        <img loading="lazy" alt="" referrerpolicy="no-referrer" src="@option.ThumbnailUrl" />
                        <span class="cell-note">
                            @option.Source
                            @if (option.Language.Length > 0)
                            {
                                <text> · @LanguageLabel(option.Language)</text>
                            }
                            @if (option.Width is not null && option.Height is not null)
                            {
                                <text> · @option.Width×@option.Height</text>
                            }
                        </span>
                    </button>
                }
            </div>

            @if (VisibleOptions.Count > _shown)
            {
                <button type="button" class="btn btn-secondary mt-3" @onclick="() => _shown += PageSize">
                    Show more (@(VisibleOptions.Count - _shown) left)
                </button>
            }
        }
    </section>

    @if (_open.Type == "Series")
    {
        <section class="section">
            <h2 class="section-title">Seasons</h2>

            @if (_seasons.Count == 0)
            {
                <p class="cell-note">@(_isLoadingSeasons ? "Loading..." : "Jellyfin lists no seasons for this show.")</p>
            }
            else
            {
                <div class="poster-grid">
                    @foreach (var season in _seasons)
                    {
                        <button type="button"
                                class="poster-card"
                                disabled="@_isSetting"
                                @key="season.Id"
                                @onclick="() => OpenSeasonAsync(season)">
                            @if (season.HasPoster)
                            {
                                <img loading="lazy" alt="" src="@PictureUrl(season.Id, PictureTypes.Poster)" />
                            }
                            else
                            {
                                <span class="poster-missing">
                                    <i class="bi bi-image" aria-hidden="true"></i>
                                    No poster
                                </span>
                            }

                            <span class="poster-card-title">@season.Name</span>
                        </button>
                    }
                </div>
            }
        </section>
    }
}

@code
{
    private const int PageSize = 60;

    private static readonly (string Type, string Label)[] Kinds =
    [
        ("Movie", "Movies"),
        ("Series", "Shows"),
        ("BoxSet", "Collections")
    ];

    /// <summary>
    /// Opens straight onto one item, e.g. a collection from its own page.
    /// </summary>
    [SupplyParameterFromQuery(Name = "item")]
    public string? ItemId { get; set; }

    private bool _isSetUp;

    /// <summary>The picture types chosen under "Pictures to show".</summary>
    private HashSet<string> _chosen = new(PictureTypes.Defaults, StringComparer.OrdinalIgnoreCase);

    private bool _showChoices;

    // The list.
    private string _kind = "Movie";
    private string _search = string.Empty;
    private List<JellyfinPosterItem> _items = [];
    private int _total;
    private bool _isLoadingItems;
    private string? _error;

    // The open item, and the show it belongs to when it is a season.
    private JellyfinPosterItem? _open;
    private JellyfinPosterItem? _series;
    private string _type = PictureTypes.Poster;
    private List<PosterOption> _options = [];
    private List<string> _notes = [];
    private List<JellyfinPosterItem> _inside = [];
    private List<JellyfinPosterItem> _seasons = [];
    private bool _isLoadingOptions;
    private bool _isLoadingSeasons;
    private string _source = string.Empty;
    private string _language = string.Empty;
    private int _shown = PageSize;
    private string _link = string.Empty;

    private bool _isSetting;
    private string? _message;
    private bool _messageIsProblem;

    /// <summary>A backdrop waiting on "change the main one" or "add".</summary>
    private Func<BackdropChoice, Task<PictureChange>>? _pending;

    /// <summary>The last change, kept so it can be undone.</summary>
    private PictureChange? _lastChange;

    // Changes whenever a picture is set, so the browser fetches the new one
    // rather than showing the one it remembers.
    private long _version = DateTime.UtcNow.Ticks;

    private string OpenTitle =>
        _series is null ? _open!.Name : $"{_series.Name}: {_open!.Name}";

    private IReadOnlyList<PictureType> OpenTypes =>
        _open is null ? [] : PictureTypes.For(_open.Type, _chosen);

    private List<JellyfinPosterItem> InsideWithType =>
        _inside.Where(member => member.Has(_type)).ToList();

    private string NothingFoundText
    {
        get
        {
            var label = PictureTypes.Find(_type).Label.ToLowerInvariant();

            return _open?.Type == "BoxSet"
                ? $"No {label}s were found online for this collection. That is normal for a collection you made up yourself - use one from above, or your own picture."
                : $"No {label}s were found online for this. You can still use your own picture.";
        }
    }

    private List<string> Sources =>
        _options
            .Select(option => option.Source)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Order(StringComparer.OrdinalIgnoreCase)
            .ToList();

    private List<string> Languages =>
        _options
            .Select(option => LanguageKey(option.Language))
            .Where(language => language.Length > 0)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(LanguageLabel, StringComparer.OrdinalIgnoreCase)
            .ToList();

    private List<PosterOption> VisibleOptions =>
        _options
            .Where(option =>
                (_source.Length == 0 ||
                 string.Equals(option.Source, _source, StringComparison.OrdinalIgnoreCase)) &&
                (_language.Length == 0 ||
                 string.Equals(LanguageKey(option.Language), _language, StringComparison.OrdinalIgnoreCase)))
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        var settings =
            await SettingsService.GetSettingsAsync();

        _isSetUp =
            !string.IsNullOrWhiteSpace(settings.JellyfinUrl) &&
            !string.IsNullOrWhiteSpace(settings.JellyfinApiKey);

        _chosen = new HashSet<string>(settings.PictureTypes ?? [.. PictureTypes.Defaults], StringComparer.OrdinalIgnoreCase);

        if (!_isSetUp)
        {
            return;
        }

        if (!string.IsNullOrWhiteSpace(ItemId))
        {
            try
            {
                if (await Jellyfin.GetPosterItemAsync(ItemId) is { } item)
                {
                    _kind = Kinds.Any(kind => kind.Type == item.Type) ? item.Type : _kind;

                    await OpenAsync(item);
                }
            }
            catch (InvalidOperationException exception)
            {
                _error = exception.Message;
            }
        }

        await LoadItemsAsync(reset: true);
    }

    // ------------------------------------------------------------- Choices

    private async Task ChooseAsync(string type, bool wanted)
    {
        if (wanted)
        {
            _chosen.Add(type);
        }
        else
        {
            _chosen.Remove(type);
        }

        // Saved straight away, in the usual order.
        var settings =
            await SettingsService.GetSettingsAsync();

        settings.PictureTypes =
            PictureTypes.All
                .Where(picture => picture.Type == PictureTypes.Poster || _chosen.Contains(picture.Type))
                .Select(picture => picture.Type)
                .ToList();

        await SettingsService.SaveSettingsAsync(settings);
    }

    /// <summary>The chosen pictures this item doesn't have (the poster is shown already).</summary>
    private List<PictureType> Gaps(JellyfinPosterItem item) =>
        PictureTypes.For(item.Type, _chosen)
            .Where(picture => picture.Type != PictureTypes.Poster && !item.Has(picture.Type))
            .ToList();

    // ---------------------------------------------------------------- List

    private async Task ShowKindAsync(string kind)
    {
        if (kind == _kind)
        {
            return;
        }

        _kind = kind;
        _search = string.Empty;

        await LoadItemsAsync(reset: true);
    }

    private async Task LoadItemsAsync(bool reset)
    {
        if (_isLoadingItems)
        {
            return;
        }

        _isLoadingItems = true;
        _error = null;

        if (reset)
        {
            _items = [];
            _total = 0;
        }

        try
        {
            var page =
                await Jellyfin.FindPosterItemsAsync(_kind, _search, _items.Count, PageSize);

            _items = [.. _items, .. page.Items];
            _total = page.Total;
        }
        catch (InvalidOperationException exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _isLoadingItems = false;
        }
    }

    // ---------------------------------------------------------------- Open

    private async Task OpenAsync(JellyfinPosterItem item, JellyfinPosterItem? series = null)
    {
        _open = item;
        _series = series;
        _inside = [];
        _seasons = [];
        _message = null;
        _lastChange = null;
        _pending = null;
        _link = string.Empty;

        if (!OpenTypes.Any(type => type.Type == _type))
        {
            _type = PictureTypes.Poster;
        }

        var loadSeasons = item.Type == "Series" ? LoadSeasonsAsync(item) : Task.CompletedTask;

        if (item.Type == "BoxSet")
        {
            try
            {
                _inside = (await Jellyfin.GetCollectionPosterItemsAsync(item.Id)).ToList();
            }
            catch (InvalidOperationException exception)
            {
                _notes = [exception.Message];
            }
        }

        await Task.WhenAll(LoadOptionsAsync(), loadSeasons);
    }

    private async Task OpenSeasonAsync(JellyfinPosterItem season)
    {
        await ScrollToTopAsync();
        await OpenAsync(season, _open);
    }

    private async Task ScrollToTopAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("scrollTo", 0, 0);
        }
        catch (JSException)
        {
            // Only where the page is; nothing to undo if it can't.
        }
    }

    private async Task LoadSeasonsAsync(JellyfinPosterItem series)
    {
        _isLoadingSeasons = true;

        try
        {
            _seasons = (await Jellyfin.GetSeasonsAsync(series)).ToList();
        }
        catch (InvalidOperationException)
        {
            _seasons = [];
        }
        finally
        {
            _isLoadingSeasons = false;
        }
    }

    private async Task ShowTypeAsync(string type)
    {
        if (type == _type)
        {
            return;
        }

        _type = type;
        _message = null;
        _lastChange = null;
        _pending = null;

        await LoadOptionsAsync();
    }

    private async Task LoadOptionsAsync()
    {
        var item = _open!;
        var type = _type;

        _options = [];
        _notes = [];
        _source = string.Empty;
        _language = string.Empty;
        _shown = PageSize;
        _isLoadingOptions = true;

        StateHasChanged();

        try
        {
            var found =
                await PosterService.GetOptionsAsync(item, type);

            // Another tab or item may have been opened meanwhile.
            if (_open?.Id != item.Id || type != _type)
            {
                return;
            }

            _options = found.Options.ToList();
            _notes = found.Notes.ToList();

            // Start on English when there is any, since that is what most
            // posters are; "Any language" is one click away.
            if (_options.Any(option => LanguageKey(option.Language) == "en"))
            {
                _language = "en";
            }
        }
        catch (InvalidOperationException exception)
        {
            _notes = [exception.Message];
        }
        finally
        {
            if (_open?.Id == item.Id && type == _type)
            {
                _isLoadingOptions = false;
            }
        }
    }

    private async Task BackAsync()
    {
        _pending = null;

        if (_series is { } series)
        {
            // Back to the show, with its seasons as they are now.
            var season = _open;

            await ScrollToTopAsync();
            await OpenAsync(series);

            if (season is not null)
            {
                var index = _seasons.FindIndex(item => item.Id == season.Id);

                if (index >= 0)
                {
                    _seasons[index] = season;
                }
            }

            return;
        }

        _open = null;

        // Drop "?item=..." so a refresh shows the list.
        if (!string.IsNullOrWhiteSpace(ItemId))
        {
            Navigation.NavigateTo("posters", replace: true);
        }
    }

    private void SetSource(string? source)
    {
        _source = source ?? string.Empty;
        _shown = PageSize;
    }

    private void SetLanguage(string? language)
    {
        _language = language ?? string.Empty;
        _shown = PageSize;
    }

    // ----------------------------------------------------------------- Set

    private Task UseOptionAsync(PosterOption option)
    {
        var id = _open!.Id;
        var type = _type;

        return SetOrAskAsync(choice => PosterService.SetFromUrlAsync(id, option.Url, type, choice));
    }

    private Task UseItemAsync(JellyfinPosterItem member)
    {
        var id = _open!.Id;
        var type = _type;

        return SetOrAskAsync(async choice =>
        {
            var image =
                await Jellyfin.GetPosterAsync(member.Id, imageType: type)
                ?? throw new InvalidOperationException("That item has no picture of this kind to use.");

            return await PosterService.SetFromImageAsync(id, image.Bytes, type, choice);
        });
    }

    private async Task UseLinkAsync()
    {
        var link = _link;
        var id = _open!.Id;
        var type = _type;

        _link = string.Empty;

        await SetOrAskAsync(choice => PosterService.SetFromUrlAsync(id, link, type, choice));
    }

    private async Task UseFileAsync(InputFileChangeEventArgs args)
    {
        var id = _open!.Id;
        var type = _type;

        byte[] bytes;

        try
        {
            if (args.File.Size > Simplifiarr.Core.Services.PosterService.MaxImageBytes)
            {
                throw new InvalidOperationException("That picture is too big (over 25 MB).");
            }

            await using var stream =
                args.File.OpenReadStream(Simplifiarr.Core.Services.PosterService.MaxImageBytes);

            using var buffer = new MemoryStream();

            await stream.CopyToAsync(buffer);

            bytes = buffer.ToArray();
        }
        catch (Exception exception) when (exception is InvalidOperationException or IOException)
        {
            _message = exception.Message;
            _messageIsProblem = true;

            return;
        }

        await SetOrAskAsync(choice => PosterService.SetFromImageAsync(id, bytes, type, choice));
    }

    /// <summary>
    /// Sets the picture, or - for a backdrop when there are some already -
    /// first asks whether to change the main one or add to them.
    /// </summary>
    private async Task SetOrAskAsync(Func<BackdropChoice, Task<PictureChange>> change)
    {
        if (_type == PictureTypes.Backdrop && _open!.Backdrops > 0)
        {
            _pending = change;
            _message = null;

            return;
        }

        await SetAsync(() => change(BackdropChoice.ReplaceMain));
    }

    private async Task FinishPendingAsync(BackdropChoice choice)
    {
        if (_pending is not { } pending)
        {
            return;
        }

        _pending = null;

        await SetAsync(() => pending(choice));
    }

    private async Task UndoAsync()
    {
        if (_lastChange is not { } change || _isSetting || _open is null)
        {
            return;
        }

        _isSetting = true;

        try
        {
            await PosterService.UndoAsync(change);

            var backdrops =
                change.Added ? change.Backdrops - 1 : change.Backdrops;

            Changed(
                change.PictureType,
                has: change.PictureType == PictureTypes.Backdrop ? backdrops > 0 : change.Previous is not null,
                backdrops: change.PictureType == PictureTypes.Backdrop ? backdrops : null);

            _message = "Put it back the way it was.";
            _messageIsProblem = false;
            _lastChange = null;
        }
        catch (Exception exception) when (exception is InvalidOperationException or IOException)
        {
            _message = exception.Message;
            _messageIsProblem = true;
        }
        finally
        {
            _isSetting = false;
        }
    }

    /// <summary>
    /// Runs one picture change. True when Jellyfin took it.
    /// </summary>
    private async Task<bool> SetAsync(Func<Task<PictureChange>> change)
    {
        if (_isSetting || _open is null)
        {
            return false;
        }

        var label = PictureTypes.Find(_type).Label;

        _isSetting = true;
        _message = $"Setting the {label.ToLowerInvariant()}...";
        _messageIsProblem = false;

        StateHasChanged();

        try
        {
            var done = await change();

            _lastChange = done;

            Changed(
                done.PictureType,
                has: true,
                backdrops: done.PictureType == PictureTypes.Backdrop ? done.Backdrops : null);

            _message =
                done.Added && done.Backdrops > 1
                    ? $"Backdrop added in Jellyfin. It now has {done.Backdrops}."
                    : $"{label} changed in Jellyfin.";

            return true;
        }
        catch (Exception exception) when (exception is InvalidOperationException or IOException)
        {
            _message = exception.Message;
            _messageIsProblem = true;

            return false;
        }
        finally
        {
            _isSetting = false;
        }
    }

    /// <summary>Notes a change on the open item, and wherever else it is listed.</summary>
    private void Changed(string type, bool has, int? backdrops)
    {
        _open = _open!.With(type, has, backdrops);

        Replace(_items, _open);
        Replace(_seasons, _open);

        _version = DateTime.UtcNow.Ticks;
    }

    private static void Replace(List<JellyfinPosterItem> items, JellyfinPosterItem item)
    {
        var index = items.FindIndex(entry => entry.Id == item.Id);

        if (index >= 0)
        {
            items[index] = item;
        }
    }

    // -------------------------------------------------------------- Labels

    private string PictureUrl(string itemId, string type, int index = 0) =>
        $"poster-image/{itemId}?type={type}{(index > 0 ? $"&index={index}" : "")}&v={_version}";

    private static string KindLabel(string kind) =>
        Kinds.First(entry => entry.Type == kind).Label;

    // "en-US" and "en" are the same choice in the language picker.
    private static string LanguageKey(string language) =>
        language.Split('-', '_')[0].ToLowerInvariant();

    private static string LanguageLabel(string language)
    {
        if (language.Length == 0)
        {
            return "No text";
        }

        try
        {
            return System.Globalization.CultureInfo.GetCultureInfo(LanguageKey(language)).EnglishName;
        }
        catch (System.Globalization.CultureNotFoundException)
        {
            return language;
        }
    }
}
