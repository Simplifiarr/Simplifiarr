@page "/download-cleanup"
@rendermode InteractiveServer

@using Simplifiarr.Core.Models
@using Simplifiarr.Core.Services
@using Simplifiarr.Core.Utilities

@inject ISettingsService SettingsService
@inject IDownloadCleanupService DownloadCleanupService

<PageTitle>Downloads - Simplifiarr</PageTitle>

<PageHeader Title="Downloads"
            Subtitle="Download files that your library already has and that qBittorrent is no longer using - so the download copy is just taking up room.">
    <button type="button"
            class="btn btn-primary"
            disabled="@(IsBusy || _profiles.Count == 0)"
            @onclick="CheckAllAsync">
        <i class="bi bi-arrow-repeat" aria-hidden="true"></i>
        @(_checkingDrive is null ? "Check downloads" : $"Checking {_checkingDrive}...")
    </button>
</PageHeader>

<details class="mb-3">
    <summary>How a file gets on this list, and what deleting does</summary>

    <div class="mt-2 text-muted">
        <p class="mb-2">
            A download is only listed when the library has the same file (a
            hardlink) or a copy whose every byte matches - checked by reading
            both, not guessed from the name or size - <em>and</em> it isn't
            part of any torrent in qBittorrent, in any state. If qBittorrent
            can't be reached, nothing is checked and nothing can be deleted.
        </p>
        <p class="mb-2">
            This check is separate from the Scan at the top of the page,
            because comparing whole files takes a while on a big library.
        </p>
        <p class="mb-0">
            Deleting here is permanent - these files do not go to Quarantine,
            because Quarantine lives on one drive and moving a hardlink there
            from another drive would turn it into a full copy. Each file is
            checked again against qBittorrent and its library copy right
            before it is deleted. Deleting a hardlinked download only removes
            that extra name and frees no space; deleting an identical copy
            frees its space.
        </p>
    </div>
</details>

@if (_profiles.Count == 0)
{
    <div class="alert alert-warning">
        No drives are set up yet. <a href="settings">Add one in Settings</a>.
    </div>
}

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="alert alert-danger">
        @_errorMessage
    </div>
}

@if (!string.IsNullOrWhiteSpace(_statusMessage))
{
    <div class="alert alert-info">
        @_statusMessage
    </div>
}

@if (_skipReasons.Count > 0)
{
    <details class="mb-3">
        <summary>@_skipReasons.Count file(s) were left alone - why</summary>

        <ul class="mt-2 text-muted mb-0">
            @foreach (var reason in _skipReasons.Take(50))
            {
                <li>@reason</li>
            }
        </ul>
    </details>
}

@if (!_hasChecked)
{
    <EmptyState Icon="search" Text="Downloads haven't been checked yet. Press Check downloads." />
}
else if (_candidates.Count == 0)
{
    <EmptyState Icon="check-circle" Text="@($"No removable download copies. Last checked {LastCheckedText}.")" />
}
else
{
    @if (_isConfirming)
    {
        <BatchConfirmBanner CssClass="alert alert-danger"
                            IsBusy="_isProcessing"
                            ConfirmLabel="Delete permanently"
                            BusyLabel="Deleting..."
                            OnConfirm="ConfirmAsync"
                            OnCancel="CancelConfirm">
            <Message>
                <strong>Permanently delete @_pending.Count download file(s)?</strong>
                They skip Quarantine and can't be restored. The library copies are
                not touched. Each file is re-checked first and skipped if anything
                has changed.
            </Message>
        </BatchConfirmBanner>
    }
    else
    {
        <div class="toolbar">
            <div class="toolbar-summary">
                <strong>@_candidates.Count</strong> file(s) ·
                <strong>@SizeFormatter.FormatBytes(SpaceFreed(_candidates))</strong> freed by deleting them
                @if (_selection.Count > 0)
                {
                    <text> · @_selection.Count selected</text>
                }
                <div class="cell-note">Last checked @LastCheckedText</div>
            </div>

            <div class="toolbar-actions">
                <button type="button"
                        class="btn btn-secondary btn-sm"
                        disabled="@IsBusy"
                        @onclick="() => _selection.ToggleSelectAll(_candidates)">
                    @(_selection.Count == _candidates.Count ? "Select none" : "Select all")
                </button>

                <button type="button"
                        class="btn btn-danger btn-sm"
                        disabled="@(IsBusy || _selection.Count == 0)"
                        @onclick="RequestConfirm">
                    Delete selected (@_selection.Count)
                </button>
            </div>
        </div>
    }

    <div class="table-scroll">
        <table class="table">
            <thead>
                <tr>
                    <th class="col-check">Select</th>
                    <th>Download copy</th>
                    <th>Proof</th>
                    <th>Drive</th>
                    <th class="col-num">Size</th>
                    <th>Details</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var candidate in _candidates.Take(_shown))
                {
                    <tr @key="candidate.DownloadPath">
                        <SelectableCheckboxCell Checked="_selection.IsSelected(candidate)"
                                                Disabled="IsBusy"
                                                OnChanged="selected => _selection.SetSelected(candidate, selected)" />

                        <td>
                            <div class="file-name">@Path.GetFileName(candidate.DownloadPath)</div>
                            <div class="cell-note">@Path.GetDirectoryName(candidate.DownloadPath)</div>
                        </td>

                        <td>
                            @if (candidate.MatchKind == DownloadMatchKind.Hardlink)
                            {
                                <div>Same file as the library (hardlink)</div>
                                <div class="cell-note">Deleting frees no space</div>
                            }
                            else
                            {
                                <div>Identical copy</div>
                                <div class="cell-note">Every byte compared · frees @SizeFormatter.FormatBytes(candidate.SizeBytes)</div>
                            }
                        </td>

                        <td>@candidate.DriveProfileName</td>
                        <td class="col-num">@SizeFormatter.FormatBytes(candidate.SizeBytes)</td>

                        <td>
                            <details>
                                <summary>Library copy</summary>

                                <div class="detail-label">Kept in the library at</div>
                                <code>@candidate.LibraryPath</code>
                            </details>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (_candidates.Count > _shown)
    {
        <button type="button"
                class="btn btn-secondary mt-3"
                @onclick="() => _shown += PageSize">
            Show @Math.Min(PageSize, _candidates.Count - _shown) more (@(_candidates.Count - _shown) left)
        </button>
    }
}

@code
{
    private const int PageSize = 100;

    private List<DriveProfile> _profiles = [];

    private List<DownloadCleanupCandidate> _candidates = [];

    private List<DownloadCleanupCandidate> _pending = [];

    private readonly CandidateSelection<DownloadCleanupCandidate> _selection =
        new(candidate => candidate.DownloadPath);

    private int _shown = PageSize;

    private string? _checkingDrive;
    private DateTime? _lastCheckedUtc;
    private bool _hasChecked;

    private string _statusMessage = string.Empty;
    private string _errorMessage = string.Empty;

    private List<string> _skipReasons = [];

    private bool _isConfirming;
    private bool _isProcessing;

    private bool IsBusy =>
        _isProcessing || _checkingDrive is not null;

    private string LastCheckedText =>
        _lastCheckedUtc is null
            ? "never"
            : _lastCheckedUtc.Value.ToLocalTime().ToString("g");

    protected override async Task OnInitializedAsync()
    {
        _profiles =
            await SettingsService.GetEnabledDriveProfilesAsync();

        LoadCandidates();
    }

    private void LoadCandidates()
    {
        _candidates =
            _profiles
                .SelectMany(profile =>
                    DownloadCleanupService.GetCandidates(profile.Name))
                .OrderByDescending(candidate => candidate.SizeBytes)
                .ThenBy(candidate => candidate.DownloadPath, StringComparer.OrdinalIgnoreCase)
                .ToList();

        // The oldest check across the drives: the list is only as fresh
        // as its least recently checked drive.
        var checks =
            _profiles
                .Select(profile => DownloadCleanupService.GetLastScanUtc(profile.Name))
                .Where(checkedUtc => checkedUtc.HasValue)
                .Select(checkedUtc => checkedUtc!.Value)
                .ToList();

        _hasChecked = checks.Count > 0;
        _lastCheckedUtc = _hasChecked ? checks.Min() : null;
    }

    private static long SpaceFreed(
        IEnumerable<DownloadCleanupCandidate> candidates) =>
        candidates
            .Where(candidate => candidate.MatchKind == DownloadMatchKind.IdenticalCopy)
            .Sum(candidate => candidate.SizeBytes);

    private async Task CheckAllAsync()
    {
        if (IsBusy)
        {
            return;
        }

        _errorMessage = string.Empty;
        _statusMessage = string.Empty;
        _skipReasons = [];

        CancelConfirm();

        var found = 0;
        var filesChecked = 0;
        var stillInUse = 0;

        try
        {
            foreach (var profile in _profiles)
            {
                _checkingDrive = profile.Name;

                await InvokeAsync(StateHasChanged);

                var result =
                    await DownloadCleanupService.ScanAsync(profile.Name);

                if (result.Error is not null)
                {
                    // Almost always "qBittorrent can't be reached" - which
                    // is the same answer for every drive, so stop here.
                    _errorMessage = result.Error;

                    break;
                }

                found += result.Candidates.Count;
                filesChecked += result.DownloadFilesChecked;
                stillInUse += result.SkippedStillInQbittorrent;
            }

            _selection.Clear();

            LoadCandidates();

            if (string.IsNullOrEmpty(_errorMessage))
            {
                _statusMessage =
                    $"Checked {filesChecked:N0} download file(s). {found:N0} can be removed.";

                if (stillInUse > 0)
                {
                    _statusMessage +=
                        $" {stillInUse:N0} more are in your library too, but qBittorrent still has them, so they were left alone.";
                }
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"The check stopped: {ex.Message}";
        }
        finally
        {
            _checkingDrive = null;
        }
    }

    private void RequestConfirm()
    {
        if (IsBusy || _selection.Count == 0)
        {
            return;
        }

        _pending =
            _candidates
                .Where(_selection.IsSelected)
                .ToList();

        _isConfirming = true;
    }

    private void CancelConfirm()
    {
        _isConfirming = false;
        _pending = [];
    }

    private async Task ConfirmAsync()
    {
        if (IsBusy || _pending.Count == 0)
        {
            return;
        }

        _isProcessing = true;
        _errorMessage = string.Empty;

        try
        {
            var result =
                await DownloadCleanupService.RemoveAsync(_pending.ToList());

            if (result.Error is not null)
            {
                _errorMessage = result.Error;

                return;
            }

            _skipReasons = result.SkipReasons;

            _statusMessage =
                result.Skipped == 0
                    ? $"Deleted {result.Removed} download file(s)."
                    : $"Deleted {result.Removed} download file(s); {result.Skipped} were left alone because something had changed.";

            _selection.Clear();

            LoadCandidates();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Deleting stopped: {ex.Message}";
        }
        finally
        {
            CancelConfirm();

            _isProcessing = false;
        }
    }
}
