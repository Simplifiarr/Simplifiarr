@page "/potential-waste"
@rendermode InteractiveServer
@implements IDisposable

@using Simplifiarr.Core.Models
@using Simplifiarr.Core.Services
@using Simplifiarr.Core.Utilities

@inject ISettingsService SettingsService
@inject IWasteCandidateCacheService WasteCandidateCache
@inject IHardlinkRemediationService HardlinkRemediationService
@inject IHistoryService HistoryService
@inject IScanCoordinator Scans

<PageTitle>Potential Waste - Simplifiarr</PageTitle>

<PageHeader Title="Potential Waste"
            Subtitle="Library files that are full copies of a download. Converting one replaces the copy with a hardlink to the download; the old copy goes to Quarantine first, so nothing is deleted until you say so." />

@if (_profiles.Count == 0)
{
    <div class="alert alert-warning">
        No drives are set up yet. <a href="settings">Add one in Settings</a>.
    </div>
}
else if (_isScanning)
{
    <div class="alert alert-info">
        A scan is running. This page will update when it finishes.
    </div>
}

<div class="app-tabs" role="tablist" aria-label="Media type">
    @foreach (var kind in Kinds)
    {
        <button type="button"
                role="tab"
                aria-selected="@(_activeKind == kind)"
                class="app-tab @(_activeKind == kind ? "active" : null)"
                @onclick="() => ShowKind(kind)">
            @KindLabel(kind) <span class="app-tab-count">@_candidates.Count(candidate => candidate.Kind == kind)</span>
        </button>
    }
</div>

@if (!string.IsNullOrWhiteSpace(_statusMessage))
{
    <div class="alert alert-info">
        @_statusMessage
    </div>
}

@if (!_hasScanned)
{
    <EmptyState Icon="search" Text="No scan has looked for full copies yet. Press Scan at the top of the page." />
}
else if (Visible.Count == 0)
{
    <EmptyState Icon="check-circle" Text="@($"No {KindLabel(_activeKind).ToLowerInvariant()} library files are full copies of a download.")" />
}
else
{
    @if (_isBatchConfirming)
    {
        <BatchConfirmBanner IsBusy="_isConverting"
                            ConfirmLabel="Confirm Convert"
                            BusyLabel="Converting..."
                            OnConfirm="ConfirmBatchAsync"
                            OnCancel="CancelBatchConfirm">
            <Message>
                <strong>Convert @_pendingBatch.Count file(s) and free @SizeFormatter.FormatBytes(_pendingBatch.Sum(candidate => candidate.SizeBytes))?</strong>
                Each library copy is moved to Quarantine, then a hardlink to the download takes its place.
            </Message>
        </BatchConfirmBanner>
    }
    else
    {
        <div class="toolbar">
            <div class="toolbar-summary">
                <strong>@Visible.Count</strong> file(s) ·
                <strong>@SizeFormatter.FormatBytes(Visible.Sum(candidate => candidate.SizeBytes))</strong> reclaimable
                @if (_selection.Count > 0)
                {
                    <text> · @_selection.Count selected</text>
                }
            </div>

            <div class="toolbar-actions">
                <button type="button"
                        class="btn btn-secondary btn-sm"
                        disabled="@(IsBusy || Convertible(Visible).Count == 0)"
                        @onclick="() => RequestBatchConfirm(Convertible(Visible))">
                    Convert all
                </button>

                <button type="button"
                        class="btn btn-primary btn-sm"
                        disabled="@(IsBusy || _selection.Count == 0)"
                        @onclick="() => RequestBatchConfirm(Convertible(Visible.Where(_selection.IsSelected)))">
                    Convert selected (@_selection.Count)
                </button>
            </div>
        </div>
    }

    <div class="table-scroll">
        <table class="table">
            <thead>
                <tr>
                    <th class="col-check">Select</th>
                    <th>File</th>
                    <th class="col-num">Size</th>
                    <th>Status</th>
                    <th>Actions</th>
                    <th>Details</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var candidate in Visible)
                {
                    var isConverting =
                        string.Equals(_convertingLibraryPath, candidate.LibraryPath, StringComparison.OrdinalIgnoreCase);

                    var isConfirming =
                        string.Equals(_confirmLibraryPath, candidate.LibraryPath, StringComparison.OrdinalIgnoreCase);

                    var canConvert =
                        candidate.CanConvert && candidate.Plan is not null;

                    <tr @key="candidate.LibraryPath">
                        <SelectableCheckboxCell Checked="_selection.IsSelected(candidate)"
                                                Disabled="IsBusy || !canConvert"
                                                OnChanged="selected => _selection.SetSelected(candidate, selected)" />

                        <td>
                            <div class="file-name">@candidate.LibraryFileName</div>

                            @if (!string.IsNullOrWhiteSpace(candidate.DriveProfileName))
                            {
                                <div class="cell-note">Drive: @candidate.DriveProfileName</div>
                            }
                        </td>

                        <td class="col-num">@SizeFormatter.FormatBytes(candidate.SizeBytes)</td>

                        <td>
                            @if (isConverting)
                            {
                                <span class="status-muted">Converting...</span>
                            }
                            else if (canConvert)
                            {
                                <span class="status-ok">Ready</span>
                            }
                            else
                            {
                                <span class="status-warn">Can't convert</span>
                                <div class="cell-note">@candidate.Reason</div>
                            }
                        </td>

                        <td>
                            <div class="cell-actions">
                                @if (isConfirming)
                                {
                                    <button type="button"
                                            class="btn btn-primary btn-sm"
                                            disabled="@(IsBusy || !canConvert)"
                                            @onclick="() => ConvertAsync(candidate)">
                                        <i class="bi bi-check-lg" aria-hidden="true"></i>
                                        Confirm
                                    </button>

                                    <button type="button"
                                            class="btn btn-secondary btn-sm"
                                            disabled="@_isConverting"
                                            @onclick="() => _confirmLibraryPath = null">
                                        Cancel
                                    </button>
                                }
                                else
                                {
                                    <button type="button"
                                            class="btn btn-secondary btn-sm"
                                            disabled="@(IsBusy || !canConvert)"
                                            @onclick="() => _confirmLibraryPath = candidate.LibraryPath">
                                        Convert
                                    </button>
                                }
                            </div>
                        </td>

                        <td>
                            <details>
                                <summary>View paths</summary>

                                <div class="detail-label">Library copy (will be replaced)</div>
                                <code>@candidate.LibraryPath</code>

                                <div class="detail-label">Download (kept, becomes the one file)</div>
                                <code>@candidate.DownloadPath</code>

                                <div class="detail-label">Why it's listed</div>
                                <div>@candidate.Reason</div>
                            </details>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code
{
    private static readonly MediaKind[] Kinds = [MediaKind.Movies, MediaKind.Tv];

    private List<DriveProfile> _profiles = [];

    private List<WasteCandidate> _candidates = [];

    private MediaKind _activeKind = MediaKind.Movies;

    private bool _isScanning;
    private bool _isConverting;
    private bool _hasScanned;

    private string? _convertingLibraryPath;
    private string? _confirmLibraryPath;

    private bool _isBatchConfirming;

    private List<WasteCandidate> _pendingBatch = [];

    private readonly CandidateSelection<WasteCandidate> _selection =
        new(candidate => candidate.LibraryPath);

    private string _statusMessage =
        string.Empty;

    // Nothing here may change the list while a scan is rebuilding it.
    private bool IsBusy =>
        _isConverting || _isScanning;

    private List<WasteCandidate> Visible =>
        _candidates
            .Where(candidate => candidate.Kind == _activeKind)
            .ToList();

    private static List<WasteCandidate> Convertible(
        IEnumerable<WasteCandidate> candidates) =>
        candidates
            .Where(candidate => candidate.CanConvert && candidate.Plan is not null)
            .ToList();

    private static string KindLabel(MediaKind kind) =>
        kind == MediaKind.Tv ? "TV" : "Movies";

    protected override async Task OnInitializedAsync()
    {
        _isScanning = Scans.Progress.IsRunning;

        Scans.Changed += OnScanChanged;

        _profiles =
            (await SettingsService.GetEnabledDriveProfilesAsync())
                .OrderBy(profile => profile.Name)
                .ToList();

        LoadCandidates();

        // Open on whichever tab has something in it.
        if (!_candidates.Any(candidate => candidate.Kind == MediaKind.Movies) &&
            _candidates.Any(candidate => candidate.Kind == MediaKind.Tv))
        {
            _activeKind = MediaKind.Tv;
        }
    }

    // Scanning is done by the app-wide Scan (top of every page). This page
    // only needs to know when one is running, and to reload when it ends.
    private void OnScanChanged()
    {
        _ = InvokeAsync(() =>
        {
            var isRunning = Scans.Progress.IsRunning;

            if (isRunning == _isScanning)
            {
                return;
            }

            var justFinished = _isScanning && !isRunning;

            _isScanning = isRunning;

            if (justFinished)
            {
                // The scan replaced the list, so anything ticked or
                // half-confirmed may no longer exist.
                ClearPending();
                LoadCandidates();

                _statusMessage = string.Empty;
            }

            StateHasChanged();
        });
    }

    private void ShowKind(MediaKind kind)
    {
        if (_isConverting || kind == _activeKind)
        {
            return;
        }

        _activeKind = kind;

        // Don't carry ticks over to a tab where they can't be seen.
        ClearPending();
    }

    private void ClearPending()
    {
        _selection.Clear();
        _confirmLibraryPath = null;
        _isBatchConfirming = false;
        _pendingBatch = [];
    }

    private void LoadCandidates()
    {
        _candidates =
            _profiles
                .SelectMany(profile =>
                    WasteCandidateCache.GetCandidates(profile.Name))
                .GroupBy(
                    candidate => candidate.LibraryPath,
                    StringComparer.OrdinalIgnoreCase)
                .Select(group => group.First())
                .OrderByDescending(candidate => candidate.SizeBytes)
                .ToList();

        _hasScanned =
            _profiles.Any(profile =>
                WasteCandidateCache.GetLastScanUtc(profile.Name).HasValue);
    }

    private void RequestBatchConfirm(
        List<WasteCandidate> candidates)
    {
        if (IsBusy || candidates.Count == 0)
        {
            return;
        }

        _confirmLibraryPath = null;
        _pendingBatch = candidates;
        _isBatchConfirming = true;
    }

    private void CancelBatchConfirm()
    {
        if (_isConverting)
        {
            return;
        }

        _isBatchConfirming = false;
        _pendingBatch = [];
    }

    private async Task ConfirmBatchAsync()
    {
        if (IsBusy || _pendingBatch.Count == 0)
        {
            return;
        }

        var batch = _pendingBatch.ToList();

        _isConverting = true;

        var converted = 0;
        var failed = 0;
        var convertedBytes = 0L;

        try
        {
            foreach (var candidate in batch)
            {
                _convertingLibraryPath = candidate.LibraryPath;

                _statusMessage =
                    $"Converting {candidate.LibraryFileName}...";

                await InvokeAsync(StateHasChanged);

                if (await HardlinkRemediationService.ExecuteAsync(candidate.Plan!))
                {
                    converted++;
                    convertedBytes += candidate.SizeBytes;

                    _selection.Remove(candidate);

                    WasteCandidateCache.RemoveCandidate(candidate.LibraryPath);
                }
                else
                {
                    failed++;
                }
            }

            _statusMessage =
                failed == 0
                    ? $"Converted {converted} file(s). The old copies are in Quarantine - delete them there to free {SizeFormatter.FormatBytes(convertedBytes)}."
                    : $"Converted {converted} file(s); {failed} failed and were left as they were. See History for why.";

            await HistoryService.AddRecordAsync(
                new HistoryRecord
                {
                    ActionType = HistoryActionType.BatchCompleted,
                    FileName = "Batch conversion",
                    SizeBytes = convertedBytes,
                    Success = failed == 0,
                    Message = $"Batch complete. Converted: {converted}. Failed: {failed}."
                });

            LoadCandidates();
        }
        catch (Exception ex)
        {
            _statusMessage =
                $"Batch conversion stopped: {ex.Message}";
        }
        finally
        {
            _isConverting = false;
            _convertingLibraryPath = null;
            _isBatchConfirming = false;
            _pendingBatch = [];
        }
    }

    private async Task ConvertAsync(
        WasteCandidate candidate)
    {
        if (IsBusy || candidate.Plan is null)
        {
            return;
        }

        _confirmLibraryPath = null;
        _isConverting = true;
        _convertingLibraryPath = candidate.LibraryPath;

        _statusMessage =
            $"Converting {candidate.LibraryFileName}...";

        await InvokeAsync(StateHasChanged);

        try
        {
            if (await HardlinkRemediationService.ExecuteAsync(candidate.Plan))
            {
                WasteCandidateCache.RemoveCandidate(candidate.LibraryPath);

                _selection.Remove(candidate);

                LoadCandidates();

                _statusMessage =
                    $"Converted {candidate.LibraryFileName}. The old copy is in Quarantine - delete it there to free the space.";
            }
            else
            {
                _statusMessage =
                    $"Couldn't convert {candidate.LibraryFileName}; it was left as it was. See History for why.";
            }
        }
        catch (Exception ex)
        {
            _statusMessage =
                $"Couldn't convert {candidate.LibraryFileName}: {ex.Message}";
        }
        finally
        {
            _isConverting = false;
            _convertingLibraryPath = null;
        }
    }

    public void Dispose() =>
        Scans.Changed -= OnScanChanged;
}
