@page "/"
@rendermode InteractiveServer
@implements IDisposable

@using Simplifiarr.Core.Models
@using Simplifiarr.Core.Services
@using Simplifiarr.Core.Utilities

@inject IDashboardSummaryService DashboardSummaryService
@inject IScanCoordinator Scans

<PageTitle>Simplifiarr</PageTitle>

<PageHeader Title="Home" Subtitle="@HeaderLine" />

@if (_dashboard is null)
{
    <div class="stat-grid" aria-hidden="true">
        @for (var i = 0; i < 4; i++)
        {
            <div class="stat-card">
                <div class="stat-label">&nbsp;</div>
                <div class="stat-value">&nbsp;</div>
            </div>
        }
    </div>
}
else
{
    <div class="stat-grid">
        <StatCard Label="Space saved"
                  Value="@_dashboard.StorageSavedFormatted"
                  Note="by replacing copies with hardlinks"
                  Href="history"
                  Accent="true" />

        <StatCard Label="Reclaimable now"
                  Value="@_dashboard.PossibleDuplicateCopySizeFormatted"
                  Note="@Count(_dashboard.PossibleDuplicateCopyCount, "full copy", "full copies")"
                  Href="potential-waste" />

        <StatCard Label="Healthy hardlinks"
                  Value="@_dashboard.HealthyHardlinkCount.ToString("N0")"
                  Note="library files sharing space with a download"
                  Href="potential-waste" />

        <StatCard Label="In quarantine"
                  Value="@Count(_dashboard.QuarantinedFileCount, "file", "files")"
                  Note="@($"{_dashboard.QuarantinedSizeFormatted} held until you delete or restore")"
                  Href="quarantine" />
    </div>

    <section class="section">
        <h2 class="section-title">Next up</h2>

        <div class="panel">
            @if (_dashboard.EnabledDriveProfileCount == 0)
            {
                <div class="action-row">
                    <div>
                        <div class="action-row-title">Tell Simplifiarr where your files are</div>
                        <div class="action-row-detail">Add a drive with its download and library folders to get started.</div>
                    </div>
                    <a class="btn btn-primary" href="settings">Open Settings</a>
                </div>
            }
            else if (!HasEverScanned)
            {
                <div class="action-row">
                    <div>
                        <div class="action-row-title">Run your first scan</div>
                        <div class="action-row-detail">
                            Press Scan at the top of the page. One scan covers every drive and every page.
                        </div>
                    </div>
                </div>
            }
            else
            {
                @foreach (var drive in _dashboard.Drives.Where(drive => drive.SetupProblems.Count > 0))
                {
                    <div class="action-row action-row-warn">
                        <div>
                            <div class="action-row-title">@drive.Name: folders overlap, so its results can't be trusted</div>

                            @foreach (var problem in drive.SetupProblems)
                            {
                                <div class="action-row-detail">@problem</div>
                            }
                        </div>
                        <a class="btn btn-secondary" href="settings">Fix in Settings</a>
                    </div>
                }

                @foreach (var problem in ScanProblems)
                {
                    <div class="action-row action-row-warn">
                        <div>
                            <div class="action-row-title">Part of the last scan failed</div>
                            <div class="action-row-detail">@problem</div>
                        </div>
                    </div>
                }

                @if (_dashboard.PromotionOpportunityCount > 0)
                {
                    <div class="action-row">
                        <div>
                            <div class="action-row-title">
                                @Count(_dashboard.PromotionOpportunityCount, "download is", "downloads are") ready to link into your libraries
                            </div>
                            <div class="action-row-detail">Nothing is copied or moved - the library gets a second name for the same file.</div>
                        </div>
                        <a class="btn btn-primary" href="hardlinks">Review</a>
                    </div>
                }

                @if (_dashboard.PossibleDuplicateCopyCount > 0)
                {
                    <div class="action-row">
                        <div>
                            <div class="action-row-title">
                                @Count(_dashboard.PossibleDuplicateCopyCount, "library file is a full copy", "library files are full copies") of a download
                            </div>
                            <div class="action-row-detail">
                                Converting to hardlinks frees @_dashboard.PossibleDuplicateCopySizeFormatted.
                            </div>
                        </div>
                        <a class="btn btn-secondary" href="potential-waste">Review</a>
                    </div>
                }

                @if (_dashboard.JunkFileCount > 0)
                {
                    <div class="action-row">
                        <div>
                            <div class="action-row-title">
                                @Count(_dashboard.JunkFileCount, "leftover file", "leftover files") found in your libraries
                            </div>
                            <div class="action-row-detail">Samples, checksums and other release leftovers.</div>
                        </div>
                        <a class="btn btn-secondary" href="junk-cleanup">Review</a>
                    </div>
                }

                @if (_dashboard.PlaybackErrorCount > 0)
                {
                    <div class="action-row">
                        <div>
                            <div class="action-row-title">
                                @Count(_dashboard.PlaybackErrorCount, "playback problem", "playback problems") found in your libraries
                            </div>
                            <div class="action-row-detail">Files your media server may not be able to open: blocked, unreadable, packed or badly named.</div>
                        </div>
                        <a class="btn btn-secondary" href="playback-errors">Review</a>
                    </div>
                }

                @if (NothingToDo)
                {
                    <div class="action-row">
                        <div>
                            <div class="action-row-title status-ok">
                                <i class="bi bi-check-circle" aria-hidden="true"></i> Everything is in order
                            </div>
                            <div class="action-row-detail">The last scan found nothing that needs you.</div>
                        </div>
                    </div>
                }
            }
        </div>
    </section>

    @if (_dashboard.Drives.Count > 0)
    {
        <section class="section">
            <h2 class="section-title">Drives</h2>

            <div class="table-scroll">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Drive</th>
                            <th>Status</th>
                            <th>Found</th>
                            <th>Healthy hardlinks</th>
                            <th>Last scan</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var drive in _dashboard.Drives)
                        {
                            <tr @key="drive.Name">
                                <td><strong>@drive.Name</strong></td>
                                <td>
                                    @if (drive.SetupProblems.Count > 0)
                                    {
                                        <span class="status-warn">Check folders</span>
                                    }
                                    else if (drive.LastScanUtc is null)
                                    {
                                        <span class="status-muted">Not scanned yet</span>
                                    }
                                    else if (drive.ItemsToReview > 0)
                                    {
                                        <span class="status-warn">@drive.ItemsToReview to review</span>
                                    }
                                    else
                                    {
                                        <span class="status-ok">All clear</span>
                                    }
                                </td>
                                <td class="status-muted">@DescribeFound(drive)</td>
                                <td>@drive.HealthyHardlinkCount.ToString("N0")</td>
                                <td class="status-muted">@HowLongAgo(drive.LastScanUtc)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
}

@code
{
    private DashboardSummary? _dashboard;
    private bool _scanWasRunning;

    private bool HasEverScanned =>
        _dashboard is not null &&
        _dashboard.Drives.Any(drive => drive.LastScanUtc.HasValue);

    private IReadOnlyList<string> ScanProblems =>
        // Folder-setup problems get their own, clearer rows above.
        (Scans.LastSummary?.Problems ?? [])
            .Where(problem => !problem.Contains(" setup: ", StringComparison.Ordinal))
            .ToList();

    private bool NothingToDo =>
        _dashboard is not null &&
        _dashboard.PromotionOpportunityCount == 0 &&
        _dashboard.PossibleDuplicateCopyCount == 0 &&
        _dashboard.JunkFileCount == 0 &&
        _dashboard.PlaybackErrorCount == 0 &&
        ScanProblems.Count == 0 &&
        _dashboard.Drives.All(drive => drive.SetupProblems.Count == 0);

    private string HeaderLine
    {
        get
        {
            if (_dashboard is null)
            {
                return "Loading...";
            }

            var drives = Count(_dashboard.EnabledDriveProfileCount, "drive", "drives");
            var finished = Scans.LastSummary?.FinishedUtc;

            return finished is null
                ? $"{drives} · not scanned yet"
                : $"{drives} · last scan finished {HowLongAgo(finished)}";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _scanWasRunning = Scans.Progress.IsRunning;

        Scans.Changed += OnScanChanged;

        _dashboard =
            await DashboardSummaryService.GetDashboardSummaryAsync();
    }

    // When a scan finishes, show its results without making the user
    // reload the page.
    private void OnScanChanged()
    {
        var isRunning = Scans.Progress.IsRunning;
        var justFinished = _scanWasRunning && !isRunning;

        _scanWasRunning = isRunning;

        if (!justFinished)
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            _dashboard =
                await DashboardSummaryService.GetDashboardSummaryAsync();

            StateHasChanged();
        });
    }

    private static string Count(int number, string one, string many) =>
        $"{number:N0} {(number == 1 ? one : many)}";

    private static string DescribeFound(DriveSummary drive)
    {
        var parts = new List<string>();

        if (drive.ToLinkCount > 0)
        {
            parts.Add($"{drive.ToLinkCount:N0} to link");
        }

        if (drive.FullCopyCount > 0)
        {
            parts.Add($"{Count(drive.FullCopyCount, "full copy", "full copies")} ({SizeFormatter.FormatBytes(drive.FullCopyBytes)})");
        }

        if (drive.LeftoverFileCount > 0)
        {
            parts.Add(Count(drive.LeftoverFileCount, "leftover", "leftovers"));
        }

        if (drive.PlaybackErrorCount > 0)
        {
            parts.Add($"{drive.PlaybackErrorCount:N0} playback problem(s)");
        }

        return parts.Count == 0
            ? "Nothing to do"
            : string.Join(" · ", parts);
    }

    private static string HowLongAgo(DateTime? utc)
    {
        if (utc is null)
        {
            return "Never";
        }

        var age = DateTime.UtcNow - utc.Value;

        return age.TotalMinutes < 1 ? "just now"
            : age.TotalMinutes < 2 ? "a minute ago"
            : age.TotalHours < 1 ? $"{(int)age.TotalMinutes} minutes ago"
            : age.TotalHours < 2 ? "an hour ago"
            : age.TotalDays < 1 ? $"{(int)age.TotalHours} hours ago"
            : age.TotalDays < 2 ? "yesterday"
            : $"{(int)age.TotalDays} days ago";
    }

    public void Dispose() =>
        Scans.Changed -= OnScanChanged;
}
