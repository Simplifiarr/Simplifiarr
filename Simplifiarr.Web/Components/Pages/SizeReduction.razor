@page "/size-reduction"
@rendermode InteractiveServer
@implements IDisposable

@using Simplifiarr.Core.Models
@using Simplifiarr.Core.Services
@using Simplifiarr.Core.Utilities

@inject ISettingsService SettingsService
@inject ISizeReductionCandidateService Search
@inject ISizeReductionDownloadService Downloads
@inject ITorrentClient Client

<PageTitle>Size Reduction - Simplifiarr</PageTitle>

<PageHeader Title="Size Reduction"
            Subtitle="Looks on your indexers, through Prowlarr, for smaller releases of films and episodes you already have. Nothing is downloaded or replaced unless you press Download.">
    @if (Search.IsSearching)
    {
        <button type="button" class="btn btn-secondary" @onclick="Search.Stop">
            <i class="bi bi-stop-fill" aria-hidden="true"></i>
            Stop
        </button>
    }
    else if (_profiles.Count > 1 && _prowlarrIsSetUp)
    {
        <button type="button" class="btn btn-primary" @onclick="() => Start(null)">
            <i class="bi bi-search" aria-hidden="true"></i>
            Search all drives
        </button>
    }
</PageHeader>

@if (_profiles.Count == 0)
{
    <div class="alert alert-warning">
        No drives are set up yet. <a href="settings">Add one in Settings</a>.
    </div>
}
else if (!_prowlarrIsSetUp)
{
    <div class="alert alert-warning">
        Prowlarr isn't set up yet, so there is nowhere to search.
        <a href="settings">Add its address and API key in Settings</a>, under Connections.
    </div>
}

@if (Search.Progress is { } progress)
{
    <div class="alert alert-info" role="status">
        <strong>Searching @progress.DriveName</strong> -
        @progress.Done of @progress.Total file(s) done.
        <div class="cell-note">Now: @progress.CurrentTitle. You can leave this page; the search carries on.</div>
    </div>
}
else if (!string.IsNullOrWhiteSpace(Search.LastMessage))
{
    <div class="alert @(Search.LastSucceeded ? "alert-info" : "alert-warning")" role="status">
        @Search.LastMessage
    </div>
}

@if (_profiles.Count > 0)
{
    <div class="panel section">
        @foreach (var profile in _profiles)
        {
            var found = _groups.Count(group => group.DriveName == profile.Name);

            <div class="action-row">
                <div>
                    <div class="action-row-title">@profile.Name</div>
                    <div class="action-row-detail">
                        @if (Search.GetLastSearchUtc(profile.Name) is { } searchedUtc)
                        {
                            <text>Last searched @FormatTime(searchedUtc) · @found file(s) with a smaller release</text>
                        }
                        else
                        {
                            <text>Not searched yet</text>
                        }
                    </div>
                </div>

                <button type="button"
                        class="btn btn-secondary btn-sm"
                        disabled="@(Search.IsSearching || !_prowlarrIsSetUp)"
                        @onclick="() => Start(profile.Name)">
                    Search
                </button>
            </div>
        }
    </div>
}

@if (_downloadMessage is not null)
{
    <div class="alert @(_downloadOk ? "alert-info" : "alert-warning")">@_downloadMessage</div>
}

@if (Downloads.Downloads.Count > 0)
{
    <div class="panel mb-3">
        <div class="toolbar mb-2">
            <div class="toolbar-summary">
                <strong>Downloads</strong> ·
                @Downloads.Downloads.Count(download => download.Status == SizeReductionDownloadStatus.Downloading) downloading ·
                @Downloads.Downloads.Count(download => download.Status == SizeReductionDownloadStatus.ReadyToSwap) ready to swap
            </div>
            <div class="toolbar-actions">
                <button type="button" class="btn btn-secondary btn-sm" disabled="@_checking" @onclick="CheckDownloadsAsync">
                    @(_checking ? "Checking..." : "Check progress")
                </button>
            </div>
        </div>

        <div class="table-scroll">
            <table class="table mb-0">
                <thead>
                    <tr>
                        <th>Release</th>
                        <th>Replaces</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var download in Downloads.Downloads.Take(20))
                    {
                        <tr @key="download.Id">
                            <td>
                                <div class="file-name">@download.ReleaseTitle</div>
                                <div class="cell-note">@SizeFormatter.FormatBytes(download.ReleaseBytes) · @download.DriveName</div>
                            </td>
                            <td>
                                <code>@System.IO.Path.GetFileName(download.LibraryFilePath)</code>
                                <div class="cell-note">@SizeFormatter.FormatBytes(download.LibraryFileBytes)</div>
                            </td>
                            <td>
                                @switch (download.Status)
                                {
                                    case SizeReductionDownloadStatus.Downloading:
                                        <span>Downloading @download.Progress.ToString("P0")</span>
                                        @if (download.Live is { } live)
                                        {
                                            <div class="cell-note">
                                                @(live.DownloadSpeed > 0 ? $"{SizeFormatter.FormatBytes(live.DownloadSpeed)}/s" : "Not downloading right now")
                                                @if (live.TimeLeft is { } left)
                                                {
                                                    <text> · @(left.TotalDays >= 2 ? $"about {(int)Math.Round(left.TotalDays)} days" : left.TotalHours >= 1 ? $"{(int)left.TotalHours} h {left.Minutes} min" : $"{Math.Max(1, left.Minutes)} min") left</text>
                                                }
                                            </div>
                                            <div class="cell-note">
                                                Seeds @live.SeedsConnected (@live.SeedsInSwarm in swarm) ·
                                                leechers @live.LeechersConnected (@live.LeechersInSwarm in swarm)
                                            </div>
                                        }
                                        break;
                                    case SizeReductionDownloadStatus.ReadyToSwap:
                                        <span class="status-ok">Ready to swap</span>
                                        break;
                                    case SizeReductionDownloadStatus.Swapped:
                                        <span class="status-ok">Swapped</span>
                                        break;
                                    case SizeReductionDownloadStatus.Cancelled:
                                        <span class="status-muted">Cancelled</span>
                                        break;
                                    default:
                                        <span class="status-warn">Stopped</span>
                                        break;
                                }
                                <div class="cell-note">@download.Message</div>
                            </td>
                            <td>
                                <div class="d-flex gap-2 flex-wrap">
                                    @if (download.Status == SizeReductionDownloadStatus.ReadyToSwap)
                                    {
                                        <button type="button" class="btn btn-primary btn-sm" disabled="@_checking" @onclick="() => SwapAsync(download)">Swap now</button>
                                    }
                                    @if (download.Status is SizeReductionDownloadStatus.Downloading or SizeReductionDownloadStatus.ReadyToSwap)
                                    {
                                        @if (_confirmCancel == download.Id)
                                        {
                                            <button type="button" class="btn btn-danger btn-sm" disabled="@_checking" @onclick="() => CancelAsync(download)">Cancel it</button>
                                            <button type="button" class="btn btn-secondary btn-sm" @onclick="() => _confirmCancel = null">Keep</button>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-outline-danger btn-sm" @onclick="() => _confirmCancel = download.Id">Cancel...</button>
                                        }
                                    }
                                    @if (download.Status is SizeReductionDownloadStatus.Swapped or SizeReductionDownloadStatus.Failed or SizeReductionDownloadStatus.Cancelled)
                                    {
                                        <button type="button" class="btn btn-link btn-sm py-0" @onclick="() => Downloads.Forget(download.Id)">Clear</button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="cell-note mt-2">
            Downloads are tagged <code>@SizeReductionDownloadService.Tag</code> in @Client.Name. Swapping links the new file into
            your library (it keeps seeding), sends the old one to the Recycle Bin and asks Radarr or Sonarr to rescan.
            The old file's torrent, if any, is left alone. Progress is checked on every Scan.
        </div>
    </div>
}

@if (_unscannedCount > 0)
{
    <p class="cell-note">
        @_unscannedCount file(s) are left out because their resolution isn't known yet.
        Press Scan at the top of the page to read it.
    </p>
}

@if (_groups.Count > 0)
{
    <div class="app-tabs" role="tablist" aria-label="Media type">
        @foreach (var isTv in new[] { false, true })
        {
            <button type="button"
                    role="tab"
                    aria-selected="@(_showTv == isTv)"
                    class="app-tab @(_showTv == isTv ? "active" : null)"
                    @onclick="() => ShowTab(isTv)">
                @(isTv ? "TV" : "Movies") <span class="app-tab-count">@_groups.Count(group => group.IsTv == isTv)</span>
            </button>
        }
    </div>

    <div class="toolbar">
        <div class="toolbar-summary">
            <strong>@Visible.Count</strong> file(s) ·
            up to <strong>@SizeFormatter.FormatBytes(Visible.Sum(group => group.BestSavingsBytes))</strong> smaller
        </div>

        <div class="toolbar-actions">
            <label class="form-check mb-0 align-self-center">
                <input type="checkbox"
                       class="form-check-input"
                       checked="@_sameQualityOnly"
                       @onchange="e => SetSameQualityOnly((bool?)e.Value == true)" />
                <span class="form-check-label">Same quality or better only</span>
            </label>

            <select class="form-select form-select-sm w-auto"
                    aria-label="Resolution"
                    value="@_tier"
                    @onchange="e => SetTier(e.Value?.ToString())">
                <option value="">Any resolution</option>
                @foreach (var tier in Search.Tiers)
                {
                    <option value="@tier">@tier.ToLowerInvariant()</option>
                }
            </select>

            <select class="form-select form-select-sm w-auto"
                    aria-label="Sort by"
                    value="@_sort"
                    @onchange="e => SetSort(e.Value?.ToString())">
                <option value="saving">Biggest saving first</option>
                <option value="size">Largest file first</option>
                <option value="title">Title</option>
            </select>
        </div>
    </div>
}

@if (_profiles.Count == 0)
{
}
else if (!_hasSearched)
{
    <EmptyState Icon="search" Text="No search has been run yet. Press Search next to a drive." />
}
else if (_groups.Count == 0)
{
    <EmptyState Icon="check-circle" Text="No smaller releases were found." />
}
else if (Visible.Count == 0)
{
    <EmptyState Icon="funnel" Text="Nothing matches these filters." />
}
else
{
    @foreach (var group in Visible.Take(_shown))
    {
        <div class="group-card" @key="group.MediaAssetId">
            <div class="group-card-header">
                <div>
                    <div class="group-card-title">
                        @group.Title
                        @if (group.HasUpgrade)
                        {
                            <span class="pill">Better quality available</span>
                        }
                    </div>
                    <div class="cell-note">
                        Yours: @SizeFormatter.FormatBytes(group.SizeBytes) · @group.Resolution.ToLowerInvariant()
                        @if (!string.IsNullOrWhiteSpace(group.VideoCodec))
                        {
                            <text> · @group.VideoCodec</text>
                        }
                        · @group.DriveName
                    </div>
                </div>

                <div class="group-card-meta">
                    Up to <strong>@SizeFormatter.FormatBytes(group.BestSavingsBytes)</strong> smaller
                    (@group.BestSavingsPercent.ToString("P0"))
                </div>
            </div>

            <details class="group-card-details">
                <summary>@group.Releases.Count smaller release(s)</summary>

                <div class="table-scroll">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Release</th>
                                <th>Quality</th>
                                <th class="col-num">Size</th>
                                <th class="col-num">Saves</th>
                                <th class="col-num">Seed / leech</th>
                                <th></th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var release in group.Releases)
                            {
                                <tr>
                                    <td>
                                        <div class="file-name">@release.Candidate.Title</div>
                                        <div class="cell-note">@release.Candidate.Indexer</div>
                                    </td>

                                    <td class="text-nowrap">
                                        @(string.IsNullOrWhiteSpace(release.CandidateResolution) ? "Not stated" : release.CandidateResolution.ToLowerInvariant())
                                        @if (!string.IsNullOrWhiteSpace(release.CandidateCodec))
                                        {
                                            <text> · @release.CandidateCodec</text>
                                        }

                                        @if (release.IsUpgrade)
                                        {
                                            <div class="status-ok">Higher resolution</div>
                                        }
                                        else if (!release.IsSameResolution &&
                                                 !string.IsNullOrWhiteSpace(release.CandidateResolution))
                                        {
                                            <div class="status-warn">Lower resolution</div>
                                        }
                                    </td>

                                    <td class="col-num">@SizeFormatter.FormatBytes(release.Candidate.SizeBytes)</td>

                                    <td class="col-num">
                                        <strong>@SizeFormatter.FormatBytes(release.SavingsBytes)</strong>
                                        <div class="cell-note">@release.SavingsPercent.ToString("P0")</div>
                                    </td>

                                    <td class="col-num">@release.Candidate.Seeders / @release.Candidate.Leechers</td>

                                    <td>
                                        <div class="d-flex gap-2 flex-wrap align-items-center">
                                            @if (_confirmDownload == release)
                                            {
                                                <button type="button" class="btn btn-primary btn-sm" disabled="@_starting" @onclick="() => StartDownloadAsync(release)">
                                                    @(_starting ? "Adding..." : "Download it")
                                                </button>
                                                <button type="button" class="btn btn-secondary btn-sm" disabled="@_starting" @onclick="() => _confirmDownload = null">Cancel</button>
                                            }
                                            else if (IsDownloading(group.Path))
                                            {
                                                <span class="cell-note">Downloading</span>
                                            }
                                            else
                                            {
                                                <button type="button" class="btn btn-secondary btn-sm" @onclick="() => _confirmDownload = release">Download</button>
                                            }

                                            @if (IsWebLink(release.Candidate.InfoUrl))
                                            {
                                                <a class="text-nowrap" href="@release.Candidate.InfoUrl" target="_blank" rel="noopener noreferrer">
                                                    Open
                                                </a>
                                            }
                                        </div>

                                        @if (_rowMessage is { } note && note.Release == release)
                                        {
                                            <div class="@(note.Ok ? "status-ok" : "status-warn") mt-1" style="max-width: 32ch; white-space: normal">@note.Text</div>
                                        }

                                        @if (_confirmDownload == release)
                                        {
                                            <div class="cell-note mt-1" style="max-width: 32ch">
                                                Starts it in @Client.Name. When it's done, the new file is linked into the library
                                                and yours goes to the Recycle Bin@(_autoSwap ? "" : " when you press Swap now").
                                            </div>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="detail-label">Your file</div>
                <code>@group.Path</code>
            </details>
        </div>
    }

    @if (Visible.Count > _shown)
    {
        <button type="button" class="btn btn-secondary" @onclick="() => _shown += PageSize">
            Show @Math.Min(PageSize, Visible.Count - _shown) more (@(Visible.Count - _shown) left)
        </button>
    }
}

@code
{
    private const int PageSize = 50;

    /// <summary>One library file and the smaller releases found for it.</summary>
    private sealed class FileGroup
    {
        public Guid MediaAssetId { get; init; }

        public string Title { get; init; } = string.Empty;

        public bool IsTv { get; init; }

        public string DriveName { get; init; } = string.Empty;

        public string Path { get; init; } = string.Empty;

        public long SizeBytes { get; init; }

        public string Resolution { get; init; } = string.Empty;

        public string VideoCodec { get; init; } = string.Empty;

        public List<SizeReductionCandidate> Releases { get; init; } = [];

        public bool HasUpgrade =>
            Releases.Any(release => release.IsUpgrade);

        public long BestSavingsBytes =>
            Releases.Max(release => release.SavingsBytes);

        public double BestSavingsPercent =>
            Releases.Max(release => release.SavingsPercent);
    }

    private List<DriveProfile> _profiles = [];

    private SizeReductionCandidate? _confirmDownload;
    private (SizeReductionCandidate Release, string Text, bool Ok)? _rowMessage;
    private bool _starting;
    private bool _checking;
    private bool _autoSwap;
    private string? _downloadMessage;
    private bool _downloadOk;

    private Guid? _confirmCancel;
    private Timer? _refresh;

    private async Task CancelAsync(SizeReductionDownload download)
    {
        _checking = true;

        try
        {
            var problem = await Downloads.CancelAsync(download.Id);

            _downloadOk = problem is null;
            _downloadMessage = problem ?? $"Cancelled {download.ReleaseTitle}. It and what it downloaded were removed from {Client.Name}; your file is untouched.";
        }
        finally
        {
            _checking = false;
            _confirmCancel = null;
        }
    }

    // While anything is downloading, the numbers are refreshed every few seconds.
    private void RefreshWhileDownloading(object? _)
    {
        if (Downloads.Downloads.Any(download => download.Status == SizeReductionDownloadStatus.Downloading))
        {
            _ = InvokeAsync(Downloads.CheckAsync);
        }
    }

    private bool IsDownloading(string libraryFile) =>
        Downloads.Downloads.Any(download =>
            download.Status is SizeReductionDownloadStatus.Downloading or SizeReductionDownloadStatus.ReadyToSwap &&
            string.Equals(download.LibraryFilePath, libraryFile, StringComparison.OrdinalIgnoreCase));

    private async Task StartDownloadAsync(SizeReductionCandidate release)
    {
        _starting = true;

        try
        {
            string? problem;

            try
            {
                problem = await Downloads.StartAsync(release);
            }
            catch (Exception exception)
            {
                Simplifiarr.Core.Utilities.AppLog.Warn("Starting a Size Reduction download failed.", exception);
                problem = $"It couldn't be added: {exception.Message}";
            }

            _downloadOk = problem is null;
            _downloadMessage = problem ?? $"Added {release.Candidate.Title} to {Client.Name}. It's in Downloads above.";

            // Said next to the button too, where you are looking.
            _rowMessage = (release, problem ?? $"Added to {Client.Name}; see Downloads at the top.", problem is null);
        }
        finally
        {
            _starting = false;
            _confirmDownload = null;
        }
    }

    private async Task CheckDownloadsAsync()
    {
        _checking = true;

        try
        {
            await Downloads.CheckAsync();
        }
        finally
        {
            _checking = false;
        }
    }

    private async Task SwapAsync(SizeReductionDownload download)
    {
        _checking = true;

        try
        {
            var problem = await Downloads.SwapAsync(download.Id);

            _downloadOk = problem is null;
            _downloadMessage = problem ?? download.Message;
        }
        finally
        {
            _checking = false;
        }
    }

    private List<SizeReductionCandidate> _found = [];

    /// <summary>Every file with a release, after the quality filter.</summary>
    private List<FileGroup> _groups = [];

    private bool _prowlarrIsSetUp;
    private bool _hasSearched;
    private bool _wasSearching;

    private int _unscannedCount;

    private bool _showTv;
    private bool _sameQualityOnly;
    private string _tier = string.Empty;
    private string _sort = "saving";
    private int _shown = PageSize;

    private List<FileGroup> Visible =>
        Sorted(
            _groups.Where(group =>
                group.IsTv == _showTv &&
                (_tier.Length == 0 ||
                 string.Equals(group.Resolution, _tier, StringComparison.OrdinalIgnoreCase))))
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        _wasSearching = Search.IsSearching;

        Downloads.Changed += OnDownloadsChanged;

        _refresh = new Timer(RefreshWhileDownloading, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));

        Search.Changed += OnSearchChanged;

        var settings =
            await SettingsService.GetSettingsAsync();

        _prowlarrIsSetUp =
            !string.IsNullOrWhiteSpace(settings.ProwlarrUrl) &&
            !string.IsNullOrWhiteSpace(settings.ProwlarrApiKey);

        _autoSwap = settings.SizeReductionAutoSwap;

        // Fresh progress for anything downloading.
        _ = InvokeAsync(Downloads.CheckAsync);

        _profiles =
            (await SettingsService.GetEnabledDriveProfilesAsync())
                .OrderBy(profile => profile.Name)
                .ToList();

        await LoadAsync();

        // Open on whichever tab has something in it.
        _showTv =
            !_groups.Any(group => !group.IsTv) &&
            _groups.Any(group => group.IsTv);
    }

    private void Start(string? driveName)
    {
        if (Search.IsSearching)
        {
            return;
        }

        // Runs on its own, so it carries on if this page is closed.
        _ = Task.Run(() => Search.SearchAsync(driveName));
    }

    // Raised from the search's own thread - hop back onto this page's.
    private void OnSearchChanged()
    {
        _ = InvokeAsync(async () =>
        {
            var justFinished =
                _wasSearching && !Search.IsSearching;

            _wasSearching = Search.IsSearching;

        Downloads.Changed += OnDownloadsChanged;

        _refresh = new Timer(RefreshWhileDownloading, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));

            if (justFinished)
            {
                await LoadAsync();
            }

            StateHasChanged();
        });
    }

    private async Task LoadAsync()
    {
        _found = await Search.GetFoundAsync();

        _unscannedCount = await Search.CountUnscannedAssetsAsync();

        _hasSearched =
            _profiles.Any(profile => Search.GetLastSearchUtc(profile.Name).HasValue);

        BuildGroups();
    }

    private void BuildGroups()
    {
        _groups =
            _found
                .Where(release =>
                    !_sameQualityOnly || release.IsSameResolution || release.IsUpgrade)
                .GroupBy(release => release.MediaAssetId)
                .Select(group =>
                {
                    var first = group.First();

                    var isTv =
                        first.Season is not null && first.Episode is not null;

                    var title =
                        first.AssetYear is null
                            ? first.AssetTitle
                            : $"{first.AssetTitle} ({first.AssetYear})";

                    return new FileGroup
                    {
                        MediaAssetId = group.Key,
                        Title = isTv
                            ? $"{first.AssetTitle} S{first.Season:00}E{first.Episode:00}"
                            : title,
                        IsTv = isTv,
                        DriveName = first.DriveProfileName,
                        Path = first.CanonicalPath,
                        SizeBytes = first.AssetSizeBytes,
                        Resolution = first.AssetResolution,
                        VideoCodec = first.AssetVideoCodec,
                        Releases = group
                            .OrderByDescending(release => release.IsUpgrade)
                            .ThenByDescending(release => release.IsSameResolution)
                            .ThenByDescending(release => release.SavingsBytes)
                            .ToList()
                    };
                })
                .ToList();

        _shown = PageSize;
    }

    private IEnumerable<FileGroup> Sorted(IEnumerable<FileGroup> groups) =>
        _sort switch
        {
            "title" => groups.OrderBy(group => group.Title, StringComparer.OrdinalIgnoreCase),
            "size" => groups.OrderByDescending(group => group.SizeBytes),
            _ => groups
                .OrderByDescending(group => group.HasUpgrade)
                .ThenByDescending(group => group.BestSavingsBytes)
        };

    private void ShowTab(bool tv)
    {
        _showTv = tv;
        _shown = PageSize;
    }

    private void SetSameQualityOnly(bool value)
    {
        _sameQualityOnly = value;

        BuildGroups();
    }

    private void SetTier(string? tier)
    {
        _tier = tier ?? string.Empty;
        _shown = PageSize;
    }

    private void SetSort(string? sort)
    {
        _sort = sort ?? "saving";
        _shown = PageSize;
    }

    // An indexer's link is shown as given, so only ever as a web link.
    private static bool IsWebLink(string? url) =>
        Uri.TryCreate(url, UriKind.Absolute, out var uri) &&
        (uri.Scheme == Uri.UriSchemeHttp || uri.Scheme == Uri.UriSchemeHttps);

    private static string FormatTime(DateTime utc) =>
        DateTime.SpecifyKind(utc, DateTimeKind.Utc)
            .ToLocalTime()
            .ToString("g");

    private void OnDownloadsChanged() =>
        _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Search.Changed -= OnSearchChanged;
        Downloads.Changed -= OnDownloadsChanged;
        _refresh?.Dispose();
    }
}
