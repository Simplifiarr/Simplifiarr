@page "/size-reduction"
@rendermode InteractiveServer
@implements IDisposable

@using Simplifiarr.Core.Models
@using Simplifiarr.Core.Services
@using Simplifiarr.Core.Utilities

@inject ISettingsService SettingsService
@inject ISizeReductionCandidateService Search

<PageTitle>Size Reduction - Simplifiarr</PageTitle>

<PageHeader Title="Size Reduction"
            Subtitle="Looks on your indexers, through Prowlarr, for smaller releases of films and episodes you already have. It only reports what it finds - nothing is downloaded or replaced.">
    @if (Search.IsSearching)
    {
        <button type="button" class="btn btn-secondary" @onclick="Search.Stop">
            <i class="bi bi-stop-fill" aria-hidden="true"></i>
            Stop
        </button>
    }
    else if (_profiles.Count > 1 && _prowlarrIsSetUp)
    {
        <button type="button" class="btn btn-primary" @onclick="() => Start(null)">
            <i class="bi bi-search" aria-hidden="true"></i>
            Search all drives
        </button>
    }
</PageHeader>

@if (_profiles.Count == 0)
{
    <div class="alert alert-warning">
        No drives are set up yet. <a href="settings">Add one in Settings</a>.
    </div>
}
else if (!_prowlarrIsSetUp)
{
    <div class="alert alert-warning">
        Prowlarr isn't set up yet, so there is nowhere to search.
        <a href="settings">Add its address and API key in Settings</a>, under Connections.
    </div>
}

@if (Search.Progress is { } progress)
{
    <div class="alert alert-info" role="status">
        <strong>Searching @progress.DriveName</strong> -
        @progress.Done of @progress.Total file(s) done.
        <div class="cell-note">Now: @progress.CurrentTitle. You can leave this page; the search carries on.</div>
    </div>
}
else if (!string.IsNullOrWhiteSpace(Search.LastMessage))
{
    <div class="alert @(Search.LastSucceeded ? "alert-info" : "alert-warning")" role="status">
        @Search.LastMessage
    </div>
}

@if (_profiles.Count > 0)
{
    <div class="panel section">
        @foreach (var profile in _profiles)
        {
            var found = _groups.Count(group => group.DriveName == profile.Name);

            <div class="action-row">
                <div>
                    <div class="action-row-title">@profile.Name</div>
                    <div class="action-row-detail">
                        @if (Search.GetLastSearchUtc(profile.Name) is { } searchedUtc)
                        {
                            <text>Last searched @FormatTime(searchedUtc) · @found file(s) with a smaller release</text>
                        }
                        else
                        {
                            <text>Not searched yet</text>
                        }
                    </div>
                </div>

                <button type="button"
                        class="btn btn-secondary btn-sm"
                        disabled="@(Search.IsSearching || !_prowlarrIsSetUp)"
                        @onclick="() => Start(profile.Name)">
                    Search
                </button>
            </div>
        }
    </div>
}

@if (_unscannedCount > 0)
{
    <p class="cell-note">
        @_unscannedCount file(s) are left out because their resolution isn't known yet.
        Press Scan at the top of the page to read it.
    </p>
}

@if (_groups.Count > 0)
{
    <div class="app-tabs" role="tablist" aria-label="Media type">
        @foreach (var isTv in new[] { false, true })
        {
            <button type="button"
                    role="tab"
                    aria-selected="@(_showTv == isTv)"
                    class="app-tab @(_showTv == isTv ? "active" : null)"
                    @onclick="() => ShowTab(isTv)">
                @(isTv ? "TV" : "Movies") <span class="app-tab-count">@_groups.Count(group => group.IsTv == isTv)</span>
            </button>
        }
    </div>

    <div class="toolbar">
        <div class="toolbar-summary">
            <strong>@Visible.Count</strong> file(s) ·
            up to <strong>@SizeFormatter.FormatBytes(Visible.Sum(group => group.BestSavingsBytes))</strong> smaller
        </div>

        <div class="toolbar-actions">
            <label class="form-check mb-0 align-self-center">
                <input type="checkbox"
                       class="form-check-input"
                       checked="@_sameQualityOnly"
                       @onchange="e => SetSameQualityOnly((bool?)e.Value == true)" />
                <span class="form-check-label">Same quality or better only</span>
            </label>

            <select class="form-select form-select-sm w-auto"
                    aria-label="Resolution"
                    value="@_tier"
                    @onchange="e => SetTier(e.Value?.ToString())">
                <option value="">Any resolution</option>
                @foreach (var tier in Search.Tiers)
                {
                    <option value="@tier">@tier.ToLowerInvariant()</option>
                }
            </select>

            <select class="form-select form-select-sm w-auto"
                    aria-label="Sort by"
                    value="@_sort"
                    @onchange="e => SetSort(e.Value?.ToString())">
                <option value="saving">Biggest saving first</option>
                <option value="size">Largest file first</option>
                <option value="title">Title</option>
            </select>
        </div>
    </div>
}

@if (_profiles.Count == 0)
{
}
else if (!_hasSearched)
{
    <EmptyState Icon="search" Text="No search has been run yet. Press Search next to a drive." />
}
else if (_groups.Count == 0)
{
    <EmptyState Icon="check-circle" Text="No smaller releases were found." />
}
else if (Visible.Count == 0)
{
    <EmptyState Icon="funnel" Text="Nothing matches these filters." />
}
else
{
    @foreach (var group in Visible.Take(_shown))
    {
        <div class="group-card" @key="group.MediaAssetId">
            <div class="group-card-header">
                <div>
                    <div class="group-card-title">
                        @group.Title
                        @if (group.HasUpgrade)
                        {
                            <span class="pill">Better quality available</span>
                        }
                    </div>
                    <div class="cell-note">
                        Yours: @SizeFormatter.FormatBytes(group.SizeBytes) · @group.Resolution.ToLowerInvariant()
                        @if (!string.IsNullOrWhiteSpace(group.VideoCodec))
                        {
                            <text> · @group.VideoCodec</text>
                        }
                        · @group.DriveName
                    </div>
                </div>

                <div class="group-card-meta">
                    Up to <strong>@SizeFormatter.FormatBytes(group.BestSavingsBytes)</strong> smaller
                    (@group.BestSavingsPercent.ToString("P0"))
                </div>
            </div>

            <details class="group-card-details">
                <summary>@group.Releases.Count smaller release(s)</summary>

                <div class="table-scroll">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Release</th>
                                <th>Quality</th>
                                <th class="col-num">Size</th>
                                <th class="col-num">Saves</th>
                                <th class="col-num">Seeders</th>
                                <th></th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var release in group.Releases)
                            {
                                <tr>
                                    <td>
                                        <div class="file-name">@release.Candidate.Title</div>
                                        <div class="cell-note">@release.Candidate.Indexer</div>
                                    </td>

                                    <td class="text-nowrap">
                                        @(string.IsNullOrWhiteSpace(release.CandidateResolution) ? "Not stated" : release.CandidateResolution.ToLowerInvariant())
                                        @if (!string.IsNullOrWhiteSpace(release.CandidateCodec))
                                        {
                                            <text> · @release.CandidateCodec</text>
                                        }

                                        @if (release.IsUpgrade)
                                        {
                                            <div class="status-ok">Higher resolution</div>
                                        }
                                        else if (!release.IsSameResolution &&
                                                 !string.IsNullOrWhiteSpace(release.CandidateResolution))
                                        {
                                            <div class="status-warn">Lower resolution</div>
                                        }
                                    </td>

                                    <td class="col-num">@SizeFormatter.FormatBytes(release.Candidate.SizeBytes)</td>

                                    <td class="col-num">
                                        <strong>@SizeFormatter.FormatBytes(release.SavingsBytes)</strong>
                                        <div class="cell-note">@release.SavingsPercent.ToString("P0")</div>
                                    </td>

                                    <td class="col-num">@release.Candidate.Seeders</td>

                                    <td>
                                        @if (IsWebLink(release.Candidate.InfoUrl))
                                        {
                                            <a class="text-nowrap" href="@release.Candidate.InfoUrl" target="_blank" rel="noopener noreferrer">
                                                Open
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="detail-label">Your file</div>
                <code>@group.Path</code>
            </details>
        </div>
    }

    @if (Visible.Count > _shown)
    {
        <button type="button" class="btn btn-secondary" @onclick="() => _shown += PageSize">
            Show @Math.Min(PageSize, Visible.Count - _shown) more (@(Visible.Count - _shown) left)
        </button>
    }
}

@code
{
    private const int PageSize = 50;

    /// <summary>One library file and the smaller releases found for it.</summary>
    private sealed class FileGroup
    {
        public Guid MediaAssetId { get; init; }

        public string Title { get; init; } = string.Empty;

        public bool IsTv { get; init; }

        public string DriveName { get; init; } = string.Empty;

        public string Path { get; init; } = string.Empty;

        public long SizeBytes { get; init; }

        public string Resolution { get; init; } = string.Empty;

        public string VideoCodec { get; init; } = string.Empty;

        public List<SizeReductionCandidate> Releases { get; init; } = [];

        public bool HasUpgrade =>
            Releases.Any(release => release.IsUpgrade);

        public long BestSavingsBytes =>
            Releases.Max(release => release.SavingsBytes);

        public double BestSavingsPercent =>
            Releases.Max(release => release.SavingsPercent);
    }

    private List<DriveProfile> _profiles = [];

    private List<SizeReductionCandidate> _found = [];

    /// <summary>Every file with a release, after the quality filter.</summary>
    private List<FileGroup> _groups = [];

    private bool _prowlarrIsSetUp;
    private bool _hasSearched;
    private bool _wasSearching;

    private int _unscannedCount;

    private bool _showTv;
    private bool _sameQualityOnly;
    private string _tier = string.Empty;
    private string _sort = "saving";
    private int _shown = PageSize;

    private List<FileGroup> Visible =>
        Sorted(
            _groups.Where(group =>
                group.IsTv == _showTv &&
                (_tier.Length == 0 ||
                 string.Equals(group.Resolution, _tier, StringComparison.OrdinalIgnoreCase))))
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        _wasSearching = Search.IsSearching;

        Search.Changed += OnSearchChanged;

        var settings =
            await SettingsService.GetSettingsAsync();

        _prowlarrIsSetUp =
            !string.IsNullOrWhiteSpace(settings.ProwlarrUrl) &&
            !string.IsNullOrWhiteSpace(settings.ProwlarrApiKey);

        _profiles =
            (await SettingsService.GetEnabledDriveProfilesAsync())
                .OrderBy(profile => profile.Name)
                .ToList();

        await LoadAsync();

        // Open on whichever tab has something in it.
        _showTv =
            !_groups.Any(group => !group.IsTv) &&
            _groups.Any(group => group.IsTv);
    }

    private void Start(string? driveName)
    {
        if (Search.IsSearching)
        {
            return;
        }

        // Runs on its own, so it carries on if this page is closed.
        _ = Task.Run(() => Search.SearchAsync(driveName));
    }

    // Raised from the search's own thread - hop back onto this page's.
    private void OnSearchChanged()
    {
        _ = InvokeAsync(async () =>
        {
            var justFinished =
                _wasSearching && !Search.IsSearching;

            _wasSearching = Search.IsSearching;

            if (justFinished)
            {
                await LoadAsync();
            }

            StateHasChanged();
        });
    }

    private async Task LoadAsync()
    {
        _found = await Search.GetFoundAsync();

        _unscannedCount = await Search.CountUnscannedAssetsAsync();

        _hasSearched =
            _profiles.Any(profile => Search.GetLastSearchUtc(profile.Name).HasValue);

        BuildGroups();
    }

    private void BuildGroups()
    {
        _groups =
            _found
                .Where(release =>
                    !_sameQualityOnly || release.IsSameResolution || release.IsUpgrade)
                .GroupBy(release => release.MediaAssetId)
                .Select(group =>
                {
                    var first = group.First();

                    var isTv =
                        first.Season is not null && first.Episode is not null;

                    var title =
                        first.AssetYear is null
                            ? first.AssetTitle
                            : $"{first.AssetTitle} ({first.AssetYear})";

                    return new FileGroup
                    {
                        MediaAssetId = group.Key,
                        Title = isTv
                            ? $"{first.AssetTitle} S{first.Season:00}E{first.Episode:00}"
                            : title,
                        IsTv = isTv,
                        DriveName = first.DriveProfileName,
                        Path = first.CanonicalPath,
                        SizeBytes = first.AssetSizeBytes,
                        Resolution = first.AssetResolution,
                        VideoCodec = first.AssetVideoCodec,
                        Releases = group
                            .OrderByDescending(release => release.IsUpgrade)
                            .ThenByDescending(release => release.IsSameResolution)
                            .ThenByDescending(release => release.SavingsBytes)
                            .ToList()
                    };
                })
                .ToList();

        _shown = PageSize;
    }

    private IEnumerable<FileGroup> Sorted(IEnumerable<FileGroup> groups) =>
        _sort switch
        {
            "title" => groups.OrderBy(group => group.Title, StringComparer.OrdinalIgnoreCase),
            "size" => groups.OrderByDescending(group => group.SizeBytes),
            _ => groups
                .OrderByDescending(group => group.HasUpgrade)
                .ThenByDescending(group => group.BestSavingsBytes)
        };

    private void ShowTab(bool tv)
    {
        _showTv = tv;
        _shown = PageSize;
    }

    private void SetSameQualityOnly(bool value)
    {
        _sameQualityOnly = value;

        BuildGroups();
    }

    private void SetTier(string? tier)
    {
        _tier = tier ?? string.Empty;
        _shown = PageSize;
    }

    private void SetSort(string? sort)
    {
        _sort = sort ?? "saving";
        _shown = PageSize;
    }

    // An indexer's link is shown as given, so only ever as a web link.
    private static bool IsWebLink(string? url) =>
        Uri.TryCreate(url, UriKind.Absolute, out var uri) &&
        (uri.Scheme == Uri.UriSchemeHttp || uri.Scheme == Uri.UriSchemeHttps);

    private static string FormatTime(DateTime utc) =>
        DateTime.SpecifyKind(utc, DateTimeKind.Utc)
            .ToLocalTime()
            .ToString("g");

    public void Dispose() =>
        Search.Changed -= OnSearchChanged;
}
