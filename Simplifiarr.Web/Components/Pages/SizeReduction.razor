@page "/size-reduction"
@rendermode InteractiveServer

@using Simplifiarr.Core.Models
@using Simplifiarr.Core.Services
@using Simplifiarr.Core.Utilities

@inject ISettingsService SettingsService
@inject ISizeReductionCandidateService SizeReductionCandidateService
@inject ISizeReductionCandidateCacheService CandidateCache

<PageTitle>Size Reduction Scan</PageTitle>

<h1>Size Reduction Scan</h1>

<p>
    Finds smaller alternate releases of your movies/TV episodes on Prowlarr -
    report-only, nothing is ever downloaded or replaced automatically. Unlike
    Cross-Seed, these candidates are genuinely different encodes, so there's
    no byte-for-byte proof possible - everything here comes from your file's
    already-known resolution/codec and the candidate's declared size and
    release-title-parsed resolution/codec. Same-resolution candidates are
    preferred and sorted first; a smaller candidate at a different resolution
    can still show, clearly marked, below them.
</p>

@if (_profiles.Count == 0)
{
    <div class="alert alert-warning">
        No enabled drive profiles are configured.
    </div>
}
else
{
    <div class="row g-3 mt-2">
        @foreach (var profile in _profiles)
        {
            <div class="col-md-6">
                <DriveScanCard DriveName="@profile.Name"
                               Paths="BuildPaths(profile)"
                               Rows="BuildRows(profile)"
                               IsScanningDrive="@(_isScanningDrive == profile.Name)"
                               OnScanDrive="() => ScanDriveAsync(profile.Name)" />
            </div>
        }
    </div>
}

@if (!string.IsNullOrWhiteSpace(_statusMessage))
{
    <div class="alert alert-info mt-3">
        @_statusMessage
    </div>
}

@if (_unscannedCount > 0)
{
    <div class="alert alert-secondary mt-3">
        <strong>@_unscannedCount</strong> asset(s) skipped - resolution not
        yet determined. Run a scan on the
        <a href="hardlinks">Hardlinks</a> page first so those files can be
        probed.
    </div>
}

<div class="row g-2 align-items-end mt-3 mb-2">
    <div class="col-auto">
        <label class="form-label d-block">Resolution</label>
        @foreach (var tier in Tiers)
        {
            <div class="form-check form-check-inline">
                <input class="form-check-input"
                       type="checkbox"
                       id="@("tier-" + tier)"
                       checked="@_selectedTiers.Contains(tier)"
                       @onchange="e => ToggleTier(tier, (bool?)e.Value == true)" />
                <label class="form-check-label" for="@("tier-" + tier)">@tier</label>
            </div>
        }
    </div>
</div>

@if (!_hasScanned)
{
    <EmptyState Icon="search" Text="No size reduction scan has been run yet." />
}
else if (_groups.Count == 0)
{
    <EmptyState Icon="check-circle" Text="No smaller candidates were found." />
}
else
{
    <p>
        <strong>@_groups.Count</strong> file(s) &middot;
        <strong>@_groups.Sum(group => group.Candidates.Count)</strong> candidate(s) total
        @{
            var upgradeGroupCount = _groups.Count(group => group.Candidates.Any(candidate => candidate.IsUpgrade));
        }
        @if (upgradeGroupCount > 0)
        {
            <text> &middot; </text>
            <span class="badge bg-success">⬆ @upgradeGroupCount file(s) have an upgrade available</span>
        }
    </p>

    <div class="table-responsive">
        <table class="table table-sm">
            <thead>
                <tr>
                    <th style="width: 2em;"></th>
                    <th role="button" @onclick='() => SetSort("Title")'>Title @SortIndicator("Title")</th>
                    <th role="button" @onclick='() => SetSort("CurrentSize")'>Current File @SortIndicator("CurrentSize")</th>
                    <th role="button" @onclick='() => SetSort("CandidateCount")'>Candidates @SortIndicator("CandidateCount")</th>
                    <th role="button" @onclick='() => SetSort("Savings")'>Best Savings @SortIndicator("Savings")</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var group in _groups)
                {
                    var expanded = IsExpanded(group.MediaAssetId);

                    <tr role="button" @onclick="() => ToggleExpanded(group.MediaAssetId)">
                        <td>@(expanded ? "▼" : "▶")</td>
                        <td>
                            @group.AssetTitle
                            @if (group.AssetYear is not null)
                            {
                                <text> (@group.AssetYear)</text>
                            }
                            @if (group.Season is not null && group.Episode is not null)
                            {
                                <text> S@(group.Season.Value.ToString("00"))E@(group.Episode.Value.ToString("00"))</text>
                            }
                        </td>
                        <td>
                            @SizeFormatter.FormatBytes(group.AssetSizeBytes)<br />
                            <small class="text-muted">
                                @group.AssetResolution &middot;
                                @(string.IsNullOrWhiteSpace(group.AssetVideoCodec) ? "—" : group.AssetVideoCodec)
                            </small><br />
                            <small class="text-muted"><code>@group.CanonicalPath</code></small>
                        </td>
                        <td>@group.Candidates.Count</td>
                        <td>
                            <strong>@SizeFormatter.FormatBytes(group.BestSavingsBytes)</strong><br />
                            <small class="text-muted">@group.BestSavingsPercent.ToString("P0")</small>
                        </td>
                    </tr>

                    @if (expanded)
                    {
                        <tr>
                            <td></td>
                            <td colspan="4" class="p-0">
                                <table class="table table-sm mb-0">
                                    <thead>
                                        <tr class="text-muted">
                                            <th>Candidate</th>
                                            <th>Resolution / Codec</th>
                                            <th>Savings</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var candidate in group.Candidates)
                                        {
                                            <tr>
                                                <td>
                                                    @candidate.Candidate.Title<br />
                                                    <small class="text-muted">
                                                        @candidate.Candidate.Indexer &middot;
                                                        @SizeFormatter.FormatBytes(candidate.Candidate.SizeBytes) &middot;
                                                        @candidate.Candidate.Seeders / @candidate.Candidate.Leechers
                                                    </small>
                                                </td>
                                                <td>
                                                    @candidate.CandidateResolution &middot;
                                                    @(candidate.CandidateCodec ?? "—")
                                                    @if (candidate.IsUpgrade)
                                                    {
                                                        <span class="badge bg-success ms-1">⬆ Upgrade</span>
                                                    }
                                                    else if (!candidate.IsSameResolution)
                                                    {
                                                        <span class="badge bg-warning text-dark ms-1">Lower resolution</span>
                                                    }
                                                </td>
                                                <td>
                                                    <strong>@SizeFormatter.FormatBytes(candidate.SavingsBytes)</strong>
                                                    <small class="text-muted">(@candidate.SavingsPercent.ToString("P0"))</small>
                                                </td>
                                                <td>
                                                    @if (!string.IsNullOrWhiteSpace(candidate.Candidate.InfoUrl))
                                                    {
                                                        <a href="@candidate.Candidate.InfoUrl" target="_blank" rel="noopener">
                                                            View on Indexer
                                                        </a>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}

@code
{
    private static readonly string[] Tiers =
        ["2160P", "1440P", "1080P", "720P"];

    private sealed class AssetGroup
    {
        public Guid MediaAssetId { get; set; }

        public string AssetTitle { get; set; } =
            string.Empty;

        public int? AssetYear { get; set; }

        public int? Season { get; set; }

        public int? Episode { get; set; }

        public string CanonicalPath { get; set; } =
            string.Empty;

        public long AssetSizeBytes { get; set; }

        public string AssetResolution { get; set; } =
            string.Empty;

        public string AssetVideoCodec { get; set; } =
            string.Empty;

        public List<SizeReductionCandidate> Candidates { get; set; } =
            [];

        public long BestSavingsBytes =>
            Candidates.Count == 0 ? 0 : Candidates.Max(candidate => candidate.SavingsBytes);

        public double BestSavingsPercent =>
            Candidates.Count == 0 ? 0 : Candidates.Max(candidate => candidate.SavingsPercent);
    }

    private List<DriveProfile> _profiles = [];
    private List<AssetGroup> _groups = [];
    private readonly HashSet<Guid> _expandedAssetIds = [];

    private bool _hasScanned;
    private bool _isScanning;
    private string? _isScanningDrive;
    private string? _activeDriveName;
    private string? _activeTier;

    private int _unscannedCount;

    private readonly HashSet<string> _selectedTiers =
        new(Tiers, StringComparer.OrdinalIgnoreCase);

    private string _sortColumn = "Default";
    private bool _sortDescending = true;
    private string _statusMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _profiles =
            (await SettingsService.GetEnabledDriveProfilesAsync())
                .OrderBy(profile => profile.Name)
                .ToList();

        LoadCachedCandidates();

        await RefreshUnscannedCountAsync();
    }

    private static List<DriveScanCardPath> BuildPaths(
        DriveProfile profile)
    {
        var paths = new List<DriveScanCardPath>();

        if (!string.IsNullOrWhiteSpace(profile.MovieLibraryPath))
        {
            paths.Add(new DriveScanCardPath { Label = "Movies", Path = profile.MovieLibraryPath });
        }

        if (!string.IsNullOrWhiteSpace(profile.TvLibraryPath))
        {
            paths.Add(new DriveScanCardPath { Label = "TV", Path = profile.TvLibraryPath });
        }

        return paths;
    }

    private List<DriveScanCardRow> BuildRows(
        DriveProfile profile)
    {
        var anyScanning =
            _isScanning || _isScanningDrive == profile.Name;

        return Tiers
            .Select(tier => new DriveScanCardRow
            {
                Label = tier,
                Count = CandidateCache.GetCandidates(profile.Name, tier).Count,
                LastScanText = FormatScanTime(
                    CandidateCache.GetLastScanUtc(profile.Name, tier)),
                IsScanning =
                    _isScanning &&
                    _activeDriveName == profile.Name &&
                    _activeTier == tier,
                IsDisabled = anyScanning,
                OnScanClick = () => ScanAsync(profile.Name, tier)
            })
            .ToList();
    }

    private async Task ScanDriveAsync(
        string driveName)
    {
        if (_isScanning || _isScanningDrive is not null)
        {
            return;
        }

        _isScanningDrive = driveName;

        try
        {
            foreach (var tier in Tiers)
            {
                await ScanAsync(driveName, tier);
            }
        }
        finally
        {
            _isScanningDrive = null;
        }
    }

    private async Task ScanAsync(
        string driveName,
        string tier)
    {
        if (_isScanning)
        {
            return;
        }

        _isScanning = true;
        _activeDriveName = driveName;
        _activeTier = tier;
        _statusMessage = $"Scanning {driveName} ({tier})...";
        await InvokeAsync(StateHasChanged);

        try
        {
            await SizeReductionCandidateService.GetCandidatesAsync(
                tier,
                driveName,
                forceRefresh: true);

            await RefreshUnscannedCountAsync();

            LoadCachedCandidates();

            _statusMessage = $"Scan complete for {driveName} ({tier}).";
        }
        catch (Exception ex)
        {
            _statusMessage = $"Scan failed: {ex.Message}";
        }
        finally
        {
            _isScanning = false;
            _activeDriveName = null;
            _activeTier = null;
        }
    }

    private async Task RefreshUnscannedCountAsync()
    {
        _unscannedCount =
            await SizeReductionCandidateService.CountUnscannedAssetsAsync();
    }

    private void ToggleTier(
        string tier,
        bool isChecked)
    {
        if (isChecked)
        {
            _selectedTiers.Add(tier);
        }
        else
        {
            _selectedTiers.Remove(tier);
        }

        LoadCachedCandidates();
    }

    private void ToggleExpanded(
        Guid mediaAssetId)
    {
        if (!_expandedAssetIds.Add(mediaAssetId))
        {
            _expandedAssetIds.Remove(mediaAssetId);
        }
    }

    private bool IsExpanded(
        Guid mediaAssetId) =>
        _expandedAssetIds.Contains(mediaAssetId);

    private void LoadCachedCandidates()
    {
        var candidates =
            _profiles
                .SelectMany(profile =>
                    _selectedTiers.SelectMany(tier =>
                        CandidateCache.GetCandidates(profile.Name, tier)))
                .Where(candidate => candidate.SavingsBytes >= SizeReductionCandidateService.MinSavingsBytes)
                .ToList();

        _groups =
            candidates
                .GroupBy(candidate => candidate.MediaAssetId)
                .Select(group =>
                {
                    var first = group.First();

                    return new AssetGroup
                    {
                        MediaAssetId = group.Key,
                        AssetTitle = first.AssetTitle,
                        AssetYear = first.AssetYear,
                        Season = first.Season,
                        Episode = first.Episode,
                        CanonicalPath = first.CanonicalPath,
                        AssetSizeBytes = first.AssetSizeBytes,
                        AssetResolution = first.AssetResolution,
                        AssetVideoCodec = first.AssetVideoCodec,
                        Candidates = group
                            .OrderByDescending(candidate => candidate.IsUpgrade)
                            .ThenByDescending(candidate => candidate.IsSameResolution)
                            .ThenByDescending(candidate => candidate.SavingsBytes)
                            .ToList()
                    };
                })
                .ToList();

        ApplySort();

        // "Has anything ever been scanned" is independent of the current
        // tier filter - unchecking every tier shouldn't make the page think
        // no scan has ever run.
        _hasScanned =
            _profiles.Any(profile =>
                Tiers.Any(tier =>
                    CandidateCache.GetLastScanUtc(profile.Name, tier) is not null));
    }

    private void SetSort(
        string column)
    {
        if (_sortColumn == column)
        {
            _sortDescending = !_sortDescending;
        }
        else
        {
            _sortColumn = column;
            _sortDescending = true;
        }

        ApplySort();
    }

    private void ApplySort()
    {
        IOrderedEnumerable<AssetGroup> sorted =
            _sortColumn switch
            {
                "Title" =>
                    _sortDescending
                        ? _groups.OrderByDescending(group => group.AssetTitle)
                        : _groups.OrderBy(group => group.AssetTitle),
                "CurrentSize" =>
                    _sortDescending
                        ? _groups.OrderByDescending(group => group.AssetSizeBytes)
                        : _groups.OrderBy(group => group.AssetSizeBytes),
                "CandidateCount" =>
                    _sortDescending
                        ? _groups.OrderByDescending(group => group.Candidates.Count)
                        : _groups.OrderBy(group => group.Candidates.Count),
                "Savings" =>
                    _sortDescending
                        ? _groups.OrderByDescending(group => group.BestSavingsBytes)
                        : _groups.OrderBy(group => group.BestSavingsBytes),
                _ =>
                    _groups
                        .OrderByDescending(group => group.Candidates.Any(candidate => candidate.IsUpgrade))
                        .ThenByDescending(group => group.Candidates.Any(candidate => candidate.IsSameResolution))
                        .ThenByDescending(group => group.BestSavingsBytes)
            };

        _groups = sorted.ToList();
    }

    private string SortIndicator(
        string column)
    {
        if (_sortColumn != column)
        {
            return string.Empty;
        }

        return _sortDescending ? "▼" : "▲";
    }

    private static string FormatScanTime(
        DateTime? scanUtc)
    {
        if (!scanUtc.HasValue)
        {
            return "Never";
        }

        return new DateTimeOffset(
                DateTime.SpecifyKind(scanUtc.Value, DateTimeKind.Utc))
            .LocalDateTime
            .ToString("g");
    }
}
