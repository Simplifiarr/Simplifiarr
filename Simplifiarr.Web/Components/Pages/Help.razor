@page "/help"

@using Simplifiarr.Core.Utilities

<PageTitle>Help - Simplifiarr</PageTitle>

<PageHeader Title="Help"
            Subtitle="Store once. Seed everywhere. Waste nothing. What each page is for, and how Simplifiarr keeps your files safe." />

@* Scrolled by hand: Blazor's own navigation doesn't scroll to a #section. *@
<nav class="help-contents" aria-label="On this page">
    <a href="help#start" onclick="document.getElementById('start').scrollIntoView({behavior:'smooth'}); return false;">Getting started</a>
    <a href="help#scan" onclick="document.getElementById('scan').scrollIntoView({behavior:'smooth'}); return false;">Scanning</a>
    <a href="help#link" onclick="document.getElementById('link').scrollIntoView({behavior:'smooth'}); return false;">Link</a>
    <a href="help#clean" onclick="document.getElementById('clean').scrollIntoView({behavior:'smooth'}); return false;">Clean up</a>
    <a href="help#safety" onclick="document.getElementById('safety').scrollIntoView({behavior:'smooth'}); return false;">Safety net</a>
    <a href="help#settings" onclick="document.getElementById('settings').scrollIntoView({behavior:'smooth'}); return false;">Settings</a>
    <a href="help#questions" onclick="document.getElementById('questions').scrollIntoView({behavior:'smooth'}); return false;">Questions</a>
</nav>

@* ------------------------------------------------------------------ Start *@

<section class="section" id="start">
    <h2 class="section-title">Getting started</h2>

    <div class="panel help-panel">
        <p>
            A <strong>hardlink</strong> lets one file appear in two folders while taking up the
            space of one. Simplifiarr uses that so a download can keep seeding while the same
            file sits in your library - no second copy.
        </p>

        <ol class="help-steps">
            <li>
                <strong>Add your drives.</strong>
                In <a href="settings">Settings</a>, add one entry per drive with its downloads folder
                and whichever library folders it has. Hardlinks only work within one drive, so each
                drive is set up on its own.
            </li>
            <li>
                <strong>Connect your apps (optional).</strong>
                Your torrent client, Radarr, Sonarr, Prowlarr and Jellyfin each unlock more. Simplifiarr
                works without any of them.
            </li>
            <li>
                <strong>Press Scan.</strong>
                It's at the top of every page.
            </li>
            <li>
                <strong>Look at Home.</strong>
                It shows what the scan found and links to anything that needs you.
            </li>
        </ol>
    </div>
</section>

@* ------------------------------------------------------------------- Scan *@

<section class="section" id="scan">
    <h2 class="section-title">Scanning</h2>

    <div class="panel help-panel">
        <p>
            There is one <strong>Scan</strong> button, at the top of every page. It reads every drive
            in Settings and refreshes every list in Simplifiarr at once. It runs on the server, so you
            can move between pages or close the browser and it carries on. <strong>Stop</strong>
            ends it early; lists keep what they had.
        </p>

        <p class="mb-0">
            The first scan of a large library takes a while, because each video's resolution is read
            once. Later scans only look at what changed and are much quicker.
        </p>
    </div>

    <p class="cell-note">
        A few pages search elsewhere and have their own button instead:
        Size Reduction and Cross-Seed (your indexers) and Posters (Jellyfin).
    </p>
</section>

@* ------------------------------------------------------------------- Link *@

<section class="section" id="link">
    <h2 class="section-title">Link</h2>

    <div class="panel">
        @foreach (var page in LinkPages)
        {
            <HelpRow Page="page" />
        }
    </div>
</section>

@* ---------------------------------------------------------------- Clean up *@

<section class="section" id="clean">
    <h2 class="section-title">Clean up</h2>

    <div class="panel">
        @foreach (var page in CleanPages)
        {
            <HelpRow Page="page" />
        }
    </div>
</section>

@* -------------------------------------------------------------- Safety net *@

<section class="section" id="safety">
    <h2 class="section-title">Safety net</h2>

    <div class="panel help-panel">
        <p>Simplifiarr is built so a mistake can be undone:</p>

        <ul>
            <li>It never copies a file from one drive to another, and never deletes a file outright.</li>
            <li>Anything taken out of a library goes to <a href="quarantine">Quarantine</a> first. Restore puts it back; Delete sends it to the Windows Recycle Bin.</li>
            <li>A hardlink is only counted as done once Simplifiarr has checked it really is the same file.</li>
            <li>Cross-seeds and rebuilt torrents are only offered once every piece has been checked against your files, and are added to your torrent client stopped.</li>
            <li>Anything that changes files asks you to confirm first.</li>
            <li>The only change Simplifiarr makes to a torrent already in your torrent client is Move Seeds, one torrent at a time when you ask. It is undone if the client's check doesn't pass.</li>
        </ul>
    </div>

    <div class="panel mt-3">
        @foreach (var page in SafetyPages)
        {
            <HelpRow Page="page" />
        }
    </div>
</section>

@* --------------------------------------------------------------- Settings *@

<section class="section" id="settings">
    <h2 class="section-title">Settings</h2>

    <div class="panel help-panel">
        <dl class="help-terms">
            <dt>Drives</dt>
            <dd>
                One entry per drive. <em>Downloads folder</em> is where finished torrents land;
                the library folders are where your organised Movies, TV, Books, Audiobooks, Music and
                Comics live. Leave out any you don't have. Audiobooks, music and comics each need their
                own downloads folder, because their files can't be told apart by content alone.
                Each path says whether it exists as you type. Starting fresh?
                <code>scripts\new-media-folders.ps1 -Drive D</code> in the Simplifiarr folder
                creates the whole set for a drive and prints what to type here.
            </dd>

            <dt>Connections</dt>
            <dd>
                Your torrent client, qBittorrent for now (what is still seeding), Radarr and Sonarr (exact titles, genres and episode
                numbers; Hardlinks uses their folders and folder formats), Prowlarr (searching your indexers), Jellyfin (Collections and Posters) and an
                optional fanart.tv key (more posters). Each has a Test button.
            </dd>

            <dt>Storage</dt>
            <dd class="mb-0">
                Where Quarantine, History and cross-seed links are kept, and where to find ffprobe.
                Simplifiarr's own settings are in <code>@AppPaths.SettingsFile</code>.
            </dd>
        </dl>
    </div>
</section>

@* -------------------------------------------------------------- Questions *@

<section class="section" id="questions">
    <h2 class="section-title">Questions</h2>

    <div class="panel">
        @foreach (var (question, answer) in Questions)
        {
            <details class="help-question">
                <summary>@question</summary>
                <p>@answer</p>
            </details>
        }
    </div>
</section>

@code
{
    public sealed record HelpPage(
        string Href,
        string Icon,
        string Name,
        string Text);

    private static readonly HelpPage[] LinkPages =
    [
        new("hardlinks", "link-45deg", "Hardlinks",
            "Finished downloads that aren't in your library yet. Preview where each one will go, then link it in - it keeps seeding and costs no extra space. TV is grouped by show and season."),
        new("potential-waste", "arrow-repeat", "Potential Waste",
            "Library files that are full copies of a download. Converting swaps the copy for a hardlink; the old copy goes to Quarantine."),
        new("move-seeds", "truck", "Move Seeds",
            "Torrents seeding from one drive while Sonarr or Radarr copied them into a library on another. Moving the seed to the library's drive leaves one shared copy. The torrent client checks every piece before the old copy goes to the Recycle Bin, and the torrent is left paused."),
        new("cross-seed", "share", "Cross-Seed",
            "Finds other torrents of files you already seed, so you can seed them on more trackers without downloading anything."),
        new("torrent-rebuilder", "hammer", "Torrent Rebuilder",
            "Rebuilds one torrent from files already in your library, even renamed ones, so it can seed straight away."),
        new("collections", "collection", "Collections",
            "Group anything in your libraries and send the group to Jellyfin as a collection. Sending again only changes what changed."),
        new("posters", "image", "Posters",
            "Choose the poster for any film, show or collection in Jellyfin from every poster found online, or drop in your own.")
    ];

    private static readonly HelpPage[] CleanPages =
    [
        new("duplicates", "copy", "Duplicates",
            "The same title more than once in your libraries, usually two qualities. Pick the one to keep."),
        new("junk-cleanup", "trash3", "Junk",
            "Sample clips, checksum and tracker files, and stray images left in your libraries."),
        new("download-cleanup", "folder-x", "Downloads",
            "Downloads your library already has, on any drive, that your torrent client is no longer seeding. Each is checked byte for byte against the library copy."),
        new("playback-errors", "exclamation-octagon", "Playback Errors",
            "Files your media server may not be able to open: blocked by Windows, permissions it can't read, still packed in an archive, empty, unfinished, or badly named. Several can be fixed in one click."),
        new("size-reduction", "file-earmark-zip", "Size Reduction",
            "Smaller releases of films and episodes you have, found on your indexers. Report only.")
    ];

    private static readonly HelpPage[] SafetyPages =
    [
        new("quarantine", "box-seam", "Quarantine",
            "Everything Simplifiarr took out of a library, waiting for you to restore or delete it."),
        new("history", "clock-history", "History",
            "Every change Simplifiarr has made on disk, newest first."),
        new("ignored", "eye-slash", "Ignored",
            "Things you've told Simplifiarr to stop suggesting. Un-ignore one to see it again.")
    ];

    private static readonly (string Question, string Answer)[] Questions =
    [
        ("Why can't Simplifiarr link a download on one drive into a library on another?",
         "Hardlinks only work within one drive. Linking across drives would mean copying the file, which is exactly what Simplifiarr exists to avoid. Download to the drive the library is on."),
        ("I deleted the download - is my library copy gone too?",
         "No. Both names point at the same data, and it stays until the last name is deleted. Deleting either one leaves the other working."),
        ("Something I expected isn't on a list.",
         "Lists show what the last scan found. Press Scan, and check the item isn't on the Ignored page and its folder is in Settings."),
        ("Why does a film show 'resolution not known'?",
         "Simplifiarr reads it with ffprobe. If ffprobe isn't installed or can't be found, set its location under Settings, Storage."),
        ("Does Simplifiarr change Radarr, Sonarr or Jellyfin?",
         "It only reads Radarr and Sonarr. In Jellyfin it only changes collections it made and posters you choose. In your torrent client it adds torrents stopped, and moves a seed only when you press Move."),
        ("Where are the logs?",
         $"In {AppPaths.LogsDirectory}. They are the first place to look if something goes wrong.")
    ];
}
