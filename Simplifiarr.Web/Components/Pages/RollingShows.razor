@page "/rolling-shows"
@rendermode InteractiveServer
@implements IDisposable

@using System.Text.Json
@using Simplifiarr.Core.Models
@using Simplifiarr.Core.Services
@using Simplifiarr.Core.Utilities

@inject IRollingShowService Rolling
@inject ISonarrShowClient Sonarr
@inject IJellyfinClient Jellyfin
@inject ITorrentClient Client
@inject NavigationManager Navigation

<PageTitle>Rolling Shows - Simplifiarr</PageTitle>

<PageHeader Title="Rolling Shows"
            Subtitle="For daily and weekly shows: keep only the newest episodes, and older ones go by themselves as new ones arrive." />

@if (_problem is not null)
{
    <div class="alert alert-warning">@_problem</div>
}

@if (_message is not null)
{
    <div class="alert alert-info">@_message</div>
}

@if (_editing is { } edited)
{
    @* ------------------------------------------------------------ Editor *@

    <div class="group-card">
        <div class="group-card-header">
            <div class="group-card-title">@edited.SeriesTitle</div>
        </div>

        <div style="padding: 0 1.1rem 1.1rem">
            <div class="d-flex flex-wrap align-items-center gap-2" style="font-size: 1.1rem">
                <span>Keep the last</span>
                <input class="form-control"
                       type="number"
                       min="1"
                       style="max-width: 6rem"
                       aria-label="How many"
                       value="@_count"
                       @oninput="e => SetCount(e.Value)" />
                <select class="form-select" style="max-width: 10rem" aria-label="Of what" value="@_unit" @onchange="e => SetUnit(e.Value)">
                    <option value="@KeepUnit.Episodes">episodes</option>
                    <option value="@KeepUnit.Days">days</option>
                    <option value="@KeepUnit.Weeks">weeks</option>
                    <option value="@KeepUnit.Seasons">seasons</option>
                </select>
            </div>

            <div class="form-check mt-3">
                <input id="wait-watched" class="form-check-input" type="checkbox" checked="@(edited.Watched != WatchRequirement.None)" @onchange="e => SetWatched(e.Value is true)" />
                <label class="form-check-label" for="wait-watched">
                    Wait until it's been watched
                </label>
            </div>

            @if (edited.Watched != WatchRequirement.None)
            {
                <div class="ms-4 mt-1 d-flex flex-wrap gap-1 align-items-center" role="group" aria-label="Watched by">
                    <span class="me-1">by</span>
                    <button type="button" class="btn btn-sm @(Watchers.Count == 0 ? "btn-primary" : "btn-outline-secondary")" aria-pressed="@(Watchers.Count == 0)" @onclick="() => ToggleWatcher(null)">anyone</button>
                    @foreach (var user in _users)
                    {
                        var picked = Watchers.Contains(user, StringComparer.OrdinalIgnoreCase);
                        <button type="button" class="btn btn-sm @(picked ? "btn-primary" : "btn-outline-secondary")" aria-pressed="@picked" @onclick="() => ToggleWatcher(user)">@user</button>
                    }
                </div>
                @if (Watchers.Count > 1)
                {
                    <div class="cell-note ms-4">An episode waits until @(Watchers.Count == 2 ? "both" : $"all {Watchers.Count}") of them have watched it.</div>
                }
            }

            @if (edited.Watched != WatchRequirement.None)
            {
                <div class="cell-note ms-4">
                    @(edited.UnwatchedAfterDays is { } wait
                        ? $"Unwatched episodes still go once they aired over {wait} days ago."
                        : "Unwatched episodes are never deleted.")
                </div>
            }

            @* The live answer to "what would this do?" *@
            <div class="panel mt-3 mb-0">
                @if (_previewing)
                {
                    <span class="cell-note">Checking...</span>
                }
                else if (_preview is null)
                {
                    <span class="cell-note">Set how many to keep.</span>
                }
                else if (_preview.Problem is not null)
                {
                    <span class="status-warn">@_preview.Problem</span>
                }
                else if (_preview.Deletions.Count == 0)
                {
                    <span>Right now nothing would be deleted: all @_preview.EpisodesWithFiles episode(s) stay.</span>
                }
                else
                {
                    <span>
                        Right now this deletes <strong>@_preview.Deletions.Count</strong> of @_preview.EpisodesWithFiles episodes
                        (@SizeFormatter.FormatBytes(_preview.Deletions.Sum(deletion => deletion.Episode.SizeBytes)))@AiredRange.
                    </span>

                    <details class="mt-2">
                        <summary>Which ones</summary>
                        <ul class="cell-note mb-0 mt-1">
                            @foreach (var deletion in _preview.Deletions.Take(100))
                            {
                                <li>
                                    S@(deletion.Episode.Season.ToString("00"))E@(deletion.Episode.Number.ToString("00"))
                                    @deletion.Episode.Title
                                    · @(deletion.Episode.AiredUtc?.ToLocalTime().ToString("d MMM yyyy") ?? "no air date")
                                    · @deletion.Reason
                                </li>
                            }
                        </ul>
                    </details>
                }
            </div>

            <div class="cell-actions mt-3" style="flex-wrap: wrap; align-items: center">
                <button type="button" class="btn btn-primary" disabled="@(_busy || !CanSave)" @onclick="() => SaveAsync(turnOn: true)">
                    @(_busy ? "Working..." : "Turn on")
                </button>
                <button type="button" class="btn btn-secondary" disabled="@_busy" @onclick="CloseEditor">Cancel</button>

                @if (IsSaved(edited))
                {
                    <button type="button" class="btn btn-link btn-sm" disabled="@_busy" @onclick="() => SaveAsync(turnOn: false)">Save but leave off</button>
                }
            </div>
            <div class="cell-note">
                Turning on deletes what's listed above straight away, then keeps the show trimmed as new episodes arrive.
            </div>

            <details class="mt-4">
                <summary>More options</summary>

                <div class="mt-2">
                    <div class="detail-label" style="margin-top: 0">Deleted episodes go</div>
                    <div class="form-check">
                        <input id="del-recycle" class="form-check-input" type="radio" name="permanent" checked="@(!edited.Permanent)" @onchange="() => edited.Permanent = false" />
                        <label class="form-check-label" for="del-recycle">to Quarantine, where you can restore them</label>
                    </div>
                    <div class="form-check">
                        <input id="del-permanent" class="form-check-input" type="radio" name="permanent" checked="@edited.Permanent" @onchange="() => edited.Permanent = true" />
                        <label class="form-check-label" for="del-permanent">for good (daily shows fill Quarantine fast)</label>
                    </div>

                    @if (_unit != KeepUnit.Episodes)
                    {
                        <div class="detail-label">But always keep at least</div>
                        <div class="d-flex align-items-center gap-2">
                            <input class="form-control" type="number" min="0" style="max-width: 6rem" placeholder="0" aria-label="At least" value="@edited.MinimumKeep" @oninput="e => SetFloor(e.Value)" />
                            <span>episodes, for when the show is on a break</span>
                        </div>
                    }

                    @if (_unit == KeepUnit.Seasons)
                    {
                        <div class="detail-label">A new season takes over</div>
                        <div class="d-flex flex-wrap align-items-center gap-2">
                            <select class="form-select" style="max-width: 18rem" aria-label="When" value="@edited.SeasonSwitch" @onchange="e => SetSwitch(e.Value)">
                                <option value="@SeasonSwitch.FirstEpisode">with its first episode</option>
                                <option value="@SeasonSwitch.AfterEpisodes">once this many episodes are in</option>
                                <option value="@SeasonSwitch.AfterDays">this many days after it starts</option>
                            </select>
                            @if (edited.SeasonSwitch != SeasonSwitch.FirstEpisode)
                            {
                                <input class="form-control" type="number" min="1" style="max-width: 6rem" aria-label="How many" value="@edited.SeasonSwitchValue" @oninput="e => SetSwitchValue(e.Value)" />
                            }
                        </div>
                    }

                    @if (edited.Watched != WatchRequirement.None)
                    {
                        <div class="detail-label">Unwatched episodes still go after</div>
                        <div class="d-flex align-items-center gap-2">
                            <input class="form-control" type="number" min="1" style="max-width: 6rem" placeholder="Never" aria-label="Days" value="@edited.UnwatchedAfterDays" @oninput="e => SetUnwatched(e.Value)" />
                            <span>days (blank: never)</span>
                        </div>
                    }

                    <div class="detail-label">Episodes still seeding</div>
                    <div class="cell-note mb-1">
                        Their library copy goes at once. The torrent keeps seeding, tagged <code>@RollingShowService.DeleteTag</code>,
                        and is removed from @Client.Name when it stops, or after:
                    </div>
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <input class="form-control" type="number" min="0" style="max-width: 6rem" placeholder="-" aria-label="Days" @bind="edited.SeedDays" />
                        <span>days, or ratio</span>
                        <input class="form-control" type="number" min="0" step="0.1" style="max-width: 6rem" placeholder="-" aria-label="Ratio" @bind="edited.SeedRatio" />
                    </div>

                    @if (IsSaved(edited))
                    {
                        <div class="detail-label">Remove this show</div>
                        @if (_confirmRemove)
                        {
                            <button type="button" class="btn btn-danger btn-sm" @onclick="() => RemoveRule(edited)">Remove it</button>
                            <button type="button" class="btn btn-secondary btn-sm" @onclick="() => _confirmRemove = false">Keep</button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-outline-danger btn-sm" @onclick="() => _confirmRemove = true">Remove...</button>
                        }
                        <div class="cell-note">Nothing already deleted comes back, and nothing else changes.</div>
                    }
                </div>
            </details>
        </div>
    </div>
}
else
{
    @* ------------------------------------------------------------- Rules *@

    <div class="toolbar">
        <div class="toolbar-actions">
            <select class="form-select" aria-label="Add a show" value="0" @onchange="e => StartNew(e.Value)">
                <option value="0">+ Add a show...</option>
                @foreach (var show in _shows.Where(show => Rolling.Rules.All(rule => rule.SeriesId != show.Id)))
                {
                    <option value="@show.Id">@show.Title</option>
                }
            </select>
        </div>
    </div>

    @if (Rolling.Rules.Count == 0)
    {
        <EmptyState Icon="arrow-repeat" Text="No shows yet. Add one above." />
    }
    else
    {
        <div class="table-scroll">
            <table class="table">
                <tbody>
                    @foreach (var rule in Rolling.Rules)
                    {
                        <tr @key="rule.Id">
                            <td>
                                <div class="file-name">@rule.SeriesTitle</div>
                                <div class="cell-note">
                                    @RollingShowPlanner.Describe(rule)
                                    @if (rule.LastRunUtc is { } ran)
                                    {
                                        <text> · @LastRunText(rule, ran)</text>
                                    }
                                </div>
                            </td>
                            <td class="text-nowrap" style="width: 1%">
                                <div class="form-check form-switch d-inline-block me-2" title="@(rule.IsOn ? "On" : "Off")">
                                    <input class="form-check-input" type="checkbox" role="switch" id="@($"on-{rule.Id}")" checked="@rule.IsOn" @onchange="e => Toggle(rule, e.Value is true)" />
                                    <label class="form-check-label" for="@($"on-{rule.Id}")">@(rule.IsOn ? "On" : "Off")</label>
                                </div>
                                <button type="button" class="btn btn-secondary btn-sm" @onclick="() => EditAsync(rule)">Edit</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (Rolling.Seeds.Count > 0)
    {
        <details class="mt-3">
            <summary>@Rolling.Seeds.Count torrent(s) still seeding before they're removed</summary>
            <ul class="cell-note">
                @foreach (var seed in Rolling.Seeds)
                {
                    <li>@seed.Name</li>
                }
            </ul>
        </details>
    }

    <details class="mt-4">
        <summary>Make it instant (optional)</summary>
        <div class="panel mt-2 help-panel">
            Shows are trimmed on every Scan. To trim them the moment Sonarr imports a new episode, add a webhook in Sonarr:
            <ol class="mb-0 mt-2">
                <li>Settings, Connect, the + button, then <strong>Webhook</strong>.</li>
                <li>Tick <strong>On Import</strong> and <strong>On Upgrade</strong>.</li>
                <li>URL: <code>@WebhookUrl</code>, method <strong>POST</strong>.</li>
                <li>Press Test, then Save.</li>
            </ol>
            <div class="cell-note mt-2">If Sonarr runs on another computer, use this computer's address at the start.</div>
        </div>
    </details>
}

@code
{
    private IReadOnlyList<SonarrShow> _shows = [];
    private List<string> _users = [];

    private RollingShowRule? _editing;
    private int _count = 7;
    private KeepUnit _unit = KeepUnit.Days;

    private RollingPreview? _preview;
    private bool _previewing;
    private CancellationTokenSource? _previewDelay;

    private bool _busy;
    private bool _confirmRemove;
    private string? _problem;
    private string? _message;

    private string WebhookUrl =>
        $"{Navigation.BaseUri.TrimEnd('/')}/api/hooks/sonarr/{Rolling.WebhookKey}";

    private IReadOnlyList<string> Watchers =>
        _editing?.Watched == WatchRequirement.User ? _editing.Watchers : [];

    private bool CanSave =>
        _editing is { HasAnyLimit: true } && _preview is { Problem: null } && !_previewing;

    private string AiredRange
    {
        get
        {
            var dates = _preview?.Deletions.Select(deletion => deletion.Episode.AiredUtc).OfType<DateTime>().ToList() ?? [];

            if (dates.Count == 0)
            {
                return string.Empty;
            }

            var first = dates.Min().ToLocalTime();
            var last = dates.Max().ToLocalTime();

            return first.Date == last.Date
                ? $", aired {first:d MMM}"
                : $", aired {first:d MMM yyyy} to {last:d MMM yyyy}";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Rolling.Changed += OnChanged;

        try
        {
            _shows = await Sonarr.GetShowsAsync();

            if (_shows.Count == 0)
            {
                _problem = "Sonarr isn't set up, or has no shows. Add it in Settings, under Connections.";
            }
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or JsonException)
        {
            _problem = $"Couldn't reach Sonarr: {exception.Message}";
        }

        try
        {
            _users = (await Jellyfin.GetUsersAsync()).Select(user => user.Name).OrderBy(name => name).ToList();
        }
        catch (InvalidOperationException)
        {
            // Jellyfin not set up: "watched by" offers only "anyone".
        }
    }

    // ---------------------------------------------------------------- Editing

    private bool IsSaved(RollingShowRule rule) =>
        Rolling.Rules.Any(saved => saved.Id == rule.Id);

    private async Task StartNew(object? value)
    {
        if (!int.TryParse(value?.ToString(), out var id) ||
            _shows.FirstOrDefault(show => show.Id == id) is not { } show)
        {
            return;
        }

        var rule = new RollingShowRule { SeriesId = show.Id, SeriesTitle = show.Title, SeriesPath = show.Path, SeedDays = 7 };
        rule.SetSimple(7, KeepUnit.Days);

        await OpenAsync(rule);
    }

    // Edits a copy, so Cancel leaves the saved rule as it was.
    private Task EditAsync(RollingShowRule rule) =>
        OpenAsync(JsonSerializer.Deserialize<RollingShowRule>(JsonSerializer.Serialize(rule))!);

    private async Task OpenAsync(RollingShowRule rule)
    {
        _editing = rule;
        (_count, _unit) = rule.Simple;
        rule.SetSimple(_count, _unit);

        _message = null;
        _confirmRemove = false;
        _preview = null;

        await RefreshPreviewAsync();
    }

    private void CloseEditor()
    {
        _previewDelay?.Cancel();
        _editing = null;
        _preview = null;
    }

    private void SetCount(object? value)
    {
        if (int.TryParse(value?.ToString(), out var count) && count > 0)
        {
            _count = count;
            Changed();
        }
    }

    private void SetUnit(object? value)
    {
        if (Enum.TryParse<KeepUnit>(value?.ToString(), out var unit))
        {
            _unit = unit;
            Changed();
        }
    }

    private void SetWatched(bool wait)
    {
        if (_editing is null)
        {
            return;
        }

        _editing.Watched = wait ? WatchRequirement.Anyone : WatchRequirement.None;
        _editing.WatchedBy = string.Empty;
        _editing.WatchedByUsers = [];

        // A sensible cap, so a show nobody watches can't pile up.
        if (wait && _editing.UnwatchedAfterDays is null)
        {
            _editing.UnwatchedAfterDays = 30;
        }

        Changed();
    }

    // "anyone" (null) clears the picks; a name is added or taken away.
    private void ToggleWatcher(string? user)
    {
        if (_editing is null)
        {
            return;
        }

        var picked = Watchers.ToList();

        if (user is null)
        {
            picked.Clear();
        }
        else if (picked.RemoveAll(name => string.Equals(name, user, StringComparison.OrdinalIgnoreCase)) == 0)
        {
            picked.Add(user);
        }

        _editing.WatchedByUsers = picked;
        _editing.WatchedBy = string.Empty;
        _editing.Watched = picked.Count == 0 ? WatchRequirement.Anyone : WatchRequirement.User;
        Changed();
    }

    private void SetFloor(object? value)
    {
        if (_editing is not null)
        {
            _editing.MinimumKeep = int.TryParse(value?.ToString(), out var floor) && floor > 0 ? floor : null;
            Changed();
        }
    }

    private void SetSwitch(object? value)
    {
        if (_editing is not null && Enum.TryParse<SeasonSwitch>(value?.ToString(), out var when))
        {
            _editing.SeasonSwitch = when;
            Changed();
        }
    }

    private void SetSwitchValue(object? value)
    {
        if (_editing is not null && int.TryParse(value?.ToString(), out var number) && number > 0)
        {
            _editing.SeasonSwitchValue = number;
            Changed();
        }
    }

    private void SetUnwatched(object? value)
    {
        if (_editing is not null)
        {
            _editing.UnwatchedAfterDays = int.TryParse(value?.ToString(), out var days) && days > 0 ? days : null;
            Changed();
        }
    }

    // Anything that changes what gets deleted refreshes the preview, a
    // moment after typing stops.
    private void Changed()
    {
        _editing?.SetSimple(_count, _unit);

        _previewDelay?.Cancel();
        _previewDelay = new CancellationTokenSource();

        var token = _previewDelay.Token;
        _previewing = true;

        _ = InvokeAsync(async () =>
        {
            try
            {
                await Task.Delay(400, token);
                await RefreshPreviewAsync();
                StateHasChanged();
            }
            catch (TaskCanceledException)
            {
                // A newer change is on its way.
            }
        });
    }

    private async Task RefreshPreviewAsync()
    {
        if (_editing is null)
        {
            return;
        }

        _previewing = true;

        try
        {
            _preview = await Rolling.PreviewAsync(_editing);
        }
        finally
        {
            _previewing = false;
        }
    }

    private async Task SaveAsync(bool turnOn)
    {
        if (_editing is not { } rule)
        {
            return;
        }

        _busy = true;

        try
        {
            rule.SetSimple(_count, _unit);
            rule.IsOn = turnOn;
            Rolling.Save(rule);

            _message =
                turnOn
                    ? $"{rule.SeriesTitle} is on. {await Rolling.RunRuleAsync(rule.Id)}"
                    : $"{rule.SeriesTitle} saved but off: nothing is deleted.";

            CloseEditor();
        }
        finally
        {
            _busy = false;
        }
    }

    // ------------------------------------------------------------ The list

    private async Task Toggle(RollingShowRule rule, bool on)
    {
        if (on)
        {
            // Turning on deletes straight away, so it goes through the
            // editor, where you see what first.
            await EditAsync(rule);
            _message = "Check what it deletes, then press Turn on.";

            return;
        }

        var copy = JsonSerializer.Deserialize<RollingShowRule>(JsonSerializer.Serialize(rule))!;
        copy.IsOn = false;
        Rolling.Save(copy);

        _message = $"{rule.SeriesTitle} is off: nothing more is deleted.";
    }

    private void RemoveRule(RollingShowRule rule)
    {
        Rolling.Remove(rule.Id);
        _message = $"Removed {rule.SeriesTitle}.";
        CloseEditor();
    }

    private static string LastRunText(RollingShowRule rule, DateTime ranUtc)
    {
        var when = ranUtc.ToLocalTime();
        var day = when.Date == DateTime.Today ? "today" : when.ToString("ddd d MMM");

        return $"last run {day}: {rule.LastRunMessage}";
    }

    private void OnChanged() =>
        _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        _previewDelay?.Cancel();
        Rolling.Changed -= OnChanged;
    }
}
