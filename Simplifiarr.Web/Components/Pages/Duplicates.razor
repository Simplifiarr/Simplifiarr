@page "/duplicates"
@rendermode InteractiveServer
@implements IDisposable

@using Simplifiarr.Core.Models
@using Simplifiarr.Core.Services
@using Simplifiarr.Core.Utilities

@inject IMediaCatalogService MediaCatalogService
@inject ISettingsService SettingsService
@inject IDuplicateAssetAnalysisService DuplicateAssetAnalysisService
@inject IQuarantineService QuarantineService
@inject IHistoryService HistoryService
@inject IIgnoredItemsService IgnoredItemsService
@inject IScanCoordinator Scans

<PageTitle>Duplicates - Simplifiarr</PageTitle>

<PageHeader Title="Duplicates"
            Subtitle="The same title more than once across your libraries - usually two qualities of one film or episode. Hardlinks of one file are not listed, because they don't take extra space." />

@if (_isScanning)
{
    <div class="alert alert-info">
        A scan is running. This page will update when it finishes.
    </div>
}

@if (!string.IsNullOrWhiteSpace(_statusMessage))
{
    <div class="alert alert-info">
        @_statusMessage
    </div>
}

@if (!_loaded)
{
    <EmptyState Icon="hourglass-split" Text="Comparing your libraries..." />
}
else if (_totalAssets == 0)
{
    <EmptyState Icon="search" Text="Nothing has been scanned yet. Press Scan at the top of the page." />
}
else if (_groups.Count == 0)
{
    <EmptyState Icon="check-circle" Text="No title appears more than once in your libraries." />
}
else
{
    <div class="app-tabs" role="tablist" aria-label="Media type">
        <button type="button"
                role="tab"
                aria-selected="@(_activeType is null)"
                class="app-tab @(_activeType is null ? "active" : null)"
                @onclick="() => ShowType(null)">
            All <span class="app-tab-count">@_groups.Count</span>
        </button>

        @foreach (var type in TypesPresent)
        {
            <button type="button"
                    role="tab"
                    aria-selected="@(_activeType == type)"
                    class="app-tab @(_activeType == type ? "active" : null)"
                    @onclick="() => ShowType(type)">
                @TypeLabel(type) <span class="app-tab-count">@_groups.Count(group => group.MediaType == type)</span>
            </button>
        }
    </div>

    <div class="toolbar">
        <div class="toolbar-summary">
            <strong>@Filtered.Count</strong> title(s) ·
            <strong>@SizeFormatter.FormatBytes(Filtered.Sum(group => group.ReclaimableSizeBytes))</strong>
            freed if you keep only the largest copy of each
        </div>

        <div class="toolbar-actions">
            <label class="visually-hidden" for="duplicate-filter">Filter by title</label>
            <input id="duplicate-filter"
                   type="search"
                   class="form-control form-control-sm"
                   style="width: 14rem"
                   placeholder="Filter by title"
                   @bind="_filter"
                   @bind:event="oninput"
                   @bind:after="ResetPaging" />
        </div>
    </div>

    @if (Filtered.Count == 0)
    {
        <EmptyState Icon="funnel" Text="No titles match that filter." />
    }

    @foreach (var group in Filtered.Take(_shown))
    {
        <div class="group-card" @key="group">
            <div class="group-card-header">
                <div class="group-card-title">
                    @GroupTitle(group)

                    @if (_activeType is null)
                    {
                        <span class="pill ms-1">@TypeLabel(group.MediaType)</span>
                    }
                </div>

                <div class="group-card-meta">
                    @group.Entries.Count copies ·
                    @SizeFormatter.FormatBytes(group.ReclaimableSizeBytes) could be freed
                </div>
            </div>

            <div class="table-scroll">
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>File</th>
                            <th>Drive</th>
                            <th class="col-num">Size</th>
                            <th>Quality</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @for (var index = 0; index < group.Entries.Count; index++)
                        {
                            var entry = group.Entries[index];
                            var isLargest = index == 0;

                            var isConfirming =
                                string.Equals(_confirmPath, entry.CanonicalPath, StringComparison.OrdinalIgnoreCase);

                            <tr @key="entry.CanonicalPath">
                                <td>
                                    <div class="file-name">
                                        @Path.GetFileName(entry.CanonicalPath)

                                        @if (isLargest)
                                        {
                                            <span class="pill ms-1" title="The biggest copy, usually the best quality">Largest</span>
                                        }
                                    </div>
                                    <div class="cell-note">@Path.GetDirectoryName(entry.CanonicalPath)</div>
                                </td>

                                <td>@(string.IsNullOrWhiteSpace(entry.DriveProfileName) ? "-" : entry.DriveProfileName)</td>

                                <td class="col-num">@SizeFormatter.FormatBytes(entry.SizeBytes)</td>

                                <td>@Quality(entry)</td>

                                <td>
                                    <div class="cell-actions">
                                        @if (isConfirming)
                                        {
                                            <button type="button"
                                                    class="btn btn-danger btn-sm"
                                                    disabled="@IsBusy"
                                                    @onclick="() => QuarantineAsync(group, entry)">
                                                @(_isWorking ? "Moving..." : "Move to Quarantine")
                                            </button>

                                            <button type="button"
                                                    class="btn btn-secondary btn-sm"
                                                    disabled="@_isWorking"
                                                    @onclick="() => _confirmPath = null">
                                                Cancel
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button"
                                                    class="btn btn-outline-danger btn-sm"
                                                    title="Moves this copy to Quarantine. It can be restored from there."
                                                    disabled="@IsBusy"
                                                    @onclick="() => _confirmPath = entry.CanonicalPath">
                                                Remove
                                            </button>

                                            <button type="button"
                                                    class="btn btn-secondary btn-sm"
                                                    title="Hide this file from this page. Undo it on the Ignored page."
                                                    disabled="@IsBusy"
                                                    @onclick="() => Ignore(group, entry)">
                                                Not a duplicate
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @if (Filtered.Count > _shown)
    {
        <button type="button"
                class="btn btn-secondary"
                @onclick="() => _shown += PageSize">
            Show @Math.Min(PageSize, Filtered.Count - _shown) more (@(Filtered.Count - _shown) left)
        </button>
    }
}

@code
{
    // Each title draws its own small table, so show them a page at a time
    // rather than all at once on a big library.
    private const int PageSize = 25;

    private static readonly MediaType[] TypeOrder =
    [
        MediaType.Movie, MediaType.TvEpisode, MediaType.Book,
        MediaType.Audiobook, MediaType.Music, MediaType.Comic
    ];

    private List<DuplicateAssetGroup> _groups = [];
    private int _totalAssets;
    private bool _loaded;

    private MediaType? _activeType;
    private string _filter = string.Empty;
    private int _shown = PageSize;

    private string? _confirmPath;
    private bool _isWorking;
    private bool _isScanning;

    private string _statusMessage = string.Empty;

    private bool IsBusy =>
        _isWorking || _isScanning;

    private List<MediaType> TypesPresent =>
        TypeOrder
            .Where(type => _groups.Any(group => group.MediaType == type))
            .ToList();

    private List<DuplicateAssetGroup> Filtered =>
        _groups
            .Where(group => _activeType is null || group.MediaType == _activeType)
            .Where(group =>
                string.IsNullOrWhiteSpace(_filter) ||
                GroupTitle(group).Contains(_filter.Trim(), StringComparison.OrdinalIgnoreCase))
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        _isScanning = Scans.Progress.IsRunning;

        Scans.Changed += OnScanChanged;

        await LoadAsync();
    }

    private void OnScanChanged()
    {
        _ = InvokeAsync(async () =>
        {
            var isRunning = Scans.Progress.IsRunning;

            if (isRunning == _isScanning)
            {
                return;
            }

            var justFinished = _isScanning && !isRunning;

            _isScanning = isRunning;

            if (justFinished)
            {
                _confirmPath = null;

                await LoadAsync();
            }

            StateHasChanged();
        });
    }

    private async Task LoadAsync()
    {
        var enabledProfiles =
            await SettingsService.GetEnabledDriveProfilesAsync();

        var assets =
            MediaCatalogService.GetAssets();

        _totalAssets = assets.Count;

        var groups =
            await DuplicateAssetAnalysisService.FindDuplicatesAsync(
                assets,
                enabledProfiles);

        // Files marked "not a duplicate" are dropped; a title left with a
        // single copy is no longer a duplicate.
        foreach (var group in groups)
        {
            group.Entries.RemoveAll(entry =>
                IgnoredItemsService.IsIgnored(entry.CanonicalPath));
        }

        groups.RemoveAll(group => group.Entries.Count <= 1);

        _groups = groups;

        if (_activeType is not null &&
            !_groups.Any(group => group.MediaType == _activeType))
        {
            _activeType = null;
        }

        _loaded = true;
    }

    private void ShowType(MediaType? type)
    {
        _activeType = type;
        _confirmPath = null;

        ResetPaging();
    }

    private void ResetPaging() =>
        _shown = PageSize;

    private void Ignore(
        DuplicateAssetGroup group,
        DuplicateAssetEntry entry)
    {
        if (IsBusy)
        {
            return;
        }

        IgnoredItemsService.Add(
            new IgnoredItem
            {
                SourcePath = entry.CanonicalPath,
                Title = group.Title,
                Category =
                    group.MediaType switch
                    {
                        MediaType.TvEpisode or MediaType.TvSeason => IgnoredCategory.Tv,
                        MediaType.Book => IgnoredCategory.Book,
                        MediaType.Audiobook => IgnoredCategory.Audiobook,
                        MediaType.Music => IgnoredCategory.Music,
                        MediaType.Comic => IgnoredCategory.Comic,
                        _ => IgnoredCategory.Movie
                    },
                Author = group.Author,
                Year = group.Year,
                Season = group.Season,
                Episode = group.Episode,
                DriveProfileName = entry.DriveProfileName,
                IgnoredUtc = DateTime.UtcNow,
                Reason = "Marked not a duplicate"
            });

        RemoveEntry(group, entry);

        _statusMessage =
            $"\"{Path.GetFileName(entry.CanonicalPath)}\" won't be listed as a duplicate any more. Undo this on the Ignored page.";
    }

    private async Task QuarantineAsync(
        DuplicateAssetGroup group,
        DuplicateAssetEntry entry)
    {
        if (IsBusy)
        {
            return;
        }

        _isWorking = true;

        var fileName = Path.GetFileName(entry.CanonicalPath);

        try
        {
            var quarantinePath =
                await QuarantineService.QuarantineFileAsync(entry.CanonicalPath);

            var success =
                !string.IsNullOrWhiteSpace(quarantinePath);

            await HistoryService.AddRecordAsync(
                new HistoryRecord
                {
                    ActionType = HistoryActionType.DuplicateQuarantined,
                    FileName = fileName,
                    LibraryPath = entry.CanonicalPath,
                    QuarantinePath = quarantinePath ?? string.Empty,
                    SizeBytes = entry.SizeBytes,
                    Success = success,
                    Message =
                        success
                            ? "Duplicate quarantined."
                            : "Failed to quarantine duplicate."
                });

            if (success)
            {
                RemoveEntry(group, entry);
            }

            _statusMessage =
                success
                    ? $"Moved \"{fileName}\" to Quarantine. Delete it there to free the space, or restore it if you change your mind."
                    : $"Couldn't move \"{fileName}\" to Quarantine. It was left where it is.";
        }
        catch (Exception ex)
        {
            _statusMessage =
                $"Couldn't move \"{fileName}\" to Quarantine: {ex.Message}";
        }
        finally
        {
            _confirmPath = null;
            _isWorking = false;
        }
    }

    private void RemoveEntry(
        DuplicateAssetGroup group,
        DuplicateAssetEntry entry)
    {
        group.Entries.Remove(entry);

        if (group.Entries.Count <= 1)
        {
            _groups.Remove(group);
        }
    }

    private static string Quality(
        DuplicateAssetEntry entry)
    {
        var parts =
            new[] { entry.Resolution, entry.VideoCodec }
                .Where(part =>
                    !string.IsNullOrWhiteSpace(part) &&
                    !string.Equals(part, "UNKNOWN", StringComparison.OrdinalIgnoreCase))
                .Select(part => part.ToLowerInvariant());

        var text = string.Join(" · ", parts);

        return text.Length == 0 ? "-" : text;
    }

    private static string TypeLabel(MediaType type) =>
        type switch
        {
            MediaType.Movie => "Movies",
            MediaType.TvEpisode => "TV",
            MediaType.Book => "Books",
            MediaType.Audiobook => "Audiobooks",
            MediaType.Music => "Music",
            MediaType.Comic => "Comics",
            _ => type.ToString()
        };

    private static string GroupTitle(
        DuplicateAssetGroup group)
    {
        return group.MediaType switch
        {
            MediaType.TvEpisode when group.Season.HasValue || group.Episode.HasValue =>
                $"{group.Title} - S{group.Season ?? 0:00}E{group.Episode ?? 0:00}",

            MediaType.Book or MediaType.Audiobook or MediaType.Music or MediaType.Comic =>
                string.IsNullOrWhiteSpace(group.Author)
                    ? group.Title
                    : $"{group.Title} ({group.Author})",

            _ =>
                group.Year.HasValue
                    ? $"{group.Title} ({group.Year})"
                    : group.Title
        };
    }

    public void Dispose() =>
        Scans.Changed -= OnScanChanged;
}
