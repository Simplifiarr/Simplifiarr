@page "/quarantine"
@rendermode InteractiveServer

@using Simplifiarr.Core.Models
@using Simplifiarr.Core.Services
@using Simplifiarr.Core.Utilities

@inject IQuarantineInventoryService QuarantineInventoryService
@inject IQuarantineManagementService QuarantineManagementService
@inject IHistoryService HistoryService

<PageTitle>Quarantine - Simplifiarr</PageTitle>

<PageHeader Title="Quarantine"
            Subtitle="Files Simplifiarr moved out of your libraries, held here until you decide. Restore puts one back where it came from. Delete sends it to the Windows Recycle Bin, so even that can be undone." />

@if (!string.IsNullOrWhiteSpace(_statusMessage))
{
    <div class="alert alert-info">
        @_statusMessage
    </div>
}

@if (_items is null)
{
    <EmptyState Icon="hourglass-split" Text="Loading..." />
}
else if (_items.Count == 0)
{
    <EmptyState Icon="shield-check" Text="Quarantine is empty." />
}
else
{
    @if (_isConfirmingBatch)
    {
        <BatchConfirmBanner CssClass="alert alert-danger"
                            IsBusy="_isWorking"
                            ConfirmLabel="Send to Recycle Bin"
                            BusyLabel="Deleting..."
                            OnConfirm="ConfirmBatchAsync"
                            OnCancel="CancelBatch">
            <Message>
                <strong>
                    Send @_pending.Count file(s)
                    (@SizeFormatter.FormatBytes(_pending.Sum(item => item.SizeBytes))) to the Recycle Bin?
                </strong>
                The space is freed once the Recycle Bin is emptied.
            </Message>
        </BatchConfirmBanner>
    }
    else
    {
        <div class="toolbar">
            <div class="toolbar-summary">
                <strong>@_items.Count</strong> file(s) ·
                <strong>@SizeFormatter.FormatBytes(_items.Sum(item => item.SizeBytes))</strong> held
                @if (_selection.Count > 0)
                {
                    <text> · @_selection.Count selected</text>
                }
            </div>

            <div class="toolbar-actions">
                <button type="button"
                        class="btn btn-outline-danger btn-sm"
                        disabled="@_isWorking"
                        @onclick="() => RequestBatch(_items.ToList())">
                    Delete all
                </button>

                <button type="button"
                        class="btn btn-danger btn-sm"
                        disabled="@(_isWorking || _selection.Count == 0)"
                        @onclick="() => RequestBatch(_items.Where(_selection.IsSelected).ToList())">
                    Delete selected (@_selection.Count)
                </button>
            </div>
        </div>
    }

    <div class="table-scroll">
        <table class="table">
            <thead>
                <tr>
                    <th class="col-check">Select</th>
                    <th>File</th>
                    <th class="col-num">Size</th>
                    <th>Quarantined</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in _items.Take(_shown))
                {
                    var originalPath =
                        _originalPaths.GetValueOrDefault(item.FullPath);

                    var isConfirmingDelete =
                        string.Equals(_confirmDeletePath, item.FullPath, StringComparison.OrdinalIgnoreCase);

                    var isConfirmingRestore =
                        string.Equals(_confirmRestorePath, item.FullPath, StringComparison.OrdinalIgnoreCase);

                    <tr @key="item.FullPath">
                        <SelectableCheckboxCell Checked="_selection.IsSelected(item)"
                                                Disabled="_isWorking"
                                                OnChanged="selected => _selection.SetSelected(item, selected)" />

                        <td>
                            <div class="file-name">@item.FileName</div>

                            @if (originalPath is not null)
                            {
                                <div class="cell-note">Came from @Path.GetDirectoryName(originalPath)</div>
                            }
                            else
                            {
                                <div class="cell-note">Original location not on record, so it can't be restored from here</div>
                            }

                            @if (isConfirmingRestore)
                            {
                                <div class="cell-note status-warn">
                                    Restoring replaces whatever is at that path now - normally the hardlink that took this file's place.
                                </div>
                            }
                        </td>

                        <td class="col-num">@SizeFormatter.FormatBytes(item.SizeBytes)</td>

                        <td style="white-space: nowrap">@item.CreatedUtc.ToLocalTime().ToString("g")</td>

                        <td>
                            <div class="cell-actions">
                                @if (isConfirmingDelete)
                                {
                                    <button type="button"
                                            class="btn btn-danger btn-sm"
                                            disabled="@_isWorking"
                                            @onclick="() => DeleteManyAsync([item])">
                                        Send to Recycle Bin
                                    </button>

                                    <button type="button"
                                            class="btn btn-secondary btn-sm"
                                            disabled="@_isWorking"
                                            @onclick="() => _confirmDeletePath = null">
                                        Cancel
                                    </button>
                                }
                                else if (isConfirmingRestore)
                                {
                                    <button type="button"
                                            class="btn btn-primary btn-sm"
                                            disabled="@_isWorking"
                                            @onclick="() => RestoreAsync(item, originalPath!)">
                                        Confirm restore
                                    </button>

                                    <button type="button"
                                            class="btn btn-secondary btn-sm"
                                            disabled="@_isWorking"
                                            @onclick="() => _confirmRestorePath = null">
                                        Cancel
                                    </button>
                                }
                                else
                                {
                                    @if (originalPath is not null)
                                    {
                                        <button type="button"
                                                class="btn btn-secondary btn-sm"
                                                disabled="@_isWorking"
                                                @onclick="() => AskRestore(item.FullPath)">
                                            Restore
                                        </button>
                                    }

                                    <button type="button"
                                            class="btn btn-outline-danger btn-sm"
                                            disabled="@_isWorking"
                                            @onclick="() => AskDelete(item.FullPath)">
                                        Delete
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (_items.Count > _shown)
    {
        <button type="button"
                class="btn btn-secondary mt-3"
                @onclick="() => _shown += PageSize">
            Show @Math.Min(PageSize, _items.Count - _shown) more (@(_items.Count - _shown) left)
        </button>
    }
}

@code
{
    private const int PageSize = 100;

    private List<QuarantineItem>? _items;

    // Where each quarantined file came from, looked up from History.
    private Dictionary<string, string> _originalPaths =
        new(StringComparer.OrdinalIgnoreCase);

    private List<QuarantineItem> _pending = [];

    private readonly CandidateSelection<QuarantineItem> _selection =
        new(item => item.FullPath);

    private int _shown = PageSize;

    private string? _confirmDeletePath;
    private string? _confirmRestorePath;

    private bool _isConfirmingBatch;
    private bool _isWorking;

    private string _statusMessage = string.Empty;

    protected override Task OnInitializedAsync() =>
        RefreshAsync();

    private async Task RefreshAsync()
    {
        _items =
            (await QuarantineInventoryService.GetItemsAsync())
                .OrderByDescending(item => item.CreatedUtc)
                .ToList();

        var history =
            await HistoryService.GetHistoryAsync();

        _originalPaths =
            history
                .Where(record =>
                    !string.IsNullOrWhiteSpace(record.QuarantinePath) &&
                    !string.IsNullOrWhiteSpace(record.LibraryPath))
                .OrderByDescending(record => record.TimestampUtc)
                .GroupBy(
                    record => record.QuarantinePath,
                    StringComparer.OrdinalIgnoreCase)
                .ToDictionary(
                    group => group.Key,
                    group => group.First().LibraryPath,
                    StringComparer.OrdinalIgnoreCase);

        _selection.Clear();
        _confirmDeletePath = null;
        _confirmRestorePath = null;
    }

    private void AskDelete(string fullPath)
    {
        _confirmRestorePath = null;
        _confirmDeletePath = fullPath;
    }

    private void AskRestore(string fullPath)
    {
        _confirmDeletePath = null;
        _confirmRestorePath = fullPath;
    }

    private void RequestBatch(
        List<QuarantineItem> items)
    {
        if (_isWorking || items.Count == 0)
        {
            return;
        }

        _confirmDeletePath = null;
        _confirmRestorePath = null;

        _pending = items;
        _isConfirmingBatch = true;
    }

    private void CancelBatch()
    {
        _isConfirmingBatch = false;
        _pending = [];
    }

    private async Task ConfirmBatchAsync()
    {
        var items = _pending.ToList();

        CancelBatch();

        await DeleteManyAsync(items);
    }

    private async Task RestoreAsync(
        QuarantineItem item,
        string originalLibraryPath)
    {
        if (_isWorking)
        {
            return;
        }

        _isWorking = true;

        try
        {
            var restored =
                await QuarantineManagementService.RestoreAsync(
                    item.FullPath,
                    originalLibraryPath);

            _statusMessage =
                restored
                    ? $"Restored {item.FileName} to where it came from."
                    : $"Couldn't restore {item.FileName}. It is still in Quarantine.";

            await RefreshAsync();
        }
        catch (Exception ex)
        {
            _statusMessage =
                $"Couldn't restore {item.FileName}: {ex.Message}";
        }
        finally
        {
            _isWorking = false;
        }
    }

    private async Task DeleteManyAsync(
        List<QuarantineItem> items)
    {
        if (_isWorking || items.Count == 0)
        {
            return;
        }

        _isWorking = true;

        await InvokeAsync(StateHasChanged);

        var deleted = 0;
        var failed = 0;
        var bytes = 0L;

        try
        {
            foreach (var item in items)
            {
                if (await QuarantineManagementService.DeleteAsync(item.FullPath))
                {
                    deleted++;
                    bytes += item.SizeBytes;
                }
                else
                {
                    failed++;
                }
            }

            _statusMessage =
                failed == 0
                    ? $"Sent {deleted} file(s) ({SizeFormatter.FormatBytes(bytes)}) to the Recycle Bin."
                    : $"Sent {deleted} file(s) to the Recycle Bin; {failed} could not be deleted and are still here.";

            await RefreshAsync();
        }
        catch (Exception ex)
        {
            _statusMessage =
                $"Stopped part-way: {ex.Message}";

            await RefreshAsync();
        }
        finally
        {
            _isWorking = false;
        }
    }
}
