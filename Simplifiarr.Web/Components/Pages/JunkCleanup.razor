@page "/junk-cleanup"
@rendermode InteractiveServer
@inherits ScanAwareComponent

@using Simplifiarr.Core.Models
@using Simplifiarr.Core.Services
@using Simplifiarr.Core.Utilities

@inject ISettingsService SettingsService
@inject IJunkFileScannerService JunkFileScannerService
@inject IQuarantineService QuarantineService
@inject IHistoryService HistoryService

<PageTitle>Junk - Simplifiarr</PageTitle>

<PageHeader Title="Junk"
            Subtitle="Release leftovers sitting in your libraries: sample clips, checksum and tracker files, and stray images. Removing one moves it to Quarantine, so it can be put back." />

<details class="mb-3">
    <summary>What counts as junk, and what never does</summary>

    <div class="mt-2 text-muted">
        Only library folders are checked - downloads are never touched, so a
        torrent that is still seeding is safe. Standard artwork
        (<code>folder.jpg</code>, <code>poster.jpg</code>, <code>backdrop.jpg</code>
        and so on) and <code>.nfo</code> files are always left alone, because
        Jellyfin, Plex and Kodi use them.
    </div>
</details>

@if (_profiles.Count == 0)
{
    <div class="alert alert-warning">
        No drives are set up yet. <a href="settings">Add one in Settings</a>.
    </div>
}
else if (IsScanning)
{
    <div class="alert alert-info">
        A scan is running. This page will update when it finishes.
    </div>
}

@if (!string.IsNullOrWhiteSpace(_statusMessage))
{
    <div class="alert alert-info">
        @_statusMessage
    </div>
}

@if (!_hasScanned)
{
    <EmptyState Icon="search" Text="No scan has looked for leftovers yet. Press Scan at the top of the page." />
}
else if (_candidates.Count == 0)
{
    <EmptyState Icon="check-circle" Text="No leftover files in your libraries." />
}
else
{
    <div class="app-tabs" role="tablist" aria-label="Kind of leftover">
        <button type="button"
                role="tab"
                aria-selected="@(_activeReason is null)"
                class="app-tab @(_activeReason is null ? "active" : null)"
                @onclick="() => ShowReason(null)">
            All <span class="app-tab-count">@_candidates.Count</span>
        </button>

        @foreach (var reason in Reasons)
        {
            <button type="button"
                    role="tab"
                    aria-selected="@(_activeReason == reason)"
                    class="app-tab @(_activeReason == reason ? "active" : null)"
                    @onclick="() => ShowReason(reason)">
                @ShortReason(reason) <span class="app-tab-count">@_candidates.Count(candidate => candidate.Reason == reason)</span>
            </button>
        }
    </div>

    @if (_isConfirming)
    {
        <BatchConfirmBanner IsBusy="_isProcessing"
                            ConfirmLabel="Move to Quarantine"
                            BusyLabel="Moving..."
                            OnConfirm="ConfirmAsync"
                            OnCancel="CancelConfirm">
            <Message>
                <strong>Move @_pending.Count file(s) to Quarantine?</strong>
                Only these leftover files are moved - no video, book or audio file is touched.
            </Message>
        </BatchConfirmBanner>
    }
    else
    {
        <div class="toolbar">
            <div class="toolbar-summary">
                <strong>@Visible.Count</strong> file(s) ·
                <strong>@SizeFormatter.FormatBytes(Visible.Sum(candidate => candidate.SizeBytes))</strong>
                @if (_selection.Count > 0)
                {
                    <text> · @_selection.Count selected</text>
                }
            </div>

            <div class="toolbar-actions">
                <button type="button"
                        class="btn btn-secondary btn-sm"
                        disabled="@IsBusy"
                        @onclick="() => RequestConfirm(Visible)">
                    Remove all
                </button>

                <button type="button"
                        class="btn btn-primary btn-sm"
                        disabled="@(IsBusy || _selection.Count == 0)"
                        @onclick="() => RequestConfirm(Visible.Where(_selection.IsSelected).ToList())">
                    Remove selected (@_selection.Count)
                </button>
            </div>
        </div>
    }

    <div class="table-scroll">
        <table class="table">
            <thead>
                <tr>
                    <th class="col-check">Select</th>
                    <th>File</th>
                    <th>Why it's listed</th>
                    <th>Drive</th>
                    <th class="col-num">Size</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var candidate in Visible.Take(_shown))
                {
                    <tr @key="candidate.FilePath">
                        <SelectableCheckboxCell Checked="_selection.IsSelected(candidate)"
                                                Disabled="IsBusy"
                                                OnChanged="selected => _selection.SetSelected(candidate, selected)" />

                        <td>
                            <div class="file-name">@candidate.FileName</div>
                            <div class="cell-note">@Path.GetDirectoryName(candidate.FilePath)</div>
                        </td>

                        <td>@candidate.Reason</td>
                        <td>@candidate.DriveProfileName</td>
                        <td class="col-num">@SizeFormatter.FormatBytes(candidate.SizeBytes)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Visible.Count > _shown)
    {
        <button type="button"
                class="btn btn-secondary mt-3"
                @onclick="() => _shown += PageSize">
            Show @Math.Min(PageSize, Visible.Count - _shown) more (@(Visible.Count - _shown) left)
        </button>
    }
}

@code
{
    private const int PageSize = 100;

    private List<DriveProfile> _profiles = [];

    private List<JunkFileCandidate> _candidates = [];

    private readonly CandidateSelection<JunkFileCandidate> _selection =
        new(candidate => candidate.FilePath);

    private List<JunkFileCandidate> _pending = [];

    private string? _activeReason;
    private int _shown = PageSize;

    private string _statusMessage = string.Empty;

    private bool _hasScanned;
    private bool _isConfirming;
    private bool _isProcessing;

    private bool IsBusy =>
        _isProcessing || IsScanning;

    private List<string> Reasons =>
        _candidates
            .Select(candidate => candidate.Reason)
            .Distinct()
            .OrderBy(reason => reason)
            .ToList();

    private List<JunkFileCandidate> Visible =>
        _candidates
            .Where(candidate => _activeReason is null || candidate.Reason == _activeReason)
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        _profiles =
            await SettingsService.GetEnabledDriveProfilesAsync();

        LoadCandidates();
    }

    protected override Task OnScanFinishedAsync()
    {
        CancelConfirm();

        _selection.Clear();
        _statusMessage = string.Empty;

        LoadCandidates();

        return Task.CompletedTask;
    }

    private void LoadCandidates()
    {
        _candidates =
            _profiles
                .SelectMany(profile =>
                    JunkFileScannerService.GetCandidates(profile.Name))
                .OrderBy(candidate => candidate.DriveProfileName)
                .ThenBy(candidate => candidate.FilePath)
                .ToList();

        _hasScanned =
            _profiles.Any(profile =>
                JunkFileScannerService.GetLastScanUtc(profile.Name).HasValue);

        if (_activeReason is not null &&
            !_candidates.Any(candidate => candidate.Reason == _activeReason))
        {
            _activeReason = null;
        }
    }

    private void ShowReason(string? reason)
    {
        if (_isProcessing)
        {
            return;
        }

        _activeReason = reason;
        _shown = PageSize;

        // Don't carry ticks over to a tab where they can't be seen.
        _selection.Clear();

        CancelConfirm();
    }

    // The tab label: the reason without its bracketed explanation.
    private static string ShortReason(string reason)
    {
        var bracket = reason.IndexOf(" (", StringComparison.Ordinal);

        return bracket > 0 ? reason[..bracket] : reason;
    }

    private void RequestConfirm(
        List<JunkFileCandidate> candidates)
    {
        if (IsBusy || candidates.Count == 0)
        {
            return;
        }

        _pending = candidates;
        _isConfirming = true;
    }

    private void CancelConfirm()
    {
        _isConfirming = false;
        _pending = [];
    }

    private async Task ConfirmAsync()
    {
        if (IsBusy || _pending.Count == 0)
        {
            return;
        }

        _isProcessing = true;

        var moved = 0;
        var failed = 0;

        try
        {
            foreach (var candidate in _pending.ToList())
            {
                var quarantinePath =
                    await QuarantineService.QuarantineFileAsync(candidate.FilePath);

                var success = !string.IsNullOrWhiteSpace(quarantinePath);

                await HistoryService.AddRecordAsync(
                    new HistoryRecord
                    {
                        ActionType = HistoryActionType.JunkFileQuarantined,
                        FileName = candidate.FileName,
                        LibraryPath = candidate.FilePath,
                        QuarantinePath = quarantinePath ?? string.Empty,
                        SizeBytes = candidate.SizeBytes,
                        Success = success,
                        Message =
                            success
                                ? $"Junk file quarantined ({candidate.Reason})."
                                : "Failed to quarantine junk file."
                    });

                if (success)
                {
                    moved++;

                    JunkFileScannerService.RemoveCandidate(candidate.FilePath);

                    _selection.Remove(candidate);
                }
                else
                {
                    failed++;
                }
            }

            _statusMessage =
                failed == 0
                    ? $"Moved {moved} file(s) to Quarantine."
                    : $"Moved {moved} file(s) to Quarantine; {failed} could not be moved and were left where they are.";

            LoadCandidates();
        }
        catch (Exception ex)
        {
            _statusMessage =
                $"Stopped part-way: {ex.Message}";

            LoadCandidates();
        }
        finally
        {
            CancelConfirm();

            _isProcessing = false;
        }
    }
}
