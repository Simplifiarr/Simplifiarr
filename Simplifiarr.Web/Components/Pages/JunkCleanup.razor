@page "/junk-cleanup"
@rendermode InteractiveServer
@inherits ScanAwareComponent

@using Simplifiarr.Core.Models
@using Simplifiarr.Core.Services
@using Simplifiarr.Core.Utilities

@inject ISettingsService SettingsService
@inject IJunkFileScannerService JunkFileScannerService
@inject IQuarantineService QuarantineService
@inject IHistoryService HistoryService

<PageTitle>Junk - Simplifiarr</PageTitle>

<PageHeader Title="Junk"
            Subtitle="Release leftovers sitting in your libraries: sample clips, checksum and tracker files, and stray images. Removing one moves it to Quarantine, so it can be put back." />

<details class="panel rules-panel mb-3">
    <summary>What counts as junk</summary>

    <div class="rules-body">
        <div class="form-check">
            <input id="junk-samples" class="form-check-input" type="checkbox" checked="@_rules.SampleVideos" @onchange="e => ChangeAsync(() => _rules.SampleVideos = e.Value is true)" />
            <label class="form-check-label" for="junk-samples">Sample clips (<code>sample.mkv</code>, <code>Movie-sample.mkv</code>)</label>
        </div>
        <div class="form-check">
            <input id="junk-sample-folders" class="form-check-input" type="checkbox" checked="@_rules.SampleFolderLeftovers" @onchange="e => ChangeAsync(() => _rules.SampleFolderLeftovers = e.Value is true)" />
            <label class="form-check-label" for="junk-sample-folders">Everything inside a release's Sample folder</label>
        </div>
        <div class="form-check">
            <input id="junk-images" class="form-check-input" type="checkbox" checked="@_rules.UnrecognizedImages" @onchange="e => ChangeAsync(() => _rules.UnrecognizedImages = e.Value is true)" />
            <label class="form-check-label" for="junk-images">Images that aren't pictures you keep (like <code>screen1.jpg</code> or a tracker's banner)</label>
        </div>

        @if (_rules.UnrecognizedImages)
        {
            <div class="rule-row">
                <div class="rule-label">Pictures to keep</div>
                <div class="d-flex flex-wrap gap-3">
                    @foreach (var (kind, label, names) in JunkRules.PictureKinds)
                    {
                        <div class="form-check mb-0" title="@string.Join(", ", names.Select(name => name + ".jpg"))">
                            <input id="keep-@kind"
                                   class="form-check-input"
                                   type="checkbox"
                                   checked="@(!_rules.UnwantedPictures.Contains(kind))"
                                   @onchange="e => ChangeAsync(() => SetPictureKept(kind, e.Value is true))" />
                            <label class="form-check-label" for="keep-@kind">@label</label>
                        </div>
                    }
                </div>
                <div class="cell-note">Unticked ones count as junk. Hover one to see the file names it covers.</div>
            </div>
        }

        <div class="rule-row">
            <div class="rule-label">These file types</div>
            <div class="d-flex flex-wrap gap-1 align-items-center">
                @foreach (var extension in _rules.Extensions)
                {
                    <span class="badge text-bg-primary d-inline-flex align-items-center gap-1 rule-chip">
                        @extension
                        <button type="button" class="btn-close btn-close-white" aria-label="@($"Stop treating {extension} as junk")" @onclick="() => ChangeAsync(() => _rules.Extensions.Remove(extension))"></button>
                    </span>
                }
                <input class="form-control form-control-sm rule-input" placeholder=".exe" aria-label="Add a file type" value="@_newExtension" @onchange="e => AddExtensionAsync(e.Value?.ToString())" />
            </div>
            @if (Suggestions.Count > 0)
            {
                <div class="d-flex flex-wrap gap-1 mt-1">
                    @foreach (var (extension, note) in Suggestions)
                    {
                        <button type="button" class="btn btn-sm btn-outline-secondary rule-suggestion" title="@note" @onclick="() => AddExtensionAsync(extension)">+ @extension</button>
                    }
                </div>
            }
            @if (_rules.Extensions.Contains(".nfo"))
            {
                <div class="cell-note status-warn">Jellyfin, Plex and Kodi can read .nfo files for titles and artwork. Removing them is only safe if you don't rely on them.</div>
            }
        </div>

        <div class="rule-row">
            <div class="rule-label">Files named</div>
            <div class="d-flex flex-wrap gap-1 align-items-center">
                @foreach (var name in _rules.JunkNames)
                {
                    <span class="badge text-bg-primary d-inline-flex align-items-center gap-1 rule-chip">
                        @name
                        <button type="button" class="btn-close btn-close-white" aria-label="@($"Stop treating {name} as junk")" @onclick="() => ChangeAsync(() => _rules.JunkNames.Remove(name))"></button>
                    </span>
                }
                <input class="form-control form-control-sm rule-input" placeholder="RARBG*.txt" aria-label="Add a junk file name" value="@_newJunkName" @onchange="e => AddNameAsync(_rules.JunkNames, e.Value?.ToString(), keep: false)" />
            </div>
        </div>

        <div class="rule-row">
            <div class="rule-label">Never junk</div>
            <div class="d-flex flex-wrap gap-1 align-items-center">
                @foreach (var name in _rules.KeepNames)
                {
                    <span class="badge text-bg-secondary d-inline-flex align-items-center gap-1 rule-chip">
                        @name
                        <button type="button" class="btn-close btn-close-white" aria-label="@($"Stop keeping {name}")" @onclick="() => ChangeAsync(() => _rules.KeepNames.Remove(name))"></button>
                    </span>
                }
                <input class="form-control form-control-sm rule-input" placeholder="theme.mp3" aria-label="Add a file name to always keep" value="@_newKeepName" @onchange="e => AddNameAsync(_rules.KeepNames, e.Value?.ToString(), keep: true)" />
            </div>
        </div>

        <div class="cell-note">
            Use <code>*</code> for any text in a name: <code>*.exe</code>, <code>RARBG*.txt</code>.
            Videos, music, books, comics and subtitles are never junk (except sample clips), and
            downloads are never looked at, so anything still seeding is safe.
        </div>

        @if (_rulesNote is not null)
        {
            <div class="d-flex flex-wrap align-items-center gap-2 mt-2">
                <span class="cell-note">@_rulesNote</span>
                <button type="button" class="btn btn-sm btn-primary" disabled="@(_lookingAgain || IsScanning)" @onclick="LookAgainAsync">
                    @(_lookingAgain ? "Looking..." : "Look again now")
                </button>
            </div>
        }
    </div>
</details>

@if (_profiles.Count == 0)
{
    <div class="alert alert-warning">
        No drives are set up yet. <a href="settings">Add one in Settings</a>.
    </div>
}
else if (IsScanning)
{
    <div class="alert alert-info">
        A scan is running. This page will update when it finishes.
    </div>
}

@if (!string.IsNullOrWhiteSpace(_statusMessage))
{
    <div class="alert alert-info">
        @_statusMessage
    </div>
}

@if (!_hasScanned)
{
    <EmptyState Icon="search" Text="No scan has looked for leftovers yet. Press Scan at the top of the page." />
}
else if (_candidates.Count == 0)
{
    <EmptyState Icon="check-circle" Text="No leftover files in your libraries." />
}
else
{
    <div class="app-tabs" role="tablist" aria-label="Kind of leftover">
        <button type="button"
                role="tab"
                aria-selected="@(_activeReason is null)"
                class="app-tab @(_activeReason is null ? "active" : null)"
                @onclick="() => ShowReason(null)">
            All <span class="app-tab-count">@_candidates.Count</span>
        </button>

        @foreach (var reason in Reasons)
        {
            <button type="button"
                    role="tab"
                    aria-selected="@(_activeReason == reason)"
                    class="app-tab @(_activeReason == reason ? "active" : null)"
                    @onclick="() => ShowReason(reason)">
                @ShortReason(reason) <span class="app-tab-count">@_candidates.Count(candidate => candidate.Reason == reason)</span>
            </button>
        }
    </div>

    @if (_isConfirming)
    {
        <BatchConfirmBanner IsBusy="_isProcessing"
                            ConfirmLabel="Move to Quarantine"
                            BusyLabel="Moving..."
                            OnConfirm="ConfirmAsync"
                            OnCancel="CancelConfirm">
            <Message>
                <strong>Move @_pending.Count file(s) to Quarantine?</strong>
                Only these leftover files are moved - no video, book or audio file is touched.
            </Message>
        </BatchConfirmBanner>
    }
    else
    {
        <div class="toolbar">
            <div class="toolbar-summary">
                <strong>@Visible.Count</strong> file(s) ·
                <strong>@SizeFormatter.FormatBytes(Visible.Sum(candidate => candidate.SizeBytes))</strong>
                @if (_selection.Count > 0)
                {
                    <text> · @_selection.Count selected</text>
                }
            </div>

            <div class="toolbar-actions">
                <button type="button"
                        class="btn btn-secondary btn-sm"
                        disabled="@IsBusy"
                        @onclick="() => RequestConfirm(Visible)">
                    Remove all
                </button>

                <button type="button"
                        class="btn btn-primary btn-sm"
                        disabled="@(IsBusy || _selection.Count == 0)"
                        @onclick="() => RequestConfirm(Visible.Where(_selection.IsSelected).ToList())">
                    Remove selected (@_selection.Count)
                </button>
            </div>
        </div>
    }

    <div class="table-scroll">
        <table class="table">
            <thead>
                <tr>
                    <th class="col-check">Select</th>
                    <th>File</th>
                    <th>Why it's listed</th>
                    <th>Drive</th>
                    <th class="col-num">Size</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var candidate in Visible.Take(_shown))
                {
                    <tr @key="candidate.FilePath">
                        <SelectableCheckboxCell Checked="_selection.IsSelected(candidate)"
                                                Disabled="IsBusy"
                                                OnChanged="selected => _selection.SetSelected(candidate, selected)" />

                        <td>
                            <div class="file-name">@candidate.FileName</div>
                            <div class="cell-note">@Path.GetDirectoryName(candidate.FilePath)</div>
                        </td>

                        <td>@candidate.Reason</td>
                        <td>@candidate.DriveProfileName</td>
                        <td class="col-num">@SizeFormatter.FormatBytes(candidate.SizeBytes)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Visible.Count > _shown)
    {
        <button type="button"
                class="btn btn-secondary mt-3"
                @onclick="() => _shown += PageSize">
            Show @Math.Min(PageSize, Visible.Count - _shown) more (@(Visible.Count - _shown) left)
        </button>
    }
}

@code
{
    private const int PageSize = 100;

    private List<DriveProfile> _profiles = [];

    private List<JunkFileCandidate> _candidates = [];

    private readonly CandidateSelection<JunkFileCandidate> _selection =
        new(candidate => candidate.FilePath);

    private List<JunkFileCandidate> _pending = [];

    private string? _activeReason;
    private int _shown = PageSize;

    private string _statusMessage = string.Empty;

    private bool _hasScanned;
    private bool _isConfirming;
    private bool _isProcessing;

    private bool IsBusy =>
        _isProcessing || IsScanning;

    private List<string> Reasons =>
        _candidates
            .Select(candidate => candidate.Reason)
            .Distinct()
            .OrderBy(reason => reason)
            .ToList();

    private List<JunkFileCandidate> Visible =>
        _candidates
            .Where(candidate => _activeReason is null || candidate.Reason == _activeReason)
            .ToList();

    private JunkRules _rules = new();
    private string? _rulesNote;
    private bool _lookingAgain;
    private string _newExtension = string.Empty;
    private string _newJunkName = string.Empty;
    private string _newKeepName = string.Empty;

    private List<(string Extension, string Note)> Suggestions =>
        JunkRules.Suggestions.Where(suggestion => !_rules.Extensions.Contains(suggestion.Extension)).ToList();

    protected override async Task OnInitializedAsync()
    {
        _profiles =
            await SettingsService.GetEnabledDriveProfilesAsync();

        _rules =
            (await SettingsService.GetSettingsAsync()).Junk ?? new JunkRules();

        JunkFileScannerService.UseRules(_rules);

        LoadCandidates();
    }

    private async Task ChangeAsync(Action change)
    {
        change();

        var settings =
            await SettingsService.GetSettingsAsync();

        settings.Junk = _rules;

        await SettingsService.SaveSettingsAsync(settings);

        JunkFileScannerService.UseRules(_rules);
        _selection.Clear();
        CancelConfirm();
        LoadCandidates();

        _rulesNote = "Saved. Anything a rule no longer covers is already gone from the list; to find files a new rule covers, look again.";
    }

    private void SetPictureKept(string kind, bool keep)
    {
        _rules.UnwantedPictures.RemoveAll(unwanted => unwanted == kind);

        if (!keep)
        {
            _rules.UnwantedPictures.Add(kind);
        }
    }

    private async Task AddExtensionAsync(string? text)
    {
        _newExtension = text ?? string.Empty;

        if (JunkRules.NormalizeExtension(text) is not { } extension)
        {
            _rulesNote = string.IsNullOrWhiteSpace(text) ? _rulesNote : $"\"{text}\" isn't a file type. Type it like .exe";
            return;
        }

        if (FileScannerService.FileTypeOf(extension) is FileType.Video or FileType.Audio or FileType.Book or FileType.Comic or FileType.Subtitle)
        {
            _rulesNote = $"{extension} is a media file type, so it can't be junk.";
            return;
        }

        _newExtension = string.Empty;

        if (!_rules.Extensions.Contains(extension))
        {
            await ChangeAsync(() => _rules.Extensions.Add(extension));
        }
    }

    private async Task AddNameAsync(List<string> names, string? text, bool keep)
    {
        var name = (text ?? string.Empty).Trim();

        if (keep) { _newKeepName = name; } else { _newJunkName = name; }

        if (name.Length == 0 || name.IndexOfAny(['\\', '/']) >= 0)
        {
            _rulesNote = name.Length == 0 ? _rulesNote : "Use just a file name, not a folder path.";
            return;
        }

        if (keep) { _newKeepName = string.Empty; } else { _newJunkName = string.Empty; }

        if (!names.Contains(name, StringComparer.OrdinalIgnoreCase))
        {
            await ChangeAsync(() => names.Add(name));
        }
    }

    private async Task LookAgainAsync()
    {
        _lookingAgain = true;

        try
        {
            foreach (var profile in _profiles)
            {
                await JunkFileScannerService.ScanAsync(profile.Name);
            }

            _rulesNote = null;
            LoadCandidates();
        }
        catch (Exception exception)
        {
            _rulesNote = $"Looking again failed: {exception.Message}";
        }
        finally
        {
            _lookingAgain = false;
        }
    }

    protected override Task OnScanFinishedAsync()
    {
        CancelConfirm();

        _selection.Clear();
        _statusMessage = string.Empty;

        LoadCandidates();

        return Task.CompletedTask;
    }

    private void LoadCandidates()
    {
        _candidates =
            _profiles
                .SelectMany(profile =>
                    JunkFileScannerService.GetCandidates(profile.Name))
                .OrderBy(candidate => candidate.DriveProfileName)
                .ThenBy(candidate => candidate.FilePath)
                .ToList();

        _hasScanned =
            _profiles.Any(profile =>
                JunkFileScannerService.GetLastScanUtc(profile.Name).HasValue);

        if (_activeReason is not null &&
            !_candidates.Any(candidate => candidate.Reason == _activeReason))
        {
            _activeReason = null;
        }
    }

    private void ShowReason(string? reason)
    {
        if (_isProcessing)
        {
            return;
        }

        _activeReason = reason;
        _shown = PageSize;

        // Don't carry ticks over to a tab where they can't be seen.
        _selection.Clear();

        CancelConfirm();
    }

    // The tab label: the reason without its bracketed explanation.
    private static string ShortReason(string reason)
    {
        var bracket = reason.IndexOf(" (", StringComparison.Ordinal);

        return bracket > 0 ? reason[..bracket] : reason;
    }

    private void RequestConfirm(
        List<JunkFileCandidate> candidates)
    {
        if (IsBusy || candidates.Count == 0)
        {
            return;
        }

        _pending = candidates;
        _isConfirming = true;
    }

    private void CancelConfirm()
    {
        _isConfirming = false;
        _pending = [];
    }

    private async Task ConfirmAsync()
    {
        if (IsBusy || _pending.Count == 0)
        {
            return;
        }

        _isProcessing = true;

        var moved = 0;
        var failed = 0;

        try
        {
            foreach (var candidate in _pending.ToList())
            {
                var quarantinePath =
                    await QuarantineService.QuarantineFileAsync(candidate.FilePath);

                var success = !string.IsNullOrWhiteSpace(quarantinePath);

                await HistoryService.AddRecordAsync(
                    new HistoryRecord
                    {
                        ActionType = HistoryActionType.JunkFileQuarantined,
                        FileName = candidate.FileName,
                        LibraryPath = candidate.FilePath,
                        QuarantinePath = quarantinePath ?? string.Empty,
                        SizeBytes = candidate.SizeBytes,
                        Success = success,
                        Message =
                            success
                                ? $"Junk file quarantined ({candidate.Reason})."
                                : "Failed to quarantine junk file."
                    });

                if (success)
                {
                    moved++;

                    JunkFileScannerService.RemoveCandidate(candidate.FilePath);

                    _selection.Remove(candidate);
                }
                else
                {
                    failed++;
                }
            }

            _statusMessage =
                failed == 0
                    ? $"Moved {moved} file(s) to Quarantine."
                    : $"Moved {moved} file(s) to Quarantine; {failed} could not be moved and were left where they are.";

            LoadCandidates();
        }
        catch (Exception ex)
        {
            _statusMessage =
                $"Stopped part-way: {ex.Message}";

            LoadCandidates();
        }
        finally
        {
            CancelConfirm();

            _isProcessing = false;
        }
    }
}
