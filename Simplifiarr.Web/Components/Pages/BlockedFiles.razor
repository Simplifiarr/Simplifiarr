@page "/blocked-files"
@rendermode InteractiveServer
@inherits ScanAwareComponent

@using Simplifiarr.Core.Models
@using Simplifiarr.Core.Services
@using Simplifiarr.Core.Utilities

@inject ISettingsService SettingsService
@inject IBlockedFileService BlockedFileService
@inject IBlockedFileCacheService BlockedFileCache

<PageTitle>Blocked Files - Simplifiarr</PageTitle>

<PageHeader Title="Blocked Files"
            Subtitle="Library files Windows has marked as coming from the internet or another computer. That mark can cause security prompts and trip up media servers. Unblocking removes the mark from the file and changes nothing else." />

@if (_profiles.Count == 0)
{
    <div class="alert alert-warning">
        No drives are set up yet. <a href="settings">Add one in Settings</a>.
    </div>
}
else if (IsScanning)
{
    <div class="alert alert-info">
        A scan is running. This page will update when it finishes.
    </div>
}

@if (!string.IsNullOrWhiteSpace(_statusMessage))
{
    <div class="alert alert-info">
        @_statusMessage
    </div>
}

@if (!_hasScanned)
{
    <EmptyState Icon="search" Text="No scan has checked for blocked files yet. Press Scan at the top of the page." />
}
else if (_files.Count == 0)
{
    <EmptyState Icon="shield-check" Text="No library files are blocked." />
}
else
{
    @if (_isConfirming)
    {
        <BatchConfirmBanner IsBusy="_isUnblocking"
                            ConfirmLabel="Unblock"
                            BusyLabel="Unblocking..."
                            OnConfirm="ConfirmAsync"
                            OnCancel="CancelConfirm">
            <Message>
                <strong>Unblock @_pending.Count file(s)?</strong>
                Only these files are changed - no Windows security setting is touched.
            </Message>
        </BatchConfirmBanner>
    }
    else
    {
        <div class="toolbar">
            <div class="toolbar-summary">
                <strong>@_files.Count</strong> blocked file(s) ·
                <strong>@SizeFormatter.FormatBytes(_files.Sum(file => file.SizeBytes))</strong>
                @if (_selection.Count > 0)
                {
                    <text> · @_selection.Count selected</text>
                }
            </div>

            <div class="toolbar-actions">
                <button type="button"
                        class="btn btn-secondary btn-sm"
                        disabled="@IsBusy"
                        @onclick="() => RequestConfirm(_files.ToList())">
                    Unblock all
                </button>

                <button type="button"
                        class="btn btn-primary btn-sm"
                        disabled="@(IsBusy || _selection.Count == 0)"
                        @onclick="() => RequestConfirm(_files.Where(_selection.IsSelected).ToList())">
                    Unblock selected (@_selection.Count)
                </button>
            </div>
        </div>
    }

    <div class="table-scroll">
        <table class="table">
            <thead>
                <tr>
                    <th class="col-check">Select</th>
                    <th>File</th>
                    <th>Type</th>
                    <th>Drive</th>
                    <th class="col-num">Size</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var file in _files.Take(_shown))
                {
                    <tr @key="file.CanonicalPath">
                        <SelectableCheckboxCell Checked="_selection.IsSelected(file)"
                                                Disabled="IsBusy"
                                                OnChanged="selected => _selection.SetSelected(file, selected)" />

                        <td>
                            <div class="file-name">@file.Title</div>
                            <div class="cell-note">@file.CanonicalPath</div>

                            @if (!string.IsNullOrWhiteSpace(file.SourceUrl))
                            {
                                <div class="cell-note">Came from: @file.SourceUrl</div>
                            }
                        </td>

                        <td>@TypeLabel(file.MediaType)</td>
                        <td>@file.DriveProfileName</td>
                        <td class="col-num">@SizeFormatter.FormatBytes(file.SizeBytes)</td>

                        <td>
                            <button type="button"
                                    class="btn btn-secondary btn-sm"
                                    disabled="@IsBusy"
                                    @onclick="() => UnblockAsync([file])">
                                Unblock
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (_files.Count > _shown)
    {
        <button type="button"
                class="btn btn-secondary mt-3"
                @onclick="() => _shown += PageSize">
            Show @Math.Min(PageSize, _files.Count - _shown) more (@(_files.Count - _shown) left)
        </button>
    }
}

@code
{
    private const int PageSize = 100;

    private List<DriveProfile> _profiles = [];

    private List<BlockedFile> _files = [];

    private List<BlockedFile> _pending = [];

    private readonly CandidateSelection<BlockedFile> _selection =
        new(file => file.CanonicalPath);

    private int _shown = PageSize;

    private string _statusMessage = string.Empty;

    private bool _hasScanned;
    private bool _isUnblocking;
    private bool _isConfirming;

    private bool IsBusy =>
        _isUnblocking || IsScanning;

    protected override async Task OnInitializedAsync()
    {
        _profiles =
            await SettingsService.GetEnabledDriveProfilesAsync();

        await LoadAsync();
    }

    protected override async Task OnScanFinishedAsync()
    {
        CancelConfirm();

        _selection.Clear();
        _statusMessage = string.Empty;

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _files =
            await BlockedFileService.GetBlockedFilesAsync(forceRefresh: false);

        _hasScanned =
            _profiles.Any(profile =>
                BlockedFileCache.GetLastScanUtc(profile.Name).HasValue);
    }

    private void RequestConfirm(
        List<BlockedFile> files)
    {
        if (IsBusy || files.Count == 0)
        {
            return;
        }

        _pending = files;
        _isConfirming = true;
    }

    private void CancelConfirm()
    {
        _isConfirming = false;
        _pending = [];
    }

    private async Task ConfirmAsync()
    {
        var files = _pending.ToList();

        CancelConfirm();

        await UnblockAsync(files);
    }

    private async Task UnblockAsync(
        List<BlockedFile> files)
    {
        if (IsBusy || files.Count == 0)
        {
            return;
        }

        _isUnblocking = true;

        await InvokeAsync(StateHasChanged);

        var unblocked = 0;
        var failed = 0;

        try
        {
            foreach (var file in files)
            {
                if (await BlockedFileService.UnblockAsync(file.CanonicalPath))
                {
                    unblocked++;

                    _files.Remove(file);
                    _selection.Remove(file);
                }
                else
                {
                    failed++;
                }
            }

            _statusMessage =
                failed == 0
                    ? $"Unblocked {unblocked} file(s)."
                    : $"Unblocked {unblocked} file(s); {failed} could not be changed (the file may be in use or read-only).";
        }
        catch (Exception ex)
        {
            _statusMessage =
                $"Stopped part-way: {ex.Message}";
        }
        finally
        {
            _isUnblocking = false;
        }
    }

    private static string TypeLabel(MediaType type) =>
        type switch
        {
            MediaType.Movie => "Movie",
            MediaType.TvEpisode => "TV",
            _ => type.ToString()
        };
}
