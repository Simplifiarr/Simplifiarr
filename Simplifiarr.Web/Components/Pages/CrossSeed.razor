@page "/cross-seed"
@rendermode InteractiveServer
@implements IDisposable

@using Simplifiarr.Core.Models
@using Simplifiarr.Core.Services
@using Simplifiarr.Core.Utilities

@inject ICrossSeedScanService Scanner
@inject ISettingsService SettingsService

<PageTitle>Cross-Seed - Simplifiarr</PageTitle>

<PageHeader Title="Cross-Seed"
            Subtitle="Finds other torrents of files you already seed, so you can seed the same files on more trackers without downloading anything. A torrent only counts once every piece of it has been checked against your files.">
    @if (Scanner.IsScanning)
    {
        <button type="button" class="btn btn-secondary" @onclick="Scanner.Stop">
            <i class="bi bi-stop-fill" aria-hidden="true"></i>
            Stop
        </button>
    }
    else
    {
        <button type="button"
                class="btn btn-primary"
                disabled="@(_isAdding || !_isSetUp)"
                @onclick="Start">
            <i class="bi bi-search" aria-hidden="true"></i>
            Find cross-seeds
        </button>
    }
</PageHeader>

@if (!_isSetUp)
{
    <div class="alert alert-warning">
        Cross-seeding needs both qBittorrent and Prowlarr.
        <a href="settings">Set them up in Settings</a>, under Connections.
    </div>
}

@if (Scanner.Progress is { } progress)
{
    <div class="alert alert-info" role="status">
        <strong>Checking torrent @(progress.Done + 1) of @progress.Total</strong> -
        @progress.Found match(es) so far.
        <div class="cell-note">Now: @progress.CurrentTorrent. You can leave this page; the scan carries on.</div>
    </div>
}
else if (Scanner.IsScanning)
{
    <div class="alert alert-info" role="status">Starting...</div>
}
else if (!string.IsNullOrWhiteSpace(Scanner.LastMessage))
{
    <div class="alert @(Scanner.LastSucceeded ? "alert-info" : "alert-warning")" role="status">
        @Scanner.LastMessage
    </div>
}

@if (!string.IsNullOrWhiteSpace(_addMessage))
{
    <div class="alert alert-info" role="status">@_addMessage</div>
}

@if (_matches.Count == 0)
{
    @if (!Scanner.IsScanning)
    {
        <EmptyState Icon="share"
                    Text="@(Scanner.LastMessage is null
                              ? "Nothing to show yet. Press Find cross-seeds to check everything you seed against your indexers."
                              : "No cross-seeds are waiting to be added.")" />
    }
}
else
{
    @if (_pending.Count > 0)
    {
        <BatchConfirmBanner IsBusy="_isAdding"
                            ConfirmLabel="Confirm"
                            BusyLabel="Adding..."
                            OnConfirm="AddPendingAsync"
                            OnCancel="() => _pending = []">
            <Message>
                <strong>Add @_pending.Count torrent(s) to qBittorrent?</strong>
                Your files are hardlinked into <code>@_storagePath</code> under the names each torrent expects,
                and the torrents are added stopped so you can check them before they start. No file is copied or moved.
            </Message>
        </BatchConfirmBanner>
    }
    else
    {
        <div class="toolbar">
            <div class="toolbar-summary">
                <strong>@_matches.Count</strong> proven match(es)
                @if (_matches.Count > Addable.Count)
                {
                    <text> · @(_matches.Count - Addable.Count) already on that tracker</text>
                }
                @if (_selection.Count > 0)
                {
                    <text> · @_selection.Count selected</text>
                }
            </div>

            <div class="toolbar-actions">
                <button type="button"
                        class="btn btn-secondary btn-sm"
                        disabled="@(IsBusy || Addable.Count == 0)"
                        @onclick="() => _pending = Addable">
                    Add all new (@Addable.Count)
                </button>

                <button type="button"
                        class="btn btn-primary btn-sm"
                        disabled="@(IsBusy || _selection.Count == 0)"
                        @onclick="() => _pending = _matches.Where(_selection.IsSelected).ToList()">
                    Add selected (@_selection.Count)
                </button>
            </div>
        </div>
    }

    <div class="table-scroll">
        <table class="table">
            <thead>
                <tr>
                    <th class="col-check">Select</th>
                    <th>Torrent found</th>
                    <th class="col-num">Size</th>
                    <th>You seed these files as</th>
                    <th>Details</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var match in _matches)
                {
                    <tr @key="match.CandidateResult.DownloadUrl">
                        <SelectableCheckboxCell Checked="_selection.IsSelected(match)"
                                                Disabled="IsBusy"
                                                OnChanged="selected => _selection.SetSelected(match, selected)" />

                        <td>
                            <div class="file-name">@match.CandidateResult.Title</div>
                            <div class="cell-note">
                                @match.CandidateResult.Indexer
                                @if (Trackers(match) is { Length: > 0 } trackers)
                                {
                                    <text> · @trackers</text>
                                }
                            </div>

                            @if (match.IsAlreadySeededOnSameTracker)
                            {
                                <div class="status-warn">Already seeding on this tracker</div>
                                <div class="cell-note">Adding it would seed the same files twice in one place.</div>
                            }
                            else
                            {
                                <div class="status-ok">New tracker</div>
                            }
                        </td>

                        <td class="col-num">@SizeFormatter.FormatBytes(match.CandidateMetadata.TotalLengthBytes)</td>

                        <td>
                            @if (match.SeedingTorrents.Count == 0)
                            {
                                <span class="status-muted">Not seeding - the files are in your library</span>
                            }
                            else
                            {
                                @foreach (var seeding in match.SeedingTorrents.Take(3))
                                {
                                    <div>
                                        @seeding.Name
                                        <span class="cell-note">(@(CrossSeedScanService.TrackerDomain(seeding.Tracker) ?? "no tracker"))</span>
                                    </div>
                                }

                                @if (match.SeedingTorrents.Count > 3)
                                {
                                    <div class="cell-note">+ @(match.SeedingTorrents.Count - 3) more</div>
                                }
                            }
                        </td>

                        <td>
                            <details>
                                <summary>View proof</summary>

                                <div class="detail-label">Checked</div>
                                <div>
                                    @(match.Match.WholeTorrentVerification?.VerifiedPieceCount ?? 0) of
                                    @(match.Match.WholeTorrentVerification?.TotalPieceCount ?? 0) pieces match,
                                    across @match.Match.EntryMatches.Count file(s)
                                </div>

                                <div class="detail-label">Your file(s)</div>
                                @foreach (var entry in match.Match.EntryMatches.Take(5))
                                {
                                    <div><code>@entry.ResolvedPath</code></div>
                                }

                                @if (match.Match.EntryMatches.Count > 5)
                                {
                                    <div class="cell-note">+ @(match.Match.EntryMatches.Count - 5) more</div>
                                }

                                <div class="detail-label">Found by searching for</div>
                                <div>@match.SourceQueryTitle</div>
                            </details>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (_alreadyHave.Count > 0)
{
    <details class="mt-3">
        <summary>@_alreadyHave.Count result(s) left out - that torrent is already in qBittorrent</summary>

        <ul class="cell-note">
            @foreach (var title in _alreadyHave.Distinct().Take(50))
            {
                <li>@title</li>
            }
        </ul>
    </details>
}

<p class="cell-note mt-3">
    Have one particular .torrent you want to seed from files you already own?
    Use the <a href="torrent-rebuilder">Torrent Rebuilder</a>.
</p>

@code
{
    private List<CrossSeedScanResult> _matches = [];
    private List<string> _alreadyHave = [];

    /// <summary>Matches waiting for the user to confirm adding them.</summary>
    private List<CrossSeedScanResult> _pending = [];

    private readonly CandidateSelection<CrossSeedScanResult> _selection =
        new(match => match.CandidateResult.DownloadUrl);

    private bool _isSetUp;
    private bool _isAdding;
    private bool _wasScanning;

    private string _storagePath = string.Empty;
    private string? _addMessage;

    private bool IsBusy =>
        _isAdding || Scanner.IsScanning;

    private List<CrossSeedScanResult> Addable =>
        _matches
            .Where(match => !match.IsAlreadySeededOnSameTracker)
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        _wasScanning = Scanner.IsScanning;

        Scanner.Changed += OnChanged;

        var settings =
            await SettingsService.GetSettingsAsync();

        _storagePath = settings.CrossSeedTorrentStoragePath;

        _isSetUp =
            !string.IsNullOrWhiteSpace(settings.QbittorrentUrl) &&
            !string.IsNullOrWhiteSpace(settings.ProwlarrUrl) &&
            !string.IsNullOrWhiteSpace(settings.ProwlarrApiKey);

        Load();
    }

    private void Start()
    {
        if (IsBusy)
        {
            return;
        }

        _addMessage = null;
        _pending = [];
        _selection.Clear();

        // Runs on its own, so it carries on if this page is closed.
        _ = Task.Run(Scanner.ScanAsync);
    }

    // Raised from the scan's own thread - hop back onto this page's.
    private void OnChanged()
    {
        _ = InvokeAsync(() =>
        {
            if (_wasScanning && !Scanner.IsScanning)
            {
                // The list was rebuilt; old ticks may point at nothing.
                _selection.Clear();
                _pending = [];
            }

            _wasScanning = Scanner.IsScanning;

            Load();

            StateHasChanged();
        });
    }

    private void Load()
    {
        _matches =
            Scanner.Matches
                .OrderBy(match => match.IsAlreadySeededOnSameTracker)
                .ThenBy(match => match.CandidateResult.Title, StringComparer.OrdinalIgnoreCase)
                .ToList();

        _alreadyHave = Scanner.AlreadyInQbittorrent.ToList();
    }

    private async Task AddPendingAsync()
    {
        if (IsBusy || _pending.Count == 0)
        {
            return;
        }

        var batch = _pending.ToList();

        _isAdding = true;

        try
        {
            var summary =
                await Scanner.AddAsync(
                    batch,
                    message =>
                    {
                        _addMessage = message;

                        _ = InvokeAsync(StateHasChanged);
                    });

            _addMessage =
                $"Added {summary.AddedToQbittorrent} torrent(s) to qBittorrent, stopped. Start them there once they have checked.";

            if (summary.FailedToLink > 0)
            {
                _addMessage +=
                    $" {summary.FailedToLink} couldn't be linked and were left in the list.";
            }

            if (summary.FailedToAddToQbittorrent > 0)
            {
                _addMessage +=
                    $" {summary.FailedToAddToQbittorrent} were linked into {_storagePath} but qBittorrent didn't take them - add their .torrent files from that folder by hand.";
            }
        }
        catch (Exception exception)
        {
            _addMessage = $"Adding stopped: {exception.Message}";
        }
        finally
        {
            _isAdding = false;
            _pending = [];

            foreach (var match in batch)
            {
                _selection.Remove(match);
            }

            Load();
        }
    }

    private static string Trackers(CrossSeedScanResult match) =>
        string.Join(
            ", ",
            match.CandidateMetadata.TrackerUrls
                .Select(CrossSeedScanService.TrackerDomain)
                .OfType<string>()
                .Distinct(StringComparer.OrdinalIgnoreCase));

    public void Dispose() =>
        Scanner.Changed -= OnChanged;
}
