@page "/move-seeds"
@rendermode InteractiveServer
@implements IDisposable

@using Simplifiarr.Core.Models
@using Simplifiarr.Core.Services
@using Simplifiarr.Core.Utilities
@using Simplifiarr.Web.Support

@inject ISettingsService SettingsService
@inject ISeedMoveService Seeds
@inject ITorrentClient Client
@inject IScanCoordinator Scans

<PageTitle>Move Seeds - Simplifiarr</PageTitle>

<PageHeader Title="Move Seeds"
            Subtitle="Torrents seeding from one drive while Sonarr or Radarr copied them into a library on another. Moving the seed to the library's drive leaves one copy that both share." />

<details class="mb-3">
    <summary>How moving works, and what it changes</summary>

    <div class="mt-2 text-muted">
        <p class="mb-2">
            Simplifiarr pauses the torrent, links each library file into the downloads folder
            on the library's drive (instant, and it takes no space), and tells @Client.Name to
            seed from there. @Client.Name then checks every piece of the torrent. Only if every
            piece passes is the old copy deleted. If the check doesn't pass,
            the torrent is pointed back at its old files, which were never touched.
        </p>
        <p class="mb-2">
            Files the library doesn't have, such as samples or episodes Sonarr skipped, are
            copied across by @Client.Name itself.
        </p>
        <p class="mb-0">
            Afterwards the torrent starts seeding again, or stays paused if you untick
            "Start seeding again". Several moves run one after another, and carry on if you
            leave the page. This list is updated by Scan, which only compares sizes.
            @(Client.Name)'s check is what proves a match.
        </p>
    </div>
</details>

@if (Seeds.Batch is { } batch)
{
    <div class="alert @(batch.Finished ? (batch.Failed.Count == 0 ? "alert-success" : "alert-warning") : "alert-info")">
        @if (!batch.Finished)
        {
            <div class="d-flex flex-wrap align-items-center gap-2">
                <strong>Moving @(batch.Done + 1 > batch.Total ? batch.Total : batch.Done + 1) of @batch.Total</strong>
                <span class="cell-note">@batch.Moved moved · @batch.Failed.Count didn't · @SizeFormatter.FormatBytes(batch.FreedBytes) freed so far</span>
                <button type="button" class="btn btn-secondary btn-sm ms-auto" disabled="@batch.StopRequested" @onclick="Seeds.StopBatch">
                    @(batch.StopRequested ? "Stopping after this one..." : "Stop after this one")
                </button>
            </div>
            <div class="progress mt-2" role="progressbar" aria-label="Moves done" aria-valuenow="@batch.Done" aria-valuemin="0" aria-valuemax="@batch.Total" style="height: .5rem">
                <div class="progress-bar" style="width: @(batch.Total == 0 ? 0 : batch.Done * 100 / batch.Total)%"></div>
            </div>
            @if (Seeds.Current is { } moving)
            {
                <div class="cell-note mt-2">@moving.TorrentName: @moving.Step...</div>
            }
            <div class="cell-note">This carries on if you leave the page.</div>
        }
        else
        {
            <div class="d-flex flex-wrap align-items-center gap-2">
                <strong>
                    @(batch.StopRequested ? "Stopped. " : "Done. ")
                    Moved @batch.Moved of @batch.Total@(batch.Failed.Count > 0 ? $"; {batch.Failed.Count} didn't move" : "").
                </strong>
                <button type="button" class="btn btn-secondary btn-sm ms-auto" @onclick="Seeds.ClearBatch">Close</button>
            </div>
            @if (batch.FreedBytes > 0)
            {
                <div class="cell-note">@SizeFormatter.FormatBytes(batch.FreedBytes) is free again.</div>
            }
        }

        @if (batch.Failed.Count > 0)
        {
            <details class="mt-2">
                <summary>Why @batch.Failed.Count didn't move</summary>
                <ul class="mb-0 mt-1">
                    @foreach (var (torrent, why) in batch.Failed)
                    {
                        <li><strong>@torrent</strong>: @why</li>
                    }
                </ul>
            </details>
        }

        @if (batch.NotStarted.Count > 0)
        {
            <details class="mt-2">
                <summary>@batch.NotStarted.Count moved but didn't start again; start them in @Client.Name</summary>
                <ul class="mb-0 mt-1">
                    @foreach (var (torrent, why) in batch.NotStarted)
                    {
                        <li><strong>@torrent</strong>: @why</li>
                    }
                </ul>
            </details>
        }
    </div>
}
else if (Seeds.Current is { } current)
{
    <div class="alert alert-info">
        <i class="bi bi-arrow-repeat" aria-hidden="true"></i>
        <strong>Moving @current.TorrentName:</strong> @current.Step...
        <div class="cell-note">This carries on if you leave the page.</div>
    </div>
}

@if (_result is not null)
{
    <div class="alert @(_result.Succeeded ? "alert-success" : "alert-danger")">
        @_result.Message
        @if (_result.FreedBytes > 0)
        {
            <div class="cell-note">
                @SizeFormatter.FormatBytes(_result.FreedBytes) is free again.
            </div>
        }
    </div>
}

@if (_profiles.Count == 0)
{
    <div class="alert alert-warning">
        No drives are set up yet. <a href="settings">Add one in Settings</a>.
    </div>
}
else if (!_hasScanned)
{
    <EmptyState Icon="search" Text="Nothing to show yet. Press Scan at the top of the page." />
}
else if (_candidates.Count == 0)
{
    <EmptyState Icon="check-circle" Text="Every torrent seeds from the same drive as its library copy." />
}
else
{
    @if (_pending is not null)
    {
        <BatchConfirmBanner IsBusy="IsBusy"
                            ConfirmLabel="@($"Move {_pending.Count}")"
                            BusyLabel="Moving..."
                            OnConfirm="StartBatch"
                            OnCancel="() => _pending = null">
            <Message>
                <strong>Move @_pending.Count torrent(s) to their library's drive?</strong>
                They're moved one after another, each checked by @Client.Name before its old copy
                is deleted. That frees @SizeFormatter.FormatBytes(_pending.Sum(candidate => candidate.LinkedBytes)).
            </Message>
        </BatchConfirmBanner>
    }
    else
    {
        <div class="toolbar">
            <div class="toolbar-summary">
                <strong>@_candidates.Count</strong> torrent(s) ·
                <strong>@SizeFormatter.FormatBytes(_candidates.Sum(candidate => candidate.LinkedBytes))</strong> freed by moving them all
                @if (_selection.Count > 0)
                {
                    <text> · @_selection.Count selected</text>
                }
            </div>

            <div class="toolbar-actions">
                <div class="form-check form-check-inline mb-0 me-2">
                    <input id="start-after" class="form-check-input" type="checkbox" @bind="_startAfter" />
                    <label class="form-check-label" for="start-after">Start seeding again</label>
                </div>

                <button type="button"
                        class="btn btn-secondary btn-sm"
                        disabled="@IsBusy"
                        @onclick="() => _pending = _candidates.ToList()">
                    Move all
                </button>

                <button type="button"
                        class="btn btn-primary btn-sm"
                        disabled="@(IsBusy || _selection.Count == 0)"
                        @onclick="() => _pending = _candidates.Where(_selection.IsSelected).ToList()">
                    Move selected (@_selection.Count)
                </button>
            </div>
        </div>
    }

    @if (Causes.Count > 0)
    {
        <div class="panel mb-3 help-panel">
            <strong>Why this happens.</strong>
            @Client.Name saved these on a different drive from where Sonarr or Radarr keeps them,
            so the files had to be copied. To stop it, give each category a save folder on the
            drive its library is on:
            <ul class="mb-0 mt-2">
                @foreach (var cause in Causes)
                {
                    <li>
                        <strong>@(string.IsNullOrWhiteSpace(cause.Category) ? "No category" : $"Category \"{cause.Category}\"")</strong>:
                        @cause.Count torrent(s) saved on @cause.From whose library is on @cause.To.
                    </li>
                }
            </ul>
        </div>
    }

    <div class="table-scroll">
        <table class="table">
            <thead>
                <tr>
                    <th class="col-check">
                        <input type="checkbox"
                               aria-label="Select all"
                               checked="@(_candidates.Count > 0 && _selection.Count == _candidates.Count)"
                               disabled="@IsBusy"
                               @onchange="() => _selection.ToggleSelectAll(_candidates)" />
                    </th>
                    <th>Torrent</th>
                    <th>Move</th>
                    <th>Files in library</th>
                    <th class="col-num">Frees</th>
                    <th></th>
                </tr>
            </thead>

            <tbody>
                @foreach (var candidate in _candidates)
                {
                    <tr @key="candidate.TorrentHash">
                        <SelectableCheckboxCell Checked="_selection.IsSelected(candidate)"
                                                Disabled="IsBusy"
                                                OnChanged="selected => _selection.SetSelected(candidate, selected)" />
                        <td>
                            <div class="file-name">@candidate.TorrentName</div>
                            <div class="cell-note">
                                @(string.IsNullOrWhiteSpace(candidate.TrackerHost) ? "No tracker" : candidate.TrackerHost)
                                @if (!string.IsNullOrWhiteSpace(candidate.Category))
                                {
                                    <text> · @candidate.Category</text>
                                }
                            </div>

                            <details class="mt-1">
                                <summary>Files</summary>

                                <div class="detail-label">Seeds from now</div>
                                <code>@candidate.SavePath</code>

                                <div class="detail-label mt-2">Will seed from</div>
                                <code>@candidate.TargetSavePath</code>

                                <ul class="mt-2 mb-0">
                                    @foreach (var file in candidate.Files)
                                    {
                                        <li>
                                            @file.RelativePath
                                            <span class="cell-note">
                                                · @SizeFormatter.FormatBytes(file.SizeBytes) ·
                                                @(file.InLibrary ? "in the library" : $"copied by {Client.Name}")
                                            </span>
                                        </li>
                                    }
                                </ul>
                            </details>
                        </td>

                        <td>@candidate.SourceDriveName → @candidate.TargetDriveName</td>

                        <td>
                            @candidate.Files.Count(file => file.InLibrary) of @candidate.Files.Count
                            @if (candidate.CopiedBytes > 0)
                            {
                                <div class="cell-note">@SizeFormatter.FormatBytes(candidate.CopiedBytes) copied across</div>
                            }
                        </td>

                        <td class="col-num">@SizeFormatter.FormatBytes(candidate.LinkedBytes)</td>

                        <td>
                            @if (_confirmHash == candidate.TorrentHash)
                            {
                                <div class="d-flex gap-2 flex-wrap">
                                    <button type="button"
                                            class="btn btn-primary btn-sm"
                                            disabled="@IsBusy"
                                            @onclick="() => MoveAsync(candidate)">
                                        Move it
                                    </button>
                                    <button type="button"
                                            class="btn btn-secondary btn-sm"
                                            disabled="@IsBusy"
                                            @onclick="() => _confirmHash = null">
                                        Cancel
                                    </button>
                                </div>
                                <div class="cell-note mt-1">@(_startAfter ? $"Pauses it in {Client.Name} while it moves, then starts it again." : $"Pauses it in {Client.Name} and leaves it paused.")</div>
                            }
                            else
                            {
                                <button type="button"
                                        class="btn btn-secondary btn-sm"
                                        disabled="@IsBusy"
                                        @onclick="() => _confirmHash = candidate.TorrentHash">
                                    Move to @candidate.TargetDriveName
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code
{
    private sealed record Cause(string Category, string From, string To, int Count);

    private List<DriveProfile> _profiles = [];
    private List<SeedMoveCandidate> _candidates = [];
    private bool _hasScanned;

    private string? _confirmHash;
    private List<SeedMoveCandidate>? _pending;
    private bool _startAfter = true;
    private bool _batchWasRunning;

    private readonly CandidateSelection<SeedMoveCandidate> _selection =
        new(candidate => candidate.TorrentHash);
    private SeedMoveResult? _result;
    private bool _scanWasRunning;

    private bool IsBusy =>
        Seeds.Current is not null || Seeds.Batch is { Finished: false } || Scans.Progress.IsRunning;

    private List<Cause> Causes =>
        _candidates
            .GroupBy(candidate => (candidate.Category, candidate.SourceDriveName, candidate.TargetDriveName))
            .Select(group => new Cause(group.Key.Category, group.Key.SourceDriveName, group.Key.TargetDriveName, group.Count()))
            .OrderByDescending(cause => cause.Count)
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        _profiles = await SettingsService.GetEnabledDriveProfilesAsync();
        _scanWasRunning = Scans.Progress.IsRunning;

        Seeds.Changed += OnChanged;
        Scans.Changed += OnScanChanged;

        Load();
    }

    private void Load()
    {
        _candidates =
            _profiles
                .SelectMany(profile => Seeds.GetCandidates(profile.Name))
                .OrderByDescending(candidate => candidate.LinkedBytes)
                .ToList();

        _hasScanned = _profiles.Any(profile => Seeds.GetLastScanUtc(profile.Name).HasValue);

        // Drop ticks for torrents that are no longer listed.
        _selection.SelectedKeys.IntersectWith(_candidates.Select(candidate => candidate.TorrentHash));
    }

    private async Task MoveAsync(SeedMoveCandidate candidate)
    {
        _confirmHash = null;
        _result = null;

        // Runs in the service, so it finishes even if this page is closed.
        _result = await Seeds.MoveAsync(candidate, startAfter: _startAfter);

        if (_result.NotStartedBecause is { } why)
        {
            _result = _result with { Message = $"{_result.Message} It didn't start again ({why}); start it in {Client.Name}." };
        }

        _selection.Remove(candidate);
        Load();
    }

    private void StartBatch()
    {
        if (_pending is null)
        {
            return;
        }

        _result = null;

        if (!Seeds.StartBatch(_pending, _startAfter))
        {
            _result = new SeedMoveResult(false, "Another move is still running. Wait for it to finish.");
        }

        _pending = null;
        _selection.Clear();
    }

    private void OnChanged()
    {
        // Reload the list as moves finish, so moved torrents drop off it.
        var running = Seeds.Batch is { Finished: false };
        var reload = _batchWasRunning || running;

        _batchWasRunning = running;

        _ = InvokeAsync(() =>
        {
            if (reload)
            {
                Load();
            }

            StateHasChanged();
        });
    }

    private void OnScanChanged()
    {
        var running = Scans.Progress.IsRunning;
        var finished = _scanWasRunning && !running;

        _scanWasRunning = running;

        _ = InvokeAsync(() =>
        {
            if (finished)
            {
                Load();
            }

            StateHasChanged();
        });
    }

    public void Dispose()
    {
        Seeds.Changed -= OnChanged;
        Scans.Changed -= OnScanChanged;
    }
}
