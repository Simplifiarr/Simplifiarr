                if (result.Success)
                {
                    succeeded++;

                    BookPromotionCandidateCache.RemoveCandidate(
                        candidate.SourcePath);

                    _bookSelection.Remove(candidate);
                }
                else
                {
                    failed++;
                }
            }

            LoadCachedBookCandidates();

            _isConfirmingBookBatch = false;
            _pendingBookBatch = [];

            _statusMessage =
                failed == 0
                    ? $"Promoted {succeeded} book(s)."
                    : $"Promoted {succeeded} book(s), {failed} failed.";
        }
        catch (Exception ex)
        {
            _statusMessage =
                $"Batch promotion failed: {ex.Message}";
        }
        finally
        {
            _isExecuting = false;
        }
    }

