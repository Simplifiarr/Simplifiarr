@page "/hardlinks"
@rendermode InteractiveServer

@implements IDisposable

@using Simplifiarr.Core.Models
@using Simplifiarr.Core.Services

@inject ISettingsService SettingsService
@inject IPromotionCandidateCacheService PromotionCandidateCache
@inject IPromotionPreviewService PromotionPreviewService
@inject IPromotionExecuteService PromotionExecuteService
@inject IIgnoredItemsService IgnoredItemsService
@inject IHistoryService HistoryService
@inject IWasteCandidateCacheService WasteCandidateCache
@inject IQuarantineService QuarantineService
@inject IScanCoordinator Scans
@inject IMediaPromotionService MediaPromotion

<PageTitle>Hardlinks - Simplifiarr</PageTitle>

<PageHeader Title="Hardlinks"
            Subtitle="Finished downloads that can be linked into your libraries without copying. This list comes from the last scan.">
    <a class="btn btn-secondary" href="ignored">
        <i class="bi bi-eye-slash" aria-hidden="true"></i> Ignored items
    </a>
</PageHeader>

@if (_profiles.Count == 0)
{
    <div class="alert alert-warning">
        No drives are set up yet. <a href="settings">Add one in Settings</a>.
    </div>
}
else if (_isScanning)
{
    <div class="alert alert-info">
        A scan is running. This page will update when it finishes.
    </div>
}

<div class="app-tabs" role="tablist" aria-label="Media type">
    <button type="button"
            role="tab"
            aria-selected="@(_activeTab == MoviesTab)"
            class="app-tab @(_activeTab == MoviesTab ? "active" : null)"
            @onclick="() => _activeTab = MoviesTab">
        Movies <span class="app-tab-count">@GetMovieCandidates().Count</span>
    </button>

    <button type="button"
            role="tab"
            aria-selected="@(_activeTab == TvTab)"
            class="app-tab @(_activeTab == TvTab ? "active" : null)"
            @onclick="() => _activeTab = TvTab">
        TV <span class="app-tab-count">@_candidates.Count(candidate => candidate.IsTv)</span>
    </button>

    @foreach (var definition in MediaTypeDefinitions.All)
    {
        var tab = definition.MediaType.ToString();

        <button type="button"
                role="tab"
                aria-selected="@(_activeTab == tab)"
                class="app-tab @(_activeTab == tab ? "active" : null)"
                @onclick="() => _activeTab = tab">
            @definition.PluralName <span class="app-tab-count">@CountFor(definition)</span>
        </button>
    }
</div>

@if (ActiveDefinition is null && !string.IsNullOrWhiteSpace(_statusMessage))
{
    <div class="alert alert-info">
        @_statusMessage
    </div>
}

@if (_selectedPreview is not null)
{
    <div class="panel mb-3">
        <div class="action-row">
            <div>
                <div class="action-row-title">Link this file into the library?</div>

                <div class="detail-label">Download (stays where it is)</div>
                <code>@_selectedPreview.SourcePath</code>

                <div class="detail-label">Will also appear in the library as</div>
                <code>@_selectedPreview.TargetFilePath</code>

                <details class="mt-2">
                    <summary>What will happen, step by step</summary>

                    <ul class="mt-2 mb-0">
                        @foreach (var action in _selectedPreview.PlannedActions)
                        {
                            <li>@action</li>
                        }
                    </ul>
                </details>
            </div>

            <div class="cell-actions">
                <button type="button"
                        class="btn btn-primary"
                        disabled="@(_isExecuting || _isScanning)"
                        @onclick="ExecuteSelectedAsync">
                    @(_isExecuting ? "Linking..." : "Link")
                </button>

                <button type="button"
                        class="btn btn-secondary"
                        disabled="@_isExecuting"
                        @onclick="CancelPreview">
                    Cancel
                </button>
            </div>
        </div>
    </div>
}

@if (ActiveDefinition is not null)
{
    <MediaTypeSection @key="ActiveDefinition.MediaType"
                      Definition="ActiveDefinition"
                      Profiles="_profiles"
                      OnChanged="StateHasChanged" />
}
else if (!_hasScanned)
{
    <EmptyState Icon="search" Text="No scan has looked for movies or TV yet. Press Scan at the top of the page." />
}
else if (_activeTab == MoviesTab)
{
    @if (GetMovieCandidates().Count == 0)
    {
        <EmptyState Icon="check-circle" Text="No movies waiting to be linked into the library." />
    }
    else
    {
        @if (_isConfirmingMovieBatch)
        {
            <BatchConfirmBanner IsBusy="_isExecuting"
                                ConfirmLabel="Link"
                                BusyLabel="Linking..."
                                OnConfirm="ConfirmMovieBatchAsync"
                                OnCancel="CancelMovieBatchConfirm">
                <Message>
                    <strong>Link @_pendingMovieBatch.Count movie(s) into the library?</strong>
                    Each gets a hardlink - nothing is copied or moved.
                </Message>
            </BatchConfirmBanner>
        }
        else
        {
            <div class="toolbar">
                <div class="toolbar-summary">
                    <strong>@GetMovieCandidates().Count</strong> movie(s) ready to link
                    @if (_movieSelection.Count > 0)
                    {
                        <text> · @_movieSelection.Count selected</text>
                    }
                </div>

                <div class="toolbar-actions">
                    <button type="button"
                            class="btn btn-secondary btn-sm"
                            disabled="@(_isScanning || _isExecuting || GetPromotableMovieCandidates().Count == 0)"
                            @onclick="() => RequestMovieBatchConfirm(GetPromotableMovieCandidates())">
                        Link all
                    </button>

                    <button type="button"
                            class="btn btn-primary btn-sm"
                            disabled="@(_isScanning || _isExecuting || _movieSelection.Count == 0)"
                            @onclick="() => RequestMovieBatchConfirm(GetSelectedPromotableMovieCandidates())">
                        Link selected (@_movieSelection.Count)
                    </button>
                </div>
            </div>
        }

        <div class="table-scroll">
            <table class="table">
                <thead>
                    <tr>
                        <th class="col-check">Select</th>
                        <th>Movie</th>
                        <th>Drive</th>
                        <th>Status</th>
                        <th>Actions</th>
                        <th>Details</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var candidate in GetMovieCandidates())
                    {
                        var canLink =
                            candidate.CanPromote && candidate.Plan is not null;

                        <tr @key="candidate.SourcePath" class="@_moviePreviewSelection.RowClass(candidate)">
                            <SelectableCheckboxCell Checked="_movieSelection.IsSelected(candidate)"
                                                    Disabled="_isScanning || _isExecuting || !canLink"
                                                    OnChanged="selected => _movieSelection.SetSelected(candidate, selected)" />

                            <td>
                                <div class="file-name">
                                    @candidate.Title
                                    @if (candidate.Year.HasValue)
                                    {
                                        <text> (@candidate.Year)</text>
                                    }
                                </div>

                                <div class="cell-note">Found @GetCandidateAgeText(candidate.DiscoveredUtc)</div>

                                @if (candidate.WasPreviouslyPromoted)
                                {
                                    <div class="cell-note status-warn">
                                        Linked before, but the library copy has since gone missing
                                    </div>
                                }
                            </td>

                            <td>@(string.IsNullOrWhiteSpace(candidate.DriveProfileName) ? "-" : candidate.DriveProfileName)</td>

                            <td>
                                @if (canLink)
                                {
                                    <span class="status-ok">Ready</span>
                                }
                                else
                                {
                                    <span class="status-warn">Can't link</span>
                                    <div class="cell-note">@candidate.Reason</div>
                                }
                            </td>

                            <td>
                                @if (_confirmingDownloadDelete.Contains(candidate.SourcePath))
                                {
                                    <div class="cell-note mb-1" style="white-space: normal; max-width: 22rem">
                                        Move the download to Quarantine? Your torrent client may still list
                                        the torrent until you remove it there too.
                                    </div>

                                    <div class="cell-actions">
                                        <button type="button"
                                                class="btn btn-danger btn-sm"
                                                disabled="@_isExecuting"
                                                @onclick="() => DeleteDownloadCopyAsync(candidate)">
                                            Move to Quarantine
                                        </button>

                                        <button type="button"
                                                class="btn btn-secondary btn-sm"
                                                disabled="@_isExecuting"
                                                @onclick="() => _confirmingDownloadDelete.Remove(candidate.SourcePath)">
                                            Cancel
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <div class="cell-actions">
                                        @if (canLink)
                                        {
                                            <button type="button"
                                                    class="@_moviePreviewSelection.ButtonClass(candidate)"
                                                    disabled="@_moviePreviewSelection.IsButtonDisabled(candidate, _isScanning || _isExecuting)"
                                                    @onclick="() => PreviewAsync(candidate)">
                                                @(candidate.WasPreviouslyPromoted && !_moviePreviewSelection.IsSelected(candidate)
                                                    ? "Link again"
                                                    : _moviePreviewSelection.ButtonText(candidate))
                                            </button>
                                        }

                                        @if (candidate.WasPreviouslyPromoted)
                                        {
                                            <button type="button"
                                                    class="btn btn-outline-danger btn-sm"
                                                    disabled="@(_isScanning || _isExecuting)"
                                                    @onclick="() => _confirmingDownloadDelete.Add(candidate.SourcePath)">
                                                Remove download
                                            </button>
                                        }

                                        <button type="button"
                                                class="btn btn-secondary btn-sm"
                                                disabled="@(_isScanning || _isExecuting)"
                                                @onclick="() => IgnoreMovieCandidate(candidate)">
                                            Ignore
                                        </button>
                                    </div>
                                }
                            </td>

                            <td>
                                <details>
                                    <summary>View paths</summary>

                                    <div class="detail-label">Download</div>
                                    <code>@candidate.SourcePath</code>

                                    @if (candidate.Plan is not null)
                                    {
                                        <div class="detail-label">Will be linked to</div>
                                        <code>@candidate.Plan.TargetFilePath</code>
                                    }

                                    <div class="detail-label">Why it's listed</div>
                                    <div>@candidate.Reason</div>
                                </details>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}
else if (_activeTab == TvTab)
{
    @if (GetTvGroups().Count == 0)
    {
        <EmptyState Icon="check-circle" Text="No TV episodes waiting to be linked into the library." />
    }
    else
    {
        <div class="toolbar">
            <div class="toolbar-summary">
                <strong>@GetTvGroups().Sum(group => group.Count())</strong> episode(s) ready to link,
                in <strong>@GetTvGroups().Count</strong> season(s)
            </div>
        </div>

        @foreach (var group in GetTvGroups())
        {
            var key = group.Key;

            var episodes =
                group
                    .OrderBy(episode => episode.Episode)
                    .ToList();

            var showEpisodes =
                GetTvGroups()
                    .Where(otherGroup =>
                        string.Equals(otherGroup.Key.Title, key.Title, StringComparison.OrdinalIgnoreCase))
                    .SelectMany(otherGroup => otherGroup)
                    .ToList();

            var seasonText =
                key.Season.HasValue ? $"Season {key.Season:00}" : "Season unknown";

            <div class="group-card" @key="key">
                <div class="group-card-header">
                    <div class="group-card-title">@key.Title · @seasonText</div>

                    <div class="group-card-meta">
                        @episodes.Count episode(s):
                        @string.Join(", ", episodes.Select(episode => episode.Episode.HasValue ? $"E{episode.Episode:00}" : "E?"))
                    </div>
                </div>

                <div class="action-row" style="border-top: 1px solid var(--app-border)">
                    @if (_confirmingGroups.Contains(key))
                    {
                        <div>
                            <div class="action-row-title">Link all @episodes.Count episode(s) of @key.Title @seasonText?</div>
                            <div class="action-row-detail">Each gets a hardlink - nothing is copied or moved.</div>
                        </div>

                        <div class="cell-actions">
                            <button type="button"
                                    class="btn btn-primary btn-sm"
                                    disabled="@(_isExecuting || _isScanning)"
                                    @onclick="() => PromoteGroupAsync(key, episodes)">
                                @(_isExecuting ? "Linking..." : "Link")
                            </button>

                            <button type="button"
                                    class="btn btn-secondary btn-sm"
                                    disabled="@_isExecuting"
                                    @onclick="() => CancelGroupConfirm(key)">
                                Cancel
                            </button>
                        </div>
                    }
                    else if (_confirmingIgnoreSeason.Contains(key))
                    {
                        <div>
                            <div class="action-row-title">Ignore all @episodes.Count episode(s) of @key.Title @seasonText?</div>
                            <div class="action-row-detail">They won't be suggested again until you un-ignore them on the Ignored page.</div>
                        </div>

                        <div class="cell-actions">
                            <button type="button"
                                    class="btn btn-secondary btn-sm"
                                    disabled="@(_isExecuting || _isScanning)"
                                    @onclick="() => IgnoreEpisodes(episodes, SeasonLabel(key))">
                                Ignore season
                            </button>

                            <button type="button"
                                    class="btn btn-secondary btn-sm"
                                    @onclick="() => _confirmingIgnoreSeason.Remove(key)">
                                Cancel
                            </button>
                        </div>
                    }
                    else if (_confirmingIgnoreShow.Contains(key.Title))
                    {
                        <div>
                            <div class="action-row-title">Ignore all @showEpisodes.Count episode(s) of @key.Title, every season listed?</div>
                            <div class="action-row-detail">They won't be suggested again until you un-ignore them on the Ignored page.</div>
                        </div>

                        <div class="cell-actions">
                            <button type="button"
                                    class="btn btn-secondary btn-sm"
                                    disabled="@(_isExecuting || _isScanning)"
                                    @onclick="() => IgnoreEpisodes(showEpisodes, key.Title)">
                                Ignore whole show
                            </button>

                            <button type="button"
                                    class="btn btn-secondary btn-sm"
                                    @onclick="() => _confirmingIgnoreShow.Remove(key.Title)">
                                Cancel
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="cell-actions" style="flex-wrap: wrap">
                            <button type="button"
                                    class="btn btn-primary btn-sm"
                                    disabled="@(_isExecuting || _isScanning)"
                                    @onclick="() => RequestGroupConfirm(key)">
                                Link all @episodes.Count
                            </button>

                            <button type="button"
                                    class="btn btn-secondary btn-sm"
                                    disabled="@(_isExecuting || _isScanning)"
                                    @onclick="() => _confirmingIgnoreSeason.Add(key)">
                                Ignore season
                            </button>

                            @if (showEpisodes.Count > episodes.Count)
                            {
                                <button type="button"
                                        class="btn btn-secondary btn-sm"
                                        disabled="@(_isExecuting || _isScanning)"
                                        @onclick="() => _confirmingIgnoreShow.Add(key.Title)">
                                    Ignore whole show (@showEpisodes.Count)
                                </button>
                            }
                        </div>
                    }
                </div>

                <details style="border-top: 1px solid var(--app-border)">
                    <summary style="padding: .7rem 1.1rem">Episodes one by one</summary>

                    <div class="table-scroll">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Episode</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                    <th>Details</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var episode in episodes)
                                {
                                    var canLink =
                                        episode.CanPromote && episode.Plan is not null;

                                    <tr @key="episode.SourcePath" class="@_moviePreviewSelection.RowClass(episode)">
                                        <td>
                                            <div class="file-name">
                                                @(episode.Episode.HasValue ? $"Episode {episode.Episode:00}" : "Episode unknown")
                                            </div>
                                            <div class="cell-note">@Path.GetFileName(episode.SourcePath)</div>
                                        </td>

                                        <td>
                                            @if (canLink)
                                            {
                                                <span class="status-ok">Ready</span>
                                            }
                                            else
                                            {
                                                <span class="status-warn">Can't link</span>
                                                <div class="cell-note">@episode.Reason</div>
                                            }
                                        </td>

                                        <td>
                                            <div class="cell-actions">
                                                @if (canLink)
                                                {
                                                    <button type="button"
                                                            class="@_moviePreviewSelection.ButtonClass(episode)"
                                                            disabled="@_moviePreviewSelection.IsButtonDisabled(episode, _isScanning || _isExecuting)"
                                                            @onclick="() => PreviewAsync(episode)">
                                                        @_moviePreviewSelection.ButtonText(episode)
                                                    </button>
                                                }

                                                <button type="button"
                                                        class="btn btn-secondary btn-sm"
                                                        disabled="@(_isExecuting || _isScanning)"
                                                        @onclick="() => IgnoreMovieCandidate(episode)">
                                                    Ignore
                                                </button>
                                            </div>
                                        </td>

                                        <td>
                                            <details>
                                                <summary>View paths</summary>

                                                <div class="detail-label">Download</div>
                                                <code>@episode.SourcePath</code>

                                                @if (episode.Plan is not null)
                                                {
                                                    <div class="detail-label">Will be linked to</div>
                                                    <code>@episode.Plan.TargetFilePath</code>
                                                }
                                            </details>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </details>
            </div>
        }
    }
}

@code
{
    private const string MoviesTab = "movies";
    private const string TvTab = "tv";

    // Which tab is showing: Movies, TV, or one of the shared media types.
    private string _activeTab = MoviesTab;

    private MediaTypeDefinition? ActiveDefinition =>
        MediaTypeDefinitions.All.FirstOrDefault(definition =>
            definition.MediaType.ToString() == _activeTab);

    private int CountFor(MediaTypeDefinition definition) =>
        _profiles
            .SelectMany(profile =>
                MediaPromotion.GetCandidates(definition.MediaType, profile.Name))
            .Select(candidate => candidate.SourcePath)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Count();

    private List<DriveProfile> _profiles = [];

    private List<MoviePromotionCandidate> _candidates = [];

    private readonly HashSet<(string Title, int? Season)>
        _confirmingGroups = [];

    private readonly HashSet<(string Title, int? Season)>
        _confirmingIgnoreSeason = [];

    private readonly HashSet<string> _confirmingIgnoreShow =
        new(StringComparer.OrdinalIgnoreCase);

    private readonly HashSet<string> _confirmingDownloadDelete =
        new(StringComparer.OrdinalIgnoreCase);

    private readonly CandidateSelection<MoviePromotionCandidate> _movieSelection =
        new(candidate => candidate.SourcePath);

    private readonly PreviewSelection<MoviePromotionCandidate> _moviePreviewSelection =
        new();

    private bool _isConfirmingMovieBatch;

    private List<MoviePromotionCandidate> _pendingMovieBatch = [];

    private PromotionPreview? _selectedPreview;

    private bool _isScanning;
    private bool _isExecuting;

    private bool _hasScanned;

    private string _statusMessage =
        string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _isScanning = Scans.Progress.IsRunning;

        Scans.Changed += OnScanChanged;

        _profiles =
            (await SettingsService.GetEnabledDriveProfilesAsync())
                .OrderBy(profile => profile.Name)
                .ToList();

        LoadCachedCandidates();
    }

    // Scanning is done by the app-wide Scan (top of every page). This page
    // only needs to know when one is running - so nothing can be promoted
    // from a list that is being rebuilt - and to reload when it finishes.
    private void OnScanChanged()
    {
        _ = InvokeAsync(() =>
        {
            var isRunning = Scans.Progress.IsRunning;

            if (isRunning == _isScanning)
            {
                return;
            }

            var justFinished = _isScanning && !isRunning;

            _isScanning = isRunning;

            if (justFinished)
            {
                // A rescan invalidates any preview based on the old list -
                // otherwise the preview card could keep showing a plan for
                // a candidate that no longer exists.
                _moviePreviewSelection.Clear();
                _selectedPreview = null;
                _confirmingGroups.Clear();
                _confirmingIgnoreSeason.Clear();
                _confirmingIgnoreShow.Clear();

                LoadCachedCandidates();

                _statusMessage =
                    $"Scan complete. {_candidates.Count} movie/TV opportunity(s) found.";
            }

            StateHasChanged();
        });
    }

    public void Dispose() =>
        Scans.Changed -= OnScanChanged;


    private List<MoviePromotionCandidate> GetMovieCandidates()
    {
        return _candidates
            .Where(candidate => !candidate.IsTv)
            .OrderBy(candidate => candidate.Title)
            .ThenBy(candidate => candidate.Year)
            .ToList();
    }

    private List<MoviePromotionCandidate> GetPromotableMovieCandidates()
    {
        return GetMovieCandidates()
            .Where(candidate => candidate.CanPromote && candidate.Plan is not null)
            .ToList();
    }

    private List<MoviePromotionCandidate> GetSelectedPromotableMovieCandidates()
    {
        return GetPromotableMovieCandidates()
            .Where(candidate => _movieSelection.IsSelected(candidate))
            .ToList();
    }

    private List<IGrouping<(string Title, int? Season), MoviePromotionCandidate>> GetTvGroups()
    {
        return _candidates
            .Where(candidate => candidate.IsTv)
            .GroupBy(candidate => (candidate.Title, candidate.Season))
            .OrderBy(group => group.Key.Title)
            .ThenBy(group => group.Key.Season)
            .ToList();
    }

    private void LoadCachedCandidates()
    {
        _candidates =
            _profiles
                .SelectMany(profile =>
                    PromotionCandidateCache.GetCandidates(profile.Name))
                .GroupBy(
                    candidate => candidate.SourcePath,
                    StringComparer.OrdinalIgnoreCase)
                .Select(group => group.First())
                .ToList();

        _hasScanned =
            _profiles.Any(profile =>
                PromotionCandidateCache.GetLastScanUtc(profile.Name).HasValue);

    }


    private static string GetCandidateAgeText(
        DateTime discoveredUtc)
    {
        if (discoveredUtc == default)
        {
            return "at an unknown time";
        }

        var age =
            DateTime.UtcNow - discoveredUtc;

        if (age < TimeSpan.Zero)
        {
            return "just now";
        }

        if (age.TotalMinutes < 1)
        {
            return "just now";
        }

        if (age.TotalHours < 1)
        {
            var minutes = Math.Max(1, (int)age.TotalMinutes);

            return $"{minutes} minute{(minutes == 1 ? string.Empty : "s")} ago";
        }

        if (age.TotalDays < 1)
        {
            var hours = Math.Max(1, (int)age.TotalHours);

            return $"{hours} hour{(hours == 1 ? string.Empty : "s")} ago";
        }

        var days = Math.Max(1, (int)age.TotalDays);

        return $"{days} day{(days == 1 ? string.Empty : "s")} ago";
    }

    private async Task PreviewAsync(
        MoviePromotionCandidate candidate)
    {
        if (_isScanning || _isExecuting || candidate.Plan is null)
        {
            return;
        }

        try
        {
            var preview =
                await PromotionPreviewService
                    .CreateAsync(candidate.Plan);

            _moviePreviewSelection.Select(candidate);
            _selectedPreview = preview;
        }
        catch (Exception ex)
        {
            _statusMessage =
                $"Preview failed: {ex.Message}";
        }
    }

    private void CancelPreview()
    {
        _moviePreviewSelection.Clear();

        _selectedPreview = null;
    }

    private async Task LogPromotionHistoryAsync(
        string title,
        PromotionPlan? plan,
        bool success,
        string message)
    {
        var sizeBytes =
            plan is not null && File.Exists(plan.SourcePath)
                ? new FileInfo(plan.SourcePath).Length
                : 0;

        await HistoryService.AddRecordAsync(
            new HistoryRecord
            {
                ActionType =
                    success
                        ? HistoryActionType.PromotionSucceeded
                        : HistoryActionType.PromotionFailed,
                FileName = title,
                LibraryPath = plan?.TargetFilePath ?? string.Empty,
                DownloadPath = plan?.SourcePath ?? string.Empty,
                SizeBytes = sizeBytes,
                Success = success,
                Message = message
            });
    }

    private void BumpHealthyHardlinkCount(
        string driveProfileName,
        bool isTv)
    {
        if (string.IsNullOrWhiteSpace(driveProfileName))
        {
            return;
        }

        WasteCandidateCache.IncrementHealthyHardlinkCount(
            driveProfileName,
            isTv ? MediaKind.Tv : MediaKind.Movies);
    }

    private async Task ExecuteSelectedAsync()
    {
        var promotedCandidate =
            _moviePreviewSelection.Selected;

        if (_isExecuting || promotedCandidate?.Plan is null)
        {
            return;
        }

        _isExecuting = true;

        try
        {
            var result =
                await PromotionExecuteService
                    .ExecuteAsync(
                        promotedCandidate.Plan);

            _statusMessage =
                result.Reason;

            await LogPromotionHistoryAsync(
                promotedCandidate.Title,
                promotedCandidate.Plan,
                result.Success,
                result.Reason);

            if (result.Success)
            {
                BumpHealthyHardlinkCount(
                    promotedCandidate.DriveProfileName,
                    promotedCandidate.IsTv);

                PromotionCandidateCache.RemoveCandidate(
                    promotedCandidate.SourcePath);

                LoadCachedCandidates();

                _moviePreviewSelection.Clear();
                _selectedPreview = null;

                _statusMessage =
                    $"Linked \"{promotedCandidate.Title}\" into the library. {_candidates.Count} left.";
            }
        }
        catch (Exception ex)
        {
            _statusMessage =
                $"Couldn't link it: {ex.Message}";
        }
        finally
        {
            _isExecuting = false;
        }
    }

    private void RequestGroupConfirm(
        (string Title, int? Season) key)
    {
        _confirmingGroups.Add(key);
    }

    private void CancelGroupConfirm(
        (string Title, int? Season) key)
    {
        _confirmingGroups.Remove(key);
    }

    private async Task PromoteGroupAsync(
        (string Title, int? Season) key,
        List<MoviePromotionCandidate> episodes)
    {
        if (_isExecuting)
        {
            return;
        }

        _isExecuting = true;

        var succeeded = 0;
        var failed = 0;

        try
        {
            foreach (var episode in
                episodes
                    .Where(episode =>
                        episode.CanPromote &&
                        episode.Plan is not null)
                    .ToList())
            {
                var result =
                    await PromotionExecuteService
                        .ExecuteAsync(episode.Plan!);

                await LogPromotionHistoryAsync(
                    episode.Title,
                    episode.Plan,
                    result.Success,
                    result.Reason);

                if (result.Success)
                {
                    succeeded++;

                    BumpHealthyHardlinkCount(
                        episode.DriveProfileName,
                        episode.IsTv);

                    PromotionCandidateCache.RemoveCandidate(
                        episode.SourcePath);
                }
                else
                {
                    failed++;
                }
            }

            LoadCachedCandidates();

            _confirmingGroups.Remove(key);

            _statusMessage =
                failed == 0
                    ? $"{key.Title} Season {key.Season?.ToString("00") ?? "Unknown"}: linked {succeeded} episode(s) into the library."
                    : $"{key.Title} Season {key.Season?.ToString("00") ?? "Unknown"}: linked {succeeded} episode(s); {failed} failed and are still listed.";
        }
        catch (Exception ex)
        {
            _statusMessage =
                $"Linking stopped part-way: {ex.Message}";
        }
        finally
        {
            _isExecuting = false;
        }
    }

    private void RequestMovieBatchConfirm(
        List<MoviePromotionCandidate> candidates)
    {
        if (_isExecuting || candidates.Count == 0)
        {
            return;
        }

        _pendingMovieBatch = candidates;
        _isConfirmingMovieBatch = true;
    }

    private void CancelMovieBatchConfirm()
    {
        _isConfirmingMovieBatch = false;
        _pendingMovieBatch = [];
    }

    private async Task ConfirmMovieBatchAsync()
    {
        if (_isExecuting)
        {
            return;
        }

        _isExecuting = true;

        var succeeded = 0;
        var failed = 0;

        try
        {
            foreach (var candidate in _pendingMovieBatch.ToList())
            {
                var result =
                    await PromotionExecuteService
                        .ExecuteAsync(candidate.Plan!);

                await LogPromotionHistoryAsync(
                    candidate.Title,
                    candidate.Plan,
                    result.Success,
                    result.Reason);

                if (result.Success)
                {
                    succeeded++;

                    BumpHealthyHardlinkCount(
                        candidate.DriveProfileName,
                        candidate.IsTv);

                    PromotionCandidateCache.RemoveCandidate(
                        candidate.SourcePath);

                    _movieSelection.Remove(candidate);
                }
                else
                {
                    failed++;
                }
            }

            LoadCachedCandidates();

            _isConfirmingMovieBatch = false;
            _pendingMovieBatch = [];

            _statusMessage =
                failed == 0
                    ? $"Linked {succeeded} movie(s) into the library."
                    : $"Linked {succeeded} movie(s); {failed} failed and are still listed. See History for why.";
        }
        catch (Exception ex)
        {
            _statusMessage =
                $"Linking stopped part-way: {ex.Message}";
        }
        finally
        {
            _isExecuting = false;
        }
    }

    private async Task DeleteDownloadCopyAsync(
        MoviePromotionCandidate candidate)
    {
        if (_isExecuting)
        {
            return;
        }

        _isExecuting = true;

        try
        {
            var sizeBytes =
                File.Exists(candidate.SourcePath)
                    ? new FileInfo(candidate.SourcePath).Length
                    : 0;

            var quarantinePath =
                await QuarantineService.QuarantineFileAsync(
                    candidate.SourcePath);

            var success =
                !string.IsNullOrWhiteSpace(quarantinePath);

            await HistoryService.AddRecordAsync(
                new HistoryRecord
                {
                    ActionType = HistoryActionType.DownloadCopyRemoved,
                    FileName = candidate.Title,
                    LibraryPath = candidate.PreviousLibraryPath ?? string.Empty,
                    DownloadPath = candidate.SourcePath,
                    QuarantinePath = quarantinePath ?? string.Empty,
                    SizeBytes = sizeBytes,
                    Success = success,
                    Message =
                        success
                            ? "Download copy moved to Quarantine after its library copy was removed."
                            : "Failed to move download copy to Quarantine."
                });

            if (success)
            {
                PromotionCandidateCache.RemoveCandidate(candidate.SourcePath);

                LoadCachedCandidates();

                _statusMessage =
                    $"Moved \"{candidate.Title}\"'s download copy to Quarantine.";
            }
            else
            {
                _statusMessage =
                    $"Couldn't move \"{candidate.Title}\"'s download copy to Quarantine.";
            }
        }
        finally
        {
            _confirmingDownloadDelete.Remove(candidate.SourcePath);
            _isExecuting = false;
        }
    }

    private void IgnoreMovieCandidate(
        MoviePromotionCandidate candidate)
    {
        IgnoredItemsService.Add(
            new IgnoredItem
            {
                SourcePath = candidate.SourcePath,
                Title = candidate.Title,
                Category =
                    candidate.IsTv
                        ? IgnoredCategory.Tv
                        : IgnoredCategory.Movie,
                Year = candidate.Year,
                Season = candidate.Season,
                Episode = candidate.Episode,
                DriveProfileName = candidate.DriveProfileName,
                IgnoredUtc = DateTime.UtcNow,
                Reason = candidate.Reason
            });

        PromotionCandidateCache.RemoveCandidate(candidate.SourcePath);
        _movieSelection.Remove(candidate);

        LoadCachedCandidates();

        _statusMessage =
            $"Ignored \"{candidate.Title}\". It won't reappear until un-ignored and rescanned.";
    }

    private static string SeasonLabel(
        (string Title, int? Season) key) =>
        $"{key.Title} Season {key.Season?.ToString("00") ?? "Unknown"}";

    // Bulk version of IgnoreMovieCandidate for a season or a whole show.
    private void IgnoreEpisodes(
        List<MoviePromotionCandidate> episodes,
        string label)
    {
        var now = DateTime.UtcNow;

        IgnoredItemsService.AddRange(
            episodes.Select(candidate =>
                new IgnoredItem
                {
                    SourcePath = candidate.SourcePath,
                    Title = candidate.Title,
                    Category = IgnoredCategory.Tv,
                    Year = candidate.Year,
                    Season = candidate.Season,
                    Episode = candidate.Episode,
                    DriveProfileName = candidate.DriveProfileName,
                    IgnoredUtc = now,
                    Reason = candidate.Reason
                }));

        foreach (var candidate in episodes)
        {
            PromotionCandidateCache.RemoveCandidate(candidate.SourcePath);
            _movieSelection.Remove(candidate);
        }

        _confirmingIgnoreSeason.Clear();
        _confirmingIgnoreShow.Clear();

        LoadCachedCandidates();

        _statusMessage =
            $"Ignored {episodes.Count} episode(s) of {label}. They won't reappear until un-ignored and rescanned.";
    }

