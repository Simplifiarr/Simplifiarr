    private async Task LogPromotionHistoryAsync(
        string title,
        PromotionPlan? plan,
        bool success,
        string message)
    {
        var sizeBytes =
            plan is not null && File.Exists(plan.SourcePath)
                ? new FileInfo(plan.SourcePath).Length
                : 0;

        await HistoryService.AddRecordAsync(
            new HistoryRecord
            {
                ActionType =
                    success
                        ? HistoryActionType.PromotionSucceeded
                        : HistoryActionType.PromotionFailed,
                FileName = title,
                LibraryPath = plan?.TargetFilePath ?? string.Empty,
                DownloadPath = plan?.SourcePath ?? string.Empty,
                SizeBytes = sizeBytes,
                Success = success,
                Message = message
            });
    }

