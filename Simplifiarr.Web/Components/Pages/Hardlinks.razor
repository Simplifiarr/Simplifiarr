@page "/hardlinks"
@rendermode InteractiveServer

@implements IDisposable

@using Simplifiarr.Core.Models
@using Simplifiarr.Core.Services

@inject ISettingsService SettingsService
@inject IPromotionCandidateCacheService PromotionCandidateCache
@inject IPromotionPreviewService PromotionPreviewService
@inject IPromotionExecuteService PromotionExecuteService
@inject IIgnoredItemsService IgnoredItemsService
@inject IHistoryService HistoryService
@inject IWasteCandidateCacheService WasteCandidateCache
@inject IQuarantineService QuarantineService
@inject IScanCoordinator Scans

<PageTitle>Promotion Opportunities</PageTitle>

<h1>Library Hardlink Opportunities</h1>

<p>
    Completed downloads that can be promoted into your libraries using hardlinks.
    This list comes from the last scan - press <strong>Scan</strong> at the top
    of the page to refresh it.
</p>

<p>
    <a href="ignored">View Ignored Items</a>
</p>

@if (_profiles.Count == 0)
{
    <div class="alert alert-warning">
        No enabled drive profiles are configured.
    </div>
}
else if (_isScanning)
{
    <div class="alert alert-info">
        A scan is running. This page will update when it finishes.
    </div>
}

@if (!string.IsNullOrWhiteSpace(_statusMessage))
{
    <div class="alert alert-info mt-3">
        @_statusMessage
    </div>
}

@if (_selectedPreview is not null)
{
    <div class="card mt-4">
        <div class="card-header">
            Promotion Preview
        </div>

        <div class="card-body">
            <p>
                <strong>Source</strong>
            </p>

            <code>@_selectedPreview.SourcePath</code>

            <p class="mt-3">
                <strong>Target File</strong>
            </p>

            <code>@_selectedPreview.TargetFilePath</code>

            <p class="mt-3">
                <strong>Actions</strong>
            </p>

            <ul>
                @foreach (var action in _selectedPreview.PlannedActions)
                {
                    <li>@action</li>
                }
            </ul>

            <button class="btn btn-success"
                    disabled="@_isExecuting"
                    @onclick="ExecuteSelectedAsync">
                <i class="bi bi-check-lg" aria-hidden="true"></i>
                @(_isExecuting
                    ? "Promoting..."
                    : "Confirm Promotion")
            </button>

            <button class="btn btn-secondary ms-2"
                    disabled="@_isExecuting"
                    @onclick="CancelPreview">
                <i class="bi bi-x-lg" aria-hidden="true"></i>
                Cancel
            </button>
        </div>
    </div>
}

@if (!_hasScanned)
{
    <EmptyState Icon="search" Text="No movie/TV promotion scan has been run yet." />
}
else if (_candidates.Count == 0)
{
    <EmptyState Icon="check-circle" Text="No movie/TV promotion opportunities were found." />
}
else
{
    <h2 class="mt-4">
        Movie Opportunities
    </h2>

    @if (GetMovieCandidates().Count == 0)
    {
        <EmptyState Icon="check-circle" Text="No movie promotion opportunities were found." />
    }
    else
    {
        <p>
            <strong>@GetMovieCandidates().Count</strong>
            promotable movie(s) found.
        </p>

        @if (_isConfirmingMovieBatch)
        {
            <BatchConfirmBanner IsBusy="_isExecuting"
                                ConfirmLabel="Confirm Promote"
                                BusyLabel="Promoting..."
                                OnConfirm="ConfirmMovieBatchAsync"
                                OnCancel="CancelMovieBatchConfirm">
                <Message>
                    Promote @_pendingMovieBatch.Count movie(s)? This creates a hardlink for each.
                </Message>
            </BatchConfirmBanner>
        }
        else
        {
            <div class="mb-2">
                <button class="btn btn-primary btn-sm"
                        disabled="@(_isScanning || _isExecuting)"
                        @onclick="() => RequestMovieBatchConfirm(GetPromotableMovieCandidates())">
                    <i class="bi bi-arrow-up-right" aria-hidden="true"></i>
                    Promote All Movies
                </button>

                <button class="btn btn-primary btn-sm ms-2"
                        disabled="@(_isScanning || _isExecuting || _movieSelection.Count == 0)"
                        @onclick="() => RequestMovieBatchConfirm(GetSelectedPromotableMovieCandidates())">
                    <i class="bi bi-arrow-up-right" aria-hidden="true"></i>
                    Promote Selected (@_movieSelection.Count)
                </button>
            </div>
        }

        <table class="table">
            <thead>
                <tr>
                    <th>Select</th>
                    <th>Movie</th>
                    <th>Year</th>
                    <th>Status</th>
                    <th>Actions</th>
                    <th>Details</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var candidate in GetMovieCandidates())
                {
                    <tr class="@_moviePreviewSelection.RowClass(candidate)">
                        <SelectableCheckboxCell Checked="_movieSelection.IsSelected(candidate)"
                                                Disabled="_isScanning || _isExecuting"
                                                OnChanged="selected => _movieSelection.SetSelected(candidate, selected)" />

                        <td>
                            <strong>@candidate.Title</strong>

                            @if (candidate.WasPreviouslyPromoted)
                            {
                                <div>
                                    <span class="badge bg-warning text-dark">
                                        Previously promoted - library copy missing
                                    </span>
                                </div>
                            }

                            <div class="text-muted small">
                                Found @GetCandidateAgeText(candidate.DiscoveredUtc)
                            </div>

                            @if (!string.IsNullOrWhiteSpace(candidate.DriveProfileName))
                            {
                                <div class="text-muted small">
                                    Drive: @candidate.DriveProfileName
                                </div>
                            }
                        </td>

                        <td>
                            @(candidate.Year?.ToString() ?? "Unknown")
                        </td>

                        <td>
                            @if (candidate.CanPromote)
                            {
                                <i class="bi bi-check-circle text-success" aria-hidden="true"></i> <text>READY</text>
                            }
                            else
                            {
                                <i class="bi bi-x-circle text-danger" aria-hidden="true"></i> <text>BLOCKED</text>
                            }
                        </td>

                        <td>
                            @if (_confirmingDownloadDelete.Contains(candidate.SourcePath))
                            {
                                <div class="alert alert-warning p-2 mb-0">
                                    Move the download copy to Quarantine? Your
                                    torrent client may still list this as
                                    seeding/missing until you remove the
                                    torrent there too - Simplifiarr doesn't
                                    touch qBittorrent's torrent list.

                                    <div class="mt-1">
                                        <button class="btn btn-danger btn-sm"
                                                disabled="@_isExecuting"
                                                @onclick="() => DeleteDownloadCopyAsync(candidate)">
                                            <i class="bi bi-check-lg" aria-hidden="true"></i>
                                            Confirm
                                        </button>

                                        <button class="btn btn-secondary btn-sm ms-1"
                                                disabled="@_isExecuting"
                                                @onclick="() => _confirmingDownloadDelete.Remove(candidate.SourcePath)">
                                            <i class="bi bi-x-lg" aria-hidden="true"></i>
                                            Cancel
                                        </button>
                                    </div>
                                </div>
                            }
                            else
                            {
                                @if (candidate.CanPromote && candidate.Plan is not null)
                                {
                                    <button class="@_moviePreviewSelection.ButtonClass(candidate)"
                                            disabled="@_moviePreviewSelection.IsButtonDisabled(candidate, _isScanning || _isExecuting)"
                                            @onclick="() => PreviewAsync(candidate)">
                                        <i class="bi bi-arrow-up-right" aria-hidden="true"></i>
                                        @(candidate.WasPreviouslyPromoted ? "Re-promote" : _moviePreviewSelection.ButtonText(candidate))
                                    </button>
                                }
                                else if (candidate.CanPromote && candidate.Plan is null)
                                {
                                    <span class="text-muted small">No plan available</span>
                                }

                                @if (candidate.WasPreviouslyPromoted)
                                {
                                    <button class="btn btn-sm btn-outline-danger ms-1"
                                            disabled="@(_isScanning || _isExecuting)"
                                            @onclick="() => _confirmingDownloadDelete.Add(candidate.SourcePath)">
                                        <i class="bi bi-trash" aria-hidden="true"></i>
                                        Delete Download Copy
                                    </button>
                                }

                                <button class="btn btn-sm btn-outline-secondary ms-1"
                                        disabled="@(_isScanning || _isExecuting)"
                                        @onclick="() => IgnoreMovieCandidate(candidate)">
                                    <i class="bi bi-eye-slash" aria-hidden="true"></i>
                                    Ignore
                                </button>
                            }
                        </td>

                        <td>
                            <details>
                                <summary>View paths</summary>

                                <div class="mt-2">
                                    <div>
                                        <strong>Reason</strong>
                                    </div>

                                    <p>
                                        @candidate.Reason
                                    </p>

                                    <div>
                                        <strong>Source File</strong>
                                    </div>

                                    <code>
                                        @candidate.SourcePath
                                    </code>

                                    @if (candidate.Plan is not null)
                                    {
                                        <div class="mt-2">
                                            <strong>Target File</strong>
                                        </div>

                                        <code>
                                            @candidate.Plan.TargetFilePath
                                        </code>
                                    }
                                </div>
                            </details>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <h2 class="mt-4">
        TV Opportunities
    </h2>

    @if (GetTvGroups().Count == 0)
    {
        <EmptyState Icon="check-circle" Text="No TV promotion opportunities were found." />
    }
    else
    {
        <p>
            <strong>@GetTvGroups().Sum(group => group.Count())</strong>
            promotable episode(s) found across
            <strong>@GetTvGroups().Count</strong>
            show/season group(s).
        </p>

        @foreach (var group in GetTvGroups())
        {
            var key = group.Key;
            var episodes =
                group
                    .OrderBy(episode => episode.Episode)
                    .ToList();

            var episodeList =
                string.Join(
                    ", ",
                    episodes.Select(episode =>
                        episode.Episode.HasValue
                            ? $"E{episode.Episode:00}"
                            : "E?"));

            <div class="card mb-3">
                <div class="card-body">
                    <h5 class="card-title">
                        @key.Title
                        @(key.Season.HasValue ? $" — Season {key.Season:00}" : " — Season Unknown")
                    </h5>

                    <p class="card-text">
                        <strong>@episodes.Count</strong> missing episode(s): @episodeList
                    </p>

                    @if (_confirmingGroups.Contains(key))
                    {
                        <div class="alert alert-warning">
                            Promote all @episodes.Count episode(s) for @key.Title Season @(key.Season?.ToString("00") ?? "Unknown")?
                            This creates a hardlink for each missing episode.

                            <div class="mt-2">
                                <button class="btn btn-success btn-sm"
                                        disabled="@_isExecuting"
                                        @onclick="() => PromoteGroupAsync(key, episodes)">
                                    <i class="bi bi-check-lg" aria-hidden="true"></i>
                                    @(_isExecuting ? "Promoting..." : "Confirm Promote All")
                                </button>

                                <button class="btn btn-secondary btn-sm ms-2"
                                        disabled="@_isExecuting"
                                        @onclick="() => CancelGroupConfirm(key)">
                                    <i class="bi bi-x-lg" aria-hidden="true"></i>
                                    Cancel
                                </button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <button class="btn btn-primary btn-sm"
                                disabled="@_isExecuting"
                                @onclick="() => RequestGroupConfirm(key)">
                            <i class="bi bi-arrow-up-right" aria-hidden="true"></i>
                            Promote All @episodes.Count Episode(s)
                        </button>
                    }

                    @{
                        var showEpisodes =
                            GetTvGroups()
                                .Where(otherGroup =>
                                    string.Equals(otherGroup.Key.Title, key.Title, StringComparison.OrdinalIgnoreCase))
                                .SelectMany(otherGroup => otherGroup)
                                .ToList();
                    }

                    @if (_confirmingIgnoreSeason.Contains(key))
                    {
                        <div class="alert alert-secondary mt-2 mb-0">
                            Ignore all @episodes.Count episode(s) of @key.Title Season @(key.Season?.ToString("00") ?? "Unknown")?
                            They won't reappear until un-ignored (see Ignored Items) and rescanned.

                            <div class="mt-2">
                                <button class="btn btn-secondary btn-sm"
                                        disabled="@_isExecuting"
                                        @onclick="() => IgnoreEpisodes(episodes, SeasonLabel(key))">
                                    <i class="bi bi-eye-slash" aria-hidden="true"></i>
                                    Confirm Ignore Season
                                </button>

                                <button class="btn btn-outline-secondary btn-sm ms-2"
                                        @onclick="() => _confirmingIgnoreSeason.Remove(key)">
                                    Cancel
                                </button>
                            </div>
                        </div>
                    }
                    else if (_confirmingIgnoreShow.Contains(key.Title))
                    {
                        <div class="alert alert-secondary mt-2 mb-0">
                            Ignore all @showEpisodes.Count episode(s) of @key.Title across every season listed?
                            They won't reappear until un-ignored (see Ignored Items) and rescanned.

                            <div class="mt-2">
                                <button class="btn btn-secondary btn-sm"
                                        disabled="@_isExecuting"
                                        @onclick="() => IgnoreEpisodes(showEpisodes, key.Title)">
                                    <i class="bi bi-eye-slash" aria-hidden="true"></i>
                                    Confirm Ignore Entire Show
                                </button>

                                <button class="btn btn-outline-secondary btn-sm ms-2"
                                        @onclick="() => _confirmingIgnoreShow.Remove(key.Title)">
                                    Cancel
                                </button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="mt-2">
                            <button class="btn btn-outline-secondary btn-sm"
                                    disabled="@_isExecuting"
                                    @onclick="() => _confirmingIgnoreSeason.Add(key)">
                                <i class="bi bi-eye-slash" aria-hidden="true"></i>
                                Ignore All @episodes.Count Episode(s)
                            </button>

                            @if (showEpisodes.Count > episodes.Count)
                            {
                                <button class="btn btn-outline-secondary btn-sm ms-1"
                                        disabled="@_isExecuting"
                                        @onclick="() => _confirmingIgnoreShow.Add(key.Title)">
                                    <i class="bi bi-eye-slash" aria-hidden="true"></i>
                                    Ignore Entire Show (@showEpisodes.Count)
                                </button>
                            }
                        </div>
                    }

                    <details class="mt-3">
                        <summary>View individual episodes</summary>

                        <table class="table table-sm mt-2">
                            <thead>
                                <tr>
                                    <th>Episode</th>
                                    <th>Status</th>
                                    <th>Action</th>
                                    <th>Details</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var episode in episodes)
                                {
                                    <tr class="@_moviePreviewSelection.RowClass(episode)">
                                        <td>
                                            @(episode.Episode.HasValue
                                                ? $"E{episode.Episode:00}"
                                                : "Unknown")
                                        </td>

                                        <td>
                                            @if (episode.CanPromote)
                                            {
                                                <i class="bi bi-check-circle text-success" aria-hidden="true"></i> <text>READY</text>
                                            }
                                            else
                                            {
                                                <i class="bi bi-x-circle text-danger" aria-hidden="true"></i> <text>BLOCKED</text>
                                            }
                                        </td>

                                        <td>
                                            @if (episode.CanPromote && episode.Plan is not null)
                                            {
                                                <button class="@_moviePreviewSelection.ButtonClass(episode)"
                                                        disabled="@_moviePreviewSelection.IsButtonDisabled(episode, _isScanning || _isExecuting)"
                                                        @onclick="() => PreviewAsync(episode)">
                                                    <i class="bi bi-arrow-up-right" aria-hidden="true"></i>
                                                    @_moviePreviewSelection.ButtonText(episode)
                                                </button>
                                            }

                                            <button class="btn btn-sm btn-outline-secondary ms-1"
                                                    disabled="@_isExecuting"
                                                    @onclick="() => IgnoreMovieCandidate(episode)">
                                                <i class="bi bi-eye-slash" aria-hidden="true"></i>
                                                Ignore
                                            </button>
                                        </td>

                                        <td>
                                            <details>
                                                <summary>View paths</summary>

                                                <div class="mt-2">
                                                    <code>@episode.SourcePath</code>

                                                    @if (episode.Plan is not null)
                                                    {
                                                        <div class="mt-2">
                                                            <code>@episode.Plan.TargetFilePath</code>
                                                        </div>
                                                    }
                                                </div>
                                            </details>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </details>
                </div>
            </div>
        }
    }
}

@foreach (var definition in MediaTypeDefinitions.All)
{
    <MediaTypeSection @key="definition.MediaType"
                      Definition="definition"
                      Profiles="_profiles" />
}

@code
{
    private List<DriveProfile> _profiles = [];

    private List<MoviePromotionCandidate> _candidates = [];

    private readonly HashSet<(string Title, int? Season)>
        _confirmingGroups = [];

    private readonly HashSet<(string Title, int? Season)>
        _confirmingIgnoreSeason = [];

    private readonly HashSet<string> _confirmingIgnoreShow =
        new(StringComparer.OrdinalIgnoreCase);

    private readonly HashSet<string> _confirmingDownloadDelete =
        new(StringComparer.OrdinalIgnoreCase);

    private readonly CandidateSelection<MoviePromotionCandidate> _movieSelection =
        new(candidate => candidate.SourcePath);

    private readonly PreviewSelection<MoviePromotionCandidate> _moviePreviewSelection =
        new();

    private bool _isConfirmingMovieBatch;

    private List<MoviePromotionCandidate> _pendingMovieBatch = [];

    private PromotionPreview? _selectedPreview;

    private bool _isScanning;
    private bool _isExecuting;

    private bool _hasScanned;

    private string _statusMessage =
        string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _isScanning = Scans.Progress.IsRunning;

        Scans.Changed += OnScanChanged;

        _profiles =
            (await SettingsService.GetEnabledDriveProfilesAsync())
                .OrderBy(profile => profile.Name)
                .ToList();

        LoadCachedCandidates();
    }

    // Scanning is done by the app-wide Scan (top of every page). This page
    // only needs to know when one is running - so nothing can be promoted
    // from a list that is being rebuilt - and to reload when it finishes.
    private void OnScanChanged()
    {
        _ = InvokeAsync(() =>
        {
            var isRunning = Scans.Progress.IsRunning;

            if (isRunning == _isScanning)
            {
                return;
            }

            var justFinished = _isScanning && !isRunning;

            _isScanning = isRunning;

            if (justFinished)
            {
                // A rescan invalidates any preview based on the old list -
                // otherwise the preview card could keep showing a plan for
                // a candidate that no longer exists.
                _moviePreviewSelection.Clear();
                _selectedPreview = null;
                _confirmingGroups.Clear();
                _confirmingIgnoreSeason.Clear();
                _confirmingIgnoreShow.Clear();

                LoadCachedCandidates();

                _statusMessage =
                    $"Scan complete. {_candidates.Count} movie/TV opportunity(s) found.";
            }

            StateHasChanged();
        });
    }

    public void Dispose() =>
        Scans.Changed -= OnScanChanged;


    private List<MoviePromotionCandidate> GetMovieCandidates()
    {
        return _candidates
            .Where(candidate => !candidate.IsTv)
            .OrderBy(candidate => candidate.Title)
            .ThenBy(candidate => candidate.Year)
            .ToList();
    }

    private List<MoviePromotionCandidate> GetPromotableMovieCandidates()
    {
        return GetMovieCandidates()
            .Where(candidate => candidate.CanPromote && candidate.Plan is not null)
            .ToList();
    }

    private List<MoviePromotionCandidate> GetSelectedPromotableMovieCandidates()
    {
        return GetPromotableMovieCandidates()
            .Where(candidate => _movieSelection.IsSelected(candidate))
            .ToList();
    }

    private List<IGrouping<(string Title, int? Season), MoviePromotionCandidate>> GetTvGroups()
    {
        return _candidates
            .Where(candidate => candidate.IsTv)
            .GroupBy(candidate => (candidate.Title, candidate.Season))
            .OrderBy(group => group.Key.Title)
            .ThenBy(group => group.Key.Season)
            .ToList();
    }

    private void LoadCachedCandidates()
    {
        _candidates =
            _profiles
                .SelectMany(profile =>
                    PromotionCandidateCache.GetCandidates(profile.Name))
                .GroupBy(
                    candidate => candidate.SourcePath,
                    StringComparer.OrdinalIgnoreCase)
                .Select(group => group.First())
                .ToList();

        _hasScanned =
            _profiles.Any(profile =>
                PromotionCandidateCache.GetLastScanUtc(profile.Name).HasValue);

        if (_hasScanned)
        {
            _statusMessage =
                $"Loaded {_candidates.Count} cached promotion opportunity(s).";
        }
    }


    private static string GetCandidateAgeText(
        DateTime discoveredUtc)
    {
        if (discoveredUtc == default)
        {
            return "at an unknown time";
        }

        var age =
            DateTime.UtcNow - discoveredUtc;

        if (age < TimeSpan.Zero)
        {
            return "just now";
        }

        if (age.TotalMinutes < 1)
        {
            return "just now";
        }

        if (age.TotalHours < 1)
        {
            var minutes = Math.Max(1, (int)age.TotalMinutes);

            return $"{minutes} minute{(minutes == 1 ? string.Empty : "s")} ago";
        }

        if (age.TotalDays < 1)
        {
            var hours = Math.Max(1, (int)age.TotalHours);

            return $"{hours} hour{(hours == 1 ? string.Empty : "s")} ago";
        }

        var days = Math.Max(1, (int)age.TotalDays);

        return $"{days} day{(days == 1 ? string.Empty : "s")} ago";
    }

    private async Task PreviewAsync(
        MoviePromotionCandidate candidate)
    {
        if (_isScanning || _isExecuting || candidate.Plan is null)
        {
            return;
        }

        try
        {
            var preview =
                await PromotionPreviewService
                    .CreateAsync(candidate.Plan);

            _moviePreviewSelection.Select(candidate);
            _selectedPreview = preview;
        }
        catch (Exception ex)
        {
            _statusMessage =
                $"Preview failed: {ex.Message}";
        }
    }

    private void CancelPreview()
    {
        _moviePreviewSelection.Clear();

        _selectedPreview = null;
    }

    private async Task LogPromotionHistoryAsync(
        string title,
        PromotionPlan? plan,
        bool success,
        string message)
    {
        var sizeBytes =
            plan is not null && File.Exists(plan.SourcePath)
                ? new FileInfo(plan.SourcePath).Length
                : 0;

        await HistoryService.AddRecordAsync(
            new HistoryRecord
            {
                ActionType =
                    success
                        ? HistoryActionType.PromotionSucceeded
                        : HistoryActionType.PromotionFailed,
                FileName = title,
                LibraryPath = plan?.TargetFilePath ?? string.Empty,
                DownloadPath = plan?.SourcePath ?? string.Empty,
                SizeBytes = sizeBytes,
                Success = success,
                Message = message
            });
    }

    private void BumpHealthyHardlinkCount(
        string driveProfileName,
        bool isTv)
    {
        if (string.IsNullOrWhiteSpace(driveProfileName))
        {
            return;
        }

        WasteCandidateCache.IncrementHealthyHardlinkCount(
            driveProfileName,
            isTv ? MediaKind.Tv : MediaKind.Movies);
    }

    private async Task ExecuteSelectedAsync()
    {
        var promotedCandidate =
            _moviePreviewSelection.Selected;

        if (_isExecuting || promotedCandidate?.Plan is null)
        {
            return;
        }

        _isExecuting = true;

        try
        {
            var result =
                await PromotionExecuteService
                    .ExecuteAsync(
                        promotedCandidate.Plan);

            _statusMessage =
                result.Reason;

            await LogPromotionHistoryAsync(
                promotedCandidate.Title,
                promotedCandidate.Plan,
                result.Success,
                result.Reason);

            if (result.Success)
            {
                BumpHealthyHardlinkCount(
                    promotedCandidate.DriveProfileName,
                    promotedCandidate.IsTv);

                PromotionCandidateCache.RemoveCandidate(
                    promotedCandidate.SourcePath);

                LoadCachedCandidates();

                _moviePreviewSelection.Clear();
                _selectedPreview = null;

                _statusMessage =
                    $"{result.Reason} Remaining opportunities: {_candidates.Count}.";
            }
        }
        catch (Exception ex)
        {
            _statusMessage =
                $"Promotion failed: {ex.Message}";
        }
        finally
        {
            _isExecuting = false;
        }
    }

    private void RequestGroupConfirm(
        (string Title, int? Season) key)
    {
        _confirmingGroups.Add(key);
    }

    private void CancelGroupConfirm(
        (string Title, int? Season) key)
    {
        _confirmingGroups.Remove(key);
    }

    private async Task PromoteGroupAsync(
        (string Title, int? Season) key,
        List<MoviePromotionCandidate> episodes)
    {
        if (_isExecuting)
        {
            return;
        }

        _isExecuting = true;

        var succeeded = 0;
        var failed = 0;

        try
        {
            foreach (var episode in
                episodes
                    .Where(episode =>
                        episode.CanPromote &&
                        episode.Plan is not null)
                    .ToList())
            {
                var result =
                    await PromotionExecuteService
                        .ExecuteAsync(episode.Plan!);

                await LogPromotionHistoryAsync(
                    episode.Title,
                    episode.Plan,
                    result.Success,
                    result.Reason);

                if (result.Success)
                {
                    succeeded++;

                    BumpHealthyHardlinkCount(
                        episode.DriveProfileName,
                        episode.IsTv);

                    PromotionCandidateCache.RemoveCandidate(
                        episode.SourcePath);
                }
                else
                {
                    failed++;
                }
            }

            LoadCachedCandidates();

            _confirmingGroups.Remove(key);

            _statusMessage =
                failed == 0
                    ? $"{key.Title} Season {key.Season?.ToString("00") ?? "Unknown"}: promoted {succeeded} episode(s)."
                    : $"{key.Title} Season {key.Season?.ToString("00") ?? "Unknown"}: promoted {succeeded} episode(s), {failed} failed.";
        }
        catch (Exception ex)
        {
            _statusMessage =
                $"Batch promotion failed: {ex.Message}";
        }
        finally
        {
            _isExecuting = false;
        }
    }

    private void RequestMovieBatchConfirm(
        List<MoviePromotionCandidate> candidates)
    {
        if (_isExecuting || candidates.Count == 0)
        {
            return;
        }

        _pendingMovieBatch = candidates;
        _isConfirmingMovieBatch = true;
    }

    private void CancelMovieBatchConfirm()
    {
        _isConfirmingMovieBatch = false;
        _pendingMovieBatch = [];
    }

    private async Task ConfirmMovieBatchAsync()
    {
        if (_isExecuting)
        {
            return;
        }

        _isExecuting = true;

        var succeeded = 0;
        var failed = 0;

        try
        {
            foreach (var candidate in _pendingMovieBatch.ToList())
            {
                var result =
                    await PromotionExecuteService
                        .ExecuteAsync(candidate.Plan!);

                await LogPromotionHistoryAsync(
                    candidate.Title,
                    candidate.Plan,
                    result.Success,
                    result.Reason);

                if (result.Success)
                {
                    succeeded++;

                    BumpHealthyHardlinkCount(
                        candidate.DriveProfileName,
                        candidate.IsTv);

                    PromotionCandidateCache.RemoveCandidate(
                        candidate.SourcePath);

                    _movieSelection.Remove(candidate);
                }
                else
                {
                    failed++;
                }
            }

            LoadCachedCandidates();

            _isConfirmingMovieBatch = false;
            _pendingMovieBatch = [];

            _statusMessage =
                failed == 0
                    ? $"Promoted {succeeded} movie(s)."
                    : $"Promoted {succeeded} movie(s), {failed} failed.";
        }
        catch (Exception ex)
        {
            _statusMessage =
                $"Batch promotion failed: {ex.Message}";
        }
        finally
        {
            _isExecuting = false;
        }
    }

    private async Task DeleteDownloadCopyAsync(
        MoviePromotionCandidate candidate)
    {
        if (_isExecuting)
        {
            return;
        }

        _isExecuting = true;

        try
        {
            var sizeBytes =
                File.Exists(candidate.SourcePath)
                    ? new FileInfo(candidate.SourcePath).Length
                    : 0;

            var quarantinePath =
                await QuarantineService.QuarantineFileAsync(
                    candidate.SourcePath);

            var success =
                !string.IsNullOrWhiteSpace(quarantinePath);

            await HistoryService.AddRecordAsync(
                new HistoryRecord
                {
                    ActionType = HistoryActionType.DownloadCopyRemoved,
                    FileName = candidate.Title,
                    LibraryPath = candidate.PreviousLibraryPath ?? string.Empty,
                    DownloadPath = candidate.SourcePath,
                    QuarantinePath = quarantinePath ?? string.Empty,
                    SizeBytes = sizeBytes,
                    Success = success,
                    Message =
                        success
                            ? "Download copy moved to Quarantine after its library copy was removed."
                            : "Failed to move download copy to Quarantine."
                });

            if (success)
            {
                PromotionCandidateCache.RemoveCandidate(candidate.SourcePath);

                LoadCachedCandidates();

                _statusMessage =
                    $"Moved \"{candidate.Title}\"'s download copy to Quarantine.";
            }
            else
            {
                _statusMessage =
                    $"Couldn't move \"{candidate.Title}\"'s download copy to Quarantine.";
            }
        }
        finally
        {
            _confirmingDownloadDelete.Remove(candidate.SourcePath);
            _isExecuting = false;
        }
    }

    private void IgnoreMovieCandidate(
        MoviePromotionCandidate candidate)
    {
        IgnoredItemsService.Add(
            new IgnoredItem
            {
                SourcePath = candidate.SourcePath,
                Title = candidate.Title,
                Category =
                    candidate.IsTv
                        ? IgnoredCategory.Tv
                        : IgnoredCategory.Movie,
                Year = candidate.Year,
                Season = candidate.Season,
                Episode = candidate.Episode,
                DriveProfileName = candidate.DriveProfileName,
                IgnoredUtc = DateTime.UtcNow,
                Reason = candidate.Reason
            });

        PromotionCandidateCache.RemoveCandidate(candidate.SourcePath);
        _movieSelection.Remove(candidate);

        LoadCachedCandidates();

        _statusMessage =
            $"Ignored \"{candidate.Title}\". It won't reappear until un-ignored and rescanned.";
    }

    private static string SeasonLabel(
        (string Title, int? Season) key) =>
        $"{key.Title} Season {key.Season?.ToString("00") ?? "Unknown"}";

    // Bulk version of IgnoreMovieCandidate for a season or a whole show.
    private void IgnoreEpisodes(
        List<MoviePromotionCandidate> episodes,
        string label)
    {
        var now = DateTime.UtcNow;

        IgnoredItemsService.AddRange(
            episodes.Select(candidate =>
                new IgnoredItem
                {
                    SourcePath = candidate.SourcePath,
                    Title = candidate.Title,
                    Category = IgnoredCategory.Tv,
                    Year = candidate.Year,
                    Season = candidate.Season,
                    Episode = candidate.Episode,
                    DriveProfileName = candidate.DriveProfileName,
                    IgnoredUtc = now,
                    Reason = candidate.Reason
                }));

        foreach (var candidate in episodes)
        {
            PromotionCandidateCache.RemoveCandidate(candidate.SourcePath);
            _movieSelection.Remove(candidate);
        }

        _confirmingIgnoreSeason.Clear();
        _confirmingIgnoreShow.Clear();

        LoadCachedCandidates();

        _statusMessage =
            $"Ignored {episodes.Count} episode(s) of {label}. They won't reappear until un-ignored and rescanned.";
    }

