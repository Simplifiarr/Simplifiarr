@code
{
    private List<DriveProfile> _profiles = [];

    private List<MoviePromotionCandidate> _candidates = [];

    private readonly HashSet<(string Title, int? Season)>
        _confirmingGroups = [];

    private readonly HashSet<(string Title, int? Season)>
        _confirmingIgnoreSeason = [];

    private readonly HashSet<string> _confirmingIgnoreShow =
        new(StringComparer.OrdinalIgnoreCase);

    private readonly HashSet<string> _confirmingDownloadDelete =
        new(StringComparer.OrdinalIgnoreCase);

    private readonly CandidateSelection<MoviePromotionCandidate> _movieSelection =
        new(candidate => candidate.SourcePath);

    private readonly PreviewSelection<MoviePromotionCandidate> _moviePreviewSelection =
        new();

    private bool _isConfirmingMovieBatch;

    private List<MoviePromotionCandidate> _pendingMovieBatch = [];

    private PromotionPreview? _selectedPreview;

    private bool _isScanning;
    private bool _isExecuting;

    private bool _hasScanned;

    private string? _activeDriveName;
    private MediaKind? _activeKind;

    private string? _isScanningDrive;

    private string _statusMessage =
        string.Empty;

    private List<BookPromotionCandidate> _bookCandidates = [];

    private readonly CandidateSelection<BookPromotionCandidate> _bookSelection =
        new(candidate => candidate.SourcePath);

    private readonly PreviewSelection<BookPromotionCandidate> _bookPreviewSelection =
        new();

    private bool _isConfirmingBookBatch;

    private List<BookPromotionCandidate> _pendingBookBatch = [];

    private PromotionPreview? _selectedBookPreview;

    private bool _isScanningBooks;

    private bool _hasScannedBooks;

    private string? _activeBookDriveName;

    private List<AudiobookPromotionCandidate> _audiobookCandidates = [];

    private readonly CandidateSelection<AudiobookPromotionCandidate> _audiobookSelection =
        new(candidate => candidate.SourcePath);

    private readonly PreviewSelection<AudiobookPromotionCandidate> _audiobookPreviewSelection =
        new();

    private bool _isConfirmingAudiobookBatch;

    private List<AudiobookPromotionCandidate> _pendingAudiobookBatch = [];

    private PromotionPreview? _selectedAudiobookPreview;

    private bool _isScanningAudiobooks;

    private bool _hasScannedAudiobooks;

    private string? _activeAudiobookDriveName;

    private List<MusicPromotionCandidate> _musicCandidates = [];

    private readonly CandidateSelection<MusicPromotionCandidate> _musicSelection =
        new(candidate => candidate.SourcePath);

    private readonly PreviewSelection<MusicPromotionCandidate> _musicPreviewSelection =
        new();

    private bool _isConfirmingMusicBatch;

    private List<MusicPromotionCandidate> _pendingMusicBatch = [];

    private PromotionPreview? _selectedMusicPreview;

    private bool _isScanningMusic;

    private bool _hasScannedMusic;

    private string? _activeMusicDriveName;

    private List<ComicPromotionCandidate> _comicCandidates = [];

    private readonly CandidateSelection<ComicPromotionCandidate> _comicSelection =
        new(candidate => candidate.SourcePath);

    private readonly PreviewSelection<ComicPromotionCandidate> _comicPreviewSelection =
        new();

    private bool _isConfirmingComicBatch;

    private List<ComicPromotionCandidate> _pendingComicBatch = [];

    private PromotionPreview? _selectedComicPreview;

    private bool _isScanningComic;

    private bool _hasScannedComic;

    private string? _activeComicDriveName;

    protected override async Task OnInitializedAsync()
    {
        _profiles =
            (await SettingsService.GetEnabledDriveProfilesAsync())
                .OrderBy(profile => profile.Name)
                .ToList();

        LoadCachedCandidates();
        LoadCachedBookCandidates();
        LoadCachedAudiobookCandidates();
        LoadCachedMusicCandidates();
        LoadCachedComicCandidates();
    }

    private List<DriveScanCardRow> BuildRows(
        DriveProfile profile)
    {
        var profileCandidates =
            PromotionCandidateCache.GetCandidates(profile.Name);

        var movieCount =
            profileCandidates.Count(candidate => !candidate.IsTv);

        var tvCount =
            profileCandidates.Count(candidate => candidate.IsTv);

        var bookCount =
            BookPromotionCandidateCache.GetCandidates(profile.Name).Count;

        var audiobookCount =
            AudiobookPromotionCandidateCache.GetCandidates(profile.Name).Count;

        var musicCount =
            MusicPromotionCandidateCache.GetCandidates(profile.Name).Count;

        var comicCount =
            ComicPromotionCandidateCache.GetCandidates(profile.Name).Count;

        var anyMovieTvScanning =
            _isScanning || _isScanningDrive == profile.Name;

        var anyBookScanning =
            _isScanningBooks || _isScanningDrive == profile.Name;

        var anyAudiobookScanning =
            _isScanningAudiobooks || _isScanningDrive == profile.Name;

        var anyMusicScanning =
            _isScanningMusic || _isScanningDrive == profile.Name;

        var anyComicScanning =
            _isScanningComic || _isScanningDrive == profile.Name;

        var anyScanning =
            anyMovieTvScanning || anyBookScanning || anyAudiobookScanning || anyMusicScanning || anyComicScanning;

        return
        [
            new DriveScanCardRow
            {
                Label = "Movies",
                Count = movieCount,
                LastScanText = FormatScanTime(
                    PromotionCandidateCache.GetLastScanUtc(profile.Name, MediaKind.Movies)),
                IsScanning =
                    _isScanning &&
                    _activeDriveName == profile.Name &&
                    _activeKind == MediaKind.Movies,
                IsDisabled = anyScanning,
                OnScanClick = () => ScanAsync(profile.Name, MediaKind.Movies)
            },
            new DriveScanCardRow
            {
                Label = "TV",
                Count = tvCount,
                LastScanText = FormatScanTime(
                    PromotionCandidateCache.GetLastScanUtc(profile.Name, MediaKind.Tv)),
                IsScanning =
                    _isScanning &&
                    _activeDriveName == profile.Name &&
                    _activeKind == MediaKind.Tv,
                IsDisabled = anyScanning,
                OnScanClick = () => ScanAsync(profile.Name, MediaKind.Tv)
            },
            new DriveScanCardRow
            {
                Label = "Books",
                Count = bookCount,
                LastScanText = FormatScanTime(
                    BookPromotionCandidateCache.GetLastScanUtc(profile.Name)),
                IsScanning =
                    _isScanningBooks &&
                    _activeBookDriveName == profile.Name,
                IsDisabled = anyScanning,
                OnScanClick = () => ScanBooksAsync(profile.Name)
            },
            new DriveScanCardRow
            {
                Label = "Audiobooks",
                Count = audiobookCount,
                LastScanText = FormatScanTime(
                    AudiobookPromotionCandidateCache.GetLastScanUtc(profile.Name)),
                IsScanning =
                    _isScanningAudiobooks &&
                    _activeAudiobookDriveName == profile.Name,
                IsDisabled = anyScanning,
                OnScanClick = () => ScanAudiobooksAsync(profile.Name)
            },
            new DriveScanCardRow
            {
                Label = "Music",
                Count = musicCount,
                LastScanText = FormatScanTime(
                    MusicPromotionCandidateCache.GetLastScanUtc(profile.Name)),
                IsScanning =
                    _isScanningMusic &&
                    _activeMusicDriveName == profile.Name,
                IsDisabled = anyScanning,
                OnScanClick = () => ScanMusicAsync(profile.Name)
            },
            new DriveScanCardRow
            {
                Label = "Comics",
                Count = comicCount,
                LastScanText = FormatScanTime(
                    ComicPromotionCandidateCache.GetLastScanUtc(profile.Name)),
                IsScanning =
                    _isScanningComic &&
                    _activeComicDriveName == profile.Name,
                IsDisabled = anyScanning,
                OnScanClick = () => ScanComicAsync(profile.Name)
            }
        ];
    }

    private static string FormatScanTime(
        DateTime? scanUtc)
    {
        if (!scanUtc.HasValue)
        {
            return "Never";
        }

        return new DateTimeOffset(
                DateTime.SpecifyKind(scanUtc.Value, DateTimeKind.Utc))
            .LocalDateTime
            .ToString("g");
    }

    private List<MoviePromotionCandidate> GetMovieCandidates()
    {
        return _candidates
            .Where(candidate => !candidate.IsTv)
            .OrderBy(candidate => candidate.Title)
            .ThenBy(candidate => candidate.Year)
            .ToList();
    }

    private List<MoviePromotionCandidate> GetPromotableMovieCandidates()
    {
        return GetMovieCandidates()
            .Where(candidate => candidate.CanPromote && candidate.Plan is not null)
            .ToList();
    }

    private List<MoviePromotionCandidate> GetSelectedPromotableMovieCandidates()
    {
        return GetPromotableMovieCandidates()
            .Where(candidate => _movieSelection.IsSelected(candidate))
            .ToList();
    }

    private List<BookPromotionCandidate> GetPromotableBookCandidates()
    {
        return _bookCandidates
            .Where(candidate => candidate.CanPromote && candidate.Plan is not null)
            .ToList();
    }

    private List<BookPromotionCandidate> GetSelectedPromotableBookCandidates()
    {
        return GetPromotableBookCandidates()
            .Where(candidate => _bookSelection.IsSelected(candidate))
            .ToList();
    }

    private List<AudiobookPromotionCandidate> GetPromotableAudiobookCandidates()
