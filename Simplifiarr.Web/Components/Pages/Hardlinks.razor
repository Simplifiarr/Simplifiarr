    private async Task ScanDriveAsync(
        string driveName)
    {
        if (_isScanning || _isScanningBooks || _isScanningAudiobooks || _isScanningMusic || _isScanningComic || _isScanningDrive is not null)
        {
            return;
        }

        _isScanningDrive = driveName;

        try
        {
            await ScanAsync(driveName, MediaKind.Movies);
            await ScanAsync(driveName, MediaKind.Tv);
            await ScanBooksAsync(driveName);
            await ScanAudiobooksAsync(driveName);
            await ScanMusicAsync(driveName);
            await ScanComicAsync(driveName);
        }
        finally
        {
            _isScanningDrive = null;
        }
    }

    private async Task ScanAsync(
        string? driveName,
        MediaKind mediaKind)
    {
        if (_isScanning || _isExecuting)
        {
            return;
        }

        _isScanning = true;
        _activeDriveName = driveName;
        _activeKind = mediaKind;

        // A rescan invalidates any preview based on the old candidate list -
        // otherwise the preview card could keep showing a plan for a candidate
        // that no longer exists (or whose state changed) after this scan.
        _moviePreviewSelection.Clear();
        _selectedPreview = null;
        _confirmingGroups.Clear();
        _confirmingIgnoreSeason.Clear();
        _confirmingIgnoreShow.Clear();

        try
        {
            var kindLabel =
                mediaKind switch
                {
                    MediaKind.Movies => "Movies",
                    MediaKind.Tv => "TV",
                    _ => "Movies/TV"
                };

            var scanLabel =
                string.IsNullOrWhiteSpace(driveName)
                    ? $"all enabled drives ({kindLabel})"
                    : $"{driveName} ({kindLabel})";

            _statusMessage =
                $"Scanning {scanLabel}...";

            await PromotionCandidateService.GetCandidatesAsync(
                driveName,
                forceRefresh: true,
                mediaKind);

            LoadCachedCandidates();

            _statusMessage =
                $"Scan complete. {_candidates.Count} opportunity(s) found.";
        }
        catch (Exception ex)
        {
            _statusMessage =
                $"Scan failed: {ex.Message}";
        }
        finally
        {
            _isScanning = false;
            _activeDriveName = null;
            _activeKind = null;
        }
    }

