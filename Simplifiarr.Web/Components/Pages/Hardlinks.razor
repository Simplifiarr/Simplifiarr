@if (!_hasScanned)
{
    <EmptyState Icon="search" Text="No movie/TV promotion scan has been run yet." />
}
else if (_candidates.Count == 0)
{
    <EmptyState Icon="check-circle" Text="No movie/TV promotion opportunities were found." />
}
else
{
    <h2 class="mt-4">
        Movie Opportunities
    </h2>

    @if (GetMovieCandidates().Count == 0)
    {
        <EmptyState Icon="check-circle" Text="No movie promotion opportunities were found." />
    }
    else
    {
        <p>
            <strong>@GetMovieCandidates().Count</strong>
            promotable movie(s) found.
        </p>

        @if (_isConfirmingMovieBatch)
        {
            <BatchConfirmBanner IsBusy="_isExecuting"
                                ConfirmLabel="Confirm Promote"
                                BusyLabel="Promoting..."
                                OnConfirm="ConfirmMovieBatchAsync"
                                OnCancel="CancelMovieBatchConfirm">
                <Message>
                    Promote @_pendingMovieBatch.Count movie(s)? This creates a hardlink for each.
                </Message>
            </BatchConfirmBanner>
        }
        else
        {
            <div class="mb-2">
                <button class="btn btn-primary btn-sm"
                        disabled="@(_isScanning || _isExecuting)"
                        @onclick="() => RequestMovieBatchConfirm(GetPromotableMovieCandidates())">
                    <i class="bi bi-arrow-up-right" aria-hidden="true"></i>
                    Promote All Movies
                </button>

                <button class="btn btn-primary btn-sm ms-2"
                        disabled="@(_isScanning || _isExecuting || _movieSelection.Count == 0)"
                        @onclick="() => RequestMovieBatchConfirm(GetSelectedPromotableMovieCandidates())">
                    <i class="bi bi-arrow-up-right" aria-hidden="true"></i>
                    Promote Selected (@_movieSelection.Count)
                </button>
            </div>
        }

        <table class="table">
            <thead>
                <tr>
                    <th>Select</th>
                    <th>Movie</th>
                    <th>Year</th>
                    <th>Status</th>
                    <th>Actions</th>
                    <th>Details</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var candidate in GetMovieCandidates())
                {
                    <tr class="@_moviePreviewSelection.RowClass(candidate)">
                        <SelectableCheckboxCell Checked="_movieSelection.IsSelected(candidate)"
                                                Disabled="_isScanning || _isExecuting"
                                                OnChanged="selected => _movieSelection.SetSelected(candidate, selected)" />

                        <td>
                            <strong>@candidate.Title</strong>

                            @if (candidate.WasPreviouslyPromoted)
                            {
                                <div>
                                    <span class="badge bg-warning text-dark">
                                        Previously promoted - library copy missing
                                    </span>
                                </div>
                            }

                            <div class="text-muted small">
                                Found @GetCandidateAgeText(candidate.DiscoveredUtc)
                            </div>

                            @if (!string.IsNullOrWhiteSpace(candidate.DriveProfileName))
                            {
                                <div class="text-muted small">
                                    Drive: @candidate.DriveProfileName
                                </div>
                            }
                        </td>

                        <td>
                            @(candidate.Year?.ToString() ?? "Unknown")
                        </td>

                        <td>
                            @if (candidate.CanPromote)
                            {
                                <i class="bi bi-check-circle text-success" aria-hidden="true"></i> <text>READY</text>
                            }
                            else
                            {
                                <i class="bi bi-x-circle text-danger" aria-hidden="true"></i> <text>BLOCKED</text>
                            }
                        </td>

                        <td>
                            @if (_confirmingDownloadDelete.Contains(candidate.SourcePath))
                            {
                                <div class="alert alert-warning p-2 mb-0">
                                    Move the download copy to Quarantine? Your
                                    torrent client may still list this as
                                    seeding/missing until you remove the
                                    torrent there too - Simplifiarr doesn't
                                    touch qBittorrent's torrent list.

                                    <div class="mt-1">
                                        <button class="btn btn-danger btn-sm"
                                                disabled="@_isExecuting"
                                                @onclick="() => DeleteDownloadCopyAsync(candidate)">
                                            <i class="bi bi-check-lg" aria-hidden="true"></i>
                                            Confirm
                                        </button>

                                        <button class="btn btn-secondary btn-sm ms-1"
                                                disabled="@_isExecuting"
                                                @onclick="() => _confirmingDownloadDelete.Remove(candidate.SourcePath)">
                                            <i class="bi bi-x-lg" aria-hidden="true"></i>
                                            Cancel
                                        </button>
                                    </div>
                                </div>
                            }
                            else
                            {
                                @if (candidate.CanPromote && candidate.Plan is not null)
                                {
                                    <button class="@_moviePreviewSelection.ButtonClass(candidate)"
                                            disabled="@_moviePreviewSelection.IsButtonDisabled(candidate, _isScanning || _isExecuting)"
                                            @onclick="() => PreviewAsync(candidate)">
                                        <i class="bi bi-arrow-up-right" aria-hidden="true"></i>
                                        @(candidate.WasPreviouslyPromoted ? "Re-promote" : _moviePreviewSelection.ButtonText(candidate))
                                    </button>
                                }
                                else if (candidate.CanPromote && candidate.Plan is null)
                                {
                                    <span class="text-muted small">No plan available</span>
                                }

                                @if (candidate.WasPreviouslyPromoted)
                                {
                                    <button class="btn btn-sm btn-outline-danger ms-1"
                                            disabled="@(_isScanning || _isExecuting)"
                                            @onclick="() => _confirmingDownloadDelete.Add(candidate.SourcePath)">
                                        <i class="bi bi-trash" aria-hidden="true"></i>
                                        Delete Download Copy
                                    </button>
                                }

                                <button class="btn btn-sm btn-outline-secondary ms-1"
                                        disabled="@(_isScanning || _isExecuting)"
                                        @onclick="() => IgnoreMovieCandidate(candidate)">
                                    <i class="bi bi-eye-slash" aria-hidden="true"></i>
                                    Ignore
                                </button>
                            }
                        </td>

                        <td>
                            <details>
                                <summary>View paths</summary>

                                <div class="mt-2">
                                    <div>
                                        <strong>Reason</strong>
                                    </div>

                                    <p>
                                        @candidate.Reason
                                    </p>

                                    <div>
                                        <strong>Source File</strong>
                                    </div>

                                    <code>
                                        @candidate.SourcePath
                                    </code>

                                    @if (candidate.Plan is not null)
                                    {
                                        <div class="mt-2">
                                            <strong>Target File</strong>
                                        </div>

                                        <code>
                                            @candidate.Plan.TargetFilePath
                                        </code>
                                    }
                                </div>
                            </details>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <h2 class="mt-4">
        TV Opportunities
    </h2>

    @if (GetTvGroups().Count == 0)
    {
        <EmptyState Icon="check-circle" Text="No TV promotion opportunities were found." />
    }
    else
    {
        <p>
            <strong>@GetTvGroups().Sum(group => group.Count())</strong>
            promotable episode(s) found across
            <strong>@GetTvGroups().Count</strong>
            show/season group(s).
        </p>

        @foreach (var group in GetTvGroups())
        {
            var key = group.Key;
            var episodes =
                group
                    .OrderBy(episode => episode.Episode)
                    .ToList();

            var episodeList =
                string.Join(
                    ", ",
                    episodes.Select(episode =>
                        episode.Episode.HasValue
                            ? $"E{episode.Episode:00}"
                            : "E?"));

            <div class="card mb-3">
                <div class="card-body">
                    <h5 class="card-title">
                        @key.Title
                        @(key.Season.HasValue ? $" — Season {key.Season:00}" : " — Season Unknown")
                    </h5>

                    <p class="card-text">
                        <strong>@episodes.Count</strong> missing episode(s): @episodeList
                    </p>

                    @if (_confirmingGroups.Contains(key))
                    {
                        <div class="alert alert-warning">
                            Promote all @episodes.Count episode(s) for @key.Title Season @(key.Season?.ToString("00") ?? "Unknown")?
                            This creates a hardlink for each missing episode.

                            <div class="mt-2">
                                <button class="btn btn-success btn-sm"
                                        disabled="@_isExecuting"
                                        @onclick="() => PromoteGroupAsync(key, episodes)">
                                    <i class="bi bi-check-lg" aria-hidden="true"></i>
                                    @(_isExecuting ? "Promoting..." : "Confirm Promote All")
                                </button>

                                <button class="btn btn-secondary btn-sm ms-2"
                                        disabled="@_isExecuting"
                                        @onclick="() => CancelGroupConfirm(key)">
                                    <i class="bi bi-x-lg" aria-hidden="true"></i>
                                    Cancel
                                </button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <button class="btn btn-primary btn-sm"
                                disabled="@_isExecuting"
                                @onclick="() => RequestGroupConfirm(key)">
                            <i class="bi bi-arrow-up-right" aria-hidden="true"></i>
                            Promote All @episodes.Count Episode(s)
                        </button>
                    }

                    @{
                        var showEpisodes =
                            GetTvGroups()
                                .Where(otherGroup =>
                                    string.Equals(otherGroup.Key.Title, key.Title, StringComparison.OrdinalIgnoreCase))
                                .SelectMany(otherGroup => otherGroup)
                                .ToList();
                    }

                    @if (_confirmingIgnoreSeason.Contains(key))
                    {
                        <div class="alert alert-secondary mt-2 mb-0">
                            Ignore all @episodes.Count episode(s) of @key.Title Season @(key.Season?.ToString("00") ?? "Unknown")?
                            They won't reappear until un-ignored (see Ignored Items) and rescanned.

                            <div class="mt-2">
                                <button class="btn btn-secondary btn-sm"
                                        disabled="@_isExecuting"
                                        @onclick="() => IgnoreEpisodes(episodes, SeasonLabel(key))">
                                    <i class="bi bi-eye-slash" aria-hidden="true"></i>
                                    Confirm Ignore Season
                                </button>

                                <button class="btn btn-outline-secondary btn-sm ms-2"
                                        @onclick="() => _confirmingIgnoreSeason.Remove(key)">
                                    Cancel
                                </button>
                            </div>
                        </div>
                    }
                    else if (_confirmingIgnoreShow.Contains(key.Title))
                    {
                        <div class="alert alert-secondary mt-2 mb-0">
                            Ignore all @showEpisodes.Count episode(s) of @key.Title across every season listed?
                            They won't reappear until un-ignored (see Ignored Items) and rescanned.

                            <div class="mt-2">
                                <button class="btn btn-secondary btn-sm"
                                        disabled="@_isExecuting"
                                        @onclick="() => IgnoreEpisodes(showEpisodes, key.Title)">
                                    <i class="bi bi-eye-slash" aria-hidden="true"></i>
                                    Confirm Ignore Entire Show
                                </button>

                                <button class="btn btn-outline-secondary btn-sm ms-2"
                                        @onclick="() => _confirmingIgnoreShow.Remove(key.Title)">
                                    Cancel
                                </button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="mt-2">
                            <button class="btn btn-outline-secondary btn-sm"
                                    disabled="@_isExecuting"
                                    @onclick="() => _confirmingIgnoreSeason.Add(key)">
                                <i class="bi bi-eye-slash" aria-hidden="true"></i>
                                Ignore All @episodes.Count Episode(s)
                            </button>

                            @if (showEpisodes.Count > episodes.Count)
                            {
                                <button class="btn btn-outline-secondary btn-sm ms-1"
                                        disabled="@_isExecuting"
                                        @onclick="() => _confirmingIgnoreShow.Add(key.Title)">
                                    <i class="bi bi-eye-slash" aria-hidden="true"></i>
                                    Ignore Entire Show (@showEpisodes.Count)
                                </button>
                            }
                        </div>
                    }

                    <details class="mt-3">
                        <summary>View individual episodes</summary>

                        <table class="table table-sm mt-2">
                            <thead>
                                <tr>
                                    <th>Episode</th>
                                    <th>Status</th>
                                    <th>Action</th>
                                    <th>Details</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var episode in episodes)
                                {
                                    <tr class="@_moviePreviewSelection.RowClass(episode)">
                                        <td>
                                            @(episode.Episode.HasValue
                                                ? $"E{episode.Episode:00}"
                                                : "Unknown")
                                        </td>

                                        <td>
                                            @if (episode.CanPromote)
                                            {
                                                <i class="bi bi-check-circle text-success" aria-hidden="true"></i> <text>READY</text>
                                            }
                                            else
                                            {
                                                <i class="bi bi-x-circle text-danger" aria-hidden="true"></i> <text>BLOCKED</text>
                                            }
                                        </td>

                                        <td>
                                            @if (episode.CanPromote && episode.Plan is not null)
                                            {
                                                <button class="@_moviePreviewSelection.ButtonClass(episode)"
                                                        disabled="@_moviePreviewSelection.IsButtonDisabled(episode, _isScanning || _isExecuting)"
                                                        @onclick="() => PreviewAsync(episode)">
                                                    <i class="bi bi-arrow-up-right" aria-hidden="true"></i>
                                                    @_moviePreviewSelection.ButtonText(episode)
                                                </button>
                                            }

                                            <button class="btn btn-sm btn-outline-secondary ms-1"
                                                    disabled="@_isExecuting"
                                                    @onclick="() => IgnoreMovieCandidate(episode)">
                                                <i class="bi bi-eye-slash" aria-hidden="true"></i>
                                                Ignore
                                            </button>
                                        </td>

                                        <td>
                                            <details>
                                                <summary>View paths</summary>

                                                <div class="mt-2">
                                                    <code>@episode.SourcePath</code>

                                                    @if (episode.Plan is not null)
                                                    {
                                                        <div class="mt-2">
                                                            <code>@episode.Plan.TargetFilePath</code>
                                                        </div>
                                                    }
                                                </div>
                                            </details>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </details>
                </div>
            </div>
        }
    }
}

<h2 class="mt-4">
    Book Opportunities
</h2>

@if (!_hasScannedBooks)
{
    <EmptyState Icon="search" Text="No book promotion scan has been run yet." />
}
else if (_bookCandidates.Count == 0)
{
    <EmptyState Icon="check-circle" Text="No book promotion opportunities were found." />
}
else
{
    <p>
        <strong>@_bookCandidates.Count</strong>
        promotable book(s) found.
    </p>

    @if (_isConfirmingBookBatch)
    {
        <BatchConfirmBanner IsBusy="_isExecuting"
                            ConfirmLabel="Confirm Promote"
                            BusyLabel="Promoting..."
                            OnConfirm="ConfirmBookBatchAsync"
                            OnCancel="CancelBookBatchConfirm">
            <Message>
                Promote @_pendingBookBatch.Count book(s)? This creates a hardlink for each.
            </Message>
        </BatchConfirmBanner>
    }
    else
    {
        <div class="mb-2">
            <button class="btn btn-primary btn-sm"
                    disabled="@(_isScanningBooks || _isExecuting)"
                    @onclick="() => RequestBookBatchConfirm(GetPromotableBookCandidates())">
                <i class="bi bi-arrow-up-right" aria-hidden="true"></i>
                Promote All Books
            </button>

            <button class="btn btn-primary btn-sm ms-2"
                    disabled="@(_isScanningBooks || _isExecuting || _bookSelection.Count == 0)"
                    @onclick="() => RequestBookBatchConfirm(GetSelectedPromotableBookCandidates())">
                <i class="bi bi-arrow-up-right" aria-hidden="true"></i>
                Promote Selected (@_bookSelection.Count)
            </button>
        </div>
    }

    <table class="table">
        <thead>
            <tr>
                <th>Select</th>
                <th>Title</th>
                <th>Author</th>
                <th>Format</th>
                <th>Status</th>
                <th>Actions</th>
                <th>Details</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var candidate in _bookCandidates.OrderBy(candidate => candidate.Title))
            {
                <tr class="@_bookPreviewSelection.RowClass(candidate)">
                    <SelectableCheckboxCell Checked="_bookSelection.IsSelected(candidate)"
                                            Disabled="_isScanningBooks || _isExecuting"
                                            OnChanged="selected => _bookSelection.SetSelected(candidate, selected)" />

                    <td>
                        <strong>@candidate.Title</strong>

                        <div class="text-muted small">
                            Found @GetCandidateAgeText(candidate.DiscoveredUtc)
                        </div>

                        @if (!string.IsNullOrWhiteSpace(candidate.DriveProfileName))
                        {
                            <div class="text-muted small">
                                Drive: @candidate.DriveProfileName
                            </div>
                        }
                    </td>

                    <td>
                        @(candidate.Author ?? "Unknown")
                    </td>

                    <td>
                        @candidate.Format.ToUpperInvariant()
                    </td>

                    <td>
                        @if (candidate.CanPromote)
                        {
                            <i class="bi bi-check-circle text-success" aria-hidden="true"></i> <text>READY</text>
                        }
                        else
                        {
