@page "/hardlinks"
@rendermode InteractiveServer

@using Simplifiarr.Core.Models
@using Simplifiarr.Core.Services

@inject IMoviePromotionCandidateService PromotionCandidateService
@inject ISettingsService SettingsService
@inject IPromotionCandidateCacheService PromotionCandidateCache
@inject IPromotionPreviewService PromotionPreviewService
@inject IPromotionExecuteService PromotionExecuteService
@inject IBookPromotionCandidateService BookPromotionCandidateService
@inject IBookPromotionCandidateCacheService BookPromotionCandidateCache
@inject IAudiobookPromotionCandidateService AudiobookPromotionCandidateService
@inject IAudiobookPromotionCandidateCacheService AudiobookPromotionCandidateCache
@inject IMusicPromotionCandidateService MusicPromotionCandidateService
@inject IMusicPromotionCandidateCacheService MusicPromotionCandidateCache
@inject IComicPromotionCandidateService ComicPromotionCandidateService
@inject IComicPromotionCandidateCacheService ComicPromotionCandidateCache
@inject IIgnoredItemsService IgnoredItemsService
@inject IHistoryService HistoryService
@inject IWasteCandidateCacheService WasteCandidateCache
@inject IQuarantineService QuarantineService

<PageTitle>Promotion Opportunities</PageTitle>

<h1>Library Hardlink Opportunities</h1>

<p>
    Find completed downloads that can be promoted into your libraries using hardlinks.
</p>

<p>
    <a href="ignored">View Ignored Items</a>
</p>

@if (_profiles.Count == 0)
{
    <div class="alert alert-warning">
        No enabled drive profiles are configured.
    </div>
}
else
{
    <div class="row g-3 mt-2">
        @foreach (var profile in _profiles)
        {
            <div class="col-md-6">
                <DriveScanCard DriveName="@profile.Name"
                               DownloadPath="@profile.DownloadPath"
                               Rows="BuildRows(profile)"
                               IsScanningDrive="@(_isScanningDrive == profile.Name)"
                               OnScanDrive="() => ScanDriveAsync(profile.Name)" />
            </div>
        }
    </div>
}

@if (!string.IsNullOrWhiteSpace(_statusMessage))
{
    <div class="alert alert-info mt-3">
        @_statusMessage
    </div>
}

@if (_selectedPreview is not null)
{
    <div class="card mt-4">
        <div class="card-header">
            Promotion Preview
        </div>

        <div class="card-body">
            <p>
                <strong>Source</strong>
            </p>

            <code>@_selectedPreview.SourcePath</code>

            <p class="mt-3">
                <strong>Target File</strong>
            </p>

            <code>@_selectedPreview.TargetFilePath</code>

            <p class="mt-3">
                <strong>Actions</strong>
            </p>

            <ul>
                @foreach (var action in _selectedPreview.PlannedActions)
                {
                    <li>@action</li>
                }
            </ul>

            <button class="btn btn-success"
                    disabled="@_isExecuting"
                    @onclick="ExecuteSelectedAsync">
                <i class="bi bi-check-lg" aria-hidden="true"></i>
                @(_isExecuting
                    ? "Promoting..."
                    : "Confirm Promotion")
            </button>

            <button class="btn btn-secondary ms-2"
                    disabled="@_isExecuting"
                    @onclick="CancelPreview">
                <i class="bi bi-x-lg" aria-hidden="true"></i>
                Cancel
            </button>
        </div>
    </div>
}

@if (_selectedBookPreview is not null)
{
    <div class="card mt-4">
        <div class="card-header">
            Book Promotion Preview
        </div>

        <div class="card-body">
