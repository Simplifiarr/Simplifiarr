@inherits LayoutComponentBase

<div class="app-shell">
    @* Narrow screens: this hidden checkbox is what the menu button toggles;
       the stylesheet shows the sidebar while it is ticked. No script needed. *@
    <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-hidden="true" tabindex="-1" />

    <aside class="app-sidebar" onclick="document.getElementById('nav-toggle').checked = false">
        <a class="app-brand" href="" title="Store once. Seed everywhere. Waste nothing.">
            <span class="app-brand-mark" aria-hidden="true"></span>
            Simplifiarr
        </a>

        <NavMenu />
    </aside>

    <div class="app-main">
        <header class="app-topbar">
            <label for="nav-toggle" class="topbar-btn nav-toggle-btn">
                <i class="bi bi-list" aria-hidden="true"></i> Menu
            </label>

            <ScanBar @rendermode="InteractiveServer" />

            <button type="button"
                    id="theme-toggle-btn"
                    class="theme-toggle-btn"
                    title="Switch between light, dark and your system's setting">
            </button>
        </header>

        <main class="app-content">
            @Body
        </main>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Something went wrong on this page.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
