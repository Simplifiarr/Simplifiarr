@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <div class="brand">
                <a class="brand-link" href="">Simplifiarr</a>
                <span class="brand-tagline">Store once. Seed everywhere. Waste nothing.</span>
            </div>

            <ScanBar @rendermode="InteractiveServer" />

            <button type="button"
                    id="theme-toggle-btn"
                    class="theme-toggle-btn"
                    title="Toggle color theme (System / Light / Dark)">
            </button>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
