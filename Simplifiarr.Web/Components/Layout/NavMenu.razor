@inject Simplifiarr.Core.Services.IUpdateService Updates

@*
    The whole app's navigation, grouped by what you're there to do:
      Torrents & seeding - keep seeding where it costs the least
      Free up space      - what takes space and doesn't need to (Copies
                           also links downloads into the library)
      Fix & tidy         - put wrong things right
      Jellyfin           - how the library looks
      Automatic          - rules that run by themselves
      Safety net         - undo, review and exceptions
*@

<nav class="app-nav" aria-label="Main">
    <div class="nav-group">
        <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
            <i class="bi bi-house-door" aria-hidden="true"></i> Home
        </NavLink>
    </div>

    <div class="nav-group">
        <div class="nav-group-label">Torrents &amp; seeding</div>

        <NavLink class="nav-link" href="move-seeds">
            <i class="bi bi-truck" aria-hidden="true"></i> Move Seeds
        </NavLink>
        <NavLink class="nav-link" href="cross-seed">
            <i class="bi bi-share" aria-hidden="true"></i> Cross-Seed
        </NavLink>
        <NavLink class="nav-link" href="torrent-rebuilder">
            <i class="bi bi-hammer" aria-hidden="true"></i> Torrent Rebuilder
        </NavLink>
    </div>

    <div class="nav-group">
        <div class="nav-group-label">Free up space</div>

        <NavLink class="nav-link" href="copies">
            <i class="bi bi-copy" aria-hidden="true"></i> Copies
        </NavLink>
        <NavLink class="nav-link" href="storage">
            <i class="bi bi-device-hdd" aria-hidden="true"></i> Storage
        </NavLink>
        <NavLink class="nav-link" href="junk-cleanup">
            <i class="bi bi-trash3" aria-hidden="true"></i> Junk
        </NavLink>
        <NavLink class="nav-link" href="size-reduction">
            <i class="bi bi-file-earmark-zip" aria-hidden="true"></i> Size Reduction
        </NavLink>
    </div>

    <div class="nav-group">
        <div class="nav-group-label">Fix &amp; tidy</div>

        <NavLink class="nav-link" href="folder-fixer">
            <i class="bi bi-signpost-split" aria-hidden="true"></i> Folder Fixer
        </NavLink>
        <NavLink class="nav-link" href="playback-errors">
            <i class="bi bi-exclamation-octagon" aria-hidden="true"></i> Playback Errors
        </NavLink>
        <NavLink class="nav-link" href="music">
            <i class="bi bi-music-note-beamed" aria-hidden="true"></i> Music
        </NavLink>
    </div>

    <div class="nav-group">
        <div class="nav-group-label">Jellyfin</div>

        <NavLink class="nav-link" href="posters">
            <i class="bi bi-image" aria-hidden="true"></i> Posters
        </NavLink>
        <NavLink class="nav-link" href="collections">
            <i class="bi bi-collection" aria-hidden="true"></i> Collections
        </NavLink>
    </div>

    <div class="nav-group">
        <div class="nav-group-label">Automatic</div>

        <NavLink class="nav-link" href="rolling-shows">
            <i class="bi bi-tv" aria-hidden="true"></i> Rolling Shows
        </NavLink>
        <NavLink class="nav-link" href="rolling-movies">
            <i class="bi bi-film" aria-hidden="true"></i> Rolling Movies
        </NavLink>
    </div>

    <div class="nav-group">
        <div class="nav-group-label">Safety net</div>

        <NavLink class="nav-link" href="quarantine">
            <i class="bi bi-box-seam" aria-hidden="true"></i> Quarantine
        </NavLink>
        <NavLink class="nav-link" href="history">
            <i class="bi bi-clock-history" aria-hidden="true"></i> History
        </NavLink>
        <NavLink class="nav-link" href="ignored">
            <i class="bi bi-eye-slash" aria-hidden="true"></i> Ignored
        </NavLink>
    </div>

    <div class="nav-group nav-group-bottom">
        <NavLink class="nav-link" href="settings">
            <i class="bi bi-gear" aria-hidden="true"></i> Settings
        </NavLink>
        <NavLink class="nav-link" href="setup">
            <i class="bi bi-ui-checks" aria-hidden="true"></i> Setup
        </NavLink>
        <NavLink class="nav-link" href="updates">
            <i class="bi bi-cloud-arrow-down" aria-hidden="true"></i> Updates
            <span class="nav-version">v@(Updates.CurrentVersion)</span>
        </NavLink>
        <NavLink class="nav-link" href="help">
            <i class="bi bi-question-circle" aria-hidden="true"></i> Help
        </NavLink>
        <NavLink class="nav-link" href="support">
            <i class="bi bi-life-preserver" aria-hidden="true"></i> Logs &amp; support
        </NavLink>
    </div>
</nav>
